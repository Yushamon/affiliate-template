---
import AffiliateLayout from "@affiliate-core/layouts/AffiliateLayout.astro";
import { getNavigationItems } from "@app/domain/content";
import ImageLightbox from "@affiliate-core/components/ImageLightbox.astro";
import SiteRuntimeFixes from "../components/SiteRuntimeFixes.astro";
import "../styles/pfotentechnik-design-tokens.css";
import "../styles/pfotentechnik.css";
import "../styles/pfotentechnik-design-system.css";
import "../styles/pfotentechnik-ui-system.css";
import "../styles/pfotentechnik-product-mobile-premium.css";

const props = Astro.props;
const headerLinks = await getNavigationItems();
const webAnalyticsToken = import.meta.env.CLOUDFLARE_WEB_ANALYTICS_TOKEN?.trim();
const normalizeCanonicalPath = (value) => {
  const raw = String(value ?? "/").trim();
  let pathname = raw;

  try {
    pathname = new URL(raw, "https://pfotentechnik.de").pathname;
  } catch {
    pathname = raw.split(/[?#]/, 1)[0] || "/";
  }

  const withLeadingSlash = pathname.startsWith("/")
    ? pathname
    : `/${pathname}`;

  return withLeadingSlash === "/" || withLeadingSlash.endsWith("/")
    ? withLeadingSlash
    : `${withLeadingSlash}/`;
};

const canonical = normalizeCanonicalPath(props.canonical ?? "/");
---

<AffiliateLayout
  {...props}
  canonical={canonical}
  webAnalyticsToken={webAnalyticsToken}
  headerLinks={headerLinks}
>
  <slot />
  <ImageLightbox />
<SiteRuntimeFixes />
</AffiliateLayout>
