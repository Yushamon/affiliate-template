---
import type { ProductDecisionProfile } from "../../domain/productExperience/decisionEngine";

interface Alternative {
  title: string;
  href: string;
  label: string;
  score?: number;
  matchKeys?: string[];
  decisionProfile?: ProductDecisionProfile;
}

interface Props {
  profile: ProductDecisionProfile;
  alternatives?: Alternative[];
}

const { profile, alternatives = [] } = Astro.props;
const usesFoodQuestions = profile.usesFoodQuestions !== false;
const questionCount = usesFoodQuestions ? 7 : 5;
const questionCountLabel = questionCount === 7 ? "Sieben" : "Fünf";
const serializedProfile = JSON.stringify(profile).replaceAll("<", "\\u003c");
const serializedAlternatives = JSON.stringify(alternatives).replaceAll("<", "\\u003c");
---

<section class="decision" aria-labelledby="decision-title" data-decision-assistant>
  <header class="decision__header">
    <span>Interaktive Kaufentscheidung</span>
    <h2 id="decision-title">Passt dieses Produkt zu deinem Alltag?</h2>
    <p>{questionCountLabel} kurze Angaben. Das Ergebnis wird sofort auf dieser Seite berechnet.</p>
  </header>

  <form class="decision__form" data-decision-form>
    <fieldset data-question="animal">
      <legend>Für welches Tier?</legend>
      <label><input type="radio" name="animal" value="cat" /> Katze</label>
      <label><input type="radio" name="animal" value="dog" /> Hund</label>
    </fieldset>

    <fieldset data-question="animalCount">
      <legend>Wie viele Tiere nutzen das Produkt?</legend>
      <label><input type="radio" name="animalCount" value="1" /> Ein Tier</label>
      <label><input type="radio" name="animalCount" value="2" /> Zwei Tiere</label>
      <label><input type="radio" name="animalCount" value="3" /> Drei oder mehr</label>
    </fieldset>

    {usesFoodQuestions && (
      <>
        <fieldset data-question="dryFood">
          <legend>Trockenfutter?</legend>
          <label><input type="radio" name="dryFood" value="yes" /> Ja</label>
          <label><input type="radio" name="dryFood" value="no" /> Nein</label>
        </fieldset>

        <fieldset data-question="wetFood">
          <legend>Nassfutter?</legend>
          <label><input type="radio" name="wetFood" value="yes" /> Ja</label>
          <label><input type="radio" name="wetFood" value="no" /> Nein</label>
        </fieldset>
      </>
    )}

    <fieldset data-question="budget">
      <legend>Welches Budget passt?</legend>
      <label><input type="radio" name="budget" value="budget" /> Preisbewusst</label>
      <label><input type="radio" name="budget" value="midrange" /> Mittelklasse</label>
      <label><input type="radio" name="budget" value="premium" /> Premium</label>
    </fieldset>

    <fieldset data-question="wifi">
      <legend>WLAN und App?</legend>
      <label><input type="radio" name="wifi" value="required" /> Gewünscht</label>
      <label><input type="radio" name="wifi" value="optional" /> Egal</label>
      <label><input type="radio" name="wifi" value="offline" /> Möglichst offline</label>
    </fieldset>

    <fieldset data-question="camera">
      <legend>Kamera?</legend>
      <label><input type="radio" name="camera" value="required" /> Wichtig</label>
      <label><input type="radio" name="camera" value="optional" /> Nicht entscheidend</label>
      <label><input type="radio" name="camera" value="unwanted" /> Lieber ohne</label>
    </fieldset>
  </form>

  <aside
    class="decision__result"
    aria-live="polite"
    aria-atomic="true"
    data-decision-result
    data-verdict="open"
  >
    <div class="decision__score"><strong data-result-score>–</strong><span>von 100</span></div>
    <div>
      <p class="decision__verdict" data-result-verdict>Beantworte die Fragen für eine persönliche Einordnung.</p>
      <div class="decision__reasons" role="list" data-result-reasons></div>
      <a class="decision__alternative" href="#alternativen" data-result-alternative hidden></a>
    </div>
  </aside>

  <script type="application/json" data-decision-profile set:html={serializedProfile}></script>
  <script type="application/json" data-decision-alternatives set:html={serializedAlternatives}></script>
</section>

<script>
  import { evaluateProductDecision } from "../../domain/productExperience/decisionEngine";

  type ResultReason = {
    kind: "positive" | "neutral" | "negative";
    text: string;
  };

  const reasonMark: Record<ResultReason["kind"], string> = {
    positive: "✓",
    neutral: "–",
    negative: "×"
  };

  const roots = document.querySelectorAll<HTMLElement>("[data-decision-assistant]");

  roots.forEach((root) => {
    const form = root.querySelector<HTMLFormElement>("[data-decision-form]");
    const result = root.querySelector<HTMLElement>("[data-decision-result]");
    const profileNode = root.querySelector<HTMLScriptElement>("[data-decision-profile]");
    const alternativesNode = root.querySelector<HTMLScriptElement>("[data-decision-alternatives]");

    if (!form || !result || !profileNode || !alternativesNode) return;

    const profile = JSON.parse(profileNode.textContent || "{}");
    const alternatives = JSON.parse(alternativesNode.textContent || "[]");
    const scoreNode = result.querySelector<HTMLElement>("[data-result-score]");
    const verdictNode = result.querySelector<HTMLElement>("[data-result-verdict]");
    const reasonsNode = result.querySelector<HTMLElement>("[data-result-reasons]");
    const alternativeNode = result.querySelector<HTMLAnchorElement>("[data-result-alternative]");

    const update = () => {
      const data = new FormData(form);
      const answers = {
        animal: data.get("animal") || null,
        animalCount: Number(data.get("animalCount") || 0) || null,
        dryFood: data.has("dryFood") ? data.get("dryFood") === "yes" : undefined,
        wetFood: data.has("wetFood") ? data.get("wetFood") === "yes" : undefined,
        budget: data.get("budget") || null,
        wifi: data.get("wifi") || null,
        camera: data.get("camera") || null
      };

      const evaluation = evaluateProductDecision(profile, answers);
      result.dataset.verdict = evaluation.verdict;

      if (scoreNode) {
        scoreNode.textContent = evaluation.completed ? String(evaluation.score) : "–";
      }

      if (verdictNode) {
        verdictNode.textContent = `${evaluation.headline}. ${evaluation.explanation}`;
      }

      if (reasonsNode) {
        const reasons: ResultReason[] = [
          ...evaluation.risks.map((text: string) => ({ kind: "negative" as const, text })),
          ...evaluation.neutrals.map((text: string) => ({ kind: "neutral" as const, text })),
          ...evaluation.positives.map((text: string) => ({ kind: "positive" as const, text }))
        ].slice(0, 6);

        reasonsNode.replaceChildren(...reasons.map((reason) => {
          const item = document.createElement("div");
          item.className = "decision__reason";
          item.dataset.kind = reason.kind;
          item.setAttribute("role", "listitem");

          const mark = document.createElement("span");
          mark.className = "decision__reason-mark";
          mark.setAttribute("aria-hidden", "true");
          mark.textContent = reasonMark[reason.kind];

          const copy = document.createElement("span");
          copy.className = "decision__reason-copy";
          copy.textContent = reason.text;

          item.append(mark, copy);
          return item;
        }));
      }

      if (alternativeNode) {
        const ranked = alternatives
          .map((item: any) => {
            const alternativeEvaluation = item.decisionProfile
              ? evaluateProductDecision(item.decisionProfile, answers)
              : null;
            const personalScore = alternativeEvaluation?.score ?? null;
            const editorialScore = Number(item.score || 0);
            const currentEditorialScore = Number(profile.editorialScore || 0);
            const gain = personalScore != null
              ? personalScore - evaluation.score
              : editorialScore - currentEditorialScore;
            const resolvedMismatches = alternativeEvaluation
              ? evaluation.mismatchKeys.filter(
                  (key: string) => !alternativeEvaluation.mismatchKeys.includes(key)
                ).length
              : Array.isArray(item.matchKeys)
                ? item.matchKeys.filter((key: string) => evaluation.mismatchKeys.includes(key)).length
                : 0;

            return {
              item,
              personalScore,
              editorialScore,
              gain,
              resolvedMismatches
            };
          })
          .filter((candidate: any) => candidate.gain >= 5)
          .sort((left: any, right: any) =>
            right.gain - left.gain ||
            right.resolvedMismatches - left.resolvedMismatches ||
            right.editorialScore - left.editorialScore
          );

        const match = ranked[0];

        if (evaluation.isComplete && evaluation.score < 82 && match) {
          alternativeNode.hidden = false;
          alternativeNode.href = match.item.href || "#alternativen";
          alternativeNode.textContent = match.personalScore != null
            ? `Passendere Alternative: ${match.item.title} · persönlicher Fit ${match.personalScore}/100`
            : `Besser bewertete Alternative: ${match.item.title} · ${Math.round(match.editorialScore)}/100`;
        } else {
          alternativeNode.hidden = true;
          alternativeNode.removeAttribute("href");
          alternativeNode.textContent = "";
        }
      }
    };

    form.addEventListener("change", update);
    update();
  });
</script>

<style>
  .decision {
    display: grid;
    gap: 22px;
    padding: clamp(20px, 4vw, 36px);
    border: 1px solid var(--px2-border);
    border-radius: 24px;
    background: var(--px2-surface);
    box-shadow: var(--px2-shadow);
  }

  .decision__header span {
    color: var(--px2-green-strong);
    font-size: .78rem;
    font-weight: 850;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .decision__header h2 {
    margin: 7px 0 8px;
    color: var(--px2-text);
    font-size: clamp(1.65rem, 4vw, 2.5rem);
    line-height: 1.08;
    letter-spacing: -.025em;
  }

  .decision__header p {
    margin: 0;
    color: var(--px2-muted);
    line-height: 1.55;
  }

  .decision__form {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 26px;
  }

  fieldset {
    min-width: 0;
    margin: 0;
    padding: 17px 0 10px;
    border: 0;
    border-top: 1px solid var(--px2-border);
    border-radius: 0;
    background: transparent;
  }

  legend {
    padding: 0 10px 0 0;
    color: var(--px2-text);
    font-weight: 850;
  }

  label {
    display: flex;
    min-height: 40px;
    align-items: center;
    gap: 9px;
    padding: 4px 0;
    color: var(--px2-text);
    cursor: pointer;
  }

  input {
    width: 19px;
    height: 19px;
    accent-color: var(--px2-green);
  }

  .decision__result {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: 18px;
    padding: 18px;
    border: 1px solid var(--px2-border);
    border-radius: 20px;
    background: var(--px2-surface-soft);
  }

  .decision__result[data-verdict="strong"] { background: var(--px2-green-soft); }
  .decision__result[data-verdict="conditional"] { background: var(--px2-amber-soft); }
  .decision__result[data-verdict="weak"] { background: var(--px2-red-soft); }

  .decision__score {
    display: grid;
    width: 92px;
    height: 92px;
    place-items: center;
    border: 1px solid color-mix(in srgb, var(--px2-green) 35%, transparent);
    border-radius: 50%;
    background: var(--px2-surface);
  }

  .decision__result[data-verdict="conditional"] .decision__score {
    border-color: color-mix(in srgb, var(--px2-amber) 55%, var(--px2-border));
  }

  .decision__result[data-verdict="weak"] .decision__score {
    border-color: color-mix(in srgb, var(--px2-red) 55%, var(--px2-border));
  }

  .decision__score strong {
    color: var(--px2-text);
    font-size: 2rem;
    line-height: 1;
  }

  .decision__score span {
    color: var(--px2-muted);
    font-size: .72rem;
  }

  .decision__verdict {
    margin: 0 0 10px;
    color: var(--px2-text);
    font-weight: 850;
    line-height: 1.4;
  }

  .decision__reasons {
    display: grid;
    gap: 9px;
    margin: 0 0 12px;
  }

  .decision__reason {
    display: grid;
    min-width: 0;
    grid-template-columns: 24px minmax(0, 1fr);
    gap: 8px;
    align-items: start;
    color: var(--px2-muted);
    line-height: 1.45;
  }

  .decision__reason-mark {
    display: grid;
    width: 22px;
    height: 22px;
    place-items: center;
    border-radius: 50%;
    font-size: .86rem;
    font-weight: 950;
    line-height: 1;
  }

  .decision__reason[data-kind="positive"] .decision__reason-mark {
    background: var(--px2-green-soft);
    color: var(--px2-green-strong);
  }

  .decision__reason[data-kind="neutral"] .decision__reason-mark {
    background: var(--px2-amber-soft);
    color: var(--px2-amber);
  }

  .decision__reason[data-kind="negative"] .decision__reason-mark {
    background: var(--px2-red-soft);
    color: var(--px2-red);
  }

  .decision__alternative {
    display: inline-block;
    color: var(--px2-green-strong);
    font-weight: 850;
    line-height: 1.35;
    text-underline-offset: 3px;
  }

  @media (max-width: 760px) {
    .decision {
      padding: 18px;
      border-radius: 20px;
    }

    .decision__form,
    .decision__result {
      grid-template-columns: 1fr;
    }

    .decision__score {
      width: 78px;
      height: 78px;
      place-self: start;
    }
  }
</style>
