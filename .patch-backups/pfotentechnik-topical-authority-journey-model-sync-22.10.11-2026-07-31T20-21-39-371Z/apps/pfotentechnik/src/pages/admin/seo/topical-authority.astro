---
import SeoAdminLayout from "../../../layouts/SeoAdminLayout.astro";
import { loadTopicalAuthority } from "../../../lib/seo/topical-authority/loadTopicalAuthority";

const loaded = loadTopicalAuthority();
const data = {
  generatedAt: loaded?.generatedAt ?? new Date().toISOString(),
  authorityScore: loaded?.authorityScore ?? 0,
  summary: {
    documents: loaded?.summary?.documents ?? 0,
    clusters: loaded?.summary?.clusters ?? 0,
    strong: loaded?.summary?.strong ?? 0,
    developing: loaded?.summary?.developing ?? 0,
    gaps: loaded?.summary?.gaps ?? 0,
    orphanCandidates: loaded?.summary?.orphanCandidates ?? 0,
    opportunities: loaded?.summary?.opportunities ?? 0,
  },
  inventory: {
    page: loaded?.inventory?.page ?? 0,
    comparison: loaded?.inventory?.comparison ?? 0,
    product: loaded?.inventory?.product ?? 0,
    manufacturer: loaded?.inventory?.manufacturer ?? 0,
  },
  clusters: Array.isArray(loaded?.clusters) ? loaded.clusters : [],
  opportunities: Array.isArray(loaded?.opportunities) ? loaded.opportunities : [],
  orphanCandidates: Array.isArray(loaded?.orphanCandidates) ? loaded.orphanCandidates : [],
};

const typeLabels = {
  page: "Ratgeber/Hub",
  comparison: "Vergleich",
  product: "Produkt",
  manufacturer: "Hersteller",
};

const coverageLabels = {
  hub: "Hub",
  guides: "Ratgeber",
  comparisons: "Vergleiche",
  products: "Produkte",
  manufacturers: "Hersteller",
  journey: "Journey",
};

const priorityLabels = {
  high: "Hoch",
  medium: "Mittel",
  low: "Niedrig",
};
---

<SeoAdminLayout
  title="Topical Authority"
  description="Themencluster, Abdeckung, interne Journeys und strategische Content-Lücken."
  active="topical-authority"
>
  <main class="ta-page">
    <header class="ta-hero">
      <div>
        <p class="ta-eyebrow">SEO Operations</p>
        <h1>Topical Authority</h1>
        <p>
          Repository-basierte Analyse der redaktionellen Themencluster. Die Zuordnung
          verwendet spezifische Titel-, Slug- und Inhaltsmerkmale.
        </p>
      </div>
      <div class="ta-score" aria-label={`Authority Score ${data.authorityScore} von 100`}>
        <strong>{data.authorityScore}</strong>
        <span>/100</span>
      </div>
    </header>

    <section class="ta-kpis" aria-label="Zusammenfassung">
      <article><strong>{data.summary.documents}</strong><span>Dokumente</span></article>
      <article><strong>{data.summary.clusters}</strong><span>Cluster</span></article>
      <article><strong>{data.summary.strong}</strong><span>Stark</span></article>
      <article><strong>{data.summary.developing}</strong><span>Im Aufbau</span></article>
      <article><strong>{data.summary.gaps}</strong><span>Lücken</span></article>
      <article><strong>{data.summary.opportunities}</strong><span>Chancen</span></article>
    </section>

    <section class="ta-section">
      <div class="ta-section-head">
        <div>
          <p class="ta-eyebrow">Clusterübersicht</p>
          <h2>Erkannte Themencluster</h2>
        </div>
        <small>Stand: {new Date(data.generatedAt).toLocaleString("de-DE")}</small>
      </div>

      <div class="ta-clusters">
        {data.clusters.length === 0 ? (
          <p class="ta-empty">Es wurden noch keine Cluster erkannt.</p>
        ) : data.clusters.map((cluster) => {
          const gaps = Array.isArray(cluster?.gaps) ? cluster.gaps : [];
          const documents = Array.isArray(cluster?.documents) ? cluster.documents : [];
          const coverage = cluster?.coverage ?? {};
          const counts = cluster?.counts ?? {
            pages: 0,
            comparisons: 0,
            products: 0,
            manufacturers: 0,
            total: 0,
          };

          return (
            <details class="ta-cluster">
              <summary>
                <div>
                  <span class={`ta-status ta-status--${cluster?.status ?? "gap"}`}>
                    {cluster?.status === "strong" ? "Stark" : cluster?.status === "developing" ? "Im Aufbau" : "Lücke"}
                  </span>
                  <h3>{cluster?.label ?? "Unbenannter Cluster"}</h3>
                  <p>{cluster?.description ?? ""}</p>
                </div>
                <div class="ta-cluster-score">
                  <strong>{cluster?.score ?? 0}</strong><span>/100</span>
                </div>
              </summary>

              <div class="ta-cluster-body">
                <div class="ta-metrics">
                  <div><strong>{counts.pages ?? 0}</strong><span>Ratgeber/Hubs</span></div>
                  <div><strong>{counts.comparisons ?? 0}</strong><span>Vergleiche</span></div>
                  <div><strong>{counts.products ?? 0}</strong><span>Produkte</span></div>
                  <div><strong>{counts.manufacturers ?? 0}</strong><span>Hersteller</span></div>
                  <div><strong>{cluster?.linkCoverage ?? 0}%</strong><span>Links</span></div>
                </div>

                <div class="ta-coverage">
                  {Object.entries(coverage).map(([key, value]) => (
                    <span class:list={["ta-chip", { "ta-chip--ok": Boolean(value) }]}>
                      {value ? "✓" : "–"} {coverageLabels[key] ?? key}
                    </span>
                  ))}
                </div>

                <div class="ta-grid">
                  <section>
                    <h4>Offene Lücken</h4>
                    {gaps.length ? (
                      <ul>{gaps.map((gap) => <li>{gap}</li>)}</ul>
                    ) : (
                      <p class="ta-muted">Keine priorisierten Lücken erkannt.</p>
                    )}
                  </section>
                  <section>
                    <h4>Nächster Schritt</h4>
                    <p>{cluster?.nextAction ?? "Cluster prüfen und nächste Maßnahme festlegen."}</p>
                  </section>
                </div>

                <section>
                  <h4>Erkannte Inhalte ({documents.length})</h4>
                  {documents.length ? (
                    <div class="ta-table-wrap">
                      <table>
                        <thead>
                          <tr><th>Typ</th><th>Inhalt</th><th>Route</th></tr>
                        </thead>
                        <tbody>
                          {documents.map((document) => (
                            <tr>
                              <td>{typeLabels[document?.type] ?? document?.type ?? "–"}</td>
                              <td>{document?.title ?? document?.slug ?? "–"}</td>
                              <td><code>{document?.route ?? "–"}</code></td>
                            </tr>
                          ))}
                        </tbody>
                      </table>
                    </div>
                  ) : (
                    <p class="ta-empty">Keine echten Inhalte für diesen Cluster erkannt.</p>
                  )}
                </section>
              </div>
            </details>
          );
        })}
      </div>
    </section>

    <section class="ta-section">
      <div class="ta-section-head">
        <div>
          <p class="ta-eyebrow">Roadmap</p>
          <h2>Strategische Chancen</h2>
        </div>
      </div>

      <div class="ta-opportunities">
        {data.opportunities.length === 0 ? (
          <p class="ta-empty">Aktuell wurden keine priorisierten Chancen erzeugt.</p>
        ) : data.opportunities.map((opportunity) => (
          <article>
            <div class="ta-opportunity-meta">
              <span class={`ta-priority ta-priority--${opportunity?.priority ?? "low"}`}>
                {priorityLabels[opportunity?.priority] ?? opportunity?.priority ?? "Niedrig"}
              </span>
              <span>Impact {opportunity?.impact ?? 0}</span>
              <span>Aufwand {opportunity?.effort ?? "–"}</span>
            </div>
            <h3>{opportunity?.title ?? "Unbenannte Chance"}</h3>
            <p>{opportunity?.reason ?? ""}</p>
            <strong>{opportunity?.action ?? ""}</strong>
          </article>
        ))}
      </div>
    </section>

    <section class="ta-section">
      <div class="ta-section-head">
        <div>
          <p class="ta-eyebrow">Interne Verlinkung</p>
          <h2>Journey-Modell</h2>
        </div>
      </div>
      <div class="ta-journey" aria-label="Empfohlene interne User Journey">
        <span>Ratgeber</span><b>→</b><span>Vergleich</span><b>→</b><span>Produkt</span><b>→</b><span>Hersteller</span><b>→</b><span>passender Ratgeber</span>
      </div>
    </section>

    <section class="ta-section">
      <div class="ta-section-head">
        <div>
          <p class="ta-eyebrow">Linkprüfung</p>
          <h2>Mögliche verwaiste Inhalte</h2>
        </div>
        <span>{data.orphanCandidates.length} Kandidaten</span>
      </div>

      {data.orphanCandidates.length ? (
        <div class="ta-table-wrap">
          <table>
            <thead><tr><th>Typ</th><th>Inhalt</th><th>Route</th></tr></thead>
            <tbody>
              {data.orphanCandidates.map((document) => (
                <tr>
                  <td>{typeLabels[document?.type] ?? document?.type ?? "–"}</td>
                  <td>{document?.title ?? document?.slug ?? "–"}</td>
                  <td><code>{document?.route ?? "–"}</code></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      ) : (
        <p class="ta-empty">Keine verwaisten Kandidaten erkannt.</p>
      )}
    </section>
  </main>
</SeoAdminLayout>

<style>
  .ta-page{display:grid;gap:1.25rem;max-width:1440px;margin:0 auto;padding:1rem}
  .ta-hero,.ta-section,.ta-kpis article,.ta-cluster,.ta-opportunities article{background:var(--seo-surface,Canvas);border:1px solid var(--seo-border,#d9dee7);border-radius:1rem}
  .ta-hero{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:1.25rem}
  .ta-hero h1,.ta-section h2,.ta-cluster h3,.ta-opportunities h3{margin:.2rem 0}
  .ta-hero p,.ta-cluster p,.ta-opportunities p{max-width:75ch;color:var(--seo-text-muted,#5f6875)}
  .ta-eyebrow{text-transform:uppercase;letter-spacing:.08em;font-size:.75rem;font-weight:700}
  .ta-score{display:flex;align-items:baseline;min-width:7rem;justify-content:center}
  .ta-score strong{font-size:2.5rem}.ta-score span,.ta-cluster-score span{color:var(--seo-text-muted,#5f6875)}
  .ta-kpis{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:.75rem}
  .ta-kpis article{display:grid;gap:.25rem;padding:1rem}.ta-kpis strong{font-size:1.5rem}.ta-kpis span{color:var(--seo-text-muted,#5f6875)}
  .ta-section{padding:1.25rem}.ta-section-head{display:flex;justify-content:space-between;align-items:flex-end;gap:1rem;margin-bottom:1rem}
  .ta-clusters,.ta-opportunities{display:grid;gap:.75rem}
  .ta-cluster{overflow:hidden}.ta-cluster summary{display:flex;justify-content:space-between;gap:1rem;padding:1rem;cursor:pointer;list-style:none}
  .ta-cluster summary::-webkit-details-marker{display:none}.ta-cluster-body{display:grid;gap:1rem;padding:0 1rem 1rem}
  .ta-cluster-score{display:flex;align-items:baseline;white-space:nowrap}.ta-cluster-score strong{font-size:1.75rem}
  .ta-status,.ta-priority,.ta-chip{display:inline-flex;align-items:center;border-radius:999px;padding:.3rem .6rem;font-size:.78rem;font-weight:700;background:var(--seo-surface-subtle,#eef1f5)}
  .ta-status--strong,.ta-chip--ok{background:color-mix(in srgb,#16803c 16%,transparent);color:#137033}
  .ta-status--developing,.ta-priority--medium{background:color-mix(in srgb,#b7791f 16%,transparent);color:#8a5b12}
  .ta-status--gap,.ta-priority--high{background:color-mix(in srgb,#c53030 14%,transparent);color:#a72828}
  .ta-metrics{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:.5rem}.ta-metrics div{display:grid;padding:.75rem;background:var(--seo-surface-subtle,#f3f5f8);border-radius:.75rem}.ta-metrics span{font-size:.8rem;color:var(--seo-text-muted,#5f6875)}
  .ta-coverage{display:flex;flex-wrap:wrap;gap:.5rem}.ta-grid{display:grid;grid-template-columns:1fr 1fr;gap:1rem}
  .ta-table-wrap{overflow:auto}table{width:100%;border-collapse:collapse}th,td{text-align:left;padding:.7rem;border-bottom:1px solid var(--seo-border,#d9dee7);vertical-align:top}code{font-size:.8rem}
  .ta-opportunities{grid-template-columns:repeat(2,minmax(0,1fr))}.ta-opportunities article{padding:1rem}.ta-opportunity-meta{display:flex;flex-wrap:wrap;align-items:center;gap:.5rem;color:var(--seo-text-muted,#5f6875);font-size:.8rem}
  .ta-journey{display:flex;align-items:center;flex-wrap:wrap;gap:.5rem}.ta-journey span{padding:.65rem .8rem;border-radius:.75rem;background:var(--seo-surface-subtle,#f3f5f8);font-weight:700}
  .ta-empty,.ta-muted{color:var(--seo-text-muted,#5f6875)}
  @media(max-width: 900px){.ta-kpis{grid-template-columns:repeat(3,minmax(0,1fr))}.ta-metrics{grid-template-columns:repeat(2,minmax(0,1fr))}.ta-opportunities,.ta-grid{grid-template-columns:1fr}}
  @media(max-width: 600px){.ta-page{padding:.75rem}.ta-hero{align-items:flex-start}.ta-score strong{font-size:2rem}.ta-kpis{grid-template-columns:repeat(2,minmax(0,1fr))}.ta-section,.ta-hero{padding:1rem}.ta-cluster summary{align-items:flex-start}.ta-section-head{align-items:flex-start;flex-direction:column}}

  /* 1.2.1: expliziter Kontrast für Kennzahlen und Coverage-Chips */
  .ta-metrics div {
    color: var(--seo-text, #172033);
    background: var(--seo-surface-subtle, #f3f5f8);
  }
  .ta-metrics strong {
    color: var(--seo-text, #172033);
    font-size: 1.35rem;
    line-height: 1.1;
  }
  .ta-metrics span {
    color: var(--seo-text-muted, #4f5b6d);
  }
  .ta-chip {
    color: var(--seo-text, #172033);
    border: 1px solid var(--seo-border, #d9dee7);
  }
  .ta-chip--ok {
    color: var(--seo-success-text, #0f6b32);
    background: var(--seo-success-surface, #e7f6ec);
    border-color: var(--seo-success-border, #9dd6ad);
  }
  :global([data-theme="dark"]) .ta-metrics div,
  :global(.dark) .ta-metrics div {
    color: #f4f7fb;
    background: #202832;
  }
  :global([data-theme="dark"]) .ta-metrics strong,
  :global(.dark) .ta-metrics strong {
    color: #ffffff;
  }
  :global([data-theme="dark"]) .ta-metrics span,
  :global(.dark) .ta-metrics span {
    color: #c7d0dc;
  }
  :global([data-theme="dark"]) .ta-chip,
  :global(.dark) .ta-chip {
    color: #eef3f8;
    background: #202832;
    border-color: #465364;
  }
  :global([data-theme="dark"]) .ta-chip--ok,
  :global(.dark) .ta-chip--ok {
    color: #a9efbd;
    background: #123d23;
    border-color: #267544;
  }

</style>


