---
import {
  buildFeederDecisionJourney,
  getFeederIntent,
} from "../domain/seo/feederIntentMatrix";

type Props = {
  slug: string;
  pages: any[];
  products: any[];
  comparisons: any[];
};

const { slug, pages, products, comparisons } = Astro.props;
const intent = getFeederIntent(slug);

const routes = [
  ...pages.map((entry) => `/${entry.data.slug}/`),
  ...comparisons.map((entry) => `/vergleiche/${entry.data.slug}/`),
  ...products.map((entry) => `/produkt/${entry.data.slug}/`),
];

const editorialSteps = buildFeederDecisionJourney(slug, routes);

const feederProducts = products
  .filter((entry) => entry.data.category?.key === "futterautomaten")
  .slice()
  .sort(
    (a, b) =>
      (b.data.score ?? b.data.rating ?? 0) -
      (a.data.score ?? a.data.rating ?? 0),
  );

const comparisonStep = editorialSteps.find((item) => item.kind === "Vergleich");
const knowledgeStep = editorialSteps.find((item) => item.kind === "Ratgeber");
const topProduct = feederProducts[0];

const steps = [
  ...(comparisonStep ? [comparisonStep] : []),
  ...(topProduct
    ? [{
        href: `/produkt/${topProduct.data.slug}/`,
        label: `${topProduct.data.title} im Detail prüfen`,
        kind: "Produkt" as const,
      }]
    : []),
  ...(knowledgeStep ? [knowledgeStep] : []),
].filter(
  (item, index, all) =>
    all.findIndex((candidate) => candidate.href === item.href) === index,
).slice(0, 3);
---

{
  intent && steps.length > 0 && (
    <nav
      class="feeder-decision-journey"
      aria-label="Nächste Entscheidungsschritte"
      data-feature="feeder-decision-journey-1.1"
    >
      <div class="feeder-decision-copy">
        <p class="feeder-decision-eyebrow">{intent.label}</p>
        <h2>Was ist jetzt sinnvoll?</h2>
        <p>{intent.question}</p>
      </div>

      <div class="feeder-decision-links">
        {steps.map((item) => (
          <a class="feeder-decision-link pt-surface" href={item.href}>
            <span>{item.kind}</span>
            <strong>{item.label}</strong>
          </a>
        ))}
      </div>
    </nav>
  )
}

<style>
  .feeder-decision-journey {
    margin-block: clamp(2rem, 5vw, 3.5rem);
    padding: clamp(1rem, 3vw, 1.5rem);
    border: 1px solid var(--pt-border-subtle, rgba(127, 127, 127, 0.24));
    border-radius: var(--pt-radius-lg, 1rem);
    background: var(--pt-surface-muted, rgba(127, 127, 127, 0.06));
  }

  .feeder-decision-copy {
    max-width: 48rem;
  }

  .feeder-decision-eyebrow {
    margin: 0 0 0.35rem;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .feeder-decision-copy h2 {
    margin: 0;
  }

  .feeder-decision-copy > p:last-child {
    margin-block: 0.6rem 0;
  }

  .feeder-decision-links {
    display: grid;
    gap: 0.75rem;
    margin-top: 1rem;
  }

  .feeder-decision-link {
    display: grid;
    gap: 0.2rem;
    min-width: 0;
    padding: 0.9rem 1rem;
    color: inherit;
    text-decoration: none;
  }

  .feeder-decision-link span {
    font-size: 0.78rem;
    opacity: 0.72;
  }

  .feeder-decision-link strong {
    line-height: 1.35;
  }

  @media (min-width: 48rem) {
    .feeder-decision-links {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
