---
import { buildFindingAiActions } from "../../lib/seo-copilot/finding-ai.ts";
import type { QualityFinding } from "../../lib/seo-copilot/types.ts";

interface Props {
  findings: QualityFinding[];
  compact?: boolean;
  emptyText?: string;
}

const {
  findings,
  compact = false,
  emptyText = "Keine Findings für diese Auswahl.",
} = Astro.props;

const serviceUrl = import.meta.env.PUBLIC_SEARCH_ADMIN_URL || "http://127.0.0.1:4178";
const prepared = findings.map((finding) => ({
  ...finding,
  aiActions: buildFindingAiActions(finding),
}));
const serialized = JSON.stringify({ findings: prepared, compact, emptyText, serviceUrl })
  .replace(/</g, "\\u003c")
  .replace(/\u2028/g, "\\u2028")
  .replace(/\u2029/g, "\\u2029");
---
<section class="seo-finding-shell" data-seo-finding-list>
  {!compact && (
    <div class="seo-filter-grid">
      <label>
        Status
        <select data-finding-filter="status">
          <option value="all">Alle</option>
          <option value="open">Offen</option>
          <option value="in-progress">In Arbeit</option>
          <option value="manual-review">Manuelle Prüfung</option>
          <option value="regression">Regression</option>
          <option value="snoozed">Zurückgestellt</option>
          <option value="waiting">Wartet</option>
          <option value="fixed">Behoben</option>
          <option value="ignored">Ignoriert</option>
          <option value="auto-fixed">Auto Fixed</option>
        </select>
      </label>
      <label>
        Bereich
        <select data-finding-filter="area">
          <option value="all">Alle</option>
          {[...new Set(findings.map((item) => item.area))].sort().map((area) => (
            <option value={area}>{area}</option>
          ))}
        </select>
      </label>
      <label>
        Priorität
        <select data-finding-filter="priority">
          <option value="all">Alle</option>
          <option value="high">Hoch</option>
          <option value="medium">Mittel</option>
          <option value="low">Niedrig</option>
        </select>
      </label>
    </div>
  )}

  <p class="seo-status" data-finding-message aria-live="polite"></p>
  <div class="seo-finding-list" data-finding-items></div>
  <script type="application/json" data-finding-json set:html={serialized}></script>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-seo-finding-list]").forEach((root) => {
    const configNode = root.querySelector<HTMLScriptElement>("[data-finding-json]");
    const payload = JSON.parse(configNode?.textContent || '{"findings":[]}');
    const api = String(payload.serviceUrl || "http://127.0.0.1:4178").replace(/\/$/, "");
    const list = root.querySelector<HTMLElement>("[data-finding-items]");
    const message = root.querySelector<HTMLElement>("[data-finding-message]");
    if (!list || !message) return;

    const filters: Record<string, string> = {
      status: "all",
      area: "all",
      priority: "all",
    };

    const labels: Record<string, string> = {
      open: "Offen",
      "in-progress": "In Arbeit",
      fixed: "Behoben",
      ignored: "Ignoriert",
      snoozed: "Zurückgestellt",
      waiting: "Wartet",
      "manual-review": "Manuelle Prüfung",
      "auto-fixed": "Auto Fixed",
      regression: "Regression",
    };

    const node = <K extends keyof HTMLElementTagNameMap>(
      tag: K,
      text?: string,
      className?: string,
    ): HTMLElementTagNameMap[K] => {
      const element = document.createElement(tag);
      if (text !== undefined) element.textContent = text;
      if (className) element.className = className;
      return element;
    };

    const poll = async (id: string) => {
      for (let attempt = 0; attempt < 1440; attempt += 1) {
        await new Promise((resolve) => setTimeout(resolve, 500));
        const response = await fetch(`${api}/api/admin/search/actions/${id}`, { cache: "no-store" });
        const action = await response.json();
        if (["succeeded", "failed", "cancelled"].includes(action.status)) return action;
      }
      throw new Error("Die lokale Aktion hat das Zeitlimit überschritten.");
    };

    const runAction = async (action: string, body: Record<string, unknown>) => {
      message.dataset.state = "";
      message.textContent = "Aktion läuft …";
      const response = await fetch(`${api}/api/admin/search/actions`, {
        method: "POST",
        cache: "no-store",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ action, payload: body }),
      });
      const started = await response.json().catch(() => ({}));
      if (!response.ok) throw new Error(started?.error?.message || "Aktion wurde abgelehnt.");
      const result = await poll(started.id);
      if (result.status !== "succeeded") {
        throw new Error(result?.error?.message || "Aktion ist fehlgeschlagen.");
      }
      message.dataset.state = "success";
      message.textContent = result.result?.reason || "Aktion erfolgreich.";
      if (result.result?.reloadRequired) location.reload();
      return result.result;
    };

    const copyPrompt = async (finding: any, action: any) => {
      await navigator.clipboard.writeText(action.prompt);
      message.dataset.state = "success";
      message.textContent = `${action.label}: Prompt kopiert.`;
      if (action.id === "codex-send" && finding.status !== "in-progress") {
        await runAction("quality.finding.status", {
          findingId: finding.id,
          status: "in-progress",
          note: `AI Action ${action.templateId} an Codex übergeben.`,
        });
      }
    };

    const renderCard = (finding: any) => {
      const card = node("article", undefined, "seo-finding");
      card.dataset.blocker = String(Boolean(finding.releaseBlocker));
      card.dataset.status = finding.status;

      card.append(node("h3", finding.description));

      const badges = node("div", undefined, "seo-badges");
      [
        [finding.priority.level, `${finding.priority.score}/100`],
        [finding.severity, finding.severity],
        [finding.status, labels[finding.status] || finding.status],
        [finding.area, finding.area],
        [finding.source, finding.source],
      ].forEach(([level, text]) => {
        const badge = node("span", text, "seo-badge");
        badge.dataset.level = level;
        badges.append(badge);
      });
      card.append(badges);

      card.append(node("p", finding.impact));
      card.append(node("p", `Lösung: ${finding.recommendedSolution}`));

      const target = [finding.file, finding.route, finding.component].filter(Boolean).join(" · ");
      if (target) card.append(node("p", `Ziel: ${target}`));

      const actions = node("div", undefined, "seo-actions");

      const statusSelect = document.createElement("select");
      statusSelect.className = "seo-button";
      statusSelect.setAttribute("aria-label", "Finding-Status ändern");
      statusSelect.append(
        new Option("Status ändern …", ""),
        ...Object.entries(labels)
          .filter(([key]) => key !== "auto-fixed")
          .map(([key, label]) => new Option(label, key)),
      );
      statusSelect.addEventListener("change", async () => {
        if (!statusSelect.value) return;
        try {
          await runAction("quality.finding.status", {
            findingId: finding.id,
            status: statusSelect.value,
            days: 14,
            note: "Im gemeinsamen Finding-Workspace geändert.",
          });
        } catch (error) {
          message.dataset.state = "error";
          message.textContent = error instanceof Error ? error.message : String(error);
        }
      });
      actions.append(statusSelect);

      if (finding.autoFixPossible) {
        const button = node("button", "Sicheren Auto-Fix ausführen", "seo-button");
        button.type = "button";
        button.dataset.primary = "";
        button.addEventListener("click", async () => {
          if (!confirm("Auto-Fix mit Vorprüfung, Strict-Audit und Protokoll ausführen?")) return;
          try {
            await runAction("quality.finding.auto-fix", {
              findingId: finding.id,
              confirm: true,
            });
          } catch (error) {
            message.dataset.state = "error";
            message.textContent = error instanceof Error ? error.message : String(error);
          }
        });
        actions.append(button);
      }

      for (const aiAction of finding.aiActions || []) {
        const button = node("button", aiAction.label, "seo-button");
        button.type = "button";
        if (aiAction.id === "codex-send") button.dataset.primary = "";
        button.title = aiAction.description || aiAction.label;
        button.addEventListener("click", async () => {
          try {
            await copyPrompt(finding, aiAction);
          } catch (error) {
            message.dataset.state = "error";
            message.textContent = error instanceof Error ? error.message : String(error);
          }
        });
        actions.append(button);
      }

      card.append(actions);

      if (!payload.compact) {
        const details = document.createElement("details");
        const summary = node("summary", "Finding-Modell und AI Actions");
        const pre = node("pre", JSON.stringify({
          id: finding.id,
          type: finding.type,
          category: finding.category,
          priority: finding.priority,
          file: finding.file,
          route: finding.route,
          component: finding.component,
          autoFixPossible: finding.autoFixPossible,
          aiActionIds: finding.aiActionIds,
          codexSuitable: finding.codexSuitable,
          status: finding.status,
        }, null, 2));
        details.append(summary, pre);
        card.append(details);
      }
      return card;
    };

    const render = () => {
      const visible = payload.findings.filter((finding: any) =>
        Object.entries(filters).every(([key, selected]) => {
          if (selected === "all") return true;
          if (key === "priority") return finding.priority.level === selected;
          return finding[key] === selected;
        })
      );

      list.replaceChildren(...visible.map(renderCard));
      if (!visible.length) list.append(node("div", payload.emptyText, "seo-empty"));
    };

    root.querySelectorAll<HTMLSelectElement>("[data-finding-filter]").forEach((select) => {
      select.addEventListener("change", () => {
        filters[select.dataset.findingFilter || "status"] = select.value;
        render();
      });
    });

    render();
  });
</script>
