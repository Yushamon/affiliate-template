---
import SeoAdminLayout from "../../../layouts/SeoAdminLayout.astro";
import { readCopilotWorkspace } from "../../../lib/seo-copilot/store.mjs";
const workspace = readCopilotWorkspace();
const snapshots = [...workspace.qualitySnapshots].reverse().slice(0, 30);
const events = [...workspace.qualityHistory].reverse().slice(0, 100);
---
<SeoAdminLayout title="Quality-Operations-Historie" description="Persistente Snapshots, Statusänderungen, behobene Findings und Regressionen aus dem zentralen Copilot-Workspace." active="history">
  <section class="pt-surface seo-card history-notice">
    <span class="seo-badge">Auditierbare Entwicklung</span>
    <h2>Quality-Verlauf statt Browser-Zustand</h2>
    <p>Jeder zentrale Sync erzeugt einen Snapshot. Neue, behobene und wiederkehrende Findings werden anhand stabiler IDs protokolliert; manuelle Statusänderungen und sichere Auto-Fixes landen in derselben Historie.</p>
  </section>
  <section class="snapshot-grid">
    {snapshots.map((snapshot) => (
      <article class="pt-surface seo-card snapshot">
        <span class="seo-badge">{new Date(snapshot.generatedAt).toLocaleString("de-DE")}</span>
        <dl>
          <div><dt>Aktiv</dt><dd>{snapshot.summary?.active ?? 0}</dd></div>
          <div><dt>Blocker</dt><dd>{snapshot.summary?.releaseBlockers ?? 0}</dd></div>
          <div><dt>Regressionen</dt><dd>{snapshot.summary?.regressions ?? 0}</dd></div>
          <div><dt>Quellen</dt><dd>{snapshot.summary?.sourcesAvailable ?? 0}</dd></div>
        </dl>
      </article>
    ))}
    {!snapshots.length && <div class="pt-surface seo-card empty">Noch kein Snapshot. <code>quality-ops:sync</code> erzeugt die erste Vergleichsbasis.</div>}
  </section>
  <section class="pt-surface seo-card event-history">
    <h2>Letzte Änderungen</h2>
    {events.map((event) => (
      <article class="history-event">
        <h3>{event.description}</h3>
        <p>{new Date(event.occurredAt).toLocaleString("de-DE")} · {event.from || "Neu"} → {event.to} · {event.source}</p>
        {event.note && <p>{event.note}</p>}
        <code>{event.findingId}</code>
      </article>
    ))}
    {!events.length && <div class="empty">Noch keine Finding-Änderungen protokolliert.</div>}
  </section>
</SeoAdminLayout>
<style>
  .history-notice,.event-history{padding:24px}.history-notice h2{margin:12px 0 8px}.history-notice p,.history-event p{max-width:900px;color:var(--seo-muted);line-height:1.6}.snapshot-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:14px;margin-top:16px}.snapshot{padding:20px}.snapshot dl{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin:14px 0 0}.snapshot dl div{padding:10px;border-radius:10px;background:var(--seo-surface-soft)}.snapshot dt{color:var(--seo-muted);font-size:.72rem}.snapshot dd{margin:4px 0 0;font-weight:850}.event-history{margin-top:16px}.history-event{padding:14px 0;border-top:1px solid var(--seo-border)}.history-event h3{margin:0;font-size:1rem}.history-event code{color:var(--seo-muted);font-size:.72rem}.empty{padding:18px;color:var(--seo-muted)}@media(max-width:750px){.snapshot-grid{grid-template-columns:1fr}}@media(max-width:450px){.snapshot dl{grid-template-columns:1fr 1fr}}
</style>
