---
import type { ComparisonViewModel } from "../../comparison/model";
import ComparisonHero from "./ComparisonHero.astro";
import ComparisonEditorialRecommendation from "./ComparisonEditorialRecommendation.astro";
import RecommendationGrid from "./RecommendationGrid.astro";
import ComparisonProsCons from "./ComparisonProsCons.astro";
import ComparisonExplorer from "./ComparisonExplorer.astro";
import ComparisonVerdict from "./ComparisonVerdict.astro";
import ComparisonStickyBar from "./ComparisonStickyBar.astro";
import ComparisonInsightSummary from "./ComparisonInsightSummary.astro";
import ComparisonMethodology from "./ComparisonMethodology.astro";
import "./comparison.css";
import "./comparison-editorial-cover.css";
import "./comparison-premium-ux.css";
import "./comparison-premium-seo.css";
import "./comparison-ux-polish-3.2.css";
import "./comparison-mobile-price-fix-4.0.1.css";
import "./comparison-cta-system.css";

type Props = { model: ComparisonViewModel };
const { model } = Astro.props as Props;
const winner = model.verdict.winner;
const alternativeProducts = model.recommendationProducts.filter((product) => product.slug !== winner?.slug);
const comparisonProducts = model.products.filter((product) => product.slug !== winner?.slug);
---

<div class="comparison-shell comparison-shell--premium" data-comparison-cover-version="16.1.0" data-dark-mode-ready="true">
  <ComparisonHero
    eyebrow={model.eyebrow}
    title={model.title}
    image={model.heroImage}
    facts={model.facts}
    filters={model.filters}
    productCount={model.products.length}
  />

  {winner && <ComparisonEditorialRecommendation product={winner} />}

  <div class="comparison-decision-flow">
    <section id="alternativen" class="comparison-premium-section">
      <RecommendationGrid products={alternativeProducts} />
    </section>

    <section id="einsatzzwecke" class="comparison-premium-section comparison-slot-section">
      <slot name="scenario-recommendations" />
    </section>

    <ComparisonExplorer
      products={comparisonProducts}
      rows={model.rows}
      filters={model.filters}
      initialVisibleProducts={model.initialVisibleProducts}
    />

    {model.rows.length > 0 && (
      <section id="redaktionelle-zusammenfassung" class="comparison-premium-section" aria-label="Redaktionelle Zusammenfassung">
        <ComparisonInsightSummary products={model.products} rows={model.rows} />
      </section>
    )}

    <ComparisonProsCons products={model.products} />

    <section id="methodik" class="comparison-premium-section">
      <ComparisonMethodology productCount={model.products.length} criterionCount={model.rows.length} />
    </section>

    <div id="vergleich-fazit">
      <ComparisonVerdict
        title={model.verdict.title}
        text={model.verdict.text}
        winner={model.verdict.winner}
        alternative={model.verdict.alternative}
      />
    </div>
  </div>
</div>

<ComparisonStickyBar product={model.verdict.winner} />
