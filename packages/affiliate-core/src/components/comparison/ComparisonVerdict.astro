---
import EditorialScore from "../EditorialScore.astro";
import type { ComparisonProduct } from "../../comparison/model";
import { getPriceDisplay } from "../../comparison/price";
import ComparisonPriceSignal from "./ComparisonPriceSignal.astro";

type Props = {
  title: string;
  text: string;
  winner?: ComparisonProduct;
  alternative?: ComparisonProduct;
};

const {
  title,
  text,
  winner,
  alternative
} = Astro.props as Props;
---

<section class="comparison-verdict" aria-labelledby="comparison-verdict-title">
  <div class="comparison-verdict__copy">
    <span class="comparison-eyebrow">Redaktionelles Fazit</span>
    <h2 id="comparison-verdict-title">{title}</h2>
    <p>{text}</p>
  </div>

  {(winner || alternative) && (
    <div class="comparison-verdict__choices">
      {winner && (() => {
        const price = getPriceDisplay(winner.price);

        return (
          <article>
            <span>Unsere Empfehlung</span>
            <h3>{winner.title}</h3>
            {typeof winner.rating === "number" && (
              <EditorialScore value={winner.rating} scale={100} variant="ring-compact" description="Gesamtscore" />
            )}
            <ComparisonPriceSignal price={winner.price} />
            {winner.recommendation && <p>{winner.recommendation}</p>}
            <div>
              <a
                href={winner.href}
                class="pt-button-secondary pt-button comparison-button comparison-button--secondary"
              >
                Test lesen
              </a>

              {price.url && (
                <a
                  href={price.url}
                  class="pt-button comparison-button"
                  rel={price.rel}
                  target={price.target}
                  data-affiliate-link
                >
                  {price.label}
                </a>
              )}
            </div>
          </article>
        );
      })()}

      {alternative && (() => {
        const price = getPriceDisplay(alternative.price);
        return (
          <article>
            <span>Gute Alternative</span>
            <h3>{alternative.title}</h3>
            {typeof alternative.rating === "number" && (
              <EditorialScore value={alternative.rating} scale={100} variant="ring-compact" description="Gesamtscore" />
            )}
            <ComparisonPriceSignal price={alternative.price} />
            {alternative.recommendation && <p>{alternative.recommendation}</p>}
            <div>
              <a href={alternative.href} class="pt-button-secondary pt-button comparison-button comparison-button--secondary">
                Alternative ansehen
              </a>
              {price.url && (
                <a
                  href={price.url}
                  class="pt-button comparison-button"
                  rel={price.rel}
                  target={price.target}
                  data-affiliate-link
                >
                  {price.label}
                </a>
              )}
            </div>
          </article>
        );
      })()}
    </div>
  )}
</section>
