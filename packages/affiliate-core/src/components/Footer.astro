---
import { projectConfig } from "@app/project.config";

const year = new Date().getFullYear();
const productWorldLinks = projectConfig.headerLinks
  .filter((link) => link.mobileGroup === "Produktwelten")
  .map((link) => ({
    label: link.label,
    href: link.href
  }));

const footerColumns = [
  {
    title: "Produktwelten",
    links: productWorldLinks,
    productWorlds: true
  },
  ...projectConfig.footer.columns.map((column) => ({
    ...column,
    productWorlds: false
  }))
];

const footerColumnStyle = `--footer-column-count: ${footerColumns.length}`;
---

<footer class="footer-v2" data-footer-version="32.2.1">
  <div class="footer-inner-v2">
    <section class="footer-brand-v2" aria-labelledby="footer-brand-title">
      <a class="footer-brand-lockup" href="/" aria-label={`${projectConfig.projectName} – Startseite`}>
        <span class="brand-mark" aria-hidden="true">
          <span class="brand-mark__cut"></span>
          <span class="brand-mark__dot"></span>
        </span>
        <span class="footer-brand-name" id="footer-brand-title">
          {projectConfig.projectName}
        </span>
      </a>

      <p>{projectConfig.footer.description}</p>
    </section>

    <div class="footer-main-v2" style={footerColumnStyle}>
      {footerColumns.map((column, index) => {
        const headingId = `footer-column-${index}`;

        return (
          <nav
            class:list={[
              "footer-column-v2",
              column.productWorlds && "footer-column-v2--products"
            ]}
            aria-labelledby={headingId}
          >
            <h2 id={headingId}>{column.title}</h2>
            <div class="footer-column-links-v2">
              {column.links.map((link) => (
                <a href={link.href}>{link.label}</a>
              ))}
            </div>
          </nav>
        );
      })}
    </div>

    <div class="footer-bottom-v2">
      <p class="footer-copyright-v2">
        © {year} {projectConfig.projectName}
      </p>

      <p class="footer-transparency-v2">
        {projectConfig.footer.transparency}
      </p>
    </div>
  </div>
</footer>

<style is:global>
  /* Footer.astro is the sole owner of footer presentation. */

  .footer-v2 {
    margin-top: clamp(4rem, 8vw, 6rem);
    padding: 2.75rem clamp(1rem, 4vw, 2rem) 1.5rem;
    border-top: 1px solid color-mix(in srgb, var(--pt-color-on-brand-surface, #ffffff) 10%, transparent);
    background: var(--pt-color-brand-surface, #102019);
  }

  .footer-inner-v2 {
    width: min(100%, 1200px);
    margin-inline: auto;
  }

  .footer-brand-v2 {
    display: flex;
    padding-bottom: 1.75rem;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    border-bottom: 1px solid color-mix(in srgb, var(--pt-color-on-brand-surface, #ffffff) 12%, transparent);
  }

  .footer-brand-lockup {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    gap: 0.65rem;
    color: var(--pt-color-on-brand-surface, #ffffff);
    text-decoration: none;
  }

  .footer-brand-name {
    color: var(--pt-color-on-brand-surface, #ffffff);
    font-size: 1.35rem;
    font-weight: 950;
    letter-spacing: -0.04em;
  }

  .footer-brand-v2 p {
    max-width: 42rem;
    margin: 0;
    color: var(--pt-color-on-brand-surface-muted, rgb(255 255 255 / 0.72));
    font-size: 0.9rem;
    line-height: 1.6;
  }

  .footer-main-v2 {
    display: grid;
    padding: 2rem 0;
    grid-template-columns: repeat(var(--footer-column-count, 4), minmax(0, 1fr));
    gap: clamp(1.25rem, 3vw, 3rem);
  }

  .footer-column-v2 h2 {
    margin: 0 0 0.75rem;
    color: var(--pt-color-on-brand-surface-accent, #86efac);
    font-size: 0.68rem;
    font-weight: 950;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .footer-column-links-v2 {
    display: grid;
    gap: 0.48rem;
  }

  .footer-column-v2 a {
    width: fit-content;
    color: var(--pt-color-on-brand-surface-muted, rgb(255 255 255 / 0.72));
    font-size: 0.82rem;
    font-weight: 700;
    line-height: 1.35;
    text-decoration: none;
  }

  .footer-column-v2 a:hover {
    color: var(--pt-color-on-brand-surface, #ffffff);
  }

  .footer-column-v2 a:focus-visible {
    border-radius: 4px;
    outline: 2px solid var(--pt-color-brand-300, #86efac);
    outline-offset: 4px;
  }

  .footer-bottom-v2 {
    display: flex;
    padding-top: 1.25rem;
    align-items: flex-start;
    justify-content: space-between;
    gap: 2rem;
    border-top: 1px solid color-mix(in srgb, var(--pt-color-on-brand-surface, #ffffff) 12%, transparent);
  }

  .footer-bottom-v2 p {
    margin: 0;
  }

  .footer-copyright-v2 {
    flex: 0 0 auto;
    color: var(--pt-color-on-brand-surface, #ffffff);
    font-size: 0.78rem;
    font-weight: 800;
  }

  .footer-transparency-v2 {
    max-width: 50rem;
    color: var(--pt-color-on-brand-surface-muted, rgb(255 255 255 / 0.72));
    font-size: 0.74rem;
    line-height: 1.55;
  }

  @media (max-width: 760px) {
    .footer-v2 {
      padding-top: 2.25rem;
    }

    .footer-brand-v2 {
      display: grid;
      gap: 0.85rem;
    }

    .footer-main-v2 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.75rem 1.25rem;
    }

    .footer-column-v2--products {
      grid-column: 1 / -1;
    }

    .footer-column-v2--products .footer-column-links-v2 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 1rem;
    }

    .footer-bottom-v2 {
      display: grid;
      gap: 0.65rem;
    }
  }

  @media (max-width: 520px) {
    .footer-main-v2 {
      column-gap: 1rem;
    }

    .footer-column-v2 a {
      font-size: 0.78rem;
    }
  }
</style>
