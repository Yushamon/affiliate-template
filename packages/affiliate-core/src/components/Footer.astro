---
import { projectConfig } from "@app/project.config";

const year = new Date().getFullYear();
const productWorldLinks = projectConfig.headerLinks.filter(
  (link) => link.mobileGroup === "Produktwelten"
);
const comparisonLink = projectConfig.headerLinks.find(
  (link) => link.label === "Vergleiche"
);
const adviceLink = projectConfig.headerLinks.find(
  (link) => link.label === "Kaufberatung"
);
const footerColumnStyle = `--footer-column-count: ${projectConfig.footer.columns.length}`;
---

<footer class="footer-v2" data-footer-version="32.2.0">
  <div class="footer-inner-v2">
    <section class="footer-top-v3" aria-labelledby="footer-brand-title">
      <div class="footer-brand-v2">
        <a class="footer-brand-lockup" href="/" aria-label={`${projectConfig.projectName} – Startseite`}>
          <span class="brand-mark" aria-hidden="true">
            <span class="brand-mark__cut"></span>
            <span class="brand-mark__dot"></span>
          </span>
          <span class="footer-brand-name" id="footer-brand-title">
            {projectConfig.projectName}
          </span>
        </a>

        <p>{projectConfig.footer.description}</p>

        <ul class="footer-values" aria-label="Redaktionelle Grundsätze">
          <li>Bewertung ohne Provisionsfaktor</li>
          <li>Prüfart sichtbar</li>
          <li>Quellen und Grenzen offengelegt</li>
        </ul>
      </div>

      <div class="footer-actions-v3" aria-label="Wichtige Einstiege">
        {comparisonLink && (
          <a class="footer-action-v3 footer-action-v3--primary" href={comparisonLink.href}>
            {comparisonLink.label}
            <span aria-hidden="true">→</span>
          </a>
        )}
        {adviceLink && (
          <a class="footer-action-v3" href={adviceLink.href}>
            {adviceLink.label}
            <span aria-hidden="true">→</span>
          </a>
        )}
      </div>
    </section>

    <nav class="footer-product-worlds-v3" aria-labelledby="footer-product-worlds-title">
      <header>
        <span>Alle Kategorien</span>
        <h2 id="footer-product-worlds-title">Produktwelten</h2>
      </header>

      <div class="footer-product-grid-v3">
        {productWorldLinks.map((link) => (
          <a href={link.href}>
            <span class="footer-product-code-v3" aria-hidden="true">
              {link.navCode ?? "→"}
            </span>
            <span>
              <strong>{link.label}</strong>
              {link.description && <small>{link.description}</small>}
            </span>
            <span class="footer-product-arrow-v3" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </nav>

    <div class="footer-main-v2" style={footerColumnStyle}>
      {projectConfig.footer.columns.map((column, index) => {
        const headingId = `footer-column-${index}`;

        return (
          <nav class="footer-column-v2" aria-labelledby={headingId}>
            <h2 id={headingId}>{column.title}</h2>
            <div class="footer-column-links-v3">
              {column.links.map((link) => (
                <a href={link.href}>{link.label}</a>
              ))}
            </div>
          </nav>
        );
      })}
    </div>

    <div class="footer-bottom-v2">
      <p class="footer-copyright-v2">
        © {year} {projectConfig.projectName}
      </p>

      <p class="footer-transparency-v2">
        {projectConfig.footer.transparency}
      </p>
    </div>
  </div>
</footer>

<style is:global>
  /* Footer.astro is the sole owner of footer presentation. */

  .footer-v2 {
    margin-top: clamp(5rem, 10vw, 7rem);
    padding: clamp(3.5rem, 7vw, 5.5rem) clamp(1rem, 4vw, 2rem) 2rem;
    border-top: 1px solid color-mix(in srgb, var(--pt-color-on-brand-surface, #ffffff) 10%, transparent);
    background:
      radial-gradient(circle at 8% 0, color-mix(in srgb, var(--pt-color-brand-500, #16a34a) 22%, transparent), transparent 32%),
      radial-gradient(circle at 90% 100%, color-mix(in srgb, var(--pt-color-warning, #facc15) 8%, transparent), transparent 24%),
      var(--pt-color-brand-surface, #102019);
  }

  .footer-inner-v2 {
    width: min(100%, 1200px);
    margin-inline: auto;
  }

  .footer-top-v3 {
    display: grid;
    padding-bottom: 2.25rem;
    grid-template-columns: minmax(0, 1.35fr) minmax(16rem, 0.65fr);
    align-items: end;
    gap: clamp(2rem, 5vw, 5rem);
    border-bottom: 1px solid color-mix(in srgb, var(--pt-color-on-brand-surface, #ffffff) 12%, transparent);
  }

  .footer-brand-v2 {
    max-width: 42rem;
  }

  .footer-brand-lockup {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--pt-color-on-brand-surface, #ffffff);
    text-decoration: none;
  }

  .footer-brand-name {
    color: var(--pt-color-on-brand-surface, #ffffff);
    font-size: clamp(1.5rem, 3vw, 2.35rem);
    font-weight: 950;
    letter-spacing: -0.045em;
  }

  .footer-brand-v2 p {
    max-width: 42rem;
    margin: 1rem 0 0;
    color: var(--pt-color-on-brand-surface-muted, rgb(255 255 255 / 0.72));
    font-size: 1rem;
    line-height: 1.7;
  }

  .footer-values {
    display: flex;
    margin: 1.1rem 0 0;
    padding: 0;
    flex-wrap: wrap;
    gap: 0.5rem;
    color: var(--pt-color-on-brand-surface-muted, rgb(255 255 255 / 0.72));
    list-style: none;
  }

  .footer-values li {
    padding: 0.42rem 0.65rem;
    border: 1px solid color-mix(in srgb, var(--pt-color-on-brand-surface, #ffffff) 14%, transparent);
    border-radius: var(--pt-radius-pill);
    font-size: 0.75rem;
    font-weight: 750;
  }

  .footer-actions-v3 {
    display: grid;
    gap: 0.65rem;
  }

  .footer-action-v3 {
    display: flex;
    min-height: 3.25rem;
    padding: 0.8rem 1rem;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    border: 1px solid color-mix(in srgb, var(--pt-color-on-brand-surface, #ffffff) 18%, transparent);
    border-radius: 0.9rem;
    color: var(--pt-color-on-brand-surface, #ffffff);
    background: color-mix(in srgb, var(--pt-color-on-brand-surface, #ffffff) 6%, transparent);
    font-weight: 850;
    text-decoration: none;
    transition:
      border-color var(--pt-transition-fast),
      background-color var(--pt-transition-fast),
      transform var(--pt-transition-fast);
  }

  .footer-action-v3:hover,
  .footer-action-v3:focus-visible {
    border-color: color-mix(in srgb, var(--pt-color-on-brand-surface, #ffffff) 42%, transparent);
    background: color-mix(in srgb, var(--pt-color-on-brand-surface, #ffffff) 10%, transparent);
    transform: translateY(-1px);
  }

  .footer-action-v3--primary {
    border-color: var(--pt-color-brand-400, #4ade80);
    color: var(--pt-color-brand-surface, #102019);
    background: var(--pt-color-brand-300, #86efac);
  }

  .footer-product-worlds-v3 {
    padding: clamp(2rem, 5vw, 3.5rem) 0;
    border-bottom: 1px solid color-mix(in srgb, var(--pt-color-on-brand-surface, #ffffff) 12%, transparent);
  }

  .footer-product-worlds-v3 > header {
    display: flex;
    margin-bottom: 1rem;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
  }

  .footer-product-worlds-v3 > header span {
    color: var(--pt-color-on-brand-surface-accent, #86efac);
    font-size: 0.72rem;
    font-weight: 950;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .footer-product-worlds-v3 h2 {
    margin: 0.25rem 0 0;
    color: var(--pt-color-on-brand-surface, #ffffff);
    font-size: clamp(1.55rem, 3vw, 2.4rem);
    letter-spacing: -0.04em;
  }

  .footer-product-grid-v3 {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.7rem;
  }

  .footer-product-grid-v3 > a {
    display: grid;
    min-width: 0;
    min-height: 5rem;
    padding: 0.8rem;
    grid-template-columns: 2.35rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.75rem;
    border: 1px solid color-mix(in srgb, var(--pt-color-on-brand-surface, #ffffff) 12%, transparent);
    border-radius: 1rem;
    color: var(--pt-color-on-brand-surface, #ffffff);
    background: color-mix(in srgb, var(--pt-color-on-brand-surface, #ffffff) 5%, transparent);
    text-decoration: none;
    transition:
      border-color var(--pt-transition-fast),
      background-color var(--pt-transition-fast),
      transform var(--pt-transition-fast);
  }

  .footer-product-grid-v3 > a:hover,
  .footer-product-grid-v3 > a:focus-visible {
    border-color: var(--pt-color-brand-300, #86efac);
    background: color-mix(in srgb, var(--pt-color-on-brand-surface, #ffffff) 9%, transparent);
    transform: translateY(-2px);
  }

  .footer-product-grid-v3 strong,
  .footer-product-grid-v3 small {
    display: block;
  }

  .footer-product-grid-v3 strong {
    font-size: 0.9rem;
    line-height: 1.25;
  }

  .footer-product-grid-v3 small {
    margin-top: 0.2rem;
    color: var(--pt-color-on-brand-surface-muted, rgb(255 255 255 / 0.72));
    font-size: 0.72rem;
    line-height: 1.35;
  }

  .footer-product-code-v3 {
    display: grid;
    min-width: 2.35rem;
    min-height: 2.35rem;
    place-items: center;
    border: 1px solid color-mix(in srgb, var(--pt-color-brand-300, #86efac) 28%, transparent);
    border-radius: 0.75rem;
    color: var(--pt-color-on-brand-surface-accent, #86efac);
    background: color-mix(in srgb, var(--pt-color-brand-300, #86efac) 8%, transparent);
    font-size: 0.68rem;
    font-weight: 950;
    letter-spacing: 0.04em;
  }

  .footer-product-arrow-v3 {
    color: var(--pt-color-on-brand-surface-accent, #86efac);
  }

  .footer-main-v2 {
    display: grid;
    padding: clamp(2rem, 5vw, 3.5rem) 0;
    grid-template-columns: repeat(var(--footer-column-count, 3), minmax(0, 1fr));
    gap: clamp(1.5rem, 4vw, 4rem);
  }

  .footer-column-v2 h2 {
    margin: 0 0 0.9rem;
    color: var(--pt-color-on-brand-surface-accent, #86efac);
    font-size: 0.72rem;
    font-weight: 950;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .footer-column-links-v3 {
    display: grid;
    gap: 0.65rem;
  }

  .footer-column-v2 a {
    width: fit-content;
    color: var(--pt-color-on-brand-surface-muted, rgb(255 255 255 / 0.72));
    font-size: 0.88rem;
    font-weight: 750;
    line-height: 1.4;
    text-decoration: none;
    transition:
      color var(--pt-transition-fast),
      transform var(--pt-transition-fast);
  }

  .footer-column-v2 a:hover {
    color: var(--pt-color-on-brand-surface, #ffffff);
    transform: translateX(2px);
  }

  .footer-column-v2 a:focus-visible {
    border-radius: 4px;
    outline: 2px solid var(--pt-color-brand-300, #86efac);
    outline-offset: 4px;
  }

  .footer-bottom-v2 {
    display: grid;
    padding-top: 1.5rem;
    grid-template-columns: minmax(12rem, 0.55fr) minmax(0, 1.45fr);
    align-items: start;
    gap: 2rem;
    border-top: 1px solid color-mix(in srgb, var(--pt-color-on-brand-surface, #ffffff) 12%, transparent);
  }

  .footer-bottom-v2 p {
    margin: 0;
  }

  .footer-copyright-v2 {
    color: var(--pt-color-on-brand-surface, #ffffff);
    font-size: 0.82rem;
    font-weight: 800;
  }

  .footer-transparency-v2 {
    max-width: 52rem;
    color: var(--pt-color-on-brand-surface-muted, rgb(255 255 255 / 0.72));
    font-size: 0.78rem;
    line-height: 1.65;
  }

  @media (max-width: 760px) {
    .footer-top-v3 {
      grid-template-columns: 1fr;
      align-items: stretch;
    }

    .footer-actions-v3 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .footer-product-grid-v3 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .footer-main-v2 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .footer-bottom-v2 {
      grid-template-columns: 1fr;
      gap: 0.85rem;
    }
  }

  @media (max-width: 520px) {
    .footer-v2 {
      padding-right: 1rem;
      padding-left: 1rem;
    }

    .footer-actions-v3,
    .footer-main-v2 {
      grid-template-columns: 1fr;
    }

    .footer-product-grid-v3 {
      grid-template-columns: 1fr;
    }

    .footer-product-grid-v3 > a {
      min-height: 4.5rem;
    }

    .footer-column-v2 {
      padding-top: 1rem;
      border-top: 1px solid color-mix(in srgb, var(--pt-color-on-brand-surface, #ffffff) 9%, transparent);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .footer-action-v3,
    .footer-product-grid-v3 > a,
    .footer-column-v2 a {
      transition-duration: 0.01ms;
    }
  }

  .footer-v2,
  .footer-v2 .footer-brand-lockup,
  .footer-v2 .footer-brand-name {
    color: var(--pt-color-on-brand-surface, #ffffff);
  }

  .footer-v2 .footer-brand-v2 p,
  .footer-v2 .footer-values,
  .footer-v2 .footer-column-v2 a,
  .footer-v2 .footer-bottom-v2 {
    color: var(--pt-color-on-brand-surface-muted, rgb(255 255 255 / 0.72));
  }
</style>
