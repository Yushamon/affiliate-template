---
import type { HomepageModel } from "../../home/model";

type Props = {
  items: HomepageModel["useCases"];
};

const { items } = Astro.props as Props;

const getIconSvg = (icon: HomepageModel["useCases"][number]["icon"]) => {
  if (icon === "bowl") {
    return `<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 10h16l-1.6 8H5.6L4 10Z"/><path d="M7 10c.3-2.5 2.1-4 5-4s4.7 1.5 5 4"/><path d="M9 14h6"/></svg>`;
  }

  if (icon === "drop") {
    return `<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3s6 6.2 6 11a6 6 0 0 1-12 0c0-4.8 6-11 6-11Z"/><path d="M9.5 15.2c.7 1.1 1.6 1.6 2.8 1.6"/></svg>`;
  }

  if (icon === "location") {
    return `<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s6-5.4 6-11a6 6 0 1 0-12 0c0 5.6 6 11 6 11Z"/><circle cx="12" cy="10" r="2.2"/></svg>`;
  }

  if (icon === "door") {
    return `<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 21V4l12-1v18"/><path d="M5 21h14"/><circle cx="14" cy="12" r=".8"/></svg>`;
  }

  if (icon === "camera") {
    return `<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="6" width="18" height="13" rx="2"/><circle cx="12" cy="12.5" r="3.2"/><path d="m7 6 1.2-2h3.6L13 6"/></svg>`;
  }

  return `<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 8h14l-1 12H6L5 8Z"/><path d="M8 8V5h8v3"/><path d="M9 12h6M10 16h4"/></svg>`;
};
---

<section class="home4-usecases" aria-labelledby="home4-usecases-title">
  <header class="home3-section__header">
    <div>
      <p class="home3-eyebrow">Nach Alltag auswählen</p>
      <h2 id="home4-usecases-title">Welche Lösung passt zu wem?</h2>
    </div>
    <p>
      Die passende Technik beginnt nicht beim Modellnamen, sondern bei Futterart, Tierzahl, Betreuung und gewünschter Kontrolle.
    </p>
  </header>

  <div class="home4-usecases__grid">
    {items.map((item) => (
      <a href={item.href}>
        <span
          class="home4-usecases__icon"
          aria-hidden="true"
          set:html={getIconSvg(item.icon)}
        ></span>
        <h3>{item.title}</h3>
        <p>{item.text}</p>
        <strong>Passende Inhalte ansehen →</strong>
      </a>
    ))}
  </div>
</section>
