---
interface HeaderLink {
  label: string;
  href: string;
  mobileGroup?: "Orientierung" | "Produktwelten" | "Mehr entdecken";
  mobileEmphasis?: boolean;
  description?: string;
  navCode?: string;
}

interface Props {
  projectName: string;
  links: HeaderLink[];
}

const { projectName, links } = Astro.props as Props;

const normalizePath = (value: string) => {
  const pathname = String(value || "/").split(/[?#]/, 1)[0] || "/";
  const withLeadingSlash = pathname.startsWith("/") ? pathname : `/${pathname}`;
  return withLeadingSlash === "/" || withLeadingSlash.endsWith("/")
    ? withLeadingSlash
    : `${withLeadingSlash}/`;
};

const currentPath = normalizePath(Astro.url.pathname);
const isCurrent = (href: string) => {
  const normalizedHref = normalizePath(href);
  return normalizedHref === "/"
    ? currentPath === "/"
    : currentPath === normalizedHref || currentPath.startsWith(normalizedHref);
};

const groupOrder = ["Orientierung", "Produktwelten", "Mehr entdecken"] as const;
const groups = groupOrder
  .map((label) => ({
    label,
    links: links.filter((link) => link.mobileGroup === label)
  }))
  .filter((group) => group.links.length > 0);

const orientationLinks = links.filter((link) => link.mobileGroup === "Orientierung");
const productLinks = links.filter((link) => link.mobileGroup === "Produktwelten");
const discoveryLinks = links.filter((link) => link.mobileGroup === "Mehr entdecken");
const comparisonLink = orientationLinks.find((link) => link.label === "Vergleiche");
const adviceLink = orientationLinks.find((link) => link.label === "Kaufberatung");
const productSectionIsCurrent = productLinks.some((link) => isCurrent(link.href));
---

<header class="site-header-v2" data-site-header data-header-version="32.2.1">
  <div class="header-container-v2">
    <a href="/" class="brand-lockup" aria-label={`${projectName} – Startseite`}>
      <span class="brand-mark" aria-hidden="true">
        <span class="brand-mark__cut"></span>
        <span class="brand-mark__dot"></span>
      </span>
      <span class="brand-name">{projectName}</span>
    </a>

    <button
      class="nav-toggle-button pt-button"
      type="button"
      aria-label="Navigation öffnen"
      aria-expanded="false"
      aria-controls="main-navigation"
      data-nav-toggle
    >
      <span class="nav-toggle__bars" aria-hidden="true">
        <span></span>
        <span></span>
        <span></span>
      </span>
      <span class="nav-toggle__sr">Menü</span>
    </button>

    <nav
      id="main-navigation"
      class="main-nav-v2"
      aria-label="Hauptnavigation"
      data-main-navigation
    >
      <div class="main-nav-v2__desktop">
        {comparisonLink && (
          <a
            href={comparisonLink.href}
            class:list={["main-nav-v2__desktop-link", isCurrent(comparisonLink.href) && "is-current"]}
            aria-current={isCurrent(comparisonLink.href) ? "page" : undefined}
          >
            {comparisonLink.label}
          </a>
        )}

        {productLinks.length > 0 && (
          <details class="main-nav-v2__desktop-menu" data-desktop-menu>
            <summary
              class:list={[
                "main-nav-v2__desktop-link",
                "main-nav-v2__desktop-summary",
                productSectionIsCurrent && "is-current"
              ]}
            >
              <span>Produktwelten</span>
              <svg viewBox="0 0 16 16" aria-hidden="true">
                <path d="m4 6 4 4 4-4" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"></path>
              </svg>
            </summary>

            <div class="main-nav-v2__desktop-panel">
              {productLinks.map((link) => (
                <a
                  href={link.href}
                  class:list={["main-nav-v2__desktop-item", isCurrent(link.href) && "is-current"]}
                  aria-current={isCurrent(link.href) ? "page" : undefined}
                >
                  <span>{link.label}</span>
                  <svg viewBox="0 0 20 20" aria-hidden="true">
                    <path d="m7.5 4.5 5 5.5-5 5.5" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"></path>
                  </svg>
                </a>
              ))}
            </div>
          </details>
        )}

        {adviceLink && (
          <a
            href={adviceLink.href}
            class:list={[
              "main-nav-v2__desktop-link",
              "main-nav-v2__desktop-link--emphasis",
              isCurrent(adviceLink.href) && "is-current"
            ]}
            aria-current={isCurrent(adviceLink.href) ? "page" : undefined}
          >
            {adviceLink.label}
          </a>
        )}

        {discoveryLinks.map((link) => (
          <a
            href={link.href}
            class:list={["main-nav-v2__desktop-link", isCurrent(link.href) && "is-current"]}
            aria-current={isCurrent(link.href) ? "page" : undefined}
          >
            {link.label}
          </a>
        ))}
      </div>

      <div class="main-nav-v2__mobile">
        {groups.map((group) => (
          <section class="main-nav-v2__group">
            <span class="main-nav-v2__group-title">{group.label}</span>

            <div class="main-nav-v2__group-links">
              {group.links.map((link) => (
                <a
                  href={link.href}
                  class:list={[
                    "main-nav-v2__mobile-link",
                    link.mobileEmphasis && "main-nav-v2__mobile-link--emphasis",
                    isCurrent(link.href) && "is-current"
                  ]}
                  aria-current={isCurrent(link.href) ? "page" : undefined}
                >
                  <span>{link.label}</span>
                  <svg class="main-nav-v2__chevron" viewBox="0 0 20 20" aria-hidden="true">
                    <path d="m7.5 4.5 5 5.5-5 5.5" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"></path>
                  </svg>
                </a>
              ))}
            </div>
          </section>
        ))}
      </div>
    </nav>
  </div>
</header>

<script>
  type NavigationHeader = HTMLElement & {
    navigationAbortController?: AbortController;
  };

  const setupHeaderNavigation = () => {
    document.querySelectorAll<NavigationHeader>("[data-site-header]").forEach((header) => {
      header.navigationAbortController?.abort();

      const button = header.querySelector<HTMLButtonElement>("[data-nav-toggle]");
      const navigation = header.querySelector<HTMLElement>("[data-main-navigation]");
      if (!button || !navigation) return;

      const desktop = window.matchMedia("(min-width: 64rem)");
      const controller = new AbortController();
      const { signal } = controller;
      header.navigationAbortController = controller;

      const closeDesktopMenus = (except?: HTMLDetailsElement) => {
        header.querySelectorAll<HTMLDetailsElement>("[data-desktop-menu][open]").forEach((menu) => {
          if (menu !== except) menu.open = false;
        });
      };

      const setOpen = (open: boolean, restoreFocus = false) => {
        const mobileOpen = open && !desktop.matches;

        button.setAttribute("aria-expanded", String(mobileOpen));
        button.setAttribute(
          "aria-label",
          mobileOpen ? "Navigation schließen" : "Navigation öffnen"
        );
        navigation.toggleAttribute("data-open", mobileOpen);
        navigation.setAttribute("aria-hidden", String(!mobileOpen && !desktop.matches));
        header.toggleAttribute("data-navigation-open", mobileOpen);

        if (!mobileOpen && restoreFocus) button.focus();
      };

      setOpen(false);

      button.addEventListener("click", (event) => {
        event.stopPropagation();
        setOpen(button.getAttribute("aria-expanded") !== "true");
      }, { signal });

      navigation.addEventListener("click", (event) => {
        if ((event.target as HTMLElement).closest("a")) {
          setOpen(false);
          closeDesktopMenus();
        }
      }, { signal });

      header.querySelectorAll<HTMLDetailsElement>("[data-desktop-menu]").forEach((menu) => {
        menu.addEventListener("toggle", () => {
          if (menu.open) closeDesktopMenus(menu);
        }, { signal });
      });

      document.addEventListener("click", (event) => {
        if (!header.contains(event.target as Node)) {
          setOpen(false);
          closeDesktopMenus();
        }
      }, { signal });

      document.addEventListener("keydown", (event) => {
        if (event.key !== "Escape") return;

        closeDesktopMenus();
        if (button.getAttribute("aria-expanded") === "true") {
          setOpen(false, true);
        }
      }, { signal });

      desktop.addEventListener("change", () => {
        setOpen(false);
        closeDesktopMenus();
      }, { signal });
    });
  };

  const resetHeaderNavigation = () => {
    document.querySelectorAll<NavigationHeader>("[data-site-header]").forEach((header) => {
      header.navigationAbortController?.abort();
      header.navigationAbortController = undefined;

      const button = header.querySelector<HTMLButtonElement>("[data-nav-toggle]");
      const navigation = header.querySelector<HTMLElement>("[data-main-navigation]");

      button?.setAttribute("aria-expanded", "false");
      button?.setAttribute("aria-label", "Navigation öffnen");
      navigation?.removeAttribute("data-open");
      header.removeAttribute("data-navigation-open");

      header.querySelectorAll<HTMLDetailsElement>("[data-desktop-menu][open]").forEach((menu) => {
        menu.open = false;
      });
    });
  };

  setupHeaderNavigation();
  document.addEventListener("astro:page-load", setupHeaderNavigation);
  document.addEventListener("astro:before-swap", resetHeaderNavigation);
</script>

<style is:global>
  .site-header-v2 {
    position: sticky;
    z-index: 120;
    top: 0;
    border-bottom: 1px solid color-mix(in srgb, var(--pt-color-border) 78%, transparent);
    background: color-mix(in srgb, var(--pt-color-surface) 94%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  .site-header-v2 .brand-name {
    color: var(--pt-color-text);
  }

  .site-header-v2 .header-container-v2 {
    position: relative;
    display: grid;
    width: min(100%, var(--pt-content));
    min-height: 4.25rem;
    margin-inline: auto;
    padding-inline: clamp(1rem, 3vw, 2rem);
    box-sizing: border-box;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: var(--pt-space-4);
  }

  .site-header-v2 .main-nav-v2 {
    min-width: 0;
    margin-left: auto;
    border: 0;
    background: transparent;
    box-shadow: none;
  }

  .site-header-v2 .main-nav-v2__desktop {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.2rem;
  }

  .site-header-v2 .main-nav-v2__desktop-link {
    display: inline-flex;
    min-height: 2.5rem;
    padding: 0.55rem 0.72rem;
    align-items: center;
    gap: 0.35rem;
    border: 1px solid transparent;
    border-radius: var(--pt-radius-pill);
    color: var(--pt-color-text-muted);
    background: transparent;
    font-size: 0.88rem;
    font-weight: var(--pt-font-weight-bold);
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
  }

  .site-header-v2 .main-nav-v2__desktop-link:hover,
  .site-header-v2 .main-nav-v2__desktop-link:focus-visible,
  .site-header-v2 .main-nav-v2__desktop-link.is-current {
    border-color: var(--pt-color-border);
    color: var(--pt-color-text);
    background: var(--pt-color-surface-soft);
  }

  .site-header-v2 .main-nav-v2__desktop-link--emphasis {
    border-color: color-mix(in srgb, var(--pt-color-brand-600) 30%, var(--pt-color-border));
    color: var(--pt-color-on-brand);
    background: var(--pt-color-brand-600);
  }

  .site-header-v2 .main-nav-v2__desktop-link--emphasis:hover,
  .site-header-v2 .main-nav-v2__desktop-link--emphasis:focus-visible,
  .site-header-v2 .main-nav-v2__desktop-link--emphasis.is-current {
    border-color: var(--pt-color-brand-700);
    color: var(--pt-color-on-brand);
    background: var(--pt-color-brand-700);
  }

  .site-header-v2 .main-nav-v2__desktop-menu {
    position: relative;
  }

  .site-header-v2 .main-nav-v2__desktop-summary {
    list-style: none;
  }

  .site-header-v2 .main-nav-v2__desktop-summary::-webkit-details-marker {
    display: none;
  }

  .site-header-v2 .main-nav-v2__desktop-summary svg {
    width: 0.85rem;
  }

  .site-header-v2 .main-nav-v2__desktop-menu[open] .main-nav-v2__desktop-summary svg {
    transform: rotate(180deg);
  }

  .site-header-v2 .main-nav-v2__desktop-panel {
    position: absolute;
    z-index: 130;
    top: calc(100% + 0.55rem);
    left: 50%;
    display: grid;
    width: min(25rem, calc(100vw - 2rem));
    padding: 0.55rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.2rem;
    border: 1px solid var(--pt-color-border);
    border-radius: var(--pt-radius-lg);
    color: var(--pt-color-text);
    background: var(--pt-color-surface);
    box-shadow: var(--pt-shadow-md);
    transform: translateX(-50%);
  }

  .site-header-v2 .main-nav-v2__desktop-item {
    display: grid;
    min-width: 0;
    min-height: 2.75rem;
    padding: 0.6rem 0.7rem;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.5rem;
    border-radius: 0.65rem;
    color: var(--pt-color-text);
    font-size: 0.82rem;
    font-weight: var(--pt-font-weight-bold);
    text-decoration: none;
  }

  .site-header-v2 .main-nav-v2__desktop-item:hover,
  .site-header-v2 .main-nav-v2__desktop-item:focus-visible,
  .site-header-v2 .main-nav-v2__desktop-item.is-current {
    color: var(--pt-color-brand-700);
    background: var(--pt-color-surface-soft);
  }

  .site-header-v2 .main-nav-v2__desktop-item svg {
    width: 0.85rem;
  }

  .site-header-v2 .main-nav-v2__mobile,
  .site-header-v2 .nav-toggle-button {
    display: none;
  }

  .site-header-v2 .nav-toggle__sr {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  @media (max-width: 63.99rem) {
    .site-header-v2 .header-container-v2 {
      width: 100%;
      min-height: 4.25rem;
      padding-inline: 1rem;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: var(--pt-space-3);
    }

    .site-header-v2 .brand-lockup {
      min-width: 0;
    }

    .site-header-v2 .nav-toggle-button {
      position: relative;
      display: grid;
      inline-size: 2.9rem;
      block-size: 2.9rem;
      min-inline-size: 2.9rem;
      min-block-size: 2.9rem;
      place-items: center;
      padding: 0;
      border: 1px solid var(--pt-color-border);
      border-radius: 0.85rem;
      color: var(--pt-color-text);
      background: var(--pt-color-surface);
      box-shadow: var(--pt-shadow-xs);
      cursor: pointer;
      touch-action: manipulation;
      appearance: none;
    }

    .site-header-v2 .nav-toggle-button::before,
    .site-header-v2 .nav-toggle-button::after {
      display: none;
      content: none;
    }

    .site-header-v2 .nav-toggle-button:focus-visible {
      outline: var(--pt-focus-ring);
      outline-offset: var(--pt-focus-offset);
    }

    .site-header-v2 .nav-toggle__bars {
      position: relative;
      display: grid;
      width: 1.25rem;
      gap: 0.27rem;
    }

    .site-header-v2 .nav-toggle__bars > span {
      display: block;
      width: 100%;
      height: 2px;
      border-radius: var(--pt-radius-pill);
      background: currentColor;
      transform-origin: center;
      transition:
        transform var(--pt-transition-fast),
        opacity var(--pt-transition-fast);
    }

    .site-header-v2 .nav-toggle-button[aria-expanded="true"] .nav-toggle__bars > span:first-child {
      transform: translateY(0.36rem) rotate(45deg);
    }

    .site-header-v2 .nav-toggle-button[aria-expanded="true"] .nav-toggle__bars > span:nth-child(2) {
      opacity: 0;
    }

    .site-header-v2 .nav-toggle-button[aria-expanded="true"] .nav-toggle__bars > span:last-child {
      transform: translateY(-0.36rem) rotate(-45deg);
    }

    .site-header-v2 .main-nav-v2 {
      position: absolute;
      z-index: 130;
      top: calc(100% + 0.45rem);
      right: 1rem;
      left: 1rem;
      max-height: calc(100dvh - 5.5rem);
      overflow-y: auto;
      margin: 0;
      padding: 0.65rem;
      border: 1px solid var(--pt-color-border);
      border-radius: var(--pt-radius-lg);
      color: var(--pt-color-text);
      background: var(--pt-color-surface);
      box-shadow: var(--pt-shadow-lg);
      visibility: hidden;
      opacity: 0;
      pointer-events: none;
      transform: translateY(-0.3rem);
      overscroll-behavior: contain;
      transition:
        opacity 120ms ease-out,
        transform 120ms ease-out,
        visibility 0s linear 120ms;
    }

    .site-header-v2 .main-nav-v2[data-open] {
      visibility: visible;
      opacity: 1;
      pointer-events: auto;
      transform: translateY(0);
      transition-delay: 0s;
    }

    .site-header-v2 .main-nav-v2__desktop {
      display: none;
    }

    .site-header-v2 .main-nav-v2__mobile {
      display: grid;
      gap: 0.65rem;
    }

    .site-header-v2 .main-nav-v2__group {
      display: grid;
      gap: 0.2rem;
    }

    .site-header-v2 .main-nav-v2__group + .main-nav-v2__group {
      padding-top: 0.55rem;
      border-top: 1px solid var(--pt-color-border);
    }

    .site-header-v2 .main-nav-v2__group-title {
      padding: 0.2rem 0.55rem;
      color: var(--pt-color-text-muted);
      font-size: 0.66rem;
      font-weight: var(--pt-font-weight-black);
      letter-spacing: 0.09em;
      text-transform: uppercase;
    }

    .site-header-v2 .main-nav-v2__group-links {
      display: grid;
      gap: 0.05rem;
    }

    .site-header-v2 .main-nav-v2__mobile-link {
      display: grid;
      min-width: 0;
      min-height: 2.8rem;
      padding: 0.58rem 0.65rem;
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      gap: 0.7rem;
      border: 1px solid transparent;
      border-radius: 0.7rem;
      color: var(--pt-color-text);
      background: transparent;
      font-size: 0.9rem;
      font-weight: var(--pt-font-weight-bold);
      line-height: 1.25;
      text-decoration: none;
    }

    .site-header-v2 .main-nav-v2__mobile-link:hover,
    .site-header-v2 .main-nav-v2__mobile-link:focus-visible,
    .site-header-v2 .main-nav-v2__mobile-link.is-current {
      border-color: var(--pt-color-border);
      color: var(--pt-color-brand-700);
      background: var(--pt-color-surface-soft);
    }

    .site-header-v2 .main-nav-v2__mobile-link--emphasis {
      color: var(--pt-color-on-brand);
      background: var(--pt-color-brand-600);
    }

    .site-header-v2 .main-nav-v2__mobile-link--emphasis:hover,
    .site-header-v2 .main-nav-v2__mobile-link--emphasis:focus-visible,
    .site-header-v2 .main-nav-v2__mobile-link--emphasis.is-current {
      border-color: var(--pt-color-brand-700);
      color: var(--pt-color-on-brand);
      background: var(--pt-color-brand-700);
    }

    .site-header-v2 .main-nav-v2__chevron {
      width: 0.95rem;
      color: currentColor;
    }
  }

  @media (min-width: 64rem) {
    .site-header-v2 .nav-toggle-button {
      display: none;
      visibility: hidden;
      pointer-events: none;
    }

    .site-header-v2 .main-nav-v2 {
      position: static;
      display: block;
      visibility: visible;
      opacity: 1;
      pointer-events: auto;
      transform: none;
    }

    .site-header-v2 .main-nav-v2__desktop {
      display: flex;
    }

    .site-header-v2 .main-nav-v2__mobile {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header-v2 .main-nav-v2,
    .site-header-v2 .nav-toggle__bars > span {
      transition-duration: 0.01ms;
    }
  }
</style>
