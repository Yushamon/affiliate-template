---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata | string;
  alt: string;
  class?: string;
  width?: number;
  height?: number;
  widths?: number[];
  sizes?: string;
  layout?: "constrained" | "full-width" | "fixed" | "none";
  fit?: "cover" | "contain" | "fill" | "inside" | "outside";
  position?: string;
  loading?: "eager" | "lazy";
  decoding?: "async" | "auto" | "sync";
  priority?: boolean;
}

const {
  src,
  alt,
  class: className,
  width,
  height,
  widths,
  sizes,
  layout = "constrained",
  fit = "cover",
  position = "center",
  loading = "lazy",
  decoding = "async",
  priority = false
} = Astro.props;

const isLocalAsset = typeof src !== "string";
const constrainedWidths = width
  ? [...new Set([Math.min(width, 240), Math.ceil(width * 0.67), width])]
      .filter((value) => value > 0)
      .sort((left, right) => left - right)
  : [320, 640, 960];
const resolvedWidths = widths ?? (
  layout === "full-width"
    ? [480, 768, 1200, 1600]
    : layout === "constrained"
      ? constrainedWidths
      : undefined
);
const resolvedSizes = sizes ?? (
  layout === "full-width"
    ? "100vw"
    : layout === "constrained" && width
      ? `(max-width: ${width}px) 100vw, ${width}px`
      : layout === "constrained"
        ? "(max-width: 768px) 100vw, 50vw"
        : undefined
);
---

{
  isLocalAsset ? (
    <Image
      src={src as ImageMetadata}
      alt={alt}
      class={className}
      width={width}
      height={height}
      widths={resolvedWidths}
      sizes={resolvedSizes}
      layout={layout}
      fit={fit}
      position={position}
      loading={priority ? undefined : loading}
      decoding={priority ? undefined : decoding}
      priority={priority}
    />
  ) : (
    <img
      src={src as string}
      alt={alt}
      class={className}
      width={width}
      height={height}
      loading={priority ? "eager" : loading}
      decoding={priority ? "sync" : decoding}
      fetchpriority={priority ? "high" : undefined}
    />
  )
}
