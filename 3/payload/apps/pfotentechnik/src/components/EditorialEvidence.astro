---
import type { InformationGainProfile } from "../domain/contentPlatform/informationGainProfiles";

interface Props {
  profile?: InformationGainProfile;
}

const { profile } = Astro.props as Props;
---

{profile && (
  <aside class="editorial-evidence" aria-labelledby="editorial-evidence-title">
    <div class="editorial-evidence__note">
      <span>Redaktionelle Einordnung</span>
      <h2 id="editorial-evidence-title">Der Punkt, der in der Praxis oft übersehen wird</h2>
      <p>{profile.expertNote}</p>
    </div>
    <nav aria-label="Passende Vertiefungen">
      {profile.nextLinks.map((link) => (
        <a href={link.href}>
          <strong>{link.label}</strong>
          <span>{link.reason}</span>
        </a>
      ))}
    </nav>
  </aside>
)}

<style>
  .editorial-evidence {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(260px, .85fr);
    gap: 16px;
    margin: 42px 0;
  }
  .editorial-evidence__note,
  .editorial-evidence nav {
    padding: clamp(20px, 4vw, 28px);
    border: 1px solid var(--border);
    border-radius: 22px;
    background: var(--surface, #fff);
  }
  .editorial-evidence__note > span {
    color: var(--accent, #2e7d32);
    font-size: .78rem;
    font-weight: 800;
    letter-spacing: .08em;
    text-transform: uppercase;
  }
  .editorial-evidence h2 {
    margin: 8px 0 12px;
    font-size: clamp(1.35rem, 3vw, 1.8rem);
    line-height: 1.18;
  }
  .editorial-evidence p {
    margin: 0;
    color: var(--muted);
    line-height: 1.65;
  }
  .editorial-evidence nav {
    display: grid;
    gap: 10px;
  }
  .editorial-evidence nav a {
    display: grid;
    gap: 3px;
    padding: 12px 0;
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid var(--border);
  }
  .editorial-evidence nav a:last-child { border-bottom: 0; }
  .editorial-evidence nav a:hover strong { color: var(--accent, #2e7d32); }
  .editorial-evidence nav span { color: var(--muted); font-size: .92rem; line-height: 1.45; }
  @media (max-width: 700px) {
    .editorial-evidence { grid-template-columns: 1fr; margin: 32px 0; }
    .editorial-evidence__note,
    .editorial-evidence nav { padding: 18px; border-radius: 18px; }
  }
  :global(html[data-theme="dark"]) .editorial-evidence__note,
  :global(html[data-theme="dark"]) .editorial-evidence nav,
  :global(html.dark) .editorial-evidence__note,
  :global(html.dark) .editorial-evidence nav {
    background: #132238;
    border-color: rgba(148, 163, 184, .24);
  }
</style>
