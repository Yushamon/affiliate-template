---
import SeoAdminLayout from "../../../layouts/SeoAdminLayout.astro";
import SearchIntegrations from "../../../components/admin/SearchIntegrations.astro";
import QualityOperations from "../../../components/admin/QualityOperations.astro";
import SeoWorkPackages from "../../../components/admin/SeoWorkPackages.astro";
import { loadSearchDashboard } from "../../../lib/search/dashboard-loader";

const payload = loadSearchDashboard();
const active = payload.ranges[payload.defaultRange] ?? Object.values(payload.ranges)[0];
const formatNumber = (value: number) => new Intl.NumberFormat("de-DE").format(value);
---
<SeoAdminLayout
  title="SEO-Arbeitsübersicht"
  description="Erkennen, priorisieren, bearbeiten, prüfen und abschließen. Rohberichte bleiben Quellen, die tägliche Arbeit läuft über Findings und begrenzte Arbeitspakete."
  active="overview"
>
  <div class="seo-stack-lg">
    <SearchIntegrations />

    {active ? (
      <section class="seo-panel seo-stack">
        <div class="seo-section-header">
          <div>
            <span class="seo-eyebrow">Search-Signal</span>
            <h2>{active.label}</h2>
            <p>{active.startDate} bis {active.endDate}</p>
          </div>
          <a class="pt-button seo-button" href="/admin/seo/cockpit/">Search öffnen</a>
        </div>
        <div class="seo-metrics">
          <article class="seo-metric"><span>Klicks</span><strong>{formatNumber(active.metrics.current.clicks)}</strong></article>
          <article class="seo-metric"><span>Impressionen</span><strong>{formatNumber(active.metrics.current.impressions)}</strong></article>
          <article class="seo-metric"><span>CTR</span><strong>{active.metrics.current.ctr.toFixed(2)} %</strong></article>
          <article class="seo-metric"><span>Position</span><strong>{active.metrics.current.position.toFixed(1)}</strong></article>
          <article class="seo-metric"><span>Seiten</span><strong>{active.pages.length}</strong></article>
          <article class="seo-metric"><span>Queries</span><strong>{active.queries.length}</strong></article>
        </div>
      </section>
    ) : (
      <section class="seo-panel seo-empty">
        Keine nutzbaren Search-Daten. Die Quality-Operations-Arbeit bleibt trotzdem verfügbar.
      </section>
    )}

    <QualityOperations mode="summary" />
    <SeoWorkPackages mode="advisor" />
  </div>
</SeoAdminLayout>
