{
  "name": "pfotentechnik-responsive-image-breakpoints",
  "version": "1.0.0",
  "target": "apps/pfotentechnik/astro.config.mjs",
  "breakpoints": [
    480,
    768,
    960,
    1200
  ],
  "validation": [
    "node --check apps/pfotentechnik/astro.config.mjs",
    "npm run build:pfotentechnik",
    "npm --workspace apps/pfotentechnik run audit:performance:strict"
  ]
}
