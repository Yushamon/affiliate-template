---
import ProductExperience2 from "../product-experience-2/ProductExperience2.astro";
import { buildProductExperienceModel } from "../../domain/productExperience/model";

interface Props {
  product: any;
  currentEntry?: any;
  allProducts?: any[];
  reviewProduct?: any;
  alternativeRecommendations?: any[];
  debug?: boolean;
}

const {
  product,
  currentEntry = product,
  allProducts = [],
  reviewProduct = {},
  alternativeRecommendations = []
} = Astro.props;

const model = buildProductExperienceModel({
  currentEntry,
  allProducts,
  reviewProduct,
  alternativeRecommendations
});
---

<ProductExperience2 model={model} />
