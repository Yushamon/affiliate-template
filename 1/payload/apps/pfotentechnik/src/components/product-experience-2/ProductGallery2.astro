---
import { getImage } from "astro:assets";

interface GalleryItem {
  src: any;
  alt: string;
  caption?: string;
}

interface Props {
  name: string;
  items: GalleryItem[];
}

const { name, items } = Astro.props;

const optimized = await Promise.all(items.map(async (item, index) => {
  try {
    const [image, thumbnail] = await Promise.all([
      getImage({
        src: item.src,
        widths: [480, 768, 1024, 1400],
        sizes: "(max-width: 760px) 100vw, 48vw",
        quality: "high"
      }),
      getImage({
        src: item.src,
        width: 180,
        height: 135,
        fit: "contain",
        quality: "mid"
      })
    ]);
    return {
      ...item,
      src: image.src,
      srcset: image.srcSet.attribute,
      thumbSrc: thumbnail.src,
      width: item.src?.width ?? 1400,
      height: item.src?.height ?? 1050,
      loading: index === 0 ? "eager" : "lazy",
      fetchpriority: index === 0 ? "high" : "auto"
    };
  } catch {
    const fallback = typeof item.src === "string" ? item.src : item.src?.src;
    return {
      ...item,
      src: fallback,
      srcset: "",
      thumbSrc: fallback,
      width: item.src?.width ?? 1400,
      height: item.src?.height ?? 1050,
      loading: index === 0 ? "eager" : "lazy",
      fetchpriority: index === 0 ? "high" : "auto"
    };
  }
}));

const hero = optimized[0];
---

<section class="px2-gallery" data-px2-gallery aria-label={`Produktbilder von ${name}`}>
  {hero ? (
    <figure class="px2-gallery__stage">
      <img
        data-px2-gallery-main
        src={hero.src}
        srcset={hero.srcset || undefined}
        sizes="(max-width: 760px) 100vw, 48vw"
        width={hero.width}
        height={hero.height}
        alt={hero.alt || name}
        loading="eager"
        decoding="async"
        fetchpriority="high"
      />
      <figcaption data-px2-gallery-caption>{hero.caption}</figcaption>
    </figure>
  ) : (
    <div class="px2-gallery__empty" role="img" aria-label={`Kein Produktbild für ${name} verfügbar`}>
      <span aria-hidden="true">PT</span>
      <p>Produktbild wird geprüft</p>
    </div>
  )}

  {optimized.length > 1 && (
    <div class="px2-gallery__thumbs" aria-label="Weitere Produktansichten">
      {optimized.map((item, index) => (
        <button
          type="button"
          class:list={["px2-gallery__thumb", { "is-active": index === 0 }]}
          aria-label={`Ansicht ${index + 1} anzeigen`}
          aria-pressed={index === 0 ? "true" : "false"}
          data-px2-gallery-thumb
          data-src={item.src}
          data-srcset={item.srcset}
          data-alt={item.alt}
          data-caption={item.caption ?? ""}
        >
          <img
            src={item.thumbSrc}
            width="180"
            height="135"
            alt=""
            loading={index === 0 ? "eager" : "lazy"}
            decoding="async"
          />
        </button>
      ))}
    </div>
  )}
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-px2-gallery]").forEach((root) => {
    const main = root.querySelector<HTMLImageElement>("[data-px2-gallery-main]");
    const caption = root.querySelector<HTMLElement>("[data-px2-gallery-caption]");
    const thumbs = [...root.querySelectorAll<HTMLButtonElement>("[data-px2-gallery-thumb]")];
    if (!main) return;

    const select = (index: number) => {
      const thumb = thumbs[index];
      if (!thumb) return;
      main.src = thumb.dataset.src || main.src;
      main.srcset = thumb.dataset.srcset || "";
      main.alt = thumb.dataset.alt || main.alt;
      if (caption) caption.textContent = thumb.dataset.caption || "";
      thumbs.forEach((item, itemIndex) => {
        const active = itemIndex === index;
        item.classList.toggle("is-active", active);
        item.setAttribute("aria-pressed", active ? "true" : "false");
      });
      thumb.scrollIntoView({ behavior: "smooth", block: "nearest", inline: "nearest" });
    };

    thumbs.forEach((thumb, index) => thumb.addEventListener("click", () => select(index)));

    let touchStartX: number | null = null;
    main.addEventListener("touchstart", (event) => {
      touchStartX = event.changedTouches[0]?.clientX ?? null;
    }, { passive: true });
    main.addEventListener("touchend", (event) => {
      if (touchStartX == null || thumbs.length < 2) return;
      const delta = (event.changedTouches[0]?.clientX ?? touchStartX) - touchStartX;
      touchStartX = null;
      if (Math.abs(delta) < 45) return;
      const activeIndex = Math.max(0, thumbs.findIndex((item) => item.classList.contains("is-active")));
      const nextIndex = delta < 0
        ? Math.min(thumbs.length - 1, activeIndex + 1)
        : Math.max(0, activeIndex - 1);
      select(nextIndex);
    }, { passive: true });
  });
</script>

<style>
  .px2-gallery {
    min-width: 0;
  }

  .px2-gallery__stage,
  .px2-gallery__empty {
    display: grid;
    place-items: center;
    min-height: clamp(310px, 46vw, 610px);
    margin: 0;
    overflow: hidden;
    border: 1px solid var(--px2-border);
    border-radius: 24px;
    background:
      radial-gradient(circle at 80% 15%, color-mix(in srgb, var(--px2-green-soft) 70%, transparent), transparent 38%),
      var(--px2-surface-raised);
    box-shadow: var(--px2-shadow);
  }

  .px2-gallery__stage img {
    display: block;
    width: 100%;
    height: auto;
    max-height: 650px;
    aspect-ratio: 4 / 3;
    padding: clamp(12px, 3vw, 32px);
    object-fit: contain;
  }

  .px2-gallery__stage figcaption {
    min-height: 0;
    padding: 0 18px 14px;
    color: var(--px2-muted);
    font-size: .82rem;
    text-align: center;
  }

  .px2-gallery__stage figcaption:empty {
    display: none;
  }

  .px2-gallery__empty {
    align-content: center;
    gap: 10px;
    color: var(--px2-muted);
  }

  .px2-gallery__empty span {
    display: grid;
    place-items: center;
    width: 70px;
    height: 70px;
    border-radius: 22px;
    background: var(--px2-green-soft);
    color: var(--px2-green-strong);
    font-weight: 900;
  }

  .px2-gallery__thumbs {
    display: flex;
    gap: 10px;
    margin-top: 12px;
    padding: 2px;
    overflow-x: auto;
    scrollbar-width: thin;
  }

  .px2-gallery__thumb {
    flex: 0 0 92px;
    min-height: 74px;
    padding: 4px;
    overflow: hidden;
    border: 2px solid transparent;
    border-radius: 14px;
    background: var(--px2-surface);
    cursor: pointer;
  }

  .px2-gallery__thumb.is-active {
    border-color: var(--px2-green);
  }

  .px2-gallery__thumb img {
    display: block;
    width: 100%;
    height: 64px;
    border-radius: 9px;
    object-fit: contain;
  }

  @media (max-width: 720px) {
    .px2-gallery__stage,
    .px2-gallery__empty {
      min-height: 300px;
      border-radius: 18px;
    }

    .px2-gallery__stage img {
      max-height: 68vh;
      padding: 10px;
    }

    .px2-gallery__thumbs {
      margin-inline: -2px;
      scroll-snap-type: x proximity;
    }

    .px2-gallery__thumb {
      flex-basis: 82px;
      scroll-snap-align: start;
    }
  }
</style>
