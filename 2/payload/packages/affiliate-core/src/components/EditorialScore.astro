---
interface Props {
  value: number;
  scale?: 5 | 10 | 100;
  variant?: "inline" | "compact" | "standard" | "detailed" | "ring" | "ring-compact";
  methodologyHref?: string;
  showMethodology?: boolean;
  label?: string;
  description?: string;
  class?: string;
}

const {
  value,
  scale = 100,
  variant = "compact",
  methodologyHref = "/so-bewerten-wir/",
  showMethodology = variant === "detailed",
  label = "PfotenTechnik-Score",
  description,
  class: className
} = Astro.props;

const normalized =
  scale === 5 ? value * 20 : scale === 10 ? value * 10 : value;
const score = Math.max(0, Math.min(100, Math.round(normalized)));
const isRing = variant === "ring" || variant === "ring-compact";

const verdict =
  score >= 90 ? "Hervorragend"
  : score >= 80 ? "Sehr gut"
  : score >= 70 ? "Gut"
  : score >= 60 ? "Solide"
  : score >= 50 ? "Mit Einschränkungen"
  : "Nicht empfohlen";

const tone =
  score >= 80 ? "excellent"
  : score >= 70 ? "good"
  : score >= 60 ? "solid"
  : score >= 50 ? "limited"
  : "poor";
---

<div
  class:list={[
    "pt-score",
    `pt-score--${variant}`,
    `pt-score--${tone}`,
    className
  ]}
  aria-label={`PfotenTechnik-Score ${score} von 100: ${verdict}`}
>
  <div class="pt-score__summary">
    {isRing ? (
      <div
        class="pt-score__ring"
        style={`--pt-score-value:${score}`}
        role="meter"
        aria-valuemin="0"
        aria-valuemax="100"
        aria-valuenow={score}
      >
        <span class="pt-score__ring-inner">
          <strong class="pt-score__value">{score}</strong>
          <small>/100</small>
        </span>
      </div>
    ) : (
      <strong class="pt-score__value">{score}</strong>
    )}

    <div class="pt-score__copy">
      <span class="pt-score__verdict">{verdict}</span>
      <small class="pt-score__label">{description ?? label}</small>
    </div>
  </div>

  {!isRing && (
    <div
      class="pt-score__track"
      role="meter"
      aria-valuemin="0"
      aria-valuemax="100"
      aria-valuenow={score}
    >
      <span style={`--pt-score-value:${score}%`}></span>
    </div>
  )}

  {showMethodology && (
    <div class="pt-score__method">
      <span>Nach einheitlichen Kriterien eingeordnet</span>
      <a href={methodologyHref}>So entsteht der Score</a>
    </div>
  )}
</div>

<style>
  .pt-score {
    --score-accent: var(--pt-theme-accent, #22a95b);
    --score-soft: color-mix(in srgb, var(--score-accent) 13%, transparent);
    --score-surface: var(--pt-theme-surface, var(--surface, #fff));
    --score-text: var(--pt-theme-text, var(--text, #10231f));
    --score-muted: var(--pt-theme-text-soft, var(--muted, #687670));
    display: grid;
    min-width: 0;
    gap: .55rem;
  }

  .pt-score--good { --score-accent: #75a91b; }
  .pt-score--solid { --score-accent: #c58b00; }
  .pt-score--limited { --score-accent: #d56f1f; }
  .pt-score--poor { --score-accent: #cf4545; }

  .pt-score__summary {
    display: flex;
    min-width: 0;
    align-items: center;
    gap: .75rem;
  }

  .pt-score__value {
    flex: 0 0 auto;
    color: var(--score-text);
    font-size: clamp(1.65rem, 4vw, 2.25rem);
    font-weight: 950;
    line-height: .95;
    letter-spacing: -.05em;
  }

  .pt-score__copy {
    display: grid;
    min-width: 0;
    gap: .18rem;
  }

  .pt-score__verdict {
    color: var(--score-text);
    font-size: .92rem;
    font-weight: 900;
    line-height: 1.2;
  }

  .pt-score__label {
    max-width: 38ch;
    color: var(--score-muted);
    font-size: .72rem;
    line-height: 1.42;
  }

  .pt-score__track {
    width: 100%;
    height: 5px;
    overflow: hidden;
    border-radius: 999px;
    background: color-mix(in srgb, var(--score-muted) 16%, transparent);
  }

  .pt-score__track > span {
    display: block;
    width: var(--pt-score-value);
    height: 100%;
    border-radius: inherit;
    background: var(--score-accent);
  }

  .pt-score__ring {
    display: grid;
    width: 82px;
    height: 82px;
    flex: 0 0 82px;
    place-items: center;
    border-radius: 50%;
    background: conic-gradient(
      var(--score-accent) calc(var(--pt-score-value) * 1%),
      color-mix(in srgb, var(--score-accent) 14%, var(--score-surface)) 0
    );
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--score-accent) 16%, transparent);
  }

  .pt-score__ring-inner {
    display: grid;
    width: 66px;
    height: 66px;
    place-items: center;
    align-content: center;
    border-radius: 50%;
    background: var(--score-surface);
    box-shadow: 0 1px 5px color-mix(in srgb, var(--score-text) 8%, transparent);
  }

  .pt-score__ring .pt-score__value {
    color: var(--score-text);
    font-size: 1.55rem;
  }

  .pt-score__ring small {
    margin-top: .12rem;
    color: var(--score-muted);
    font-size: .66rem;
    line-height: 1;
  }

  .pt-score__method {
    display: flex;
    flex-wrap: wrap;
    gap: .25rem .8rem;
    color: var(--score-muted);
    font-size: .72rem;
    line-height: 1.4;
  }

  .pt-score__method a {
    color: var(--score-accent);
    font-weight: 850;
    text-underline-offset: 3px;
  }

  .pt-score--inline {
    display: inline-flex;
    width: auto;
    align-items: center;
    gap: .55rem;
  }

  .pt-score--inline .pt-score__summary { gap: .45rem; }
  .pt-score--inline .pt-score__value { color: var(--score-accent); font-size: 1.3rem; }
  .pt-score--inline .pt-score__verdict { font-size: .78rem; }

  .pt-score--inline .pt-score__label,
  .pt-score--inline .pt-score__track {
    display: none;
  }

  .pt-score--compact {
    width: 100%;
    margin-top: auto;
    padding-top: .9rem;
    border-top: 1px solid color-mix(in srgb, var(--score-muted) 17%, transparent);
  }

  .pt-score--ring,
  .pt-score--ring-compact {
    width: 100%;
  }

  .pt-score--ring-compact .pt-score__ring {
    width: 66px;
    height: 66px;
    flex-basis: 66px;
  }

  .pt-score--ring-compact .pt-score__ring-inner {
    width: 52px;
    height: 52px;
  }

  .pt-score--ring-compact .pt-score__ring .pt-score__value {
    font-size: 1.22rem;
  }

  .pt-score--ring-compact .pt-score__ring small {
    font-size: .58rem;
  }

  .pt-score--ring-compact .pt-score__verdict {
    font-size: .82rem;
  }

  .pt-score--ring-compact .pt-score__label {
    font-size: .66rem;
  }

  .pt-score--standard,
  .pt-score--detailed {
    padding: 1rem;
    border: 1px solid color-mix(in srgb, var(--score-accent) 20%, transparent);
    border-radius: 1rem;
    background: color-mix(in srgb, var(--score-soft) 52%, transparent);
  }

  .pt-score--detailed {
    padding: clamp(1.1rem, 3vw, 1.45rem);
  }

  .pt-score--detailed .pt-score__value {
    font-size: clamp(2.7rem, 8vw, 4.7rem);
  }

  @media (max-width: 420px) {
    .pt-score__ring {
      width: 74px;
      height: 74px;
      flex-basis: 74px;
    }

    .pt-score__ring-inner {
      width: 60px;
      height: 60px;
    }
  }
</style>
