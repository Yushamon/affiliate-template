---
import SeoAdminLayout from "../../../layouts/SeoAdminLayout.astro";
import { mediaAudit } from "../../../lib/media-center/service.mjs";

const audit = await mediaAudit();
const serviceUrl = import.meta.env.PUBLIC_SEARCH_ADMIN_URL || "http://127.0.0.1:4178";
const serializedConfig = JSON.stringify({ serviceUrl }).replaceAll("<", "\\u003c");
---

<SeoAdminLayout
  title="Media Center"
  description="Produktbilder prüfen, redaktionell freigeben, konkreten Zieldateien zuordnen und kontrolliert in den Produktordner veröffentlichen."
  active="media"
>
  <section class="pt-surface media-intake seo-card">
    <div>
      <span class="seo-badge">Media Factory 3.0</span>
      <h2>Produktquelle analysieren</h2>
      <p>
        Die automatische Bewertung bleibt eine Warnhilfe. Heruntergeladene Bilder kannst du
        redaktionell freigeben und anschließend gezielt als Hero, Thumbnail, Vergleichsbild
        oder Galerie-Datei verwenden.
      </p>
    </div>
    <form data-media-import>
      <label>
        Amazon- oder Hersteller-Link
        <input type="url" name="url" required placeholder="https://…" />
      </label>
      <label>
        Produkt-Slug, optional
        <input type="text" name="slug" pattern="[a-z0-9-]+" placeholder="petlibro-granary-2-vision" />
      </label>
      <button type="submit">Quelle prüfen</button>
    </form>
  </section>

  <section class="pt-surface media-flow seo-card" aria-label="Ablauf">
    <ol>
      <li><strong>1. Prüfen</strong><span>Automatische Hinweise und Bildvorschauen ansehen.</span></li>
      <li><strong>2. Zuordnen</strong><span>Bild auswählen und Zieldatei festlegen.</span></li>
      <li><strong>3. Bauen</strong><span>WebP-Dateien erzeugen und Änderungen prüfen.</span></li>
      <li><strong>4. Veröffentlichen</strong><span>Nur ausgewählte Dateien anlegen oder überschreiben.</span></li>
    </ol>
  </section>

  <p class="media-status" data-media-status aria-live="polite"></p>
  <script type="application/json" data-media-config set:html={serializedConfig}></script>

  <section class="media-workspace" data-media-workspace hidden>
    <article class="pt-surface seo-card media-summary">
      <div>
        <span class="seo-badge" data-job-state></span>
        <h2 data-job-title></h2>
        <p data-job-meta></p>
      </div>
      <dl>
        <div><dt>Gefunden</dt><dd data-found>0</dd></div>
        <div><dt>Automatisch passend</dt><dd data-accepted>0</dd></div>
        <div><dt>Manuell freigegeben</dt><dd data-manual>0</dd></div>
        <div><dt>Ziele gewählt</dt><dd data-selected>0</dd></div>
      </dl>
    </article>

    <section class="pt-surface seo-card media-candidates">
      <header>
        <div>
          <h2>Bildprüfung und Zuordnung</h2>
          <p>
            Eine Ablehnung ist kein endgültiges Verbot. Bei heruntergeladenen Bildern kannst du
            die Warnung bewusst überstimmen. Der automatische Score und dein manueller Entscheid
            bleiben im Audit erhalten.
          </p>
        </div>
      </header>
      <div data-candidates></div>
    </section>

    <section class="pt-surface seo-card media-targets">
      <header>
        <div>
          <h2>Zieldateien im Produktordner</h2>
          <p data-target-path></p>
        </div>
        <span class="media-legend"><b>Neu</b> wird angelegt · <b>Überschreiben</b> ersetzt nur diese Datei</span>
      </header>
      <div data-variants></div>
      <div class="media-actions">
        <button type="button" data-build disabled>Ausgewählte WebP-Dateien bauen</button>
        <button type="button" data-approve disabled>Auswahl veröffentlichen</button>
      </div>
    </section>
  </section>

  <section class="pt-surface seo-card media-history">
    <header>
      <div>
        <h2>Letzte Medien-Jobs</h2>
        <p>
          {audit.summary.jobs} Jobs · {audit.summary.approved} veröffentlicht · {audit.summary.manuallyApprovedImages} manuell freigegebene Bilder.
        </p>
      </div>
    </header>
    {audit.jobs.length ? (
      <div class="media-history-list">
        {audit.jobs.map((job) => (
          <article>
            <div>
              <strong>{job.product?.title || job.product?.slug || job.id}</strong>
              <span>{job.product?.slug}</span>
            </div>
            <span class="seo-badge">{job.status}</span>
            <small>{new Intl.DateTimeFormat("de-DE", { dateStyle: "medium", timeStyle: "short" }).format(new Date(job.updatedAt))}</small>
            <button type="button" class="secondary" data-open-job={job.id}>Öffnen</button>
          </article>
        ))}
      </div>
    ) : <p>Noch keine Medien-Jobs vorhanden.</p>}
  </section>
</SeoAdminLayout>

<script>
  type MediaJob = Record<string, any>;

  const configNode = document.querySelector<HTMLScriptElement>("[data-media-config]");
  const config = JSON.parse(configNode?.textContent || "{}");
  const api = String(config.serviceUrl || "http://127.0.0.1:4178").replace(/\/$/, "");
  const status = document.querySelector<HTMLElement>("[data-media-status]");
  const workspace = document.querySelector<HTMLElement>("[data-media-workspace]");
  let currentJob: MediaJob | null = null;

  const stateLabels: Record<string, string> = {
    evaluated: "geprüft",
    selected: "Auswahl offen",
    uploaded: "Upload vorhanden",
    built: "bereit zur Veröffentlichung",
    approved: "veröffentlicht"
  };

  const setStatus = (message: string, level: "normal" | "error" = "normal") => {
    if (!status) return;
    status.textContent = message;
    status.dataset.level = level;
  };

  const request = async (path: string, method = "GET", body?: unknown) => {
    const response = await fetch(`${api}${path}`, {
      method,
      cache: "no-store",
      headers: body ? { "content-type": "application/json" } : undefined,
      body: body ? JSON.stringify(body) : undefined
    });
    const payload = await response.json().catch(() => ({}));
    if (!response.ok) throw new Error(payload?.error?.message || "Media-Center-Aktion fehlgeschlagen.");
    return payload;
  };

  const text = (selector: string, value: string) => {
    const node = document.querySelector<HTMLElement>(selector);
    if (node) node.textContent = value;
  };

  const fileUrl = (job: MediaJob, file: string) =>
    `${api}/api/admin/media/jobs/${job.id}/file?name=${encodeURIComponent(file)}`;

  const sourceLabel = (job: MediaJob, variant: string) => {
    const source = job.variantSources?.[variant];
    if (!source) return "Keine Änderung gewählt";
    if (source.type === "upload") return `Eigener Upload: ${job.uploads?.[variant]?.fileName || "Bild"}`;
    if (source.type === "derived-hero") return "Wird aus dem gewählten Hero-Bild abgeleitet";
    if (source.type === "candidate") {
      const candidate = job.candidates?.find((item: any) => item.candidateId === source.candidateId);
      return `Referenzbild ${candidate?.candidateId || source.candidateId}${source.manualOverride ? " · manuell freigegeben" : ""}`;
    }
    return "Unbekannte Quelle";
  };

  const renderCandidates = (job: MediaJob) => {
    const container = document.querySelector<HTMLElement>("[data-candidates]");
    if (!container) return;
    container.replaceChildren(...job.candidates.map((item: any) => {
      const article = document.createElement("article");
      article.dataset.candidateId = item.candidateId;
      article.dataset.state = item.manualDecision === "approved" ? "manual" : item.automaticStatus;

      const preview = document.createElement("div");
      preview.className = "media-preview";
      if (item.file) {
        const image = document.createElement("img");
        image.src = fileUrl(job, item.file);
        image.alt = `Referenzbild ${item.candidateId}`;
        image.loading = "lazy";
        preview.append(image);
      } else {
        const placeholder = document.createElement("span");
        placeholder.className = "media-placeholder";
        placeholder.textContent = "Nicht heruntergeladen";
        preview.append(placeholder);
      }

      const body = document.createElement("div");
      body.className = "media-candidate-body";
      const top = document.createElement("div");
      top.className = "media-candidate-top";
      const badge = document.createElement("span");
      badge.className = "seo-badge";
      badge.dataset.level = item.automaticStatus === "accepted" ? "low" : "high";
      badge.textContent = item.automaticStatus === "accepted" ? "automatisch passend" : "automatische Warnung";
      const score = document.createElement("strong");
      score.textContent = `${item.score ?? "–"}/100`;
      top.append(badge, score);

      const heading = document.createElement("h3");
      heading.textContent = `${item.kind || "Bild"} · ${item.candidateId}`;
      const reasons = document.createElement("p");
      reasons.textContent = (item.reasons || []).join(" · ") || "Keine Beanstandung";

      const selected = document.createElement("p");
      selected.className = "media-selected-note";
      selected.textContent = item.selectedFor?.length
        ? `Verwendet für: ${item.selectedFor.map((variant: string) => job.variants?.[variant]?.fileName || variant).join(", ")}`
        : "Noch keiner Zieldatei zugeordnet.";

      const controls = document.createElement("div");
      controls.className = "media-candidate-controls";

      if (item.file && item.automaticStatus !== "accepted") {
        const reason = document.createElement("input");
        reason.type = "text";
        reason.maxLength = 240;
        reason.dataset.manualReason = "";
        reason.placeholder = "Optionaler Grund für die manuelle Freigabe";
        reason.value = item.manualReason || "";
        const manual = document.createElement("button");
        manual.type = "button";
        manual.className = item.manualDecision === "approved" ? "secondary" : "warning";
        manual.dataset.manualReview = item.candidateId;
        manual.dataset.approved = item.manualDecision === "approved" ? "true" : "false";
        manual.textContent = item.manualDecision === "approved" ? "Manuelle Freigabe zurücknehmen" : "Trotz Warnung freigeben";
        controls.append(reason, manual);
      }

      if (item.file) {
        const assignment = document.createElement("div");
        assignment.className = "media-assignment";
        const select = document.createElement("select");
        select.dataset.candidateTarget = "";
        for (const [variant, details] of Object.entries(job.variants || {})) {
          const option = document.createElement("option");
          option.value = variant;
          option.textContent = String((details as any).fileName || variant);
          select.append(option);
        }
        const assign = document.createElement("button");
        assign.type = "button";
        assign.dataset.assignCandidate = item.candidateId;
        assign.disabled = !item.canUse;
        assign.textContent = "Als Zieldatei verwenden";
        assignment.append(select, assign);
        controls.append(assignment);
      } else {
        const note = document.createElement("small");
        note.textContent = "Ohne lokale Bilddatei ist keine manuelle Freigabe oder Veröffentlichung möglich.";
        controls.append(note);
      }

      body.append(top, heading, reasons, selected, controls);
      article.append(preview, body);
      return article;
    }));
  };

  const renderTargets = (job: MediaJob) => {
    const container = document.querySelector<HTMLElement>("[data-variants]");
    if (!container) return;
    text("[data-target-path]", `Ziel: apps/pfotentechnik/src/assets/images/products/${job.product.slug}/`);

    container.replaceChildren(...job.targetPlan.map((plan: any) => {
      const variant = plan.variant;
      const card = document.createElement("article");
      card.dataset.variant = variant;

      const header = document.createElement("header");
      const title = document.createElement("div");
      const heading = document.createElement("h3");
      heading.textContent = plan.fileName;
      const dimensions = document.createElement("small");
      dimensions.textContent = `${job.variants?.[variant]?.width || ""} × ${job.variants?.[variant]?.height || ""} px`;
      title.append(heading, dimensions);
      const state = document.createElement("span");
      state.className = "media-target-state";
      state.dataset.action = plan.action;
      state.textContent = plan.action === "overwrite"
        ? "wird überschrieben"
        : plan.action === "create"
          ? "wird neu angelegt"
          : plan.exists
            ? "bleibt unverändert"
            : "noch nicht vorhanden";
      header.append(title, state);

      const source = document.createElement("p");
      source.className = "media-source";
      source.textContent = sourceLabel(job, variant);

      const preview = document.createElement("div");
      preview.className = "media-output-preview";
      const output = job.outputs?.[variant];
      if (output?.file) {
        const image = document.createElement("img");
        image.src = fileUrl(job, output.file);
        image.alt = `Gebautes Bild ${plan.fileName}`;
        preview.append(image);
      } else {
        preview.textContent = plan.exists ? "Bestehende Datei bleibt bestehen" : "Noch keine Ausgabe gebaut";
      }

      const prompt = document.createElement("details");
      const promptSummary = document.createElement("summary");
      promptSummary.textContent = "Generierungs-Prompt";
      const textarea = document.createElement("textarea");
      textarea.readOnly = true;
      textarea.rows = 5;
      textarea.value = String(job.prompts?.[variant] || "");
      const copy = document.createElement("button");
      copy.type = "button";
      copy.className = "secondary compact";
      copy.dataset.copyPrompt = variant;
      copy.textContent = "Prompt kopieren";
      prompt.append(promptSummary, textarea, copy);

      const uploadLabel = document.createElement("label");
      uploadLabel.append("Eigenes oder generiertes Bild hochladen");
      const upload = document.createElement("input");
      upload.type = "file";
      upload.accept = "image/png,image/jpeg,image/webp,image/avif";
      upload.dataset.upload = variant;
      uploadLabel.append(upload);

      const actions = document.createElement("div");
      actions.className = "media-target-actions";
      if (job.uploads?.[variant] && job.variantSources?.[variant]?.type !== "upload") {
        const useUpload = document.createElement("button");
        useUpload.type = "button";
        useUpload.className = "secondary";
        useUpload.dataset.useUpload = variant;
        useUpload.textContent = "Vorhandenen Upload verwenden";
        actions.append(useUpload);
      }
      if (["thumbnail", "comparison"].includes(variant)) {
        const derive = document.createElement("button");
        derive.type = "button";
        derive.className = "secondary";
        derive.dataset.deriveHero = variant;
        derive.textContent = "Aus Hero ableiten";
        actions.append(derive);
      }
      if (job.variantSources?.[variant]) {
        const clear = document.createElement("button");
        clear.type = "button";
        clear.className = "secondary";
        clear.dataset.clearVariant = variant;
        clear.textContent = "Keine Änderung";
        actions.append(clear);
      }

      card.append(header, source, preview, prompt, uploadLabel, actions);
      return card;
    }));
  };

  const render = (job: MediaJob) => {
    currentJob = job;
    if (workspace) workspace.hidden = false;
    text("[data-job-state]", stateLabels[job.status] || job.status);
    text("[data-job-title]", job.product.title);
    text("[data-job-meta]", `${job.product.manufacturer} · ${job.product.slug}`);
    text("[data-found]", String(job.summary.found || 0));
    text("[data-accepted]", String(job.summary.accepted || 0));
    text("[data-manual]", String(job.summary.manuallyApproved || 0));
    text("[data-selected]", String(job.summary.selected || 0));
    renderCandidates(job);
    renderTargets(job);
    const build = document.querySelector<HTMLButtonElement>("[data-build]");
    const approve = document.querySelector<HTMLButtonElement>("[data-approve]");
    if (build) build.disabled = !Object.keys(job.variantSources || {}).length;
    if (approve) approve.disabled = job.status !== "built" || !Object.keys(job.outputs || {}).length;
    workspace?.scrollIntoView({ behavior: "smooth", block: "start" });
  };

  const run = async (message: string, task: () => Promise<MediaJob>, success: string) => {
    setStatus(message);
    try {
      const job = await task();
      render(job);
      setStatus(success);
    } catch (error) {
      setStatus(error instanceof Error ? error.message : String(error), "error");
    }
  };

  document.querySelector<HTMLFormElement>("[data-media-import]")?.addEventListener("submit", (event) => {
    event.preventDefault();
    const form = event.currentTarget;
    const data = new FormData(form);
    void run(
      "Quelle wird gelesen, gefiltert und bewertet …",
      () => request("/api/admin/media/jobs", "POST", { url: data.get("url"), slug: data.get("slug") || undefined }),
      "Analyse abgeschlossen. Wähle jetzt Bilder und konkrete Zieldateien."
    );
  });

  document.addEventListener("click", (event) => {
    const target = event.target as HTMLElement;
    const open = target.closest<HTMLButtonElement>("[data-open-job]");
    if (open) {
      void run("Medien-Job wird geöffnet …", () => request(`/api/admin/media/jobs/${open.dataset.openJob}`), "Medien-Job geöffnet.");
      return;
    }

    const copy = target.closest<HTMLButtonElement>("[data-copy-prompt]");
    if (copy && currentJob) {
      void navigator.clipboard.writeText(currentJob.prompts?.[copy.dataset.copyPrompt || ""] || "");
      copy.textContent = "Kopiert";
      window.setTimeout(() => { copy.textContent = "Prompt kopieren"; }, 1200);
      return;
    }

    const manual = target.closest<HTMLButtonElement>("[data-manual-review]");
    if (manual && currentJob) {
      const article = manual.closest<HTMLElement>("[data-candidate-id]");
      const reason = article?.querySelector<HTMLInputElement>("[data-manual-reason]")?.value || "";
      const approved = manual.dataset.approved !== "true";
      void run(
        approved ? "Manuelle Freigabe wird dokumentiert …" : "Manuelle Freigabe wird zurückgenommen …",
        () => request(`/api/admin/media/jobs/${currentJob!.id}/review`, "POST", {
          candidateId: manual.dataset.manualReview,
          approved,
          reason
        }),
        approved ? "Bild wurde manuell freigegeben. Der automatische Warnhinweis bleibt sichtbar." : "Manuelle Freigabe wurde zurückgenommen."
      );
      return;
    }

    const assign = target.closest<HTMLButtonElement>("[data-assign-candidate]");
    if (assign && currentJob) {
      const article = assign.closest<HTMLElement>("[data-candidate-id]");
      const variant = article?.querySelector<HTMLSelectElement>("[data-candidate-target]")?.value;
      if (!variant) return;
      void run(
        `${currentJob.variants?.[variant]?.fileName || variant} wird zugeordnet …`,
        () => request(`/api/admin/media/jobs/${currentJob!.id}/select`, "POST", {
          variant,
          sourceType: "candidate",
          candidateId: assign.dataset.assignCandidate
        }),
        `${currentJob.variants?.[variant]?.fileName || variant} wurde als Ziel gewählt.`
      );
      return;
    }

    const derive = target.closest<HTMLButtonElement>("[data-derive-hero]");
    if (derive && currentJob) {
      const variant = derive.dataset.deriveHero || "";
      void run(
        "Ableitung aus dem Hero wird gewählt …",
        () => request(`/api/admin/media/jobs/${currentJob!.id}/select`, "POST", { variant, sourceType: "derived-hero" }),
        `${currentJob.variants?.[variant]?.fileName || variant} wird aus dem Hero-Bild erzeugt.`
      );
      return;
    }

    const useUpload = target.closest<HTMLButtonElement>("[data-use-upload]");
    if (useUpload && currentJob) {
      const variant = useUpload.dataset.useUpload || "";
      void run(
        "Upload wird als Quelle gewählt …",
        () => request(`/api/admin/media/jobs/${currentJob!.id}/select`, "POST", { variant, sourceType: "upload" }),
        "Upload wurde als Quelle gewählt."
      );
      return;
    }

    const clear = target.closest<HTMLButtonElement>("[data-clear-variant]");
    if (clear && currentJob) {
      const variant = clear.dataset.clearVariant || "";
      void run(
        "Zielauswahl wird entfernt …",
        () => request(`/api/admin/media/jobs/${currentJob!.id}/select`, "POST", { variant, sourceType: "none" }),
        `${currentJob.variants?.[variant]?.fileName || variant} bleibt unverändert.`
      );
      return;
    }

    if (target.closest("[data-build]") && currentJob) {
      void run(
        "Ausgewählte WebP-Dateien werden erzeugt …",
        () => request(`/api/admin/media/jobs/${currentJob!.id}/build`, "POST", {}),
        "WebP-Dateien wurden gebaut. Prüfe die Vorschau und die Angaben ‚neu‘ oder ‚überschreiben‘."
      );
      return;
    }

    if (target.closest("[data-approve]") && currentJob) {
      const changes = (currentJob.targetPlan || [])
        .filter((entry: any) => entry.selected)
        .map((entry: any) => `${entry.fileName}: ${entry.action === "overwrite" ? "überschreiben" : "neu anlegen"}`)
        .join("\n");
      if (!window.confirm(`Diese Dateien werden veröffentlicht:\n\n${changes}\n\nAndere Dateien im Produktordner bleiben erhalten.`)) return;
      void run(
        "Ausgewählte Dateien und der Markdown-images-Block werden atomar aktualisiert …",
        () => request(`/api/admin/media/jobs/${currentJob!.id}/approve`, "POST", {}),
        "Veröffentlicht. Nur die ausgewählten Dateien wurden angelegt oder überschrieben; übrige Produktbilder blieben erhalten."
      );
    }
  });

  document.addEventListener("change", (event) => {
    const input = (event.target as HTMLElement).closest<HTMLInputElement>("[data-upload]");
    if (!input?.files?.[0] || !currentJob) return;
    const file = input.files[0];
    const variant = input.dataset.upload || "";
    void run(
      `${currentJob.variants?.[variant]?.fileName || variant} wird hochgeladen …`,
      async () => {
        const dataBase64 = await new Promise<string>((resolve, reject) => {
          const reader = new FileReader();
          reader.onload = () => resolve(String(reader.result).split(",")[1] || "");
          reader.onerror = () => reject(reader.error);
          reader.readAsDataURL(file);
        });
        return request(`/api/admin/media/jobs/${currentJob!.id}/upload`, "POST", {
          variant,
          fileName: file.name,
          mimeType: file.type,
          dataBase64
        });
      },
      `${currentJob.variants?.[variant]?.fileName || variant} wurde hochgeladen und als Quelle ausgewählt.`
    );
  });
</script>

<style>
  .media-intake {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 28px;
    padding: 24px;
  }
  .media-intake h2 { margin: 9px 0 7px; }
  .media-intake p { margin: 0; color: var(--seo-muted); line-height: 1.55; }
  .media-intake form { display: grid; gap: 12px; }
  .media-intake label,
  .media-targets label {
    display: grid;
    gap: 6px;
    color: var(--seo-muted);
    font-size: .84rem;
    font-weight: 750;
  }
  .media-intake input,
  .media-targets input,
  .media-targets textarea,
  .media-candidate-controls input,
  .media-candidate-controls select {
    width: 100%;
    min-height: 42px;
    border: 1px solid var(--seo-border);
    border-radius: 11px;
    padding: 10px 11px;
    background: var(--seo-surface);
    color: var(--seo-text);
  }
  button {
    min-height: 40px;
    border: 0;
    border-radius: 11px;
    padding: 9px 13px;
    background: var(--seo-accent);
    color: var(--seo-on-accent);
    font-weight: 850;
    cursor: pointer;
  }
  button.secondary {
    border: 1px solid var(--seo-border);
    background: var(--seo-surface);
    color: var(--seo-text);
  }
  button.warning { background: var(--seo-warning); color: #17130a; }
  button.compact { min-height: 34px; padding: 6px 10px; }
  button:disabled { opacity: .45; cursor: not-allowed; }
  .media-status { min-height: 25px; margin: 13px 2px; color: var(--seo-muted); }
  .media-status[data-level="error"] { color: var(--seo-danger); font-weight: 800; }
