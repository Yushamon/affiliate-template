---
interface Props {
  items: Array<{ step: string; title: string; text: string }>;
}

const { items } = Astro.props;
---

<section class="timeline" aria-labelledby="timeline-title">
  <header>
    <span>Alltag statt Datenblatt</span>
    <h2 id="timeline-title">So sieht der Alltag mit diesem Produkt aus</h2>
  </header>
  <ol>
    {items.map((item) => (
      <li>
        <b aria-hidden="true">{item.step}</b>
        <div><h3>{item.title}</h3><p>{item.text}</p></div>
      </li>
    ))}
  </ol>
</section>

<style>
  .timeline {
    padding: clamp(28px, 5vw, 52px) 0;
    border-top: 1px solid var(--px2-border);
    background: var(--px2-surface);
  }

  header span {
    color: var(--px2-green-strong);
    font-size: .78rem;
    font-weight: 850;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  h2 {
    margin: 7px 0 26px;
    font-size: clamp(1.55rem, 4vw, 2.25rem);
    letter-spacing: -.025em;
  }

  ol {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    display: grid;
    min-width: 0;
    grid-template-columns: auto 1fr;
    gap: 12px;
    padding: 0 20px;
  }

  li:first-child { padding-left: 0; }
  li:last-child { padding-right: 0; }
  li + li { border-left: 1px solid var(--px2-border); }

  b {
    color: var(--px2-green-strong);
    font-size: .75rem;
    line-height: 1.4;
  }

  h3 {
    margin: 0 0 7px;
    font-size: 1rem;
  }

  p {
    margin: 0;
    color: var(--px2-muted);
    font-size: .92rem;
    line-height: 1.55;
  }

  @media (max-width: 900px) {
    ol { grid-template-columns: 1fr 1fr; }
    li { padding: 18px 18px 18px 0; border-top: 1px solid var(--px2-border); }
    li + li { border-left: 0; }
    li:nth-child(even) { padding-left: 18px; }
  }

  @media (max-width: 560px) {
    .timeline { padding: 30px 0; }
    ol { grid-template-columns: 1fr; }
    li,
    li:nth-child(even) { padding: 17px 0; }
  }
</style>
