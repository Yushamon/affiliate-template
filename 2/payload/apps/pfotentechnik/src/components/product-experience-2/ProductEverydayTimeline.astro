---
interface Props { items: Array<{ step: string; title: string; text: string }> }
const { items } = Astro.props;
---
<section class="timeline" aria-labelledby="timeline-title">
  <header><span>Alltag statt Datenblatt</span><h2 id="timeline-title">So sieht der Alltag mit diesem Produkt aus</h2></header>
  <ol>
    {items.map((item) => <li><b aria-hidden="true">{item.step}</b><div><h3>{item.title}</h3><p>{item.text}</p></div></li>)}
  </ol>
</section>
<style>
  .timeline{padding:clamp(20px,4vw,34px);border:1px solid var(--px2-border);border-radius:24px;background:var(--px2-surface);box-shadow:var(--px2-shadow)}
  header span{color:var(--px2-green-strong);font-size:.78rem;font-weight:850;letter-spacing:.08em;text-transform:uppercase}
  h2{margin:7px 0 22px;font-size:clamp(1.55rem,4vw,2.25rem);letter-spacing:-.025em}
  ol{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:0;margin:0;padding:0;list-style:none}
  li{position:relative;display:grid;grid-template-columns:auto 1fr;gap:12px;min-width:0;padding:0 18px 0 0}
  li:not(:last-child)::after{content:"";position:absolute;top:17px;right:4px;width:10px;height:10px;border-top:2px solid var(--px2-border);border-right:2px solid var(--px2-border);transform:rotate(45deg)}
  b{display:grid;place-items:center;width:36px;height:36px;border-radius:50%;background:var(--px2-green-soft);color:var(--px2-green-strong);font-size:.78rem}
  h3{margin:2px 0 7px;font-size:1rem}
  p{margin:0;color:var(--px2-muted);font-size:.92rem;line-height:1.55}
  @media(max-width:900px){ol{grid-template-columns:1fr 1fr;gap:20px}li::after{display:none}}
  @media(max-width:560px){.timeline{padding:18px;border-radius:20px}ol{grid-template-columns:1fr}li{padding:0}}
</style>
