---
import type { ProductExperienceModel } from "../../domain/productExperience/model";
import ProductHero2 from "./ProductHero2.astro";
import ProductDecisionAssistant from "./ProductDecisionAssistant.astro";
import ProductEverydayTimeline from "./ProductEverydayTimeline.astro";
import ProductAlternatives2 from "./ProductAlternatives2.astro";
import ProductTrust2 from "./ProductTrust2.astro";
import ProductDetails2 from "./ProductDetails2.astro";

interface Props {
  model: ProductExperienceModel;
}

const { model } = Astro.props;
---

<article class="px2" data-product-experience="2.0" data-product-layout="cards-restored">
  <ProductHero2 model={model} />
  <ProductDecisionAssistant
    profile={model.decisionProfile}
    alternatives={model.alternatives}
  />
  <ProductEverydayTimeline items={model.timeline} />
  <ProductDetails2 model={model} />
  <ProductAlternatives2 alternatives={model.alternatives} />
  <ProductTrust2 cards={model.trustCards} updatedAt={model.updatedAt} />
</article>

<style>
  .px2 {
    --px2-surface: #fff;
    --px2-surface-soft: #f3f7f4;
    --px2-surface-raised: #f8fbf8;
    --px2-text: #17211b;
    --px2-muted: #5d6d63;
    --px2-border: #d6e2da;
    --px2-green: #2e7d32;
    --px2-green-strong: #1f6426;
    --px2-green-soft: #e2f3e5;
    --px2-amber: #9a6700;
    --px2-amber-soft: #fff4d8;
    --px2-red: #b52d25;
    --px2-red-soft: #fee9e7;
    --px2-indigo: #4f46e5;
    --px2-shadow: 0 18px 50px rgba(31, 64, 39, .09);
    --px2-on-accent: #fff;
    display: grid;
    gap: clamp(22px, 4vw, 42px);
    width: 100%;
    min-width: 0;
    color: var(--px2-text);
  }

  :global(html[data-theme="dark"]) .px2,
  :global(html.dark) .px2,
  :global(body[data-theme="dark"]) .px2 {
    color-scheme: dark;
    --px2-surface: #101b16;
    --px2-surface-soft: #18271f;
    --px2-surface-raised: #142119;
    --px2-text: #eef7f0;
    --px2-muted: #b5c4ba;
    --px2-border: #304137;
    --px2-green: #72d889;
    --px2-green-strong: #92e8a5;
    --px2-green-soft: #183b23;
    --px2-amber: #ffd27a;
    --px2-amber-soft: #3b2d13;
    --px2-red: #ffaaa2;
    --px2-red-soft: #43201f;
    --px2-indigo: #a5b4fc;
    --px2-shadow: none;
    --px2-on-accent: #07120a;
  }

  .px2 :global(*) { box-sizing: border-box; }

  .px2 :global(h2),
  .px2 :global(h3),
  .px2 :global(p),
  .px2 :global(ul),
  .px2 :global(dl) {
    margin-top: 0;
  }

  @media (max-width: 720px) {
    .px2 { gap: 20px; }
  }
</style>
