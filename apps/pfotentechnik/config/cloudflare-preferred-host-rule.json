{
  "ref": "pfotentechnik_preferred_host_34_8",
  "description": "PfotenTechnik: www to HTTPS apex, preserve path and query",
  "expression": "(http.host eq \"www.pfotentechnik.de\")",
  "action": "redirect",
  "action_parameters": {
    "from_value": {
      "status_code": 301,
      "target_url": {
        "expression": "concat(\"https://pfotentechnik.de\", http.request.uri.path)"
      },
      "preserve_query_string": true
    }
  },
  "enabled": true
}
