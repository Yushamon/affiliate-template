---
import ArticleMeta from "@affiliate-core/components/ArticleMeta.astro";
import TableOfContents from "@affiliate-core/components/TableOfContents.astro";
import OptimizedImage from "@affiliate-core/components/OptimizedImage.astro";
import FoundationDisclosure from "../foundation/FoundationDisclosure.astro";
import FoundationProductMini from "../foundation/FoundationProductMini.astro";
import type { GuideExperienceModel } from "../../domain/guideExperience/model";

interface Props {
  model: GuideExperienceModel;
  headings: any[];
  author: any;
  publishedAt: Date | string;
  updatedAt: Date | string;
  readingTimeMinutes: number;
}
const { model, headings, author, publishedAt, updatedAt, readingTimeMinutes } = Astro.props;
---

<div class="pt-guide" data-guide-experience="34.3" data-guide-kind={model.kind} data-guide={model.slug}>
  <header class:list={["pt-guide__hero", { "pt-guide__hero--text": !model.heroImage }]}>
    <div class="pt-guide__hero-copy">
      <p class="pt-guide__eyebrow pt-eyebrow">{model.eyebrow}</p>
      <h1>{model.title}</h1>
      <p class="pt-guide__answer">{model.answer || model.description}</p>
      <ArticleMeta author={author} publishedAt={publishedAt} updatedAt={updatedAt} readingTimeMinutes={readingTimeMinutes} />
      <a class="pt-guide__hero-action" href="#guide-main">{model.actionLabel} <span aria-hidden="true">↓</span></a>
    </div>
    {model.heroImage && (
      <figure class="pt-guide__hero-media">
        <OptimizedImage src={model.heroImage.src} alt={model.heroImage.alt ?? model.title} width={880} height={660} layout="constrained" priority loading="eager" />
      </figure>
    )}
  </header>

  {model.quickItems.length > 0 && (
    <section class="pt-guide__summary" aria-labelledby="guide-summary-title">
      <header class="pt-section-header"><p class="pt-guide__eyebrow pt-eyebrow">Direkte Orientierung</p><h2 id="guide-summary-title">{model.summaryTitle}</h2></header>
      <ol>{model.quickItems.map((item, index) => <li><span>{String(index + 1).padStart(2, "0")}</span><p>{item}</p></li>)}</ol>
    </section>
  )}

  <section id="guide-main" class="pt-guide__longform" aria-label="Ratgeber">
    <div class="pt-guide__reading pt-decision-axis">
      {headings.length > 1 && <aside class="pt-guide__toc"><TableOfContents headings={headings} /></aside>}
      <article class="pt-guide__prose pt-reading-prose article-content">
        <slot />
      </article>
    </div>
  </section>

  {model.selectedProducts.length > 0 && (
    <section class="pt-guide__products" aria-labelledby="guide-products-title">
      <header class="pt-section-header"><p class="pt-guide__eyebrow pt-eyebrow">Passende Modelle</p><h2 id="guide-products-title">Passende Modelle für diesen Entscheidungsfall</h2></header>
      <div class="pt-product-mini-list">
        {model.selectedProducts.map((product) => (
          <FoundationProductMini
            href={product.href}
            title={product.title}
            manufacturer={product.manufacturer}
            image={product.image}
            rationale={product.role}
            description={product.recommendation}
            score={product.score}
          />
        ))}
      </div>
    </section>
  )}

  {model.supportingBlocks.length > 0 && (
    <section class="pt-guide__depth" aria-labelledby="guide-depth-title">
      <header class="pt-section-header"><p class="pt-guide__eyebrow pt-eyebrow">Mehr zum Thema</p><h2 id="guide-depth-title">Zusätzliche Entscheidungshilfen</h2><p>Öffne die Punkte, bei denen du mehr Details brauchst.</p></header>
      <div class="pt-disclosure-list">
        {model.supportingBlocks.map((block) => (
          <FoundationDisclosure summary={block.title}>
            {block.text && <p>{block.text}</p>}
            {block.items.length > 0 && <ul>{block.items.map((item) => <li>{item}</li>)}</ul>}
            {block.cards.length > 0 && <dl>{block.cards.map((card) => <div><dt>{card.href ? <a href={card.href}>{card.title}</a> : card.title}</dt>{card.text && <dd>{card.text}</dd>}</div>)}</dl>}
          </FoundationDisclosure>
        ))}
      </div>
    </section>
  )}

  <slot name="after-content" />
  <slot name="faq" />

  {model.nextSteps.length > 0 && (
    <section class="pt-guide__next" aria-labelledby="guide-next-title">
      <header class="pt-section-header"><p class="pt-guide__eyebrow pt-eyebrow">Nächste Schritte</p><h2 id="guide-next-title">Was ist jetzt der sinnvolle nächste Schritt?</h2><p>Nutze den Weg, der am besten zu deiner nächsten Frage passt.</p></header>
      <nav aria-label="Kontextuelle nächste Schritte">
        {model.nextSteps.map((step, index) => (
          <a href={step.href}><span>{String(index + 1).padStart(2, "0")}</span><div><small>{step.eyebrow}</small><strong>{step.title}</strong><p>{step.text}</p></div><b>{step.label} <span aria-hidden="true">→</span></b></a>
        ))}
      </nav>
    </section>
  )}
</div>

<style>
  .pt-guide { display: grid; gap: clamp(3.5rem, 8vw, 7rem); min-width: 0; padding-bottom: clamp(3rem, 7vw, 6rem); color: var(--pt-color-text); }
  .pt-guide * { box-sizing: border-box; }
  .pt-guide__hero { display: grid; grid-template-columns: minmax(0, 1.08fr) minmax(300px, .92fr); min-width: 0; overflow: hidden; border-block: 1px solid var(--pt-color-border); }
  .pt-guide__hero--text { grid-template-columns: minmax(0, 58rem); }
  .pt-guide__hero-copy { display: grid; align-content: center; gap: 1rem; min-width: 0; padding: clamp(2rem, 6vw, 5rem) clamp(0rem, 4vw, 3.5rem) clamp(2rem, 6vw, 5rem) 0; }
  .pt-guide__hero h1 { max-width: 18ch; margin: 0; font-size: clamp(2.75rem, 6.5vw, 5.5rem); line-height: .96; letter-spacing: -.055em; text-wrap: balance; overflow-wrap: anywhere; }
  .pt-guide__answer { max-width: 66ch; margin: 0; color: var(--pt-color-text-muted); font-size: clamp(1.05rem, 1.8vw, 1.22rem); line-height: 1.65; }
  .pt-guide__hero-action { display: inline-flex; width: fit-content; min-height: 44px; margin-top: .35rem; align-items: center; color: var(--pt-color-primary); font-weight: 850; text-decoration: none; }
  .pt-guide__hero-media { display: grid; min-width: 0; margin: 0; place-items: center; overflow: hidden; background: var(--pt-color-surface-soft); }
  .pt-guide__hero-media :global(picture), .pt-guide__hero-media :global(img) { display: block; width: 100%; height: 100%; }
  .pt-guide__hero-media :global(img) { object-fit: cover; }
  .pt-guide__summary { display: grid; grid-template-columns: minmax(12rem, .35fr) minmax(0, 1fr); gap: clamp(1.5rem, 5vw, 4rem); padding-block: clamp(1.5rem, 3vw, 2.5rem); border-block: 1px solid var(--pt-color-border); }
  .pt-guide__summary ol { display: grid; margin: 0; padding: 0; list-style: none; }
  .pt-guide__summary li { display: grid; grid-template-columns: 2.5rem minmax(0, 1fr); gap: 1rem; padding: .9rem 0; border-bottom: 1px solid var(--pt-color-border); }
  .pt-guide__summary li:first-child { padding-top: 0; }
  .pt-guide__summary li:last-child { padding-bottom: 0; border-bottom: 0; }
  .pt-guide__summary li > span { color: var(--pt-color-primary); font-weight: 850; }
  .pt-guide__summary li p { margin: 0; line-height: 1.55; }
  .pt-guide__products, .pt-guide__depth, .pt-guide__next { display: grid; gap: 1.5rem; }
  .pt-guide__next small { color: var(--pt-color-text-muted); font-size: .72rem; font-weight: 800; letter-spacing: .04em; text-transform: uppercase; }
  .pt-guide__longform { min-width: 0; padding-top: clamp(2rem, 5vw, 4rem); border-top: 1px solid var(--pt-color-border); }
  .pt-guide__reading { display: grid; grid-template-columns: minmax(12rem, 17rem) minmax(0, 48rem); gap: clamp(2rem, 6vw, 5rem); align-items: start; min-width: 0; }
  .pt-guide__toc { position: sticky; top: 6rem; min-width: 0; }
  .pt-guide__prose { min-width: 0; color: var(--pt-color-text); }
  .pt-guide__prose :global(> :first-child) { margin-top: 0; }
  .pt-guide__prose :global(h2) { margin: clamp(3rem, 7vw, 5rem) 0 1rem; font-size: clamp(1.8rem, 4vw, 2.8rem); line-height: 1.08; letter-spacing: -.04em; overflow-wrap: anywhere; text-wrap: balance; }
  .pt-guide__prose :global(h3) { margin: 2rem 0 .7rem; font-size: clamp(1.25rem, 2.5vw, 1.65rem); line-height: 1.2; overflow-wrap: anywhere; }
  .pt-guide__prose :global(p), .pt-guide__prose :global(li), .pt-guide__prose :global(td), .pt-guide__prose :global(th) { line-height: 1.72; }
  .pt-guide__prose :global(p), .pt-guide__prose :global(ul), .pt-guide__prose :global(ol) { max-width: 72ch; }
  .pt-guide__prose :global(a) { color: var(--pt-color-primary); text-underline-offset: .18em; }
  .pt-guide__prose :global(img) { display: block; max-width: 100%; height: auto; margin-block: 1.5rem; background: var(--pt-color-surface-soft); }
  .pt-guide__prose :global(details) { border-block: 1px solid var(--pt-color-border); }
  .pt-guide__depth dl { margin: 0 0 1.2rem; }
  .pt-guide__depth dl div { display: grid; grid-template-columns: minmax(10rem, .35fr) minmax(0, 1fr); gap: 1rem; padding: .8rem 0; border-top: 1px solid var(--pt-color-border); }
  .pt-guide__depth dt { font-weight: 800; }
  .pt-guide__depth dd { margin: 0; color: var(--pt-color-text-muted); }
  .pt-guide__next nav { display: grid; border-top: 1px solid var(--pt-color-border); }
  .pt-guide__next nav > a { display: grid; grid-template-columns: 2.5rem minmax(0, 1fr) auto; gap: 1rem; align-items: center; padding: 1.2rem 0; border-bottom: 1px solid var(--pt-color-border); color: inherit; text-decoration: none; }
  .pt-guide__next nav > a > span { color: var(--pt-color-primary); font-weight: 850; }
  .pt-guide__next nav div { display: grid; gap: .25rem; min-width: 0; }
  .pt-guide__next nav strong { font-size: 1.12rem; }
  .pt-guide__next nav p { margin: 0; color: var(--pt-color-text-muted); line-height: 1.5; }
  .pt-guide__next nav b { color: var(--pt-color-primary); font-size: .9rem; white-space: nowrap; }
  @media (max-width: 1100px) {
    .pt-guide__hero { grid-template-columns: 1fr; }
    .pt-guide__hero-copy { padding-right: 0; }
    .pt-guide__hero-media { max-height: 28rem; }
    .pt-guide__reading { grid-template-columns: minmax(0, 1fr); }
    .pt-guide__toc { position: static; }
  }
  @media (max-width: 600px) {
    .pt-guide { gap: 3.5rem; }
    .pt-guide__summary { grid-template-columns: 1fr; }
    .pt-guide__next nav > a { grid-template-columns: 2rem minmax(0, 1fr); }
    .pt-guide__next nav b { grid-column: 2; white-space: normal; }
    .pt-guide__depth dl div { grid-template-columns: 1fr; gap: .4rem; }
  }
</style>
