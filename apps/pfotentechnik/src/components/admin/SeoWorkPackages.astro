---
import { loadSeoWorkPackageData } from "../../lib/seo/advisor/loadWorkPackages";

interface Props {
  mode?: "advisor" | "prompts" | "tasks";
}
const { mode = "advisor" } = Astro.props;
const workPackageData = await loadSeoWorkPackageData();
const clientData = JSON.stringify({ mode, ...workPackageData })
  .replace(/</g, "\\u003c").replace(/\u2028/g, "\\u2028").replace(/\u2029/g, "\\u2029");
---
<section class="work-packages-shell" id={`seo-work-packages-${mode}`} data-work-package-mode={mode}>
  <div class="work-packages-heading">
    <div><span class="seo-eyebrow">Priorisierte Umsetzung</span><h2>Codex-Arbeitspakete</h2></div>
    <label>Zeitraum <select data-package-range></select></label>
  </div>
  <p class="work-packages-note">Fachlich zusammengehörige Befunde werden als ein begrenztes Codex-Paket geführt. Search-Wirkung wird erst nach dem vorgesehenen Zeitfenster und einem neuen Sync bewertet.</p>
  <div class="work-package-metrics" data-package-metrics></div>
  <div class="work-package-filters" data-package-filters>
    <label>Status <select data-filter="status"><option value="all">Alle</option><option value="open">Offen</option><option value="sent-to-codex">In Codex</option><option value="verification-pending">Prüfung läuft</option><option value="waiting-window">Wartet auf Nachmessung</option><option value="review-due">Nachmessung fällig</option><option value="needs-work">Nacharbeit</option><option value="verified">Verifiziert</option><option value="snoozed">Zurückgestellt</option></select></label>
    <label>Familie <select data-filter="family"><option value="all">Alle</option><option value="technical-structure">Technik & Struktur</option><option value="eeat-content-quality">EEAT & Qualität</option><option value="ranking-snippet">Ranking & Snippet</option><option value="search-intent-content-gap">Intent & Content Gap</option><option value="product-health">Product Health</option></select></label>
    <label>Priorität <select data-filter="priority"><option value="all">Alle</option><option value="high">Hoch</option><option value="medium">Mittel</option><option value="low">Niedrig</option></select></label>
    <label>Prüfmodus <select data-filter="verificationMode"><option value="all">Alle</option><option value="immediate">Sofort</option><option value="search-window">Search-Fenster</option><option value="manual">Manuell</option></select></label>
  </div>
  <div class="work-package-message" data-package-message aria-live="polite"></div>
  <div class="work-package-list" data-package-list></div>
  <details class="work-package-snoozed" data-snoozed-overview><summary>Zurückgestellt <span data-snoozed-count>0</span></summary><div data-snoozed-list></div></details>
  {mode === "prompts" && <details class="work-package-snoozed"><summary>Einzelaufgaben</summary><div class="work-package-list" data-individual-list></div></details>}
  {mode === "tasks" && <button class="work-package-export" type="button" data-package-export>Pakete ohne Secrets exportieren</button>}
  <script type="application/json" data-package-json set:html={clientData}></script>
</section>

<style>
  .work-packages-shell{margin-top:34px;padding:clamp(18px,3vw,28px);border:1px solid var(--seo-border);border-radius:20px;background:var(--seo-surface);box-shadow:var(--seo-shadow)}
  .work-packages-heading{display:flex;justify-content:space-between;gap:18px;align-items:end}.work-packages-heading h2{margin:5px 0 0;font-size:clamp(1.45rem,3vw,2rem)}
  .work-packages-heading label,.work-package-filters label{display:grid;gap:5px;color:var(--seo-muted);font-size:.78rem;font-weight:800}.work-packages-heading select,.work-package-filters select{min-height:42px;border:1px solid var(--seo-border);border-radius:11px;padding:8px 10px;background:var(--seo-surface);color:var(--seo-text)}
  .work-packages-note{max-width:980px;color:var(--seo-muted);line-height:1.55}.work-package-metrics{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:9px;margin:18px 0}.work-package-metric{padding:13px;border:1px solid var(--seo-border);border-radius:14px;background:var(--seo-surface-soft)}.work-package-metric strong{display:block;font-size:1.45rem}.work-package-metric span{color:var(--seo-muted);font-size:.75rem}
  .work-package-filters{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px;margin:14px 0}.work-package-list{display:grid;gap:13px}.work-package-card{padding:18px;border:1px solid var(--seo-border);border-radius:17px;background:var(--seo-surface)}.work-package-card[data-status="needs-work"]{border-color:var(--seo-danger)}.work-package-card[data-status="review-due"]{border-color:var(--seo-warning)}
  .work-package-top{display:grid;grid-template-columns:42px minmax(0,1fr) auto;gap:13px;align-items:start}.work-package-rank{display:grid;place-items:center;width:40px;height:40px;border-radius:12px;background:var(--seo-accent-soft);color:var(--seo-accent-strong);font-weight:900}.work-package-card h3{margin:4px 0 5px;font-size:1.13rem}.work-package-badges,.work-package-actions{display:flex;flex-wrap:wrap;gap:7px;align-items:center}.work-package-badge{display:inline-flex;padding:4px 8px;border-radius:999px;background:var(--seo-surface-soft);color:var(--seo-muted);font-size:.74rem;font-weight:800}.work-package-badge[data-level="high"]{background:var(--seo-danger-soft);color:var(--seo-danger)}.work-package-meta{margin:12px 0;color:var(--seo-muted);line-height:1.5}.work-package-actions button,.work-package-actions select,.work-package-export{min-height:40px;border:1px solid var(--seo-border);border-radius:999px;padding:8px 12px;background:var(--seo-surface);color:var(--seo-text);font-weight:800;cursor:pointer}.work-package-actions button[data-primary]{background:var(--seo-accent);color:var(--seo-on-accent);border-color:var(--seo-accent)}
  .work-package-task{padding:12px 0;border-top:1px solid var(--seo-border)}.work-package-task h4{margin:0 0 5px}.work-package-task p,.work-package-task li{color:var(--seo-muted);line-height:1.5}.work-package-task code{overflow-wrap:anywhere}.work-package-prompt{max-height:520px;overflow:auto;white-space:pre-wrap;padding:14px;border-radius:12px;background:var(--seo-surface-soft);color:var(--seo-text);font-size:.8rem}.work-package-message{min-height:22px;color:var(--seo-muted)}.work-package-message[data-state="error"]{color:var(--seo-danger)}.work-package-message[data-state="success"]{color:var(--seo-accent-strong)}.work-package-snoozed{margin-top:16px;padding:13px;border:1px solid var(--seo-border);border-radius:14px}.work-package-snoozed summary{cursor:pointer;font-weight:850}.work-package-export{margin-top:14px}.work-package-empty{padding:18px;border:1px dashed var(--seo-border);border-radius:14px;color:var(--seo-muted)}
  @media(max-width:960px){.work-package-metrics{grid-template-columns:repeat(3,1fr)}.work-package-filters{grid-template-columns:repeat(2,1fr)}}
  @media(max-width:620px){.work-packages-heading{display:grid}.work-package-metrics{grid-template-columns:repeat(2,1fr)}.work-package-filters{grid-template-columns:1fr}.work-package-top{grid-template-columns:38px 1fr}.work-package-top>.work-package-badges{grid-column:2}.work-package-actions button,.work-package-actions select{flex:1 1 auto}}
</style>

<script>
  const roots = document.querySelectorAll("[data-work-package-mode]");
  const API = "http://127.0.0.1:4178/api/admin/search";
  const statusLabel = {open:"Offen","sent-to-codex":"In Codex","verification-pending":"Prüfung läuft","waiting-window":"Wartet auf Nachmessung","review-due":"Nachmessung fällig","needs-work":"Nacharbeit erforderlich",verified:"Verifiziert",snoozed:"Zurückgestellt"};
  const familyLabel = {"technical-structure":"Technik & Struktur","eeat-content-quality":"EEAT & Qualität","ranking-snippet":"Ranking & Snippet","search-intent-content-gap":"Intent & Content Gap","product-health":"Product Health"};
  const node = (tag, text, className) => { const element=document.createElement(tag); if(text!==undefined) element.textContent=text; if(className) element.className=className; return element; };
  const fmtDate = (value) => value ? new Date(value).toLocaleDateString("de-DE") : "sofort";
  const redactString = (value) => String(value).replace(/(?:client_secret|refresh_token|access_token|api[_-]?key|authorization)\s*[:=]\s*\S+/gi,"[REDACTED]").replace(/\b(?:ghp|github_pat|sk)-[A-Za-z0-9_-]{12,}\b/g,"[REDACTED]");
  const safeExport = (value) => JSON.parse(JSON.stringify(value, (key, item) => /prompt|output|manifest/i.test(key) ? undefined : typeof item === "string" ? redactString(item) : item));
  const packagePayload = (pkg) => ({ id:pkg.id,title:pkg.title,rangeKey:pkg.rangeKey,family:pkg.family,priority:pkg.priority,impact:pkg.impact,confidence:pkg.confidence,effortValue:pkg.effortValue,effort:pkg.effort,verificationMode:pkg.verificationMode,verifyAfter:pkg.verifyAfter,taskIds:pkg.taskIds,affectedFiles:pkg.affectedFiles,tasks:pkg.tasks,validationCommands:pkg.validationCommands });
  const pollAction = async(id) => { for(let attempt=0;attempt<1440;attempt+=1){ await new Promise(resolve=>setTimeout(resolve,500)); const response=await fetch(`${API}/actions/${id}`); const action=await response.json(); if(["succeeded","failed","cancelled"].includes(action.status)) return action; } throw new Error("Die lokale Aktion hat das Zeitlimit überschritten."); };
  const runAction = async(root, action, payload) => {
    const message=root.querySelector("[data-package-message]"); message.dataset.state=""; message.textContent="Aktion wird gestartet …";
    const response=await fetch(`${API}/actions`,{method:"POST",headers:{"content-type":"application/json"},body:JSON.stringify({action,payload})});
    const start=await response.json(); if(!response.ok) throw new Error(start?.error?.message||"Aktion konnte nicht gestartet werden.");
    const result=await pollAction(start.id); if(result.status!=="succeeded") throw new Error(result?.error?.message||"Aktion ist fehlgeschlagen.");
    message.dataset.state="success"; message.textContent=result.result?.reason||"Aktion abgeschlossen. Daten werden neu geladen.";
    if(result.result?.reloadRequired) location.reload();
    return result.result;
  };
  roots.forEach((root) => {
    const data=JSON.parse(root.querySelector("[data-package-json]").textContent||"{}"); const mode=data.mode; let rangeKey=data.defaultRange; const filters={status:"all",family:"all",priority:"all",verificationMode:"all"};
    const rangeSelect=root.querySelector("[data-package-range]"); Object.entries(data.ranges).forEach(([key,value])=>{const option=node("option",value.label);option.value=key;option.selected=key===rangeKey;rangeSelect.append(option)});
    root.querySelectorAll("[data-filter]").forEach(select=>select.addEventListener("change",()=>{filters[select.dataset.filter]=select.value;render()})); rangeSelect.addEventListener("change",()=>{rangeKey=rangeSelect.value;render()});
    const suppressDuplicateCards = (packages) => { const hiddenTasks=packages.filter(pkg=>["sent-to-codex","verification-pending","waiting-window","review-due","snoozed","verified","needs-work"].includes(pkg.status)).flatMap(pkg=>pkg.tasks); document.querySelectorAll("#top-tasks article,#opportunities article,#quick-win-list .finding,#forecast-list .finding").forEach(card=>{const text=card.textContent||"";card.hidden=hiddenTasks.some(task=>(task.title&&text.includes(task.title))||(task.url&&text.includes(task.url))||(task.query&&text.includes(task.query)))}); };
    const button = (label, action, pkg, extra={}, primary=false) => { const item=node("button",label);item.type="button";if(primary)item.dataset.primary="";item.addEventListener("click",async()=>{try{const actionPayload={packageId:pkg.id,rangeKey,package:packagePayload(pkg),...extra};if(action==="copilot.package.reconcile")actionPayload.activeTaskIds=data.ranges[rangeKey]?.activeTaskIds||[];await runAction(root,action,actionPayload)}catch(error){const message=root.querySelector("[data-package-message]");message.dataset.state="error";message.textContent=error instanceof Error?error.message:String(error)}});return item; };
    const renderCard = (pkg, rank, snoozed=false) => { const card=node("article",undefined,"work-package-card");card.dataset.status=pkg.status;const top=node("div",undefined,"work-package-top");top.append(node("div",String(rank),"work-package-rank"));const heading=node("div");heading.append(node("h3",pkg.title));const badges=node("div",undefined,"work-package-badges");[[familyLabel[pkg.family],""],[pkg.priority,pkg.priority],[`${pkg.impact}/100 Impact`,""],[`${Math.round(pkg.confidence*100)}/100 Confidence`,""]].forEach(([label,level])=>{const badge=node("span",label,"work-package-badge");if(level)badge.dataset.level=level;badges.append(badge)});heading.append(badges);const state=node("div",undefined,"work-package-badges");state.append(node("span",statusLabel[pkg.status]||pkg.status,"work-package-badge"));top.append(heading,state);card.append(top);
      card.append(node("p",`${pkg.taskIds.length} Aufgaben · ${pkg.affectedFiles.length} Dateien · Aufwand ${pkg.effort} · Prüfmodus ${pkg.verificationMode} · früheste Prüfung ${fmtDate(pkg.verifyAfter)}`,"work-package-meta"));
      if(pkg.snoozedUntil) card.append(node("p",`Zurückgestellt bis ${fmtDate(pkg.snoozedUntil)}${pkg.snoozeReason?`: ${pkg.snoozeReason}`:""}`,"work-package-meta")); if(pkg.unresolvedTaskIds?.length) card.append(node("p",`Ungelöst: ${pkg.unresolvedTaskIds.join(", ")}`,"work-package-meta")); if(pkg.lastVerification?.checkedAt)card.append(node("p",`Letzte Prüfung: ${new Date(pkg.lastVerification.checkedAt).toLocaleString("de-DE")}${pkg.lastVerification.reason?` · ${pkg.lastVerification.reason}`:""}`,"work-package-meta")); if(pkg.failedChecks?.length)card.append(node("p",`Nicht bestandene Prüfungen: ${pkg.failedChecks.map(check=>check.command).join(", ")}`,"work-package-meta"));
      const actions=node("div",undefined,"work-package-actions"); const copy=node("button","Codex-Paket kopieren");copy.type="button";copy.dataset.primary="";copy.addEventListener("click",async()=>{try{await navigator.clipboard.writeText(pkg.codexPrompt);if(["open","needs-work","review-due"].includes(pkg.status))await runAction(root,"copilot.package.sent",{packageId:pkg.id,rangeKey,package:packagePayload(pkg)});else{const message=root.querySelector("[data-package-message]");message.dataset.state="success";message.textContent="Codex-Paket kopiert."}}catch(error){const message=root.querySelector("[data-package-message]");message.dataset.state="error";message.textContent=error instanceof Error?error.message:String(error)}});actions.append(copy);
      if(pkg.status==="open") actions.append(button("An Codex übergeben","copilot.package.sent",pkg)); if(["open","sent-to-codex","needs-work","review-due"].includes(pkg.status)) actions.append(button("Jetzt prüfen","copilot.package.verify",pkg)); if(pkg.status==="verification-pending") actions.append(button("Abgleich abschließen","copilot.package.reconcile",pkg,{},true)); if(["waiting-window","review-due"].includes(pkg.status)) actions.append(button("Search-Befunde abgleichen","copilot.package.reconcile",pkg));
      if(pkg.status!=="verified"&&pkg.status!=="snoozed"){const select=node("select");select.setAttribute("aria-label","Paket zurückstellen");select.append(new Option("Zurückstellen …",""),new Option("7 Tage","7"),new Option("14 Tage","14"),new Option("30 Tage","30"),new Option("60 Tage","60"));select.addEventListener("change",async()=>{if(!select.value)return;const reason=prompt("Grund für die Zurückstellung:",`Manuell für ${select.value} Tage zurückgestellt.`)||`Manuell für ${select.value} Tage zurückgestellt.`;try{await runAction(root,"copilot.package.snooze",{packageId:pkg.id,rangeKey,package:packagePayload(pkg),days:Number(select.value),reason})}catch(error){root.querySelector("[data-package-message]").textContent=error instanceof Error?error.message:String(error)}});actions.append(select)} if(pkg.status==="snoozed"||pkg.status==="verified")actions.append(button("Wieder öffnen","copilot.package.reopen",pkg)); card.append(actions);
      if(mode==="tasks"){const note=node("textarea");note.className="work-package-note-input";note.placeholder="Persönliche Notiz zum Paket";const noteKey=`pfotentechnik-seo-package-note:${pkg.id}`;note.value=localStorage.getItem(noteKey)||"";note.addEventListener("change",()=>localStorage.setItem(noteKey,note.value));card.append(note)}
      const details=node("details");details.append(node("summary",mode==="prompts"?"Vollständigen Paket-Prompt anzeigen":"Teilaufgaben anzeigen")); if(mode==="prompts"){const pre=node("pre",pkg.codexPrompt,"work-package-prompt");details.append(pre)} pkg.tasks.forEach(task=>{const item=node("div",undefined,"work-package-task");item.append(node("h4",task.title),node("p",`Task-ID: ${task.id}`),node("p",task.affectedFile||task.url||task.query||"Datei auflösen"),node("p",task.problem));const ul=node("ul");task.steps.forEach(step=>ul.append(node("li",step)));item.append(ul);details.append(item)});card.append(details);return card; };
    const render = () => { const entry=data.ranges[rangeKey]||Object.values(data.ranges)[0]||{packages:[]}; const packages=entry.packages||[]; const active=packages.filter(pkg=>pkg.status!=="snoozed").filter(pkg=>Object.entries(filters).every(([key,value])=>value==="all"||pkg[key]===value)); const snoozed=packages.filter(pkg=>pkg.status==="snoozed"); const list=root.querySelector("[data-package-list]");list.replaceChildren();active.forEach((pkg,index)=>list.append(renderCard(pkg,index+1)));if(!active.length)list.append(node("div","Keine Pakete für diese Filterkombination.","work-package-empty"));const snoozeList=root.querySelector("[data-snoozed-list]");snoozeList.replaceChildren();snoozed.forEach((pkg,index)=>snoozeList.append(renderCard(pkg,index+1,true)));root.querySelector("[data-snoozed-count]").textContent=String(snoozed.length);
      const individual=root.querySelector("[data-individual-list]");if(individual){individual.replaceChildren();(entry.individualTasks||[]).forEach(task=>{const card=node("article",undefined,"work-package-card");card.append(node("h3",task.title),node("p",task.url||task.query||"Keine eindeutige Zielroute","work-package-meta"));const details=node("details");details.append(node("summary","Einzelprompt anzeigen"),node("pre",task.codexPrompt||task.prompt||"","work-package-prompt"));card.append(details);individual.append(card)});if(!(entry.individualTasks||[]).length)individual.append(node("div","Keine nicht gebündelte Einzelaufgabe.","work-package-empty"))}
      const counts={open:packages.filter(p=>p.status==="open").length,high:packages.filter(p=>p.impact>=70).length,codex:packages.filter(p=>["sent-to-codex","verification-pending"].includes(p.status)).length,waiting:packages.filter(p=>p.status==="waiting-window").length,needs:packages.filter(p=>p.status==="needs-work").length,verified:packages.filter(p=>p.status==="verified").length,snoozed:snoozed.length};const metrics=root.querySelector("[data-package-metrics]");metrics.replaceChildren();[[counts.open,"Offen"],[counts.high,"High Impact"],[counts.codex,"In Codex"],[counts.waiting,"Nachmessung"],[counts.needs,"Nacharbeit"],[counts.verified,"Verifiziert"],[counts.snoozed,"Zurückgestellt"]].forEach(([value,label])=>{const metric=node("div",undefined,"work-package-metric");metric.append(node("strong",String(value)),node("span",label));metrics.append(metric)}); if(mode==="advisor")suppressDuplicateCards(packages); };
    root.querySelector("[data-package-export]")?.addEventListener("click",()=>{const packages=data.ranges[rangeKey]?.packages||[];const blob=new Blob([JSON.stringify(safeExport(packages),null,2)],{type:"application/json"});const url=URL.createObjectURL(blob);const a=node("a");a.href=url;a.download=`pfotentechnik-seo-pakete-${new Date().toISOString().slice(0,10)}.json`;a.click();URL.revokeObjectURL(url)});
    if(mode==="advisor"){const traffic=document.querySelector(".traffic-win");if(traffic)traffic.insertAdjacentElement("afterend",root);new MutationObserver(()=>suppressDuplicateCards(data.ranges[rangeKey]?.packages||[])).observe(document.body,{childList:true,subtree:true})}
    render();
    const pending=(data.ranges[rangeKey]?.packages||[]).filter(pkg=>pkg.status==="verification-pending");
    queueMicrotask(async()=>{for(const pkg of pending){const reconcileKey=`pfotentechnik-seo-package-reconcile:${pkg.id}:${pkg.updatedAt}`;if(sessionStorage.getItem(reconcileKey))continue;sessionStorage.setItem(reconcileKey,"1");try{await runAction(root,"copilot.package.reconcile",{packageId:pkg.id,rangeKey,package:packagePayload(pkg),activeTaskIds:data.ranges[rangeKey]?.activeTaskIds||[]})}catch(error){const message=root.querySelector("[data-package-message]");message.dataset.state="error";message.textContent=error instanceof Error?error.message:String(error);break}}});
  });
</script>
