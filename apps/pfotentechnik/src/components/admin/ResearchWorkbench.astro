---
import { buildWeeklyResearchPrompt } from "../../lib/seo/research/prompt-builder";
import { getOpenResearchItems, loadResearchStore } from "../../lib/seo/research/store";
import { buildClusterProgress, buildWeeklyGrowthOpportunities, impactStars, informationGainLevel } from "../../lib/seo/research/growth";
const { generatedAt, clusters, inventory } = Astro.props;
const store=loadResearchStore(); const items=getOpenResearchItems();
const prompt=buildWeeklyResearchPrompt({generatedAt,clusters,pages:inventory.page,comparisons:inventory.comparison,products:inventory.product,manufacturers:inventory.manufacturer});
const growth=buildWeeklyGrowthOpportunities(items,5); const clusterProgress=buildClusterProgress(clusters).slice(0,6); const backlogCount=Math.max(0,items.length-growth.length);
const effortLabel={small:"klein",medium:"mittel",large:"groß"}; const gainLabel={stark:"Stark",mittel:"Mittel",schwach:"Schwach"};
---
<section class="ta-section growth-workbench" aria-labelledby="growth-title">
<header class="growth-head"><div><p class="ta-eyebrow">Wöchentlicher SEO-Fokus</p><h2 id="growth-title">Die fünf sinnvollsten Verbesserungen</h2><p>Priorisiert nach möglichem SEO-Nutzen, Nutzen für Leser, Beleglage und Aufwand. Weitere Research-Funde bleiben im Hintergrund.</p></div><div class="growth-meta"><strong>{growth.length} im Fokus</strong><span>{backlogCount} im Backlog</span><small>{store.updatedAt?`Stand ${new Date(store.updatedAt).toLocaleDateString("de-DE")}`:"Noch kein Import"}</small></div></header>
<div class="growth-actions"><button type="button" class="pt-button pt-button--primary" data-copy-research-prompt={prompt}>Research-Auftrag kopieren</button><code>npm --workspace apps/pfotentechnik run research:import -- ./research-import.json</code></div>
{growth.length===0?<div class="growth-empty"><strong>Noch keine belegten Wachstumschancen.</strong><p>Research-Auftrag kopieren, in ChatGPT mit Webzugriff ausführen und das JSON importieren.</p></div>:<div class="growth-list">{growth.map((item,index)=>{const gain=informationGainLevel(item);return <article class="growth-card"><div class="growth-rank">{index+1}</div><div class="growth-card__body"><div class="growth-card__meta"><span class="growth-stars">{impactStars(item.impact)}</span><span>Aufwand {effortLabel[item.effort]}</span><span>{item.sourceCount} {item.sourceCount===1?"Beleg":"Belege"}</span></div><p class="growth-horizon">{item.horizon === "short-term" ? "Kurzfristiger Wachstumshebel" : "Strategischer Authority-Aufbau"}</p>
              <h3>{item.title}</h3>{item.target&&<p class="growth-target">{item.target}</p>}<p>{item.reason}</p>{item.gaps.length>0&&<div class="growth-gaps"><strong>Was konkret fehlt</strong><ul>{item.gaps.map(gap=><li>{gap}</li>)}</ul></div>}<div class={`growth-gain is-${gain}`}><span>Information Gain: {gainLabel[gain]}</span><p>{item.informationGain}</p></div>
              <details class="growth-brief"><summary>Umsetzungsbriefing</summary><div class="growth-brief__content"><section><strong>Ziel</strong><p>{item.implementationBrief.goal}</p></section><section><strong>Warum das wichtig ist</strong><p>{item.implementationBrief.userValue}</p></section>{item.implementationBrief.implementation.length>0&&<section><strong>Konkret umsetzen</strong><ul>{item.implementationBrief.implementation.map(entry=><li>{entry}</li>)}</ul></section>}{item.implementationBrief.files.length>0&&<section><strong>Ziele oder Dateien</strong><ul>{item.implementationBrief.files.map(entry=><li><code>{entry}</code></li>)}</ul></section>}{item.implementationBrief.doNotChange.length>0&&<section><strong>Nicht ändern</strong><ul>{item.implementationBrief.doNotChange.map(entry=><li>{entry}</li>)}</ul></section>}{item.implementationBrief.acceptanceCriteria.length>0&&<section><strong>Fertig, wenn</strong><ul>{item.implementationBrief.acceptanceCriteria.map(entry=><li>{entry}</li>)}</ul></section>}<button type="button" class="pt-button pt-button--secondary growth-copy" data-copy-implementation-prompt={item.implementationPrompt}>Umsetzungsauftrag kopieren</button></div></details></div></article>})}</div>}
<section class="cluster-progress"><header><div><p class="ta-eyebrow">Topical Authority</p><h3>Cluster-Fortschritt</h3></div><a href="/admin/seo/topical-authority/">Details ansehen</a></header><div class="cluster-progress__list">{clusterProgress.map(cluster=><article><div><strong>{cluster.label}</strong><span>{Math.round(cluster.score)} %</span></div><progress max="100" value={cluster.score}>{cluster.score}%</progress>{cluster.gaps.length>0&&<small>{cluster.gaps[0]}</small>}</article>)}</div></section>
{backlogCount>0&&<details class="growth-backlog"><summary>{backlogCount} weitere Research-Funde im Backlog</summary><p>Diese Funde bleiben gespeichert, überladen aber nicht die Wochenplanung. Sie rücken automatisch nach, sobald höher priorisierte Arbeiten erledigt sind.</p></details>}
</section>
<script is:inline>document.addEventListener("click",async e=>{const b=e.target instanceof Element?e.target.closest("[data-copy-research-prompt],[data-copy-implementation-prompt]"):null;if(!(b instanceof HTMLButtonElement))return;const isImplementation=b.hasAttribute("data-copy-implementation-prompt");const p=isImplementation?(b.dataset.copyImplementationPrompt||""):(b.dataset.copyResearchPrompt||"");const copied=isImplementation?"Umsetzungsauftrag kopiert":"Research-Auftrag kopiert";try{await navigator.clipboard.writeText(p);const old=b.textContent;b.textContent=copied;setTimeout(()=>b.textContent=old,1800);}catch{window.prompt(isImplementation?"Umsetzungsauftrag kopieren:":"Research-Auftrag kopieren:",p);}});</script>
<style>
.growth-workbench{
  --growth-surface:var(--seo-surface,Canvas);
  --growth-surface-raised:var(--seo-surface-raised,color-mix(in srgb,Canvas 94%,CanvasText 6%));
  --growth-surface-subtle:var(--seo-surface-subtle,color-mix(in srgb,Canvas 90%,CanvasText 10%));
  --growth-border:var(--seo-border,color-mix(in srgb,CanvasText 22%,transparent));
  --growth-text:var(--seo-text,CanvasText);
  --growth-text-muted:var(--seo-text-muted,color-mix(in srgb,CanvasText 68%,transparent));
  --growth-code-bg:var(--seo-code-bg,color-mix(in srgb,Canvas 84%,CanvasText 16%));
  --growth-code-text:var(--seo-code-text,CanvasText);
  color:var(--growth-text);
  display:grid;
  gap:1rem
}.growth-head,.cluster-progress>header{display:flex;align-items:start;justify-content:space-between;gap:1rem}.growth-head h2,.cluster-progress h3{margin:.2rem 0 .4rem}.growth-head p,.cluster-progress p{margin:0}.growth-meta{display:grid;flex:0 0 auto;gap:.2rem;text-align:right}.growth-meta span,.growth-meta small{color:var(--growth-text-muted)}.growth-actions{display:flex;align-items:center;gap:.75rem;flex-wrap:wrap}.growth-actions code{padding:.65rem .75rem;border-radius:var(--pt-radius-md);background:var(--growth-surface-subtle);overflow-wrap:anywhere;color:var(--growth-code-text);background:var(--growth-code-bg);border:1px solid var(--growth-border)}.growth-empty{padding:1rem;border:1px dashed var(--growth-border);border-radius:var(--pt-radius-lg)}.growth-list{display:grid;gap:.75rem}.growth-card{display:grid;grid-template-columns:2.2rem minmax(0,1fr);gap:.85rem;padding:1rem;border:1px solid var(--growth-border);border-radius:var(--pt-radius-lg);background:var(--growth-surface);color:var(--growth-text)}.growth-rank{display:grid;width:2.2rem;height:2.2rem;place-items:center;border-radius:999px;background:var(--growth-surface-subtle);font-weight:850}.growth-card__body{min-width:0}.growth-card__meta{display:flex;gap:.45rem;flex-wrap:wrap;color:var(--growth-text-muted);font-size:.78rem}.growth-card__meta span{padding:.2rem .45rem;border-radius:var(--pt-radius-pill);background:var(--growth-surface-subtle)}.growth-stars{color:var(--pt-color-warning,#9a6700);letter-spacing:.04em}.growth-card h3{margin:.55rem 0 .25rem}.growth-card p{margin:.35rem 0 0}.growth-target{color:var(--growth-text-muted);font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:.82rem;overflow-wrap:anywhere}.growth-gaps{margin-top:.85rem;padding:.75rem;border-radius:var(--pt-radius-md);background:var(--growth-surface-subtle);color:var(--growth-text);background:var(--growth-surface-raised);border:1px solid var(--growth-border)}.growth-gaps ul{display:grid;gap:.3rem;margin:.45rem 0 0;padding-left:1.1rem}.growth-gain{margin-top:.75rem;padding-left:.75rem;border-left:4px solid var(--growth-border)}.growth-gain>span{font-size:.8rem;font-weight:850}.growth-gain.is-stark{border-color:var(--pt-color-success,#16803c)}.growth-gain.is-mittel{border-color:var(--pt-color-warning,#9a6700)}.growth-gain.is-schwach{border-color:var(--pt-color-danger,#c83232)}.growth-brief{margin-top:.85rem;border-top:1px solid var(--growth-border);padding-top:.75rem}.growth-brief summary{cursor:pointer;font-weight:850}.growth-brief__content{display:grid;gap:.75rem;margin-top:.75rem;padding:.85rem;border-radius:var(--pt-radius-md);background:var(--growth-surface-subtle);color:var(--growth-text);background:var(--growth-surface-raised);border:1px solid var(--growth-border)}.growth-brief__content section{display:grid;gap:.3rem}.growth-brief__content p,.growth-brief__content ul{margin:0}.growth-brief__content ul{display:grid;gap:.3rem;padding-left:1.1rem}.growth-brief__content code{overflow-wrap:anywhere}.growth-copy{justify-self:start}.cluster-progress{display:grid;gap:.8rem;padding-top:1rem;border-top:1px solid var(--growth-border)}.cluster-progress__list{display:grid;gap:.7rem;grid-template-columns:repeat(auto-fit,minmax(14rem,1fr))}.cluster-progress__list article{display:grid;gap:.35rem;padding:.8rem;border:1px solid var(--growth-border);border-radius:var(--pt-radius-md)}.cluster-progress__list article>div{display:flex;justify-content:space-between;gap:.75rem}.cluster-progress progress{width:100%;accent-color:var(--pt-color-success,#16803c)}.cluster-progress small{color:var(--growth-text-muted)}.growth-backlog{padding:.8rem 1rem;border:1px solid var(--growth-border);border-radius:var(--pt-radius-md)}.growth-backlog summary{cursor:pointer;font-weight:800}@media(max-width:48rem){.growth-head,.cluster-progress>header{display:grid}.growth-meta{text-align:left}.growth-actions>*{width:100%}.growth-card{grid-template-columns:1fr}}
.growth-workbench :where(h2,h3,strong,summary){color:var(--growth-text)}.growth-workbench :where(p,li,small,span,code){text-wrap:pretty}.growth-workbench a{color:var(--pt-color-link,var(--growth-text))}.growth-workbench code{color:var(--growth-code-text)}@media(prefers-color-scheme:dark){.growth-workbench{color-scheme:dark}}
</style>
