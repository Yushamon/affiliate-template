---
import {buildWeeklyResearchPrompt} from "../../lib/seo/research/prompt-builder";
import {getOpenResearchItems,loadResearchStore} from "../../lib/seo/research/store";
const {generatedAt,clusters,inventory}=Astro.props; const store=loadResearchStore(); const items=getOpenResearchItems();
const prompt=buildWeeklyResearchPrompt({generatedAt,clusters,pages:inventory.page,comparisons:inventory.comparison,products:inventory.product,manufacturers:inventory.manufacturer});
const labels={topic:"Themen",product:"Produkte",manufacturer:"Hersteller","content-refresh":"Content-Refresh"};
const grouped=Object.groupBy(items,i=>i.type);
---
<section class="ta-section research-workbench"><div class="ta-section-head"><div><p class="ta-eyebrow">Manueller Research-Modus</p><h2>Wöchentliche Chancenprüfung</h2><p>ChatGPT recherchiert aktuelle Themen, Produkte, Hersteller und Refresh-Chancen. Importiert wird nur belegtes, strukturiertes JSON.</p></div><div class="research-meta"><strong>{items.length} offen</strong><span>{store.updatedAt?`Stand ${new Date(store.updatedAt).toLocaleDateString("de-DE")}`:"Noch kein Import"}</span></div></div>
<div class="research-actions"><button type="button" class="pt-button pt-button--primary" data-copy-research-prompt={prompt}>Research-Auftrag kopieren</button><code>npm --workspace apps/pfotentechnik run research:import -- ./research-import.json</code></div>
{items.length===0?<div class="research-empty"><strong>Noch keine extern validierten Chancen.</strong><p>Auftrag kopieren, in ChatGPT ausführen und das JSON importieren.</p></div>:<div class="research-groups">{Object.entries(grouped).map(([type,group])=><section><h3>{labels[type]??type} <span>{group?.length??0}</span></h3><div class="research-items">{(group??[]).slice(0,12).map(item=><article><div class="research-item-meta"><span>Priorität {item.priority}</span><span>Confidence {item.confidence}%</span>{item.repositoryMatch?.exists&&<span>Bestand prüfen</span>}</div><h4>{item.title}</h4><p>{item.reason}</p><ul>{item.actions.slice(0,4).map(a=><li><strong>{a.type}</strong>{a.target?` · ${a.target}`:""}<small>{a.reason}</small></li>)}</ul><details><summary>Belege ({item.evidence.length})</summary><ul>{item.evidence.map(e=><li><strong>{e.source}</strong><span>{e.note}</span></li>)}</ul></details></article>)}</div></section>)}</div>}
</section>
<script is:inline>document.addEventListener("click",async e=>{const b=e.target instanceof Element?e.target.closest("[data-copy-research-prompt]"):null;if(!(b instanceof HTMLButtonElement))return;const p=b.dataset.copyResearchPrompt||"";try{await navigator.clipboard.writeText(p);const old=b.textContent;b.textContent="Research-Auftrag kopiert";setTimeout(()=>b.textContent=old,1800);}catch{window.prompt("Research-Auftrag kopieren:",p);}});</script>
<style>.research-workbench{display:grid;gap:1rem}.research-meta{display:grid;gap:.25rem;text-align:right}.research-actions{display:flex;align-items:center;gap:.75rem;flex-wrap:wrap}.research-actions code{padding:.65rem .75rem;border-radius:var(--pt-radius-md);background:var(--seo-surface-subtle,#f4f6f8);overflow-wrap:anywhere}.research-empty{padding:1rem;border:1px dashed var(--seo-border,#d9dee7);border-radius:var(--pt-radius-lg)}.research-groups,.research-items{display:grid;gap:.75rem}.research-items{grid-template-columns:repeat(auto-fit,minmax(17rem,1fr))}.research-items article{padding:1rem;border:1px solid var(--seo-border,#d9dee7);border-radius:var(--pt-radius-lg);background:var(--seo-surface,Canvas)}.research-item-meta{display:flex;gap:.4rem;flex-wrap:wrap;font-size:.75rem}.research-item-meta span{padding:.25rem .45rem;border-radius:var(--pt-radius-pill);background:var(--seo-surface-subtle,#f4f6f8)}.research-items li small{display:block;color:var(--seo-text-muted,#5f6875)}@media(max-width:48rem){.research-meta{text-align:left}.research-actions>*{width:100%}}</style>
