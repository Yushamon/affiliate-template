---
import OptimizedImage from "@affiliate-core/components/OptimizedImage.astro";
import EditorialScore from "@affiliate-core/components/EditorialScore.astro";
import type { CategoryExperienceModel } from "../../domain/category/model";

interface Props {
  model: CategoryExperienceModel;
  authorName: string;
  updatedAt: Date | string;
}

const { model, authorName, updatedAt } = Astro.props;
const updatedDate = new Date(updatedAt);
const updatedLabel = new Intl.DateTimeFormat("de-DE", {
  day: "2-digit",
  month: "long",
  year: "numeric"
}).format(updatedDate);
---

<div class="pt-category-hub" data-category-experience="34.2" data-category={model.slug}>
  <header class="pt-category-hub__hero">
    <div class="pt-category-hub__hero-copy">
      <p class="pt-category-hub__eyebrow">{model.eyebrow}</p>
      <h1>{model.title}</h1>
      <p class="pt-category-hub__orientation">{model.orientation}</p>
      <p class="pt-category-hub__cue"><span aria-hidden="true">→</span>{model.cue}</p>
      <div class="pt-category-hub__meta">
        <span>{authorName}</span>
        <span>Aktualisiert <time datetime={updatedDate.toISOString()}>{updatedLabel}</time></span>
      </div>
    </div>
    {model.heroImage ? (
      <figure class="pt-category-hub__hero-media">
        <OptimizedImage src={model.heroImage.src} alt={model.heroImage.alt ?? model.heroAlt} width={880} height={660} layout="constrained" priority loading="eager" />
      </figure>
    ) : (
      <div class="pt-category-hub__hero-fallback" role="img" aria-label="Für diese Produktwelt ist kein geeignetes Bild verfügbar">
        <span>Produktwelt</span>
        <strong>{model.title}</strong>
      </div>
    )}
  </header>

  <section class="pt-category-hub__primary-comparison" aria-labelledby="category-primary-comparison-title" data-primary-comparison={model.primaryComparison.href}>
    <div>
      <p class="pt-category-hub__eyebrow">Direkt vergleichen</p>
      <h2 id="category-primary-comparison-title">{model.primaryComparison.ctaTitle}</h2>
      <p>{model.primaryComparison.ctaText}</p>
    </div>
    <div class="pt-category-hub__primary-comparison-action">
      <small>{model.primaryComparison.itemCount} Modelle eingeordnet</small>
      <a href={model.primaryComparison.href}>{model.primaryComparison.ctaLabel} <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section class="pt-category-hub__chapter pt-category-hub__requirements" aria-labelledby="category-requirements-title">
    <div class="pt-category-hub__chapter-heading">
      <p class="pt-category-hub__eyebrow">Anforderungen zuerst</p>
      <h2 id="category-requirements-title">Was muss zu deinem Alltag passen?</h2>
      <p>Diese Punkte verändern die passende Bauart oder den sinnvollen nächsten Vergleich. Zusatzfunktionen kommen danach.</p>
    </div>
    <ol class="pt-category-hub__requirement-list">
      {model.requirements.map((requirement, index) => (
        <li>
          <span>{String(index + 1).padStart(2, "0")}</span>
          <div>
            <small>{requirement.label}</small>
            <h3>{requirement.question}</h3>
          </div>
          <p>{requirement.consequence}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="pt-category-hub__chapter pt-category-hub__paths" aria-labelledby="category-paths-title">
    <div class="pt-category-hub__chapter-heading">
      <p class="pt-category-hub__eyebrow">Nach Situation wählen</p>
      <h2 id="category-paths-title">Welcher Entscheidungsweg passt zu dir?</h2>
      <p>Wähle den Engpass, der deinen Alltag tatsächlich verändert. Jeder Weg führt zu vorhandener Kaufberatung, einem Vergleich oder einer kuratierten Auswahl.</p>
    </div>
    <nav class="pt-category-hub__path-list" aria-label="Entscheidungswege">
      {model.paths.map((path, index) => (
        <a href={path.href}>
          <span class="pt-category-hub__path-index">{String(index + 1).padStart(2, "0")}</span>
          <span class="pt-category-hub__path-copy">
            <small>{path.label}</small>
            <strong>{path.title}</strong>
            <span>{path.text}</span>
          </span>
          <b>{path.cta}<span aria-hidden="true">→</span></b>
        </a>
      ))}
    </nav>
  </section>

  {model.secondaryComparisons.length > 0 && (
    <section class="pt-category-hub__chapter pt-category-hub__comparisons" aria-labelledby="category-comparisons-title">
      <div class="pt-category-hub__chapter-heading">
        <p class="pt-category-hub__eyebrow">Weitere Vergleiche</p>
        <h2 id="category-comparisons-title">Spezifische Fragen brauchen einen spezifischen Vergleich.</h2>
        <p>Wenn Tier, Futterart oder Betriebsmodell den Ausschlag geben, führen diese Wege direkt zur passenden Gegenüberstellung.</p>
      </div>
      <div class="pt-category-hub__comparison-list">
        {model.secondaryComparisons.map((comparison, index) => (
          <a href={comparison.href}>
            <span>{String(index + 1).padStart(2, "0")}</span>
            <div>
              <small>Entscheidungsfrage</small>
              <h3>{comparison.question}</h3>
              <p>{comparison.text}</p>
            </div>
            <div class="pt-category-hub__comparison-meta">
              <strong>{comparison.title}</strong>
              <small>{comparison.itemCount} Modelle im Vergleich</small>
              <b>Vergleich öffnen <span aria-hidden="true">→</span></b>
            </div>
          </a>
        ))}
      </div>
    </section>
  )}

  {model.products.length > 0 && (
    <section id="auswahl" class="pt-category-hub__chapter pt-category-hub__products" aria-labelledby="category-products-title">
      <div class="pt-category-hub__chapter-heading">
        <p class="pt-category-hub__eyebrow">Kuratierte Auswahl</p>
        <h2 id="category-products-title">Wenige Modelle, unterschiedliche Aufgaben.</h2>
        <p>Diese Produkte bilden bewusst verschiedene Entscheidungsrollen ab. Der Score folgt überall derselben redaktionellen Skala.</p>
      </div>
      <div class="pt-category-hub__product-list">
        {model.products.map((product) => (
          <article class="pt-category-hub__product">
            {product.image ? (
              <a class="pt-category-hub__product-media" href={product.href} aria-label={`${product.title} ansehen`}>
                <OptimizedImage src={product.image.src} alt={product.image.alt ?? `${product.title} in kompakter Produktansicht`} width={360} height={270} layout="constrained" fit="contain" />
              </a>
            ) : (
              <span class="pt-category-hub__product-fallback" role="img" aria-label="Produktbild nicht verfügbar">Bild nicht verfügbar</span>
            )}
            <div class="pt-category-hub__product-copy">
              <p>{product.role}</p>
              <h3>{product.title}</h3>
              <small>{product.manufacturer}{product.suitability ? ` · ${product.suitability}` : ""}</small>
              <p>{product.reason}</p>
            </div>
            <div class="pt-category-hub__product-decision">
              <EditorialScore value={product.score} scale={100} variant="ring-compact" description="Redaktioneller ProductScore" />
              <p>{product.price ? <><span>Preis erfasst</span><strong>{product.price}</strong></> : <span>Preis aktuell prüfen</span>}</p>
              <a href={product.href}>Produktcheck <span aria-hidden="true">→</span></a>
            </div>
          </article>
        ))}
      </div>
    </section>
  )}

  {model.guides.length > 0 && (
    <section class="pt-category-hub__chapter pt-category-hub__guides" aria-labelledby="category-guides-title">
      <div class="pt-category-hub__chapter-heading">
        <p class="pt-category-hub__eyebrow">Vor und nach dem Kauf</p>
        <h2 id="category-guides-title">Ratgeber, die eine konkrete Entscheidung erleichtern.</h2>
        <p>Keine chronologische Artikelliste: Diese Beiträge helfen bei Auswahl, Einrichtung, Pflege oder der Einordnung technischer Grenzen.</p>
      </div>
      <div class="pt-category-hub__guide-list">
        {model.guides.map((guide, index) => (
          <a href={guide.href}>
            <span>{String(index + 1).padStart(2, "0")}</span>
            <div><h3>{guide.title}</h3><p>{guide.text}</p></div>
            <b aria-hidden="true">→</b>
          </a>
        ))}
      </div>
    </section>
  )}

  <section id="kaufberatung" class="pt-category-hub__chapter pt-category-hub__evidence" aria-labelledby="category-evidence-title">
    <div class="pt-category-hub__chapter-heading">
      <p class="pt-category-hub__eyebrow">Einordnung & Evidenz</p>
      <h2 id="category-evidence-title">Kriterien nachvollziehen, bevor du Details vergleichst.</h2>
      <p>{model.evidenceIntro}</p>
    </div>
    <div class="pt-category-hub__trust-links">
      <a href="/so-bewerten-wir/">So bewertet die Redaktion <span aria-hidden="true">→</span></a>
      <a href="/redaktion/">Redaktionelle Transparenz <span aria-hidden="true">→</span></a>
    </div>
    <details class="pt-category-hub__depth">
      <summary><span>Vollständige Kaufberatung und technische Hintergründe</span><svg viewBox="0 0 20 20" aria-hidden="true"><path d="m5 7.5 5 5 5-5" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" /></svg></summary>
      <div class="pt-category-hub__reading">
        {model.evidenceSections.map((section) => (
          <section>
            <h3>{section.title}</h3>
            {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          </section>
        ))}
      </div>
    </details>
  </section>

  <section class="pt-category-hub__closing" aria-labelledby="category-closing-title">
    <div><p class="pt-category-hub__eyebrow">Nächster Schritt</p><h2 id="category-closing-title">{model.closing.title}</h2><p>{model.closing.text}</p></div>
    <a href={model.closing.href}>{model.closing.label} <span aria-hidden="true">→</span></a>
  </section>
</div>

<style>
  .pt-category-hub {
    --category-surface: var(--pt33-color-surface, var(--pt-color-surface));
    --category-raised: var(--pt33-color-surface-raised, var(--pt-color-surface-raised));
    --category-soft: var(--pt33-color-surface-subtle, var(--pt-color-surface-soft));
    --category-text: var(--pt33-color-text-primary, var(--pt-color-text));
    --category-muted: var(--pt33-color-text-secondary, var(--pt-color-text-muted));
    --category-tertiary: var(--pt33-color-text-tertiary, var(--pt-color-text-muted));
    --category-border: var(--pt33-color-border-subtle, var(--pt-color-border));
    --category-border-strong: var(--pt33-color-border-default, var(--pt-color-border-strong));
    --category-action: var(--pt33-color-action-primary, var(--pt-color-brand-700));
    width: min(100%, var(--pt-content-wide));
    margin-inline: auto;
    color: var(--category-text);
  }
  .pt-category-hub :where(a) { color: inherit; }
  .pt-category-hub :where(a, summary):focus-visible { outline: 3px solid color-mix(in srgb, var(--category-action) 42%, transparent); outline-offset: 4px; }
  .pt-category-hub__hero { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(300px, .75fr); gap: clamp(2rem, 6vw, 5rem); align-items: center; min-height: 590px; padding-block: clamp(2rem, 6vw, 5.5rem); }
  .pt-category-hub__hero-copy { max-width: 710px; }
  .pt-category-hub__eyebrow { margin: 0 0 var(--pt33-space-3); color: var(--category-action); font-size: .72rem; font-weight: 850; line-height: 1.3; letter-spacing: .12em; text-transform: uppercase; }
  .pt-category-hub__hero h1 { max-width: 14ch; margin: 0; font-size: clamp(2.75rem, 6.4vw, 5.4rem); font-weight: 850; line-height: .98; letter-spacing: -.06em; text-wrap: balance; }
  .pt-category-hub__orientation { max-width: 62ch; margin: var(--pt33-space-6) 0 0; color: var(--category-muted); font-size: clamp(1.05rem, 2vw, 1.28rem); line-height: 1.62; }
  .pt-category-hub__cue { display: flex; max-width: 58ch; gap: .75rem; align-items: flex-start; margin: var(--pt33-space-6) 0 0; padding-top: var(--pt33-space-4); border-top: 1px solid var(--category-border); font-weight: 720; line-height: 1.5; }
  .pt-category-hub__cue span { color: var(--category-action); }
  .pt-category-hub__meta { display: flex; flex-wrap: wrap; gap: .5rem 1.25rem; margin-top: var(--pt33-space-6); color: var(--category-tertiary); font-size: .78rem; }
  .pt-category-hub__hero-media, .pt-category-hub__hero-fallback { min-width: 0; margin: 0; overflow: hidden; border: 1px solid var(--category-border); border-radius: var(--pt33-radius-lg); background: var(--category-soft); box-shadow: var(--pt33-shadow-raised); }
  .pt-category-hub__hero-media { aspect-ratio: 4 / 3; }
  .pt-category-hub__hero-media :global(picture), .pt-category-hub__hero-media :global(img) { display: block; width: 100%; height: 100%; }
  .pt-category-hub__hero-media :global(img) { object-fit: cover; }
  .pt-category-hub__hero-fallback { display: grid; min-height: 330px; place-content: end start; padding: var(--pt33-space-8); }
  .pt-category-hub__hero-fallback span { color: var(--category-action); font-size: .75rem; font-weight: 800; text-transform: uppercase; }
  .pt-category-hub__hero-fallback strong { max-width: 15ch; margin-top: .5rem; font-size: 1.6rem; line-height: 1.1; }
  .pt-category-hub__primary-comparison { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: clamp(1.5rem, 4vw, 3rem); align-items: center; margin-bottom: clamp(1rem, 3vw, 2rem); padding: clamp(1.4rem, 3vw, 2.25rem); border: 1px solid var(--category-border-strong); border-radius: var(--pt33-radius-lg); background: var(--category-raised); box-shadow: var(--pt33-shadow-raised); }
  .pt-category-hub__primary-comparison h2 { max-width: 22ch; margin: 0; font-size: clamp(1.65rem, 3.3vw, 2.65rem); line-height: 1.05; letter-spacing: -.045em; }
  .pt-category-hub__primary-comparison > div > p:last-child { max-width: 66ch; margin: .75rem 0 0; color: var(--category-muted); line-height: 1.6; }
  .pt-category-hub__primary-comparison-action { display: grid; min-width: min(100%, 250px); gap: .75rem; justify-items: end; }
  .pt-category-hub__primary-comparison-action small { color: var(--category-tertiary); font-size: .72rem; font-weight: 750; }
  .pt-category-hub__primary-comparison-action a { display: inline-flex; min-height: 48px; align-items: center; gap: .6rem; padding: .8rem 1.1rem; border-radius: var(--pt33-radius-pill); color: var(--pt33-color-action-on-primary); background: var(--category-action); font-weight: 850; text-decoration: none; text-align: center; }
  .pt-category-hub__chapter { padding-block: clamp(4.5rem, 9vw, 8rem); border-top: 1px solid var(--category-border); }
  .pt-category-hub__chapter-heading { max-width: var(--pt33-reading-width); margin-bottom: clamp(2rem, 5vw, 3.5rem); }
  .pt-category-hub__chapter-heading h2 { max-width: 18ch; margin: 0; font-size: clamp(2.15rem, 4.6vw, 4rem); font-weight: 820; line-height: 1.02; letter-spacing: -.052em; text-wrap: balance; }
  .pt-category-hub__chapter-heading > p:last-child { max-width: 64ch; margin: 1rem 0 0; color: var(--category-muted); font-size: 1.02rem; line-height: 1.68; }
  .pt-category-hub__requirement-list { margin: 0; padding: 0; border-top: 1px solid var(--category-border-strong); list-style: none; }
  .pt-category-hub__requirement-list li { display: grid; grid-template-columns: 44px minmax(190px, .7fr) minmax(0, 1.3fr); gap: clamp(1rem, 3vw, 2.5rem); align-items: start; padding-block: clamp(1.3rem, 3vw, 2rem); border-bottom: 1px solid var(--category-border); }
  .pt-category-hub__requirement-list li > span { color: var(--category-action); font-size: .72rem; font-weight: 850; letter-spacing: .08em; }
  .pt-category-hub__requirement-list small { color: var(--category-tertiary); font-size: .68rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }
  .pt-category-hub__requirement-list h3 { margin: .35rem 0 0; font-size: clamp(1.15rem, 2vw, 1.5rem); line-height: 1.2; letter-spacing: -.025em; }
  .pt-category-hub__requirement-list p { max-width: 68ch; margin: 0; color: var(--category-muted); line-height: 1.65; }
  .pt-category-hub__paths { width: 100vw; margin-left: calc(50% - 50vw); padding-inline: max(var(--pt-page-gutter), calc((100vw - var(--pt-content-wide)) / 2 + var(--pt-page-gutter))); background: var(--category-soft); }
  .pt-category-hub__path-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); border-top: 1px solid var(--category-border-strong); }
  .pt-category-hub__path-list > a { display: grid; min-width: 0; grid-template-columns: 42px minmax(0, 1fr); gap: 1rem; align-content: start; min-height: 230px; padding: clamp(1.4rem, 3vw, 2.25rem); border-right: 1px solid var(--category-border); border-bottom: 1px solid var(--category-border); text-decoration: none; }
  .pt-category-hub__path-list > a:nth-child(2n) { border-right: 0; }
  .pt-category-hub__path-index { color: var(--category-action); font-size: .72rem; font-weight: 850; }
  .pt-category-hub__path-copy { display: grid; min-width: 0; align-content: start; gap: .55rem; }
  .pt-category-hub__path-copy small { color: var(--category-tertiary); font-size: .68rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }
  .pt-category-hub__path-copy strong { font-size: clamp(1.35rem, 2.5vw, 2rem); line-height: 1.08; letter-spacing: -.035em; }
  .pt-category-hub__path-copy > span { color: var(--category-muted); line-height: 1.6; }
  .pt-category-hub__path-list b { grid-column: 2; align-self: end; color: var(--category-action); font-size: .78rem; }
  .pt-category-hub__path-list b span { margin-left: .4rem; }
  .pt-category-hub__path-list > a:hover strong, .pt-category-hub__path-list > a:hover b { text-decoration: underline; text-underline-offset: .2em; }
  .pt-category-hub__comparison-list { border-top: 1px solid var(--category-border-strong); }
  .pt-category-hub__comparison-list > a { display: grid; grid-template-columns: 42px minmax(0, 1.35fr) minmax(220px, .65fr); gap: clamp(1rem, 3vw, 2.5rem); padding-block: clamp(1.5rem, 4vw, 2.5rem); border-bottom: 1px solid var(--category-border); text-decoration: none; }
  .pt-category-hub__comparison-list > a > span { color: var(--category-action); font-size: .72rem; font-weight: 850; }
  .pt-category-hub__comparison-list small { color: var(--category-tertiary); font-size: .68rem; font-weight: 800; letter-spacing: .07em; text-transform: uppercase; }
  .pt-category-hub__comparison-list h3 { max-width: 24ch; margin: .4rem 0 .7rem; font-size: clamp(1.4rem, 2.8vw, 2.15rem); line-height: 1.12; letter-spacing: -.04em; }
  .pt-category-hub__comparison-list p { max-width: 62ch; margin: 0; color: var(--category-muted); line-height: 1.6; }
  .pt-category-hub__comparison-meta { display: grid; align-content: start; gap: .5rem; padding-left: clamp(1rem, 3vw, 2rem); border-left: 1px solid var(--category-border); }
  .pt-category-hub__comparison-meta strong { line-height: 1.3; }
  .pt-category-hub__comparison-meta b { margin-top: 1rem; color: var(--category-action); font-size: .78rem; }
  .pt-category-hub__comparison-list > a:hover h3, .pt-category-hub__comparison-list > a:hover b { text-decoration: underline; text-underline-offset: .2em; }
  .pt-category-hub__products { width: 100vw; margin-left: calc(50% - 50vw); padding-inline: max(var(--pt-page-gutter), calc((100vw - var(--pt-content-wide)) / 2 + var(--pt-page-gutter))); background: var(--category-soft); }
  .pt-category-hub__product-list { border-top: 1px solid var(--category-border-strong); }
  .pt-category-hub__product { display: grid; grid-template-columns: 160px minmax(0, 1fr) minmax(210px, .42fr); gap: clamp(1rem, 3vw, 2.5rem); align-items: center; padding-block: clamp(1.2rem, 3vw, 2rem); border-bottom: 1px solid var(--category-border); }
  .pt-category-hub__product-media, .pt-category-hub__product-fallback { display: grid; width: 160px; height: 120px; overflow: hidden; place-items: center; border: 1px solid var(--category-border); border-radius: var(--pt33-radius-md); background: var(--category-raised); }
  .pt-category-hub__product-media :global(picture), .pt-category-hub__product-media :global(img) { display: block; width: 100%; height: 100%; }
  .pt-category-hub__product-media :global(img) { object-fit: contain; }
  .pt-category-hub__product-fallback { padding: .75rem; color: var(--category-tertiary); font-size: .72rem; text-align: center; }
  .pt-category-hub__product-copy { min-width: 0; }
  .pt-category-hub__product-copy > p:first-child { margin: 0 0 .35rem; color: var(--category-action); font-size: .68rem; font-weight: 850; letter-spacing: .08em; text-transform: uppercase; }
  .pt-category-hub__product-copy h3 { margin: 0; font-size: clamp(1.35rem, 2.5vw, 2rem); line-height: 1.12; letter-spacing: -.035em; }
  .pt-category-hub__product-copy small { display: block; margin-top: .35rem; color: var(--category-tertiary); line-height: 1.45; }
  .pt-category-hub__product-copy > p:last-child { max-width: 72ch; margin: .8rem 0 0; color: var(--category-muted); line-height: 1.58; }
  .pt-category-hub__product-decision { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: .7rem 1rem; align-items: center; padding-left: clamp(1rem, 3vw, 2rem); border-left: 1px solid var(--category-border); }
  .pt-category-hub__product-decision :global(.pt-score) { grid-row: span 2; }
  .pt-category-hub__product-decision :global(.pt-score__ring) { width: 68px; height: 68px; flex-basis: 68px; }
  .pt-category-hub__product-decision :global(.pt-score__ring-inner) { width: 54px; height: 54px; }
  .pt-category-hub__product-decision :global(.pt-score__value) { font-size: 1.35rem; }
  .pt-category-hub__product-decision > p { display: grid; margin: 0; text-align: right; white-space: nowrap; }
  .pt-category-hub__product-decision > p span { color: var(--category-tertiary); font-size: .68rem; }
  .pt-category-hub__product-decision > p strong { font-size: 1rem; }
  .pt-category-hub__product-decision > a { display: inline-flex; min-height: 44px; align-items: center; justify-self: end; color: var(--category-action); font-size: .78rem; font-weight: 850; text-decoration: none; }
  .pt-category-hub__guide-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); border-top: 1px solid var(--category-border-strong); }
