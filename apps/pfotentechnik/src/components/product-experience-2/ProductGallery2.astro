---
import { getCachedImage } from "../../lib/imageOptimization";

interface GalleryItem { src: any; alt: string; caption?: string; }
interface Props { name: string; items: GalleryItem[]; }

const { name, items = [] } = Astro.props;
const optimized = await Promise.all(items.filter((item) => item?.src).map(async (item, index) => {
  try {
    const [image, thumb] = await Promise.all([
      getCachedImage({ src: item.src, widths: [480, 760, 1080, 1440], sizes: index === 0 ? "(max-width: 760px) 100vw, 52vw" : "(max-width: 760px) 100vw, 24vw", quality: "high" }),
      getCachedImage({ src: item.src, width: 240, height: 180, fit: "contain", quality: "mid" }),
    ]);
    return { ...item, src: image.src, srcset: image.srcSet.attribute, thumbSrc: thumb.src, width: item.src?.width ?? 1400, height: item.src?.height ?? 1050 };
  } catch {
    const fallback = typeof item.src === "string" ? item.src : item.src?.src;
    return { ...item, src: fallback, srcset: "", thumbSrc: fallback, width: item.src?.width ?? 1400, height: item.src?.height ?? 1050 };
  }
}));
const desktopItems = optimized.slice(0, 5);
const hasImages = optimized.length > 0;
const hasMultiple = optimized.length > 1;
---

<section class:list={["px2-editorial-gallery", { "is-single": optimized.length === 1, "is-empty": !hasImages }]} data-px2-editorial-gallery data-gallery-airbnb-mobile aria-label={`Produktbilder von ${name}`}>
  {hasImages ? (
    <>
      <div class="px2-editorial-gallery__desktop">
        {desktopItems.map((item, index) => (
          <button type="button" class:list={["px2-editorial-gallery__tile", `px2-editorial-gallery__tile--${index + 1}`]} data-gallery-open data-gallery-index={index} aria-label={`${item.alt || name} vergrößern`}>
            <img src={item.src} srcset={item.srcset || undefined} sizes={index === 0 ? "52vw" : "24vw"} width={item.width} height={item.height} alt={item.alt || name} loading={index === 0 ? "eager" : "lazy"} decoding="async" fetchpriority={index === 0 ? "high" : "auto"} />
          </button>
        ))}
        {hasMultiple && <button type="button" class="px2-editorial-gallery__all" data-gallery-open data-gallery-index="0"><span aria-hidden="true">▦</span> Alle Bilder ({optimized.length})</button>}
      </div>

      <div class="px2-editorial-gallery__mobile" data-gallery-mobile-track aria-label="Produktbilder, horizontal wischbar">
        {optimized.map((item, index) => (
          <button type="button" class="px2-editorial-gallery__slide" data-gallery-open data-gallery-index={index} aria-label={`${item.alt || name} vergrößern`}>
            <img src={item.src} srcset={item.srcset || undefined} sizes="100vw" width={item.width} height={item.height} alt={item.alt || name} loading={index === 0 ? "eager" : "lazy"} decoding="async" fetchpriority={index === 0 ? "high" : "auto"} />
          </button>
        ))}
      </div>
      <div class="px2-editorial-gallery__mobile-meta">
        {hasMultiple && <span data-gallery-mobile-counter>1 / {optimized.length}</span>}
        <button type="button" data-gallery-open data-gallery-index="0"><span aria-hidden="true">▦</span> {hasMultiple ? `Alle Bilder (${optimized.length})` : "Bild vergrößern"}</button>
      </div>

      <dialog class="px2-editorial-lightbox" data-gallery-dialog aria-label={`Vollbildgalerie von ${name}`}>
        <div class="px2-editorial-lightbox__shell">
          <header class="px2-editorial-lightbox__header">
            <button type="button" data-gallery-close aria-label="Galerie schließen"><span aria-hidden="true">←</span> Zurück</button>
            <span data-gallery-counter aria-live="polite">1 / {optimized.length}</span>
            <button type="button" data-gallery-zoom aria-pressed="false">Zoom</button>
          </header>
          <div class="px2-editorial-lightbox__stage">
            {hasMultiple && <button type="button" class="px2-editorial-lightbox__nav" data-gallery-previous aria-label="Vorheriges Bild">‹</button>}
            <figure>
              <div class="px2-editorial-lightbox__viewport" data-gallery-viewport><img data-gallery-dialog-image src={optimized[0].src} alt={optimized[0].alt || name} width={optimized[0].width} height={optimized[0].height} draggable="false" decoding="async" /></div>
              <figcaption data-gallery-dialog-caption>{optimized[0].caption || optimized[0].alt || ""}</figcaption>
            </figure>
            {hasMultiple && <button type="button" class="px2-editorial-lightbox__nav" data-gallery-next aria-label="Nächstes Bild">›</button>}
          </div>
          {hasMultiple && <div class="px2-editorial-lightbox__thumbs">{optimized.map((item, index) => <button type="button" class:list={["px2-editorial-lightbox__thumb", { "is-active": index === 0 }]} data-gallery-thumb data-gallery-index={index} aria-label={`Bild ${index + 1} anzeigen`} aria-current={index === 0 ? "true" : undefined}><img src={item.thumbSrc} width="120" height="90" alt="" loading="lazy" decoding="async" /></button>)}</div>}
        </div>
      </dialog>
      <script type="application/json" data-gallery-data set:html={JSON.stringify(optimized.map((item) => ({ src: item.src, srcset: item.srcset, alt: item.alt || name, caption: item.caption || item.alt || "", width: item.width, height: item.height })))} />
    </>
  ) : <div class="px2-editorial-gallery__empty" role="img" aria-label={`Kein Produktbild für ${name} verfügbar`}><span aria-hidden="true">PT</span><p>Produktbild wird geprüft</p></div>}
</section>

<script>
  const setupEditorialProductGalleries = () => {
    document.querySelectorAll<HTMLElement>("[data-px2-editorial-gallery]").forEach((root) => {
      if (root.dataset.galleryReady === "true") return;
      root.dataset.galleryReady = "true";
      const data = root.querySelector<HTMLScriptElement>("[data-gallery-data]");
      const dialog = root.querySelector<HTMLDialogElement>("[data-gallery-dialog]");
      if (!data || !dialog) return;
      let items = [];
      try { items = JSON.parse(data.textContent || "[]"); } catch { return; }
      if (!items.length) return;
      const image = dialog.querySelector<HTMLImageElement>("[data-gallery-dialog-image]");
      const caption = dialog.querySelector<HTMLElement>("[data-gallery-dialog-caption]");
      const counter = dialog.querySelector<HTMLElement>("[data-gallery-counter]");
      const viewport = dialog.querySelector<HTMLElement>("[data-gallery-viewport]");
      const closeButton = dialog.querySelector<HTMLButtonElement>("[data-gallery-close]");
      const zoomButton = dialog.querySelector<HTMLButtonElement>("[data-gallery-zoom]");
      if (!image || !caption || !counter || !viewport || !closeButton || !zoomButton) return;
      const thumbs = [...dialog.querySelectorAll<HTMLButtonElement>("[data-gallery-thumb]")];
      let activeIndex = 0;
      let activeTrigger: HTMLElement | null = null;
      let zoomed = false;
      let pointerStartX = 0;
      let pointerStartY = 0;
      const setZoom = (value: boolean) => { zoomed = value; viewport.classList.toggle("is-zoomed", value); zoomButton.setAttribute("aria-pressed", value ? "true" : "false"); zoomButton.textContent = value ? "Zurücksetzen" : "Zoom"; };
      const render = (index: number) => {
        activeIndex = (index + items.length) % items.length;
        const item = items[activeIndex];
        image.src = item.src; image.srcset = item.srcset || ""; image.alt = item.alt; image.width = item.width; image.height = item.height;
        caption.textContent = item.caption; caption.hidden = !item.caption; counter.textContent = `${activeIndex + 1} / ${items.length}`; setZoom(false);
        thumbs.forEach((thumb, i) => { const active = i === activeIndex; thumb.classList.toggle("is-active", active); active ? thumb.setAttribute("aria-current", "true") : thumb.removeAttribute("aria-current"); if (active) thumb.scrollIntoView({ behavior: "smooth", block: "nearest", inline: "center" }); });
      };
      root.querySelectorAll<HTMLButtonElement>("[data-gallery-open]").forEach((button) => button.addEventListener("click", () => { activeTrigger = button; render(Number(button.dataset.galleryIndex || "0")); dialog.showModal(); document.documentElement.classList.add("has-px2-editorial-lightbox"); closeButton.focus(); }));
      const close = () => { if (dialog.open) dialog.close(); };
      closeButton.addEventListener("click", close);
      dialog.querySelector<HTMLButtonElement>("[data-gallery-previous]")?.addEventListener("click", () => render(activeIndex - 1));
      dialog.querySelector<HTMLButtonElement>("[data-gallery-next]")?.addEventListener("click", () => render(activeIndex + 1));
      zoomButton.addEventListener("click", () => setZoom(!zoomed)); viewport.addEventListener("dblclick", () => setZoom(!zoomed));
      thumbs.forEach((thumb) => thumb.addEventListener("click", () => render(Number(thumb.dataset.galleryIndex || "0"))));
      dialog.addEventListener("click", (event) => { if (event.target === dialog) close(); });
      dialog.addEventListener("cancel", (event) => { event.preventDefault(); close(); });
      dialog.addEventListener("close", () => { document.documentElement.classList.remove("has-px2-editorial-lightbox"); setZoom(false); activeTrigger?.focus(); activeTrigger = null; });
      dialog.addEventListener("keydown", (event) => { if (items.length < 2) return; if (event.key === "ArrowLeft") { event.preventDefault(); render(activeIndex - 1); } else if (event.key === "ArrowRight") { event.preventDefault(); render(activeIndex + 1); } });
      viewport.addEventListener("pointerdown", (event) => { pointerStartX = event.clientX; pointerStartY = event.clientY; viewport.setPointerCapture(event.pointerId); });
      viewport.addEventListener("pointerup", (event) => { if (viewport.hasPointerCapture(event.pointerId)) viewport.releasePointerCapture(event.pointerId); if (zoomed) return; const dx = event.clientX - pointerStartX; const dy = event.clientY - pointerStartY; if (Math.abs(dy) > 120 && Math.abs(dy) > Math.abs(dx)) close(); else if (items.length > 1 && Math.abs(dx) > 65) render(activeIndex + (dx < 0 ? 1 : -1)); });
      const track = root.querySelector<HTMLElement>("[data-gallery-mobile-track]");
      const mobileCounter = root.querySelector<HTMLElement>("[data-gallery-mobile-counter]");
      if (track && mobileCounter && items.length > 1) { let raf = 0; track.addEventListener("scroll", () => { cancelAnimationFrame(raf); raf = requestAnimationFrame(() => { const index = Math.max(0, Math.min(items.length - 1, Math.round(track.scrollLeft / (track.clientWidth || 1)))); mobileCounter.textContent = `${index + 1} / ${items.length}`; }); }, { passive: true }); }
    });
  };
  setupEditorialProductGalleries();
  document.addEventListener("astro:page-load", setupEditorialProductGalleries);
</script>

<style>
  .px2-editorial-gallery { position: relative; min-width: 0; }
  .px2-editorial-gallery button { font: inherit; }
  .px2-editorial-gallery__desktop { position: relative; display: none; grid-template-columns: minmax(0, 2fr) repeat(2, minmax(110px, 1fr)); grid-template-rows: repeat(2, minmax(170px, 1fr)); gap: 8px; min-height: 480px; overflow: hidden; border-radius: 24px; background: var(--px2-surface-soft); }
  .px2-editorial-gallery__tile { min-width: 0; min-height: 0; padding: 0; overflow: hidden; border: 0; background: var(--px2-surface-raised); cursor: zoom-in; }
  .px2-editorial-gallery__tile--1 { grid-row: 1 / 3; }
  .px2-editorial-gallery__tile img, .px2-editorial-gallery__slide img { display: block; width: 100%; height: 100%; object-fit: contain; background: var(--px2-surface-raised); transition: transform 220ms ease; }
  .px2-editorial-gallery__tile:hover img, .px2-editorial-gallery__tile:focus-visible img { transform: scale(1.025); }
  .px2-editorial-gallery button:focus-visible { outline: 3px solid var(--px2-accent-text); outline-offset: -4px; }
  .px2-editorial-gallery__all { position: absolute; right: 16px; bottom: 16px; display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 9px 14px; border: 1px solid var(--px2-border); border-radius: 12px; background: var(--px2-surface); color: var(--px2-text); box-shadow: var(--px2-shadow); font-size: .85rem; font-weight: 850; cursor: pointer; }
  .px2-editorial-gallery__mobile {
position: relative;
    display: flex;
    width: 100%;
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    border-radius: 0;
    background: var(--px2-surface-soft);
  }
  .px2-editorial-gallery__mobile::-webkit-scrollbar { display: none; }
  .px2-editorial-gallery__slide {
flex: 0 0 100%;
    width: 100%;
    height: clamp(280px, 44svh, 520px);
    max-height: 52svh;
    padding: 0;
    overflow: hidden;
    border: 0;
    border-radius: 0;
    background: var(--px2-surface-raised);
    scroll-snap-align: start;
    scroll-snap-stop: always;
    cursor: zoom-in;
  }
  .px2-editorial-gallery__mobile-meta {
position: absolute;
    z-index: 4;
    right: 0;
    bottom: 12px;
    left: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin: 0;
    padding-inline: max(16px, env(safe-area-inset-left)) max(16px, env(safe-area-inset-right));
    pointer-events: none;
  }
  .px2-editorial-gallery__mobile-meta span {
padding: 6px 10px;
    border-radius: 999px;
    background: rgba(10, 16, 13, .78);
    color: #fff;
    box-shadow: 0 4px 18px rgba(0,0,0,.2);
    backdrop-filter: blur(10px);
    font-size: .75rem;
    font-weight: 850;
    pointer-events: auto;
  }
  .px2-editorial-gallery__mobile-meta button {
display: inline-flex;
    align-items: center;
    gap: 7px;
    min-height: 42px;
    margin-left: auto;
    padding: 8px 12px;
    border: 1px solid rgba(255,255,255,.36);
    border-radius: 12px;
    background: rgba(10,28,20,.82);
    color: #fff;
    box-shadow: 0 4px 18px rgba(0,0,0,.22);
    backdrop-filter: blur(10px);
    font-size: .82rem;
    font-weight: 850;
    cursor: pointer;
    pointer-events: auto;
  }
  .px2-editorial-gallery__empty { display: grid; place-items: center; align-content: center; gap: 10px; min-height: 300px; border: 1px solid var(--px2-border); border-radius: 20px; background: var(--px2-surface-raised); color: var(--px2-muted); }
  .px2-editorial-gallery__empty span { display: grid; place-items: center; width: 70px; height: 70px; border-radius: 22px; background: var(--px2-green-soft); color: var(--px2-accent-text); font-weight: 900; }
  .px2-editorial-gallery__empty p { margin: 0; }
  .px2-editorial-lightbox { width: 100%; max-width: none; height: 100%; max-height: none; margin: 0; padding: 0; border: 0; background: #070908; color: #fff; overflow: hidden; }
  .px2-editorial-lightbox::backdrop { background: rgba(3, 5, 4, .96); }
  .px2-editorial-lightbox__shell { display: grid; grid-template-rows: auto minmax(0, 1fr) auto; width: 100%; height: 100%; }
  .px2-editorial-lightbox__header { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; min-height: 64px; padding: 10px clamp(12px, 3vw, 28px); }
  .px2-editorial-lightbox__header button { min-height: 44px; border: 0; color: #fff; background: transparent; font-weight: 800; cursor: pointer; }
  .px2-editorial-lightbox__header button:first-child { justify-self: start; } .px2-editorial-lightbox__header button:last-child { justify-self: end; }
  .px2-editorial-lightbox__stage { display: grid; grid-template-columns: 48px minmax(0, 1fr) 48px; min-height: 0; align-items: center; }
  .px2-editorial-lightbox__stage figure { display: grid; grid-template-rows: minmax(0, 1fr) auto; min-width: 0; height: 100%; margin: 0; }
  .px2-editorial-lightbox__viewport { display: grid; place-items: center; min-width: 0; min-height: 0; overflow: hidden; touch-action: pan-y; }
  .px2-editorial-lightbox__viewport img { display: block; width: 100%; height: 100%; max-height: calc(100vh - 170px); object-fit: contain; transition: transform 180ms ease; user-select: none; }
  .px2-editorial-lightbox__viewport.is-zoomed { overflow: auto; cursor: zoom-out; touch-action: pan-x pan-y; }
  .px2-editorial-lightbox__viewport.is-zoomed img { transform: scale(1.8); }
  .px2-editorial-lightbox figcaption { min-height: 34px; padding: 8px 14px; color: rgba(255,255,255,.76); font-size: .82rem; text-align: center; }
  .px2-editorial-lightbox__nav { display: grid; place-items: center; width: 42px; height: 42px; margin: auto; border: 1px solid rgba(255,255,255,.24); border-radius: 999px; color: #fff; background: rgba(0,0,0,.54); font-size: 2rem; cursor: pointer; }
  .px2-editorial-lightbox__thumbs { display: flex; gap: 8px; padding: 10px clamp(12px, 3vw, 28px) 16px; overflow-x: auto; }
  .px2-editorial-lightbox__thumb { flex: 0 0 76px; height: 58px; padding: 3px; overflow: hidden; border: 2px solid transparent; border-radius: 9px; background: rgba(255,255,255,.08); cursor: pointer; }
  .px2-editorial-lightbox__thumb.is-active { border-color: #fff; }
  .px2-editorial-lightbox__thumb img { display: block; width: 100%; height: 100%; border-radius: 5px; object-fit: contain; }
  :global(html.has-px2-editorial-lightbox) { overflow: hidden; }
  @media (min-width: 760px) { .px2-editorial-gallery__desktop { display: grid; } .px2-editorial-gallery__mobile, .px2-editorial-gallery__mobile-meta { display: none; } .px2-editorial-gallery.is-single .px2-editorial-gallery__desktop { grid-template-columns: 1fr; grid-template-rows: minmax(420px, 1fr); } .px2-editorial-gallery.is-single .px2-editorial-gallery__tile--1 { grid-row: auto; } }
  @media (max-width: 759px) {
    .px2-editorial-gallery { width: 100vw; max-width: 100vw; margin-inline: calc(50% - 50vw); }
    .px2-editorial-gallery__mobile { border-radius: 0; }
    .px2-editorial-gallery__mobile-meta { padding-inline: 16px; }
    .px2-editorial-gallery__empty { margin-inline: 16px; }
    .px2-editorial-lightbox__stage { grid-template-columns: minmax(0, 1fr); } .px2-editorial-lightbox__nav { display: none; } .px2-editorial-lightbox__stage figure { grid-column: 1; } .px2-editorial-lightbox__viewport img { max-height: calc(100vh - 150px); } }
  @media (prefers-reduced-motion: reduce) { .px2-editorial-gallery__tile img, .px2-editorial-lightbox__viewport img { transition: none; } }

@media (max-width: 759px) {
  .px2-editorial-gallery { position: relative; width: 100%; max-width: none; margin: 0; }
  .px2-editorial-gallery__slide img { width: 100%; height: 100%; object-fit: cover; object-position: center; background: transparent; }
  .px2-editorial-gallery__empty { margin-inline: 16px; }
}

@media (max-width: 759px) {
    .px2-editorial-gallery,
    .px2-editorial-gallery__mobile,
    .px2-editorial-gallery__slide,
    .px2-editorial-gallery__slide img {
      border-radius: 0;
    }

    .px2-editorial-gallery {
      width: 100%;
      max-width: none;
      margin: 0;
    }

    .px2-editorial-gallery__mobile {
      margin: 0;
    }
  }

@media (max-width: 759px) {
    .px2-editorial-gallery__mobile {
      height: clamp(280px, 44svh, 520px);
      max-height: 52svh;
    }

    .px2-editorial-gallery__slide {
      height: 100%;
      max-height: none;
      aspect-ratio: auto;
    }

    .px2-editorial-gallery__slide img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
    }
  }

  @media (max-width: 759px) and (max-height: 700px) {
    .px2-editorial-gallery__mobile {
      height: clamp(260px, 42svh, 340px);
    }
  }

  @media (max-width: 759px) and (min-height: 900px) {
    .px2-editorial-gallery__mobile {
      height: min(46svh, 480px);
    }
  }
</style>
