---
import { getCachedImage } from "../../lib/imageOptimization";
import EditorialScore from "@affiliate-core/components/EditorialScore.astro";

interface Alternative {
  type: string;
  label: string;
  title: string;
  href: string;
  image?: { src: any; alt: string } | null;
  score?: number;
  priceLabel?: string;
  reason: string;
}

interface Props { alternatives: Alternative[] }
const { alternatives } = Astro.props;
const cards = await Promise.all(alternatives.slice(0, 4).map(async (item) => ({
  ...item,
  optimized: item.image?.src ? await getCachedImage({ src:item.image.src, width:520, height:390, fit:"contain", quality:"high" }) : null
})));
---

{cards.length > 0 && (
  <section class="alternatives" id="alternativen" aria-labelledby="alternatives-title">
    <header>
      <span>Intelligente Alternativen</span>
      <h2 id="alternatives-title">Besser passend, nicht nur ähnlich</h2>
      <p>Die Auswahl folgt konkreten Kaufgründen wie Preis, Tiergröße, Futterart oder Offline-Nutzung.</p>
    </header>

    <div class="alternatives__grid">
      {cards.map((item) => (
        <article>
          <div class="alternatives__image">
            {item.optimized ? (
              <img
                src={item.optimized.src}
                srcset={item.optimized.srcSet.attribute}
                sizes="(max-width:720px) 100vw, 25vw"
                width="520"
                height="390"
                loading="lazy"
                decoding="async"
                alt={item.image?.alt || item.title}
              />
            ) : <span aria-hidden="true">PT</span>}
          </div>

          <div class="alternatives__body">
            <span>{item.label}</span>
            <h3>{item.title}</h3>
            <p>{item.reason}</p>
            {Number(item.score) > 0 && (
              <EditorialScore
                value={Number(item.score)}
                scale={100}
                variant="ring-compact"
                description="Redaktioneller Gesamtscore"
              />
            )}
            <div class="alternatives__meta">
              {item.priceLabel && <b>{item.priceLabel}</b>}
            </div>
            <a href={item.href}>Alternative ansehen</a>
          </div>
        </article>
      ))}
    </div>
  </section>
)}

<style>
  .alternatives{display:grid;gap:20px}
  .alternatives>header span{color: var(--px2-accent-text);font-size:.78rem;font-weight:850;letter-spacing:.08em;text-transform:uppercase}
  .alternatives>header h2{margin:7px 0 7px;font-size:clamp(1.65rem,4vw,2.4rem);letter-spacing:-.025em}
  .alternatives>header p{margin:0;color:var(--px2-muted);line-height:1.55}
  .alternatives__grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px}
  article{display:flex;flex-direction:column;min-width:0;overflow:hidden;border:1px solid var(--px2-border);border-radius:20px;background:var(--px2-surface);box-shadow:var(--px2-shadow)}
  .alternatives__image{display:grid;place-items:center;aspect-ratio:4/3;background:var(--px2-surface-raised)}
  .alternatives__image img{width:100%;height:100%;padding:12px;object-fit:contain}
  .alternatives__image>span{display:grid;place-items:center;width:56px;height:56px;border-radius:18px;background:var(--px2-green-soft);color: var(--px2-accent-text);font-weight:900}
  .alternatives__body{display:flex;flex:1;flex-direction:column;padding:16px}
  .alternatives__body>span{color: var(--px2-accent-text);font-size:.74rem;font-weight:850;text-transform:uppercase}
  .alternatives h3{margin:6px 0 8px;font-size:1.05rem}
  .alternatives p{margin:0 0 14px;color:var(--px2-muted);font-size:.9rem;line-height:1.5}
  .alternatives :global(.pt-score){--score-surface:var(--px2-surface);--score-text:var(--px2-text);--score-muted:var(--px2-muted);--score-accent:var(--px2-green);margin-top:auto;padding-top:12px;border-top:1px solid var(--px2-border)}
  .alternatives__meta{display:flex;justify-content:space-between;gap:8px;margin-top:12px;margin-bottom:12px;min-height:1.1rem}
  .alternatives__meta b{color:var(--px2-text)}
  .alternatives a{display:block;padding:11px 12px;border-radius:12px;background:var(--px2-green-soft);color: var(--px2-accent-text);font-weight:850;text-align:center;text-decoration:none}
  .alternatives a:hover{text-decoration:underline;text-underline-offset:3px}
  @media(max-width:1050px){.alternatives__grid{grid-template-columns:1fr 1fr}}
  @media(max-width:620px){.alternatives__grid{grid-template-columns:1fr}}
</style>
