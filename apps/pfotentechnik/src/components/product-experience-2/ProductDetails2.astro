---
import type { ProductExperienceModel } from "../../domain/productExperience/model";
interface Props { model: ProductExperienceModel }
const { model } = Astro.props;
---
<section class="details" aria-label="Produktdetails">
  <article class="details__decision">
    <header><span>Kaufentscheidung</span><h2>Nicht kaufen, wenn …</h2></header>
    <ul>{model.notFor.map((item) => <li>{item}</li>)}</ul>
    <p><strong>Größte Einschränkung:</strong> {model.mainLimitation}</p>
  </article>
  <article class="details__proscons">
    <div><h2>Vorteile</h2><ul>{model.pros.map((item) => <li>{item}</li>)}</ul></div>
    <div><h2>Nachteile</h2><ul>{model.cons.map((item) => <li>{item}</li>)}</ul></div>
  </article>
  <aside class="details__health"><span>Gesundheit und Sicherheit</span><h2>Technik unterstützt, sie ersetzt keine Kontrolle</h2><p>{model.healthNote}</p></aside>
  {model.specs.length > 0 && <details class="details__specs"><summary>Technische Daten einordnen</summary><dl>{model.specs.map((item) => <div><dt>{item.label}</dt><dd>{item.value}</dd></div>)}</dl></details>}
  {model.faq.length > 0 && <section class="details__faq" aria-labelledby="product-faq-title"><h2 id="product-faq-title">Häufige Fragen</h2>{model.faq.map((item) => <details><summary>{item.question}</summary><p>{item.answer}</p></details>)}</section>}
</section>
<style>
  .details{display:grid;grid-template-columns:1fr 1fr;gap:14px}.details>article,.details>aside,.details>details,.details>section{min-width:0;padding:clamp(18px,3vw,28px);border:1px solid var(--px2-border);border-radius:22px;background:var(--px2-surface)}.details__decision{background:linear-gradient(145deg,var(--px2-red-soft),var(--px2-surface))!important}.details__decision header span{color:var(--px2-red);font-size:.78rem;font-weight:850;text-transform:uppercase}.details h2{margin:6px 0 14px;font-size:clamp(1.35rem,3vw,1.9rem)}ul{display:grid;gap:8px;margin:0;padding-left:1.2rem;line-height:1.5}.details__decision li::marker,.details__proscons>div:last-child li::marker{color:var(--px2-red)}.details__decision p{margin:17px 0 0;padding-top:14px;border-top:1px solid var(--px2-border);line-height:1.55}.details__proscons{display:grid;grid-template-columns:1fr 1fr;gap:18px}.details__proscons>div:first-child li::marker{color:var(--px2-green)}.details__health,.details__specs,.details__faq{grid-column:1/-1}.details__health{background:var(--px2-green-soft)!important}.details__health span{color:var(--px2-green-strong);font-size:.75rem;font-weight:850;text-transform:uppercase}.details__health h2{margin:6px 0 8px}.details__health p{margin:0;color:var(--px2-muted);line-height:1.6}.details__specs>summary,.details__faq details>summary{cursor:pointer;font-weight:850}.details__specs dl{display:grid;grid-template-columns:1fr 1fr;gap:0 24px;margin:18px 0 0}.details__specs dl>div{display:grid;grid-template-columns:minmax(100px,.8fr) minmax(0,1.2fr);gap:12px;padding:10px 0;border-top:1px solid var(--px2-border)}dt{color:var(--px2-muted)}dd{margin:0;font-weight:700;overflow-wrap:anywhere}.details__faq h2{margin-top:0}.details__faq details{border-top:1px solid var(--px2-border);padding:13px 0}.details__faq p{margin:10px 0 0;color:var(--px2-muted);line-height:1.6}
  @media(max-width:800px){.details{grid-template-columns:1fr}.details__health,.details__specs,.details__faq{grid-column:auto}.details__proscons{grid-template-columns:1fr}.details__specs dl{grid-template-columns:1fr}} @media(max-width:520px){.details>article,.details>aside,.details>details,.details>section{padding:18px;border-radius:20px}.details__specs dl>div{grid-template-columns:1fr;gap:4px}}
</style>
