---
import type { ProductExperienceModel } from "../../domain/productExperience/model";
import { uniqueTextItems } from "../../domain/productExperience/contentLists";
import FoundationDisclosure from "../foundation/FoundationDisclosure.astro";

interface Props {
  model: ProductExperienceModel;
}

const { model } = Astro.props;
const pros = uniqueTextItems(model.pros, { exclude: model.cons, limit: 6 });
const cons = uniqueTextItems(model.cons, { exclude: model.notFor, limit: 6 });
---

<section class="details" aria-label="Produktdetails">
  {(pros.length > 0 || cons.length > 0) && (
    <section class="details__proscons" aria-label="Belegte Stärken und Schwächen">
      {pros.length > 0 && (
        <div class="details__column details__column--positive">
          <span class="details__eyebrow">Dafür spricht es</span>
          <h2>Stärken</h2>
          <ul>
            {pros.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      )}

      {cons.length > 0 && (
        <div class="details__column details__column--negative">
          <span class="details__eyebrow">Darauf achten</span>
          <h2>Schwächen</h2>
          <ul>
            {cons.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      )}
    </section>
  )}

  <aside class="details__health">
    <span>Gesundheit und Sicherheit</span>
    <h2>Technik ersetzt keine Kontrolle</h2>
    <p>{model.healthNote}</p>
  </aside>

  {model.specs.length > 0 && (
    <section class="details__specs">
      <FoundationDisclosure summary="Alle technischen Daten">
        <dl>
          {model.specs.map((item) => <div><dt>{item.label}</dt><dd>{item.value}</dd></div>)}
        </dl>
      </FoundationDisclosure>
    </section>
  )}

  {model.faq.length > 0 && (
    <section class="details__faq" aria-labelledby="product-faq-title">
      <h2 id="product-faq-title">Häufige Kauffragen</h2>
      <div class="pt-disclosure-list">
        {model.faq.map((item) => <FoundationDisclosure summary={item.question}><p>{item.answer}</p></FoundationDisclosure>)}
      </div>
    </section>
  )}
</section>

<style>
  .details {
    display: grid;
    gap: 18px;
  }

  .details > aside,
  .details > details,
  .details > section {
    min-width: 0;
    padding: 16px;
    border: 1px solid var(--px2-border);
    border-radius: 20px;
    background: var(--px2-surface);
  }

  .details__proscons {
    display: grid;
    gap: 24px;
  }

  .details__column {
    min-width: 0;
  }

  .details__eyebrow,
  .details__health > span {
    color: var(--px2-accent-text);
    font-size: .7rem;
    font-weight: 850;
    letter-spacing: .065em;
    text-transform: uppercase;
  }

  .details__column--negative .details__eyebrow {
    color: var(--px2-red);
  }

  .details h2 {
    margin: 4px 0 12px;
    font-size: clamp(1.2rem, 4.8vw, 1.55rem);
  }

  .details ul {
    display: grid;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .details li {
    position: relative;
    padding-left: 1rem;
    color: var(--px2-muted);
    line-height: 1.48;
  }

  .details li::before {
    position: absolute;
    top: .64em;
    left: 0;
    width: .35rem;
    height: .35rem;
    border-radius: 50%;
    background: var(--px2-green);
    content: "";
  }

  .details__column--negative li::before {
    background: var(--px2-red);
  }

  .details__health {
    background: var(--px2-green-soft);
  }

  .details__health h2 {
    margin: 5px 0 7px;
  }

  .details__health p {
    margin: 0;
    color: var(--px2-muted);
    line-height: 1.55;
  }

  .details__specs dl {
    display: grid;
    margin: 16px 0 0;
  }

  .details__specs dl > div {
    display: grid;
    gap: 3px;
    padding: 10px 0;
    border-top: 1px solid var(--px2-border);
  }

  .details__specs dt {
    color: var(--px2-muted);
  }

  .details__specs dd {
    margin: 0;
    font-weight: 700;
    overflow-wrap: anywhere;
  }

  .details__faq h2 {
    margin-top: 0;
  }

  .details__faq details {
    padding: 12px 0;
    border-top: 1px solid var(--px2-border);
  }

  .details__faq p {
    margin: 9px 0 0;
    color: var(--px2-muted);
    line-height: 1.55;
  }

  @media (min-width: 720px) {
    .details > aside,
    .details > details,
    .details > section {
      padding: 22px;
    }

    .details__proscons {
      grid-template-columns: 1fr 1fr;
    }

    .details__column--negative {
      padding-left: 22px;
      border-left: 1px solid var(--px2-border);
    }

    .details__specs dl {
      grid-template-columns: 1fr 1fr;
      gap: 0 24px;
    }

    .details__specs dl > div {
      grid-template-columns: minmax(110px, .8fr) minmax(0, 1.2fr);
      gap: 12px;
    }
  }
</style>
