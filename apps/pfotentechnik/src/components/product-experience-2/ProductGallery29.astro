---
import { getCachedImage } from "../../lib/imageOptimization";
import "./product-gallery-29.css";

interface GalleryItem { src: any; alt: string; caption?: string; role?: string; fallback?: boolean; }
interface Props { name: string; items: GalleryItem[]; reference?: boolean; }
interface OptimizedItem extends GalleryItem {
  src: string; srcset: string; mobileSrc: string; thumbSrc: string; width: number; height: number;
}

const { name, items = [] } = Astro.props;
const optimized = (await Promise.all(
  items.filter((item) => item?.src).map(async (item, index): Promise<OptimizedItem | null> => {
    try {
      const [image, mobileImage, thumb] = await Promise.all([
        getCachedImage({
          src: item.src,
          widths: [480, 760, 1080, 1440],
          sizes: index === 0 ? "(max-width: 759px) 100vw, 58vw" : "(max-width: 759px) 100vw, 28vw",
          quality: "high",
        }),
        getCachedImage({ src: item.src, width: 760, quality: "high" }),
        getCachedImage({ src: item.src, width: 240, quality: "mid" }),
      ]);
      return {
        ...item,
        src: image.src,
        srcset: image.srcSet.attribute,
        mobileSrc: mobileImage.src,
        thumbSrc: thumb.src,
        width: item.src?.width ?? 1400,
        height: item.src?.height ?? 1050,
      };
    } catch { return null; }
  }),
)).filter((item): item is OptimizedItem => item !== null);

const count = optimized.length;
const hasImages = count > 0;
const hasMultiple = count > 1;
const layout = count <= 1 ? "single" : count === 2 ? "double" : count === 3 ? "triple" : "mosaic";
const data = optimized.map((item) => ({
  src: item.src, srcset: item.srcset, alt: item.alt || name,
  caption: item.caption || item.alt || "", width: item.width, height: item.height,
}));
---

<section
  class:list={["pg29", `pg29--${layout}`, { "pg29--empty": !hasImages }]}
  data-product-gallery-v29
  data-image-count={count}
  data-primary-media-role={optimized[0]?.role}
  data-primary-media-fallback={optimized[0]?.fallback ? "true" : "false"}
  aria-label={`Produktbilder von ${name}`}
>
  {hasImages ? (
    <>
      <div class="pg29__mobile" data-pg29-track aria-label="Produktbilder, horizontal wischbar">
        {optimized.map((item, index) => (
          <button type="button" class="pg29__slide" data-pg29-open data-pg29-index={index} aria-label={`${item.alt || name} vergrößern`}>
            <img
              class="pg29__image"
              src={item.mobileSrc}
              width={item.width}
              height={item.height}
              alt={item.alt || name}
              loading={index === 0 ? "eager" : "lazy"}
              decoding="async"
              fetchpriority={index === 0 ? "high" : "auto"}
            />
          </button>
        ))}
      </div>

      {hasMultiple && (
        <div class="pg29__mobile-controls">
          <span data-pg29-mobile-counter aria-live="polite">1 / {count}</span>
          <button type="button" data-pg29-open data-pg29-index="0"><span class="pg29__gallery-icon" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><rect x="4" y="4" width="6" height="6" rx="1"/><rect x="14" y="4" width="6" height="6" rx="1"/><rect x="4" y="14" width="6" height="6" rx="1"/><rect x="14" y="14" width="6" height="6" rx="1"/></svg></span> Alle Bilder</button>
        </div>
      )}

      <div class="pg29__desktop">
        {optimized.slice(0, 5).map((item, index) => (
          <button type="button" class="pg29__tile" data-pg29-open data-pg29-index={index} aria-label={`${item.alt || name} vergrößern`}>
            <img
              class="pg29__image"
              src={item.src}
              srcset={item.srcset || undefined}
              sizes={index === 0 ? "58vw" : "28vw"}
              width={item.width}
              height={item.height}
              alt={item.alt || name}
              loading={index === 0 ? "eager" : "lazy"}
              decoding="async"
              fetchpriority={index === 0 ? "high" : "auto"}
            />
          </button>
        ))}
        {hasMultiple && (
          <button type="button" class="pg29__all" data-pg29-open data-pg29-index="0">
            <span class="pg29__gallery-icon" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><rect x="4" y="4" width="6" height="6" rx="1"/><rect x="14" y="4" width="6" height="6" rx="1"/><rect x="4" y="14" width="6" height="6" rx="1"/><rect x="14" y="14" width="6" height="6" rx="1"/></svg></span> Alle Bilder ({count})
          </button>
        )}
      </div>

      <dialog class="pg29-lightbox" data-pg29-dialog aria-label={`Vollbildgalerie von ${name}`}>
        <div class="pg29-lightbox__shell">
          <header class="pg29-lightbox__header">
            <button type="button" data-pg29-close aria-label="Galerie schließen"><span aria-hidden="true">←</span> Zurück</button>
            <span data-pg29-counter aria-live="polite">1 / {count}</span>
            <button type="button" data-pg29-zoom aria-pressed="false">Zoom</button>
          </header>

          <div class="pg29-lightbox__stage">
            {hasMultiple && <button type="button" class="pg29-lightbox__nav" data-pg29-previous aria-label="Vorheriges Bild">‹</button>}
            <figure>
              <div class="pg29-lightbox__viewport" data-pg29-viewport>
                <img class="pg29-lightbox__image" data-pg29-image src={optimized[0].src} alt={optimized[0].alt || name} width={optimized[0].width} height={optimized[0].height} draggable="false" decoding="async" />
              </div>
              <figcaption data-pg29-caption>{optimized[0].caption || optimized[0].alt || ""}</figcaption>
            </figure>
            {hasMultiple && <button type="button" class="pg29-lightbox__nav" data-pg29-next aria-label="Nächstes Bild">›</button>}
          </div>

          {hasMultiple && (
            <div class="pg29-lightbox__thumbs" aria-label="Bildauswahl">
              <div class="pg29-lightbox__thumb-list">
                {optimized.map((item, index) => (
                  <button
                    type="button"
                    class:list={["pg29-lightbox__thumb", { "is-active": index === 0 }]}
                    data-pg29-thumb
                    data-pg29-index={index}
                    aria-label={`Bild ${index + 1} anzeigen`}
                    aria-current={index === 0 ? "true" : undefined}
                  >
                    <span class="pg29-lightbox__thumb-frame" aria-hidden="true">
                      <img
                        class="pg29-lightbox__thumb-image"
                        src={item.thumbSrc}
                        width={item.width}
                        height={item.height}
                        alt=""
                        loading="lazy"
                        decoding="async"
                      />
                    </span>
                  </button>
                ))}
              </div>
            </div>
          )}
        </div>
      </dialog>

      <script type="application/json" data-pg29-data set:html={JSON.stringify(data)} />
    </>
  ) : (
    <div class="pg29__empty" role="img" aria-label={`Kein Produktbild für ${name} verfügbar`}>
      <span aria-hidden="true">PT</span><p>Produktbild wird geprüft</p>
    </div>
  )}
</section>

<script>
  interface Item29 { src: string; srcset: string; alt: string; caption: string; width: number; height: number; }

  const setupProductGallery29 = () => {
    document.querySelectorAll<HTMLElement>("[data-product-gallery-v29]").forEach((root) => {
      if (root.dataset.pg29Ready === "true") return;
      root.dataset.pg29Ready = "true";

      const dataNode = root.querySelector<HTMLScriptElement>("[data-pg29-data]");
      const dialog = root.querySelector<HTMLDialogElement>("[data-pg29-dialog]");
      if (!dataNode || !dialog) return;

      let items: Item29[];
      try { items = JSON.parse(dataNode.textContent || "[]"); } catch { return; }
      if (!items.length) return;

      const image = dialog.querySelector<HTMLImageElement>("[data-pg29-image]");
      const caption = dialog.querySelector<HTMLElement>("[data-pg29-caption]");
      const counter = dialog.querySelector<HTMLElement>("[data-pg29-counter]");
      const viewport = dialog.querySelector<HTMLElement>("[data-pg29-viewport]");
      const closeButton = dialog.querySelector<HTMLButtonElement>("[data-pg29-close]");
      const zoomButton = dialog.querySelector<HTMLButtonElement>("[data-pg29-zoom]");
      if (!image || !caption || !counter || !viewport || !closeButton || !zoomButton) return;

      const thumbs = [...dialog.querySelectorAll<HTMLButtonElement>("[data-pg29-thumb]")];
      let activeIndex = 0;
      let activeTrigger: HTMLElement | null = null;
      let zoomed = false;
      let pointerStartX = 0;
      let pointerStartY = 0;

      const setZoom = (value: boolean) => {
        zoomed = value;
        viewport.classList.toggle("is-zoomed", value);
        zoomButton.setAttribute("aria-pressed", value ? "true" : "false");
        zoomButton.textContent = value ? "Zurücksetzen" : "Zoom";
      };

      const render = (index: number) => {
        activeIndex = (index + items.length) % items.length;
        const item = items[activeIndex];
        image.src = item.src;
        image.srcset = item.srcset || "";
        image.alt = item.alt;
        image.width = item.width;
        image.height = item.height;
        caption.textContent = item.caption;
        caption.hidden = !item.caption;
        counter.textContent = `${activeIndex + 1} / ${items.length}`;
        setZoom(false);

        thumbs.forEach((thumb, i) => {
          const active = i === activeIndex;
          thumb.classList.toggle("is-active", active);
          if (active) thumb.setAttribute("aria-current", "true");
          else thumb.removeAttribute("aria-current");
        });

        if (dialog.open) {
          requestAnimationFrame(() => {
            thumbs[activeIndex]?.scrollIntoView({
              behavior: "smooth",
              block: "nearest",
              inline: "nearest",
            });
          });
        }
      };

      const close = () => { if (dialog.open) dialog.close(); };

      root.querySelectorAll<HTMLButtonElement>("[data-pg29-open]").forEach((button) => {
        button.addEventListener("click", () => {
          activeTrigger = button;
          const requestedIndex = Number(button.dataset.pg29Index || "0");
          render(requestedIndex);
          dialog.showModal();
          document.documentElement.classList.add("has-pg29-lightbox");

          requestAnimationFrame(() => {
            thumbs[requestedIndex]?.scrollIntoView({
              behavior: "auto",
              block: "nearest",
              inline: "nearest",
            });
            closeButton.focus();
          });
        });
      });

      closeButton.addEventListener("click", close);
      zoomButton.addEventListener("click", () => setZoom(!zoomed));
      viewport.addEventListener("dblclick", () => setZoom(!zoomed));
      dialog.querySelector<HTMLButtonElement>("[data-pg29-previous]")?.addEventListener("click", () => render(activeIndex - 1));
      dialog.querySelector<HTMLButtonElement>("[data-pg29-next]")?.addEventListener("click", () => render(activeIndex + 1));
      thumbs.forEach((thumb) => thumb.addEventListener("click", () => render(Number(thumb.dataset.pg29Index || "0"))));

      dialog.addEventListener("click", (event) => { if (event.target === dialog) close(); });
      dialog.addEventListener("cancel", (event) => { event.preventDefault(); close(); });
      dialog.addEventListener("close", () => {
        document.documentElement.classList.remove("has-pg29-lightbox");
        setZoom(false);
        activeTrigger?.focus();
        activeTrigger = null;
      });
      dialog.addEventListener("keydown", (event) => {
        if (items.length < 2) return;
        if (event.key === "ArrowLeft") { event.preventDefault(); render(activeIndex - 1); }
        if (event.key === "ArrowRight") { event.preventDefault(); render(activeIndex + 1); }
      });

      viewport.addEventListener("pointerdown", (event) => {
        pointerStartX = event.clientX;
        pointerStartY = event.clientY;
        viewport.setPointerCapture(event.pointerId);
      });
      viewport.addEventListener("pointerup", (event) => {
        if (viewport.hasPointerCapture(event.pointerId)) viewport.releasePointerCapture(event.pointerId);
        if (zoomed) return;
        const dx = event.clientX - pointerStartX;
        const dy = event.clientY - pointerStartY;
        if (Math.abs(dy) > 120 && Math.abs(dy) > Math.abs(dx)) close();
        else if (items.length > 1 && Math.abs(dx) > 65) render(activeIndex + (dx < 0 ? 1 : -1));
      });

      const track = root.querySelector<HTMLElement>("[data-pg29-track]");
      const mobileCounter = root.querySelector<HTMLElement>("[data-pg29-mobile-counter]");
      if (track && mobileCounter && items.length > 1) {
        let frame = 0;
        track.addEventListener("scroll", () => {
          cancelAnimationFrame(frame);
          frame = requestAnimationFrame(() => {
            const index = Math.max(0, Math.min(items.length - 1, Math.round(track.scrollLeft / (track.clientWidth || 1))));
            mobileCounter.textContent = `${index + 1} / ${items.length}`;
          });
        }, { passive: true });
      }
    });
  };

  setupProductGallery29();
  document.addEventListener("astro:page-load", setupProductGallery29);
</script>
