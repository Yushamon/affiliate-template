---
import type { ProductExperienceModel } from "../../domain/productExperience/model";

interface Props {
  model: ProductExperienceModel;
  reference?: boolean;
}

const { model, reference = false } = Astro.props;
const buyIf = model.idealFor.slice(0, 3);
const avoidIf = model.notFor.slice(0, 3);
const alternative = model.alternatives[0];
---

<section class:list={["verdict", { "verdict--reference33": reference }]} aria-labelledby="verdict-title">
  <header class="verdict__header">
    <span>{reference ? "Entscheidung zuerst" : "Schnellentscheidung"}</span>
    <h2 id="verdict-title">{reference ? "Was im Alltag wirklich zählt" : `Lohnt sich ${model.name}?`}</h2>
  </header>

  {reference ? (
    <div class="verdict__reference-grid">
      <article class="verdict__feature">
        <span>Der wichtigste Vorteil</span>
        <h3>Du erkennst, welches Tier den Brunnen genutzt hat.</h3>
        <p>{model.benefits[0] ?? model.reviewSummary}</p>
      </article>
      <article class="verdict__tradeoff">
        <span>Was du vor dem Kauf wissen solltest</span>
        <h3>{model.mainLimitation}</h3>
        <p>Die tierbezogene Zuordnung setzt den passenden PETLIBRO-Halsbandanhänger und eine zuverlässige Erkennung voraus.</p>
      </article>
      <div class="verdict__decision-line" aria-label="Qualitativer Trade-off">
        <span>Mehrkatzen</span><strong>●</strong><span>Halsband nötig</span>
      </div>
    </div>
  ) : (
  <div class="verdict__grid">
    {buyIf.length > 0 && (
      <article class="verdict__card is-positive">
        <h3>Ja, wenn …</h3>
        <ul>{buyIf.map((item) => <li>{item}</li>)}</ul>
      </article>
    )}

    {avoidIf.length > 0 && (
      <article class="verdict__card is-negative">
        <h3>Nein, wenn …</h3>
        <ul>{avoidIf.map((item) => <li>{item}</li>)}</ul>
      </article>
    )}

    {alternative && (
      <article class="verdict__card is-alternative">
        <h3>Dann lieber …</h3>
        <p>{alternative.reason}</p>
        <a href={alternative.href}>{alternative.title} ansehen</a>
      </article>
    )}
  </div>
  )}
</section>

<style>
  .verdict {
    display: grid;
    gap: 14px;
    padding: 16px;
    border: 1px solid var(--px2-border);
    border-radius: 20px;
    background: var(--px2-surface);
    box-shadow: var(--px2-shadow);
  }

  .verdict__header span {
    color: var(--px2-accent-text);
    font-size: .75rem;
    font-weight: 850;
    letter-spacing: .07em;
    text-transform: uppercase;
  }

  .verdict__header h2 {
    margin: 5px 0 0;
    font-size: clamp(1.45rem, 7vw, 2.15rem);
    letter-spacing: -.025em;
  }

  .verdict__grid {
    display: grid;
    gap: 10px;
  }

  .verdict__card {
    min-width: 0;
    padding: 14px;
    border: 1px solid var(--px2-border);
    border-radius: 15px;
    background: var(--px2-surface-raised);
  }

  .verdict__card.is-positive {
    background: var(--px2-green-soft);
  }

  .verdict__card.is-negative {
    background: var(--px2-red-soft);
  }

  .verdict__card h3 {
    margin: 0 0 9px;
    font-size: 1rem;
  }

  .verdict__card ul {
    display: grid;
    gap: 7px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .verdict__card li {
    position: relative;
    padding-left: 1.25rem;
  }

  .verdict__card li::before {
    position: absolute;
    left: 0;
    font-weight: 950;
  }

  .verdict__card.is-positive li::before {
    color: var(--px2-accent-text);
    content: "✓";
  }

  .verdict__card.is-negative li::before {
    color: var(--px2-red);
    content: "×";
  }

  .verdict__card li,
  .verdict__card p {
    color: var(--px2-text);
    font-size: .9rem;
    line-height: 1.48;
  }

  .verdict__card p {
    margin: 0 0 10px;
  }

  .verdict__card a {
    color: var(--px2-accent-text);
    font-weight: 850;
    text-underline-offset: 3px;
  }

  .verdict--reference33 { gap: var(--pt33-space-6, 24px); padding: 0; border: 0; border-radius: 0; background: transparent; box-shadow: none; }
  .verdict--reference33 .verdict__reference-grid { display: grid; gap: var(--pt33-space-4, 16px); }
  .verdict--reference33 article { display: grid; gap: 10px; padding: var(--pt33-space-8, 32px); border-radius: var(--pt33-radius-lg, 18px); }
  .verdict--reference33 article > span { color: var(--px2-accent-text); font-size: var(--pt33-font-meta, .875rem); font-weight: 800; letter-spacing: .06em; text-transform: uppercase; }
  .verdict--reference33 .verdict__feature { min-height: 17rem; align-content: end; border: 0; background: var(--px2-surface-soft); }
  .verdict--reference33 .verdict__feature h3 { max-width: 36rem; margin: 0; font-size: var(--pt33-font-heading, 2rem); line-height: var(--pt33-leading-heading, 1.12); letter-spacing: var(--pt33-tracking-heading, -.025em); }
  .verdict--reference33 .verdict__feature p { max-width: 42rem; margin: 0; color: var(--px2-muted); font-size: var(--pt33-font-body, 1.125rem); }
  .verdict--reference33 .verdict__tradeoff { border: 1px solid var(--px2-border); background: var(--px2-surface); }
  .verdict--reference33 .verdict__tradeoff > span { color: var(--px2-red); }
  .verdict--reference33 .verdict__tradeoff h3 { margin: 0; font-size: var(--pt33-font-subheading, 1.5rem); }
  .verdict--reference33 .verdict__tradeoff p { max-width: 46rem; margin: 0; color: var(--px2-muted); }
  .verdict--reference33 .verdict__decision-line { display: grid; grid-template-columns: 1fr auto 1fr; gap: var(--pt33-space-3, 12px); align-items: center; color: var(--px2-muted); font-size: var(--pt33-font-meta, .875rem); }
  .verdict--reference33 .verdict__decision-line::before, .verdict--reference33 .verdict__decision-line::after { height: 1px; background: var(--px2-border); content: ""; }
  .verdict--reference33 .verdict__decision-line strong { color: var(--px2-text); }
  @media (max-width: 719px) {
    .verdict--reference33 .verdict__feature { min-height: 0; padding: 0 0 var(--pt33-space-5, 20px); border-bottom: 1px solid var(--px2-border); border-radius: 0; background: transparent; }
    .verdict--reference33 .verdict__decision-line { grid-template-columns: 1fr; gap: 4px; padding-top: var(--pt33-space-3, 12px); border-top: 1px solid var(--px2-border); }
    .verdict--reference33 .verdict__decision-line::before, .verdict--reference33 .verdict__decision-line::after { display: none; }
    .verdict--reference33 .verdict__decision-line span { display: grid; gap: 2px; }
    .verdict--reference33 .verdict__decision-line span:first-child::before { color: var(--px2-muted); content: "Passt besonders"; font-size: .72rem; font-weight: 800; letter-spacing: .06em; text-transform: uppercase; }
    .verdict--reference33 .verdict__decision-line span:last-child::before { color: var(--px2-muted); content: "Kompromiss"; font-size: .72rem; font-weight: 800; letter-spacing: .06em; text-transform: uppercase; }
    .verdict--reference33 .verdict__decision-line strong { display: none; }
  }

  @media (min-width: 760px) {
    .verdict {
      padding: 22px;
    }

    .verdict__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
