---
interface EvidenceItem {
  label: string;
  detail?: string;
}

interface EvidenceSummary {
  items: EvidenceItem[];
  handsOn?: {
    date?: string;
    duration?: string;
    scope?: string[];
  } | null;
}

interface Props {
  evidence?: EvidenceSummary;
  updatedAt?: string;
}

const { evidence, updatedAt } = Astro.props;
const items = evidence?.items ?? [];
const formattedDate = updatedAt
  ? new Intl.DateTimeFormat("de-DE", { dateStyle: "medium" }).format(new Date(updatedAt))
  : null;
const show = items.length > 0 || evidence?.handsOn;
const iconFor = (label: string) => {
  const value = label.toLocaleLowerCase("de-DE");
  if (value.includes("hersteller")) return "D";
  if (value.includes("spezifikation") || value.includes("technisch")) return "T";
  if (value.includes("vergleich")) return "V";
  return "Q";
};
---

{show && (
  <section class="evidence" aria-labelledby="evidence-title">
    <header>
      <span>Unsere Quellen</span>
      <h2 id="evidence-title">So ist die Einordnung belegt</h2>
      {formattedDate && <p>Zuletzt inhaltlich geprüft: {formattedDate}</p>}
    </header>

    <ul class="evidence__items">
      {items.map((item) => (
        <li>
          <span class="evidence__icon" aria-hidden="true">{iconFor(item.label)}</span>
          <div>
            <strong>{item.label}</strong>
            {item.detail && <small>{item.detail}</small>}
          </div>
        </li>
      ))}
    </ul>

    {evidence?.handsOn && (
      <aside class="evidence__hands-on">
        <strong>Eigener Praxistest durchgeführt</strong>
        {evidence.handsOn.duration && <span>Testdauer: {evidence.handsOn.duration}</span>}
        {evidence.handsOn.scope?.length > 0 && <span>{evidence.handsOn.scope.join(" · ")}</span>}
      </aside>
    )}
  </section>
)}

<style>
  .evidence {
    display: grid;
    gap: 14px;
    padding: 16px;
    border: 1px solid var(--px2-border);
    border-radius: 18px;
    background: var(--px2-surface-soft);
  }

  .evidence header > span {
    color: var(--px2-accent-text);
    font-size: .72rem;
    font-weight: 850;
    letter-spacing: .07em;
    text-transform: uppercase;
  }

  .evidence h2 {
    margin: 4px 0 3px;
    font-size: clamp(1.25rem, 5vw, 1.7rem);
    letter-spacing: -.02em;
  }

  .evidence header p {
    margin: 0;
    color: var(--px2-muted);
    font-size: .82rem;
  }

  .evidence__items {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .evidence__items li {
    display: grid;
    grid-template-columns: 1.8rem minmax(0, 1fr);
    gap: 8px;
    align-items: center;
    min-width: min(100%, 13rem);
    padding: 9px 11px;
    border: 1px solid var(--px2-border);
    border-radius: 12px;
    background: var(--px2-surface);
  }

  .evidence__icon {
    display: grid;
    width: 1.75rem;
    height: 1.75rem;
    place-items: center;
    border-radius: 9px;
    background: var(--px2-green-soft);
    color: var(--px2-accent-text);
    font-size: .72rem;
    font-weight: 900;
  }

  .evidence__items div {
    display: grid;
    gap: 1px;
    min-width: 0;
  }

  .evidence__items strong {
    font-size: .86rem;
  }

  .evidence__items small {
    color: var(--px2-muted);
    line-height: 1.35;
  }

  .evidence__hands-on {
    display: grid;
    gap: 3px;
    padding: 11px 12px;
    border-radius: 12px;
    background: var(--px2-green-soft);
  }

  .evidence__hands-on span {
    color: var(--px2-muted);
    font-size: .82rem;
  }

  @media (min-width: 720px) {
    .evidence {
      grid-template-columns: minmax(210px, .65fr) minmax(0, 1.35fr);
      padding: 20px;
      align-items: center;
    }

    .evidence__hands-on {
      grid-column: 1 / -1;
    }
  }
</style>
