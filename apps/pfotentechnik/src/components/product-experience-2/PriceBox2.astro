---
import type { ProductPriceInsight } from "../../domain/price/types";
import type { SubscriptionCostModel } from "../../domain/subscriptionCosts";

interface Operations {
  availability: "available" | "temporarily-unavailable" | "out-of-stock" | "discontinued" | "unknown";
  availabilityLabel: string;
  availabilityReason?: string;
  purchasable: boolean;
  priceAvailable: boolean;
}

interface Props {
  commerce?: { offers: any[]; cheapestId: string | null; saving: number | null; hasConfiguredOffers: boolean };
  price?: ProductPriceInsight;
  operations: Operations;
  subscriptionCost?: SubscriptionCostModel;
  affiliate: {
    url?: string;
    label: string;
    rel: string;
    target: "_blank" | "_self";
  };
}

const { price, affiliate, operations, subscriptionCost, commerce } = Astro.props;
const offers = commerce?.offers ?? [];
const multiMerchant = offers.length > 1;
const showMerchantOptions = Boolean(commerce?.hasConfiguredOffers || offers.length);
const singleOffer = offers.length === 1 ? offers[0] : null;
// Prefer a merchant's validated price. Never present an older editorial price as current.
const currentPriceLabel = singleOffer?.formattedPrice || price?.formattedCurrent || "Preis beim Händler prüfen";
const unconfirmedPrice = !singleOffer?.formattedPrice && Boolean(price?.formattedCurrent) && (!operations.priceAvailable || price?.isStale);
const serviceLabel = subscriptionCost?.optional ? "Optionales Abo möglich" : subscriptionCost?.status === "no-subscription" ? "Kein Pflichtabo" : subscriptionCost?.label;
const servicePrice = subscriptionCost?.featuredPlan?.current ? subscriptionCost.featuredPlan.paymentLabel : null;
const unavailableCopy = operations.availability === "discontinued"
  ? "Dieses Produkt wurde eingestellt und wird nicht mehr als Hauptempfehlung geführt. Prüfe die Alternativen auf dieser Seite."
  : operations.availability === "temporarily-unavailable"
    ? "Dieses Produkt ist vorübergehend nicht verfügbar. Die redaktionelle Bewertung bleibt bestehen, aktuell solltest du aber eine Alternative prüfen."
    : operations.availability === "out-of-stock"
      ? "Dieses Produkt ist aktuell nicht lieferbar. Die redaktionelle Bewertung bleibt bestehen, eine Kaufempfehlung wird derzeit nicht ausgespielt."
      : null;
const ctaLabel = affiliate.label || (price?.formattedCurrent ? "Beim Anbieter ansehen" : "Aktuellen Preis prüfen");
const showTotals = Boolean(
  subscriptionCost &&
  subscriptionCost.status !== "no-subscription" &&
  (subscriptionCost.totals.months12 || subscriptionCost.totals.months24)
);
---

<section class="px2-price" aria-labelledby="px2-price-title" data-availability={operations.availability} data-subscription-status={subscriptionCost?.status}>
  {unavailableCopy && (
    <aside class:list={["px2-availability", `is-${operations.availability}`]} role="status">
      <strong>{operations.availabilityLabel}</strong>
      <p>{unavailableCopy}</p>
    </aside>
  )}

  <header class="px2-price__header">
    <h2 id="px2-price-title">{multiMerchant ? "Händler & Preise" : "Preis & Kaufoption"}</h2>
  </header>

  <dl class:list={["px2-price__summary", !multiMerchant && subscriptionCost && "has-service"]}>
    {!multiMerchant && <div class="px2-price__purchase">
      <dt>{unconfirmedPrice ? "Zuletzt erfasster Anschaffungspreis" : "Anschaffungspreis"}</dt>
      <dd class:list={[!price?.formattedCurrent && !singleOffer?.formattedPrice && "is-price-unknown"]}>{currentPriceLabel}</dd>
      {unconfirmedPrice && <small>{price?.isStale ? "Veralteter Preisstand" : "Nicht aktuell bestätigt"}</small>}
    </div>}
    {subscriptionCost && <div class:list={["px2-price__service", `is-${subscriptionCost.tone}`]}>
      <dt>Laufende Kosten</dt>
      <dd><strong>{serviceLabel}</strong>
        {servicePrice && <span>{servicePrice}</span>}
        {subscriptionCost.requiresPayment && !servicePrice && <span>Tarif beim Anbieter prüfen</span>}
        {subscriptionCost.status === "service-included" && <span>{subscriptionCost.runningCostLabel}</span>}
        {subscriptionCost.billingLabel && <small>{subscriptionCost.billingLabel}</small>}
        {subscriptionCost.requiresPayment && subscriptionCost.stale && <small>Tarifstand veraltet</small>}
      </dd>
    </div>}
  </dl>

  {showMerchantOptions ? <div class="px2-offers" data-commerce-offers>
    {!offers.length && <p>Aktuell ist keine verifizierte Kaufquelle verfügbar.</p>}
    {offers.map(offer => <div class="px2-offer" data-merchant={offer.merchant}>
      <div class="px2-offer__heading"><strong>{offer.label}</strong>{multiMerchant && offer.formattedPrice && <strong>{offer.formattedPrice}</strong>}</div>
      {offer.variantLabel && <small>{offer.variantLabel}</small>}
      {Number.isFinite(offer.shipping) && <small>Versand: {offer.shipping.toLocaleString('de-DE', {style:'currency',currency:offer.currency})}</small>}
      <a class="px2-price__cta" href={offer.affiliateUrl} rel={offer.rel} target={offer.target}
        data-affiliate-link data-merchant={offer.merchant} data-product={offer.tracking.product} data-placement={offer.tracking.placement} data-page-type={offer.tracking.pageType}>
        {`Bei ${offer.label} ansehen`}</a>
    </div>)}
  </div> : operations.purchasable && affiliate.url ? (
    <a
      class="px2-price__cta"
      href={affiliate.url}
      rel={affiliate.rel}
      target={affiliate.target}
    >
      {ctaLabel}
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M14 5h5v5M19 5l-9 9M6 9v10h10v-4"/></svg>
    </a>
  ) : (
    <span class="px2-price__cta is-disabled" aria-disabled="true">
      {operations.availability === "available"
        ? "Kaufquelle noch nicht hinterlegt"
        : "Aktuell keine Kaufempfehlung"}
    </span>
  )}

  <p class="px2-price__note">
    Preis und Verfügbarkeit beim Händler prüfen.
    {" "}<a href="/affiliate-hinweis/">Affiliate-Links</a>
  </p>

  {subscriptionCost && (subscriptionCost.plans.length > 0 || subscriptionCost.additionalCostNote || subscriptionCost.stale || subscriptionCost.freeFunctions.length > 0 || subscriptionCost.paidFunctions.length > 0 || showTotals) && (
    <details class="px2-price__details">
      <summary>Tarife und Berechnung ansehen <span aria-hidden="true">⌄</span></summary>
      <div class="px2-price__details-body">
        {subscriptionCost.additionalCostNote && <p class="px2-price__service-note">{subscriptionCost.additionalCostNote}</p>}
        {subscriptionCost.stale && <p class="px2-price__service-note"><strong>Tarifstand veraltet:</strong> Aktuellen Tarif beim Anbieter prüfen.</p>}
        {subscriptionCost.plans.length > 0 && <div><h3>Tarife</h3><ul>{subscriptionCost.plans.map((plan) => <li><strong>{plan.name}</strong><span>{plan.paymentLabel}</span>{plan.monthlyEquivalentLabel && <small>{plan.monthlyEquivalentLabel}</small>}{plan.billingLabel && <small>{plan.billingLabel}</small>}{plan.notes && <small>{plan.notes}</small>}</li>)}</ul></div>}
        {(subscriptionCost.freeFunctions.length > 0 || subscriptionCost.paidFunctions.length > 0) && <div class="px2-price__functions">{subscriptionCost.freeFunctions.length > 0 && <p><strong>Ohne Abo:</strong> {subscriptionCost.freeFunctions.join(", ")}</p>}{subscriptionCost.paidFunctions.length > 0 && <p><strong>Mit Dienst:</strong> {subscriptionCost.paidFunctions.join(", ")}</p>}</div>}
        {showTotals && <div class="px2-price__calculation"><h3>Rechenbeispiel</h3><dl>{subscriptionCost.totals.months12 && <div><dt>Nach 12 Monaten</dt><dd>{subscriptionCost.totals.months12.label}</dd></div>}{subscriptionCost.totals.months24 && <div><dt>Gesamtkosten nach 2 Jahren</dt><dd>{subscriptionCost.totals.months24.label}</dd></div>}</dl><p>{subscriptionCost.totalDisclaimer}</p></div>}
        <a class="px2-price__source" href={subscriptionCost.source} rel="nofollow noopener" target="_blank">Tarifquelle bei {subscriptionCost.provider} prüfen</a>
      </div>
    </details>
  )}

</section>

<style>
  .px2-offers { display:grid; gap:8px; min-width:0; }
  .px2-offer { display:grid; gap:8px; min-width:0; padding:12px; border:1px solid var(--px2-border); border-radius:12px; }
  .px2-offer__heading { display:flex; flex-wrap:wrap; justify-content:space-between; gap:6px 12px; overflow-wrap:anywhere; }
  .px2-offer small { color:var(--px2-muted); line-height:1.5; overflow-wrap:anywhere; }
  .px2-price {
    display: grid;
    gap: 12px;
    min-width: 0;
    padding: clamp(16px, 3vw, 20px);
    border: 1px solid var(--px2-border);
    border-radius: 20px;
    color: var(--px2-text);
    background: var(--px2-surface);
    box-shadow: var(--px2-shadow);
  }

  .px2-availability {
    padding: 14px;
    border: 1px solid var(--px2-border);
    border-radius: 14px;
    color: var(--px2-text);
    background: var(--px2-amber-soft);
  }

  .px2-availability.is-discontinued,
  .px2-availability.is-out-of-stock {
    background: var(--px2-red-soft);
  }

  .px2-availability strong {
    display: block;
    margin-bottom: 5px;
    color: var(--px2-text);
  }

  .px2-availability p {
    margin: 0;
    color: var(--px2-muted);
    font-size: .88rem;
    line-height: 1.5;
  }

  .px2-price__header {
    display: grid;
    align-items: baseline;
    gap: 8px 18px;
  }

  .px2-price__header h2 {
    margin: 0;
    color: var(--px2-text);
    font-size: clamp(1.2rem, 3vw, 1.45rem);
    line-height: 1.18;
    text-align: left;
  }

  .px2-price__summary {
    display: grid;
    grid-template-columns: 1fr;
    margin: 0;
    border-top: 1px solid var(--px2-border);
    border-bottom: 1px solid var(--px2-border);
  }

  .px2-price__summary > div {
    display: grid;
    align-content: start;
    gap: 5px;
    min-width: 0;
    padding: 10px 0;
  }

  .px2-price__summary.has-service { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 12px; }
  .px2-price__purchase > small { color: var(--px2-muted); font-size: .76rem; }
  .px2-price__purchase dd.is-price-unknown { font-size: 1rem; line-height: 1.4; letter-spacing: normal; }
  .px2-price__summary dt { color: var(--px2-muted); font-size: .72rem; font-weight: 850; letter-spacing: .05em; text-transform: uppercase; }
  .px2-price__summary dd { display: grid; gap: 3px; min-width: 0; margin: 0; color: var(--px2-text); overflow-wrap: anywhere; }
  .px2-price__summary dd > strong { font-size: 1rem; line-height: 1.3; }
  .px2-price__summary dd > span,.px2-price__summary dd > small { color: var(--px2-muted); font-size: .78rem; line-height: 1.35; }

  .px2-price__purchase dd {
    color: var(--px2-text);
    font-size: clamp(1.45rem, 5vw, 2rem);
    font-weight: 950;
    font-variant-numeric: tabular-nums;
    line-height: 1.05;
    letter-spacing: -.035em;
  }

  .px2-price__service.is-required dt,.px2-price__service.is-unknown dt { color: var(--px2-accent-text); }
  .px2-price__service.is-none dt,.px2-price__service.is-included dt { color: var(--px2-green-strong); }
  .px2-price__service-note { margin: 0; color: var(--px2-muted); font-size: .82rem; line-height: 1.5; }
  .px2-price__details { border: 1px solid var(--px2-border); border-radius: 14px; background: var(--px2-surface-soft); overflow: clip; }
  .px2-price__details summary { display: flex; min-height: 44px; align-items: center; justify-content: space-between; gap: 10px; padding: 10px 12px; color: var(--px2-text); cursor: pointer; font-size: .86rem; font-weight: 850; list-style: none; }
  .px2-price__details summary::-webkit-details-marker { display: none; }
  .px2-price__details summary:focus-visible { outline: 3px solid color-mix(in srgb, var(--px2-accent-text) 35%, transparent); outline-offset: -3px; }
  .px2-price__details[open] summary { border-bottom: 1px solid var(--px2-border); background: var(--px2-surface); }
  .px2-price__details[open] summary span { transform: rotate(180deg); }
  .px2-price__details-body { display: grid; gap: 14px; padding: 12px; }
  .px2-price__details-body h3 { margin: 0 0 8px; color: var(--px2-text); font-size: .86rem; }
  .px2-price__details-body ul { display: grid; gap: 8px; margin: 0; padding: 0; list-style: none; }
  .px2-price__details-body li { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 2px 10px; padding-bottom: 8px; border-bottom: 1px solid var(--px2-border); color: var(--px2-text); font-size: .8rem; }
  .px2-price__details-body li span { font-variant-numeric: tabular-nums; text-align: right; }
  .px2-price__details-body li small { grid-column: 1 / -1; color: var(--px2-muted); line-height: 1.35; }
  .px2-price__functions p,.px2-price__calculation p { margin: 0; color: var(--px2-muted); font-size: .78rem; line-height: 1.5; }
  .px2-price__functions p + p { margin-top: 6px; }
  .px2-price__calculation > dl { display: grid; gap: 5px; margin: 0 0 8px; }
  .px2-price__calculation > dl > div { display: flex; justify-content: space-between; gap: 10px; color: var(--px2-text); font-size: .8rem; }
  .px2-price__calculation dd { margin: 0; font-weight: 850; font-variant-numeric: tabular-nums; }
  .px2-price__source { width: fit-content; color: var(--px2-accent-text); font-size: .8rem; font-weight: 800; }

  .px2-price__cta {
    display: flex;
    min-height: 44px;
    box-sizing: border-box;
    align-items: center;
    justify-content: center;
    gap: 9px;
    padding: 10px 12px;
    border: 1px solid var(--px2-green-strong);
    border-radius: 14px;
    color: var(--px2-on-accent);
    background: var(--px2-green-strong);
    font-weight: 900;
    text-align: center;
    text-decoration: none;
  }

  .px2-price__cta:focus-visible { outline: 3px solid var(--px2-accent-text); outline-offset: 3px; }

  .px2-price__cta:hover {
    filter: brightness(1.06);
  }

  .px2-price__cta svg { width: 1rem; height: 1rem; fill: none; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; stroke-width: 2; }

  .px2-price__cta.is-disabled {
    border-color: var(--px2-border);
    color: var(--px2-muted);
    background: var(--px2-surface-soft);
  }

  .px2-price__note {
    margin: 0;
    color: var(--px2-muted);
    font-size: .76rem;
    line-height: 1.45;
  }

  @media (max-width: 410px) {
    .px2-price__summary.has-service { grid-template-columns: 1fr; gap: 0; }
    .px2-price__summary.has-service > div:nth-child(even) { padding-left: 0; border-top: 1px solid var(--px2-border); border-left: 0; }
  }
</style>
