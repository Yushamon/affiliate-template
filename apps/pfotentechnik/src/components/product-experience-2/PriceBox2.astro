---
import type { ProductPriceInsight } from "../../domain/price/types";
import type { SubscriptionCostModel } from "../../domain/subscriptionCosts";

interface Operations {
  availability: "available" | "temporarily-unavailable" | "out-of-stock" | "discontinued" | "unknown";
  availabilityLabel: string;
  availabilityReason?: string;
  purchasable: boolean;
  priceAvailable: boolean;
}

interface Props {
  commerce?: { offers: any[]; cheapestId: string | null; saving: number | null; hasConfiguredOffers: boolean };
  price?: ProductPriceInsight;
  operations: Operations;
  subscriptionCost?: SubscriptionCostModel;
  affiliate: {
    url?: string;
    label: string;
    rel: string;
    target: "_blank" | "_self";
  };
}

const { price, operations, subscriptionCost, commerce } = Astro.props;
const offers = commerce?.offers ?? [];
const merchantOffers = offers.map((offer) => {
  // A legacy price belongs to the legacy product mapping, never to another variant/shop.
  const legacyPrice = offers.length === 1 && offer.legacy && offer.verified && offer.domestic !== false && (!price?.currency || price.currency === offer.currency) ? price?.formattedCurrent : null;
  const displayPrice = offer.formattedPrice || legacyPrice;
  return { ...offer, displayPrice, historicalPrice: !offer.formattedPrice && Boolean(legacyPrice) && (!operations.priceAvailable || price?.isStale) };
});
const showService = Boolean(subscriptionCost && subscriptionCost.status !== "no-subscription");
const serviceLabel = subscriptionCost?.optional ? "Optionales Abo möglich" : subscriptionCost?.label;
const servicePrice = subscriptionCost?.featuredPlan?.current ? subscriptionCost.featuredPlan.paymentLabel : null;
const unavailableCopy = operations.availability === "discontinued"
  ? "Dieses Produkt wurde eingestellt und wird nicht mehr als Hauptempfehlung geführt. Prüfe die Alternativen auf dieser Seite."
  : operations.availability === "temporarily-unavailable"
    ? "Dieses Produkt ist vorübergehend nicht verfügbar. Preis und Lieferbarkeit beim Händler prüfen."
    : operations.availability === "out-of-stock"
      ? "Dieses Produkt ist aktuell nicht lieferbar. Prüfe die Alternativen auf dieser Seite."
      : null;
const showTotals = Boolean(showService && subscriptionCost && (subscriptionCost.totals.months12 || subscriptionCost.totals.months24));
const hasServiceDetails = Boolean(showService && subscriptionCost && (subscriptionCost.plans.length || subscriptionCost.freeFunctions.length || subscriptionCost.paidFunctions.length || subscriptionCost.additionalCostNote || showTotals || subscriptionCost.source));
---

<section class="px2-price" aria-labelledby="px2-price-title" data-availability={operations.availability} data-subscription-status={subscriptionCost?.status}>
  <header class="px2-price__header">
    <h2 id="px2-price-title"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 7h14l1 14H4L5 7Zm4 0V5a3 3 0 0 1 6 0v2" /></svg>Preis &amp; Kaufen</h2>
    <a href="/affiliate-hinweis/">Affiliate-Link</a>
  </header>

  {unavailableCopy && <aside class:list={["px2-availability", `is-${operations.availability}`]} role="status"><p>{unavailableCopy}</p></aside>}

  {merchantOffers.length ? <div class="px2-offers" data-commerce-offers>
    {merchantOffers.map(offer => <article class="px2-offer" data-merchant={offer.merchant} aria-label={`Kaufoption bei ${offer.label}`}>
      <div class="px2-offer__heading"><strong>{offer.label}</strong>{offer.variantLabel && <small>{offer.variantLabel}</small>}</div>
      <div class:list={["px2-offer__main", !offer.displayPrice && "has-no-price"]}>
        {offer.displayPrice && <dl class="px2-price__purchase">
          <dt>{offer.historicalPrice ? "Früherer Anschaffungspreis" : "Anschaffungspreis"}</dt>
          <dd>{offer.displayPrice}</dd>
          <small>{offer.historicalPrice ? (price?.isStale ? "Veralteter Preisstand" : "Nicht aktuell bestätigt") : "Hinterlegter Preis"}</small>
        </dl>}
        <a class="px2-price__cta" href={offer.affiliateUrl} rel={offer.rel} target={offer.target}
          data-affiliate-link data-merchant={offer.merchant} data-product={offer.tracking.product} data-placement={offer.tracking.placement} data-page-type={offer.tracking.pageType} data-cta-kind="regular">
          {`Bei ${offer.label} ansehen`}<span aria-hidden="true">→</span>
        </a>
      </div>
      {Number.isFinite(offer.shipping) && <small>Versand: {offer.shipping.toLocaleString('de-DE', {style:'currency',currency:offer.currency})}</small>}
    </article>)}
  </div> : <p class="px2-price__empty">Derzeit ist keine geprüfte Händleroption hinterlegt.</p>}

  {merchantOffers.length > 0 && <p class="px2-price__note">Preis und Verfügbarkeit beim Händler prüfen.</p>}

  {showService && subscriptionCost && <div class:list={["px2-price__service", `is-${subscriptionCost.tone}`]}>
    {subscriptionCost.requiresPayment && <dl class="px2-price__summary">
      <div><dt>Laufende Kosten</dt><dd><strong>{serviceLabel}</strong><span>{servicePrice || "Tarif beim Anbieter prüfen"}</span>{subscriptionCost.billingLabel && <small>{subscriptionCost.billingLabel}</small>}{subscriptionCost.stale && <small>Tarifstand veraltet</small>}</dd></div>
    </dl>}
    {hasServiceDetails ? <details class="px2-price__details">
      <summary><span class="px2-price__service-title"><strong>{subscriptionCost.requiresPayment ? "Tarife und Berechnung" : serviceLabel}</strong>{!subscriptionCost.requiresPayment && servicePrice && <small>{servicePrice}</small>}{!subscriptionCost.requiresPayment && subscriptionCost.status === "service-included" && <small>{subscriptionCost.runningCostLabel}</small>}{subscriptionCost.optional && subscriptionCost.provider && <small>{subscriptionCost.provider}</small>}</span><span class="px2-price__chevron" aria-hidden="true">⌄</span></summary>
      <div class="px2-price__details-body">
        {subscriptionCost.additionalCostNote && <p>{subscriptionCost.additionalCostNote}</p>}
        {subscriptionCost.stale && <p><strong>Tarifstand veraltet:</strong> Aktuellen Tarif beim Anbieter prüfen.</p>}
        {subscriptionCost.plans.length > 0 && <div><h3>Tarife</h3><ul>{subscriptionCost.plans.map((plan) => <li><strong>{plan.name}</strong>{plan.current && <span>{plan.paymentLabel}</span>}{plan.monthlyEquivalentLabel && <small>{plan.monthlyEquivalentLabel}</small>}{plan.billingLabel && <small>{plan.billingLabel}</small>}{plan.notes && <small>{plan.notes}</small>}</li>)}</ul></div>}
        {(subscriptionCost.freeFunctions.length > 0 || subscriptionCost.paidFunctions.length > 0) && <div class="px2-price__functions">{subscriptionCost.freeFunctions.length > 0 && <p><strong>Ohne Abo:</strong> {subscriptionCost.freeFunctions.join(", ")}</p>}{subscriptionCost.paidFunctions.length > 0 && <p><strong>Mit Dienst:</strong> {subscriptionCost.paidFunctions.join(", ")}</p>}</div>}
        {showTotals && <div class="px2-price__calculation"><h3>Rechenbeispiel</h3><dl>{subscriptionCost.totals.months12 && <div><dt>Nach 12 Monaten</dt><dd>{subscriptionCost.totals.months12.label}</dd></div>}{subscriptionCost.totals.months24 && <div><dt>Gesamtkosten nach 2 Jahren</dt><dd>{subscriptionCost.totals.months24.label}</dd></div>}</dl><p>{subscriptionCost.totalDisclaimer}</p></div>}
        {subscriptionCost.source && <a class="px2-price__source" href={subscriptionCost.source} rel="nofollow noopener" target="_blank">Tarifquelle bei {subscriptionCost.provider} prüfen</a>}
      </div>
    </details> : !subscriptionCost.requiresPayment && <p class="px2-price__service-title"><strong>{serviceLabel}</strong>{servicePrice && <small>{servicePrice}</small>}{subscriptionCost.status === "service-included" && <small>{subscriptionCost.runningCostLabel}</small>}</p>}
  </div>}

  {merchantOffers.length > 0 && <p class="px2-price__disclosure">Bei einem Kauf über diese Links erhalten wir ggf. eine Provision.</p>}
</section>

<style>
  .px2-price { display: grid; gap: 10px; min-width: 0; padding: 14px; border: 1px solid var(--px2-border); border-radius: 18px; color: var(--px2-text); background: var(--px2-green-soft); }
  .px2-price__header { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
  .px2-price__header h2 { display: flex; align-items: center; gap: 8px; margin: 0; font-size: 1rem; line-height: 1.3; }
  .px2-price__header svg { width: 20px; height: 20px; flex: 0 0 auto; fill: none; stroke: var(--px2-accent-text); stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .px2-price__header > a { color: var(--px2-muted); font-size: .72rem; text-underline-offset: 3px; }
  .px2-offers { display: grid; gap: 8px; min-width: 0; }
  .px2-offer { display: grid; gap: 8px; min-width: 0; padding: 12px; border: 1px solid var(--px2-border); border-radius: 14px; background: var(--px2-surface); }
  .px2-offer__heading { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 4px 10px; overflow-wrap: anywhere; }
  .px2-offer__heading > strong { font-size: 1rem; }
  .px2-offer__main { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 14px; }
  .px2-price__purchase { display: grid; flex: 1 1 100px; gap: 4px; margin: 0; min-width: 0; }
  .px2-price__purchase dt { font-size: .65rem; color: var(--px2-muted); }
  .px2-price__purchase dd { margin: 0; color: var(--px2-text); font-size: clamp(1.5rem, 6vw, 2rem); font-weight: 900; font-variant-numeric: tabular-nums; line-height: 1.1; letter-spacing: -.035em; }
  .px2-offer small { color: var(--px2-muted); font-size: .72rem; line-height: 1.35; overflow-wrap: anywhere; }
  .px2-price__cta { display: flex; flex: 1 1 max-content; min-width: 0; min-height: 48px; box-sizing: border-box; align-items: center; justify-content: center; gap: 8px; padding: 12px; border: 1px solid var(--px2-green-strong); border-radius: 12px; color: var(--px2-on-accent); color: light-dark(var(--px2-on-accent), var(--pt-color-page)); background: var(--pt-color-action-bg-hover); font-size: .9rem; font-weight: 850; text-align: center; text-decoration: none; overflow-wrap: anywhere; }
  .px2-price__cta:hover { filter: brightness(.96); }
  .px2-price__cta:focus-visible, .px2-price__details summary:focus-visible { outline: 3px solid var(--px2-accent-text); outline-offset: 3px; }
  .px2-price__summary { margin: 0; padding: 10px 12px; border: 1px solid var(--px2-border); border-radius: 12px; background: var(--px2-surface); }
  .px2-price__summary dt { color: var(--px2-muted); font-size: .72rem; }
  .px2-price__summary dd { display: grid; gap: 4px; margin: 4px 0 0; font-size: .86rem; }
  .px2-price__summary small { color: var(--px2-muted); font-size: .76rem; }
  .px2-price__service { display: grid; gap: 8px; min-width: 0; }
  .px2-price__service-title { display: grid; gap: 3px; min-width: 0; margin: 0; font-size: .84rem; line-height: 1.35; }
  .px2-price__service-title small { color: var(--px2-muted); font-size: .75rem; font-weight: 400; }
  .px2-price__details { min-width: 0; border: 1px solid var(--px2-border); border-radius: 12px; background: var(--px2-surface); overflow: clip; }
  .px2-price__details summary { display: flex; min-height: 48px; align-items: center; justify-content: space-between; gap: 8px; padding: 10px 12px; color: var(--px2-text); cursor: pointer; list-style: none; }
  .px2-price__details summary::-webkit-details-marker { display: none; }
  .px2-price__details[open] summary { border-bottom: 1px solid var(--px2-border); }
  .px2-price__details[open] .px2-price__chevron { transform: rotate(180deg); }
  .px2-price__details-body { display: grid; gap: 12px; padding: 12px; font-size: .8rem; overflow-wrap: anywhere; }
  .px2-price__details-body h3 { margin: 0 0 8px; color: var(--px2-text); font-size: .86rem; }
  .px2-price__details-body p { margin: 0; color: var(--px2-muted); font-size: .78rem; line-height: 1.5; }
  .px2-price__details-body ul { display: grid; gap: 8px; margin: 0; padding: 0; list-style: none; }
  .px2-price__details-body li { display: grid; gap: 3px; }
  .px2-price__details-body small { color: var(--px2-muted); }
  .px2-price__calculation > dl { display: grid; gap: 5px; margin: 0 0 8px; }
  .px2-price__calculation > dl > div { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 6px; }
  .px2-price__calculation dd { margin: 0; font-weight: 800; }
  .px2-price__source { color: var(--px2-accent-text); font-size: .8rem; }
  .px2-price__note, .px2-price__disclosure, .px2-price__empty { margin: 0; color: var(--px2-muted); font-size: .75rem; line-height: 1.45; }
  .px2-price__disclosure { font-size: .7rem; }
  .px2-availability { padding: 10px; border: 1px solid var(--px2-border); border-radius: 12px; background: var(--px2-amber-soft); }
  .px2-availability p { margin: 0; font-size: .82rem; line-height: 1.4; }
  @media (max-width: 410px) { .px2-offer__main { gap: 8px; } .px2-price__cta > span { display: none; } }
</style>
