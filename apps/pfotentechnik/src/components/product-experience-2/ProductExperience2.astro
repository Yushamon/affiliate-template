---
import type { ProductExperienceModel } from "../../domain/productExperience/model";
import ProductHero2 from "./ProductHero2.astro";
import ProductVerdict2 from "./ProductVerdict2.astro";
import ProductEvidence2 from "./ProductEvidence2.astro";
import ProductCommunityInsights2 from "./ProductCommunityInsights2.astro";
import ProductDecisionFacts2 from "./ProductDecisionFacts2.astro";
import ProductPurchaseMistakes2 from "./ProductPurchaseMistakes2.astro";
import ProductEverydayTimeline from "./ProductEverydayTimeline.astro";
import ProductCategoryFitAssistant from "./ProductCategoryFitAssistant.astro";
import ProductDetails2 from "./ProductDetails2.astro";
import ProductAlternatives2 from "./ProductAlternatives2.astro";

interface Props {
  model: ProductExperienceModel;
}

const { model } = Astro.props;
---

<article class="px2" data-product-experience="2.1" data-product-layout="decision-first">
  <ProductHero2 model={model} />
  <ProductVerdict2 model={model} />
  <ProductEvidence2 evidence={model.evidenceSummary} updatedAt={model.updatedAt} />
  <ProductCommunityInsights2 insights={model.communityInsights} />
  <ProductDecisionFacts2 facts={model.decisionFacts} />
  <ProductPurchaseMistakes2 items={model.purchaseMistakes} />
  <ProductEverydayTimeline
    items={model.timeline}
    heading={model.usageHeading}
    eyebrow={model.usageEyebrow}
  />
  <ProductCategoryFitAssistant
    profile={model.categoryFitProfile}
    alternatives={model.alternatives}
  />
  <ProductDetails2 model={model} />
  <ProductAlternatives2 alternatives={model.alternatives.slice(0, 3)} />
</article>

<style>
  .px2 {
    --px2-surface: #fff;
    --px2-surface-soft: #f3f7f4;
    --px2-surface-raised: #f8fbf8;
    --px2-text: #17211b;
    --px2-muted: #5d6d63;
    --px2-border: #d6e2da;
    --px2-green: #2e7d32;
    --px2-green-strong: #1f6426;
    --px2-green-soft: #e2f3e5;
    --px2-amber: #8a5b00;
    --px2-amber-soft: #fff4d8;
    --px2-red: #a92822;
    --px2-red-soft: #fee9e7;
    --px2-indigo: #4f46e5;
    --px2-shadow: 0 14px 42px rgba(31, 64, 39, .08);
    --px2-on-accent: #fff;
    display: grid;
    gap: clamp(24px, 4vw, 46px);
    width: 100%;
    min-width: 0;
    color: var(--px2-text);
  }

  :global(html[data-theme="dark"]) .px2,
  :global(html.dark) .px2,
  :global(body[data-theme="dark"]) .px2 {
    color-scheme: dark;
    --px2-surface: #101b16;
    --px2-surface-soft: #18271f;
    --px2-surface-raised: #142119;
    --px2-text: #eef7f0;
    --px2-muted: #b5c4ba;
    --px2-border: #304137;
    --px2-green: #72d889;
    --px2-green-strong: #92e8a5;
    --px2-green-soft: #183b23;
    --px2-amber: #ffd27a;
    --px2-amber-soft: #3b2d13;
    --px2-red: #ffaaa2;
    --px2-red-soft: #43201f;
    --px2-indigo: #a5b4fc;
    --px2-shadow: none;
    --px2-on-accent: #07120a;
  }

  .px2 :global(*) {
    box-sizing: border-box;
  }

</style>
