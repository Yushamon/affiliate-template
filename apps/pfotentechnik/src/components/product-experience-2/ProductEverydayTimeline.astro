---
interface Props {
  items: Array<{ step: string; title: string; text: string }>;
  heading?: string;
  eyebrow?: string;
}

const {
  items,
  heading = "So funktioniert die Nutzung im Alltag",
  eyebrow = "Nutzung verständlich eingeordnet"
} = Astro.props;
---

<section class="timeline" aria-labelledby="timeline-title">
  <header>
    <span>{eyebrow}</span>
    <h2 id="timeline-title">{heading}</h2>
  </header>
  <ol>
    {items.map((item) => (
      <li>
        <b aria-hidden="true">{item.step}</b>
        <div><h3>{item.title}</h3><p>{item.text}</p></div>
      </li>
    ))}
  </ol>
</section>

<style>
  .timeline {
    padding: 16px;
    border: 1px solid var(--px2-border);
    border-radius: 20px;
    background: var(--px2-surface);
    box-shadow: var(--px2-shadow);
  }

  .timeline header span {
    color: var(--px2-accent-text);
    font-size: .74rem;
    font-weight: 850;
    letter-spacing: .07em;
    text-transform: uppercase;
  }

  .timeline h2 {
    margin: 5px 0 18px;
    font-size: clamp(1.4rem, 6vw, 2rem);
    letter-spacing: -.025em;
  }

  .timeline ol {
    display: grid;
    gap: 14px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .timeline li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 11px;
    min-width: 0;
  }

  .timeline li > b {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: var(--px2-green-soft);
    color: var(--px2-accent-text);
    font-size: .76rem;
  }

  .timeline h3 {
    margin: 1px 0 5px;
    font-size: .98rem;
  }

  .timeline p {
    margin: 0;
    color: var(--px2-muted);
    font-size: .9rem;
    line-height: 1.5;
  }

  @media (min-width: 720px) {
    .timeline {
      padding: 22px;
    }

    .timeline ol {
      grid-template-columns: 1fr 1fr;
      gap: 18px;
    }
  }

  @media (min-width: 1040px) {
    .timeline ol {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
