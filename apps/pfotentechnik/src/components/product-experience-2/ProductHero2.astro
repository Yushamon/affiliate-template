---
import EditorialScore from "@affiliate-core/components/EditorialScore.astro";
import type { ProductExperienceModel } from "../../domain/productExperience/model";
import ProductGallery29 from "./ProductGallery29.astro";
import PriceBox2 from "./PriceBox2.astro";

interface Props {
  model: ProductExperienceModel;
  reference?: boolean;
}

const { model, reference = false } = Astro.props;
const suitableFor = model.suitabilitySummary;
const mainBenefit = model.benefits[0] ?? model.reviewVerdict;
const suitabilitySignals = model.idealFor.slice(0, 3);
---

<section class:list={["px2-hero", { "px2-hero--reference33": reference }]} aria-labelledby="px2-product-title">
  <div class="px2-hero__media">
    <ProductGallery29 name={model.name} items={model.gallery} reference={reference} />
  </div>

  <div class="px2-hero__content">
    <div class="px2-hero__meta">
      {model.categoryHref ? <a href={model.categoryHref}>{model.category}</a> : <span>{model.category}</span>}
      {model.manufacturer && (
        model.manufacturerHref
          ? <a href={model.manufacturerHref}>{model.manufacturer}</a>
          : <span>{model.manufacturer}</span>
      )}
    </div>

    <h1 id="px2-product-title">{model.name}</h1>
    <p class="px2-hero__lead">{model.recommendation}</p>

    <div class="px2-hero__scoreline">
      {reference && <span class="px2-hero__score-label">Redaktionelle Einordnung</span>}
      {model.score != null && model.score > 0 ? (
        <EditorialScore
          value={model.score}
          scale={100}
          variant="ring"
          description="Redaktionelle Eignungsbewertung auf Basis der dokumentierten Quellen."
        />
      ) : (
        <div class="px2-hero__score-pending" role="status">
          <strong>Noch nicht bewertet</strong>
          <span>Eine vollständige Kriterienbewertung liegt noch nicht vor.</span>
        </div>
      )}
    </div>

    {reference ? (
      <div class="px2-hero__suitability" aria-label="Passt besonders zu">
        <span>Passt besonders zu</span>
        <ul>{suitabilitySignals.map((item) => <li>{item}</li>)}</ul>
      </div>
    ) : (
      <dl class="px2-hero__decision">
        <div>
          <dt>Geeignet für</dt>
          <dd>{suitableFor}</dd>
        </div>
        <div>
          <dt>Wichtigster Vorteil</dt>
          <dd>{mainBenefit}</dd>
        </div>
        <div class="is-limitation">
          <dt>Größte Einschränkung</dt>
          <dd>{model.mainLimitation}</dd>
        </div>
      </dl>
    )}

    <PriceBox2 price={model.price} affiliate={model.affiliate} operations={model.operations} />

    <a class="px2-hero__compare" href={model.comparisonHref}>
      {model.comparisonLabel}
      <span aria-hidden="true">→</span>
    </a>
  </div>
</section>

<style>
.px2-hero {
    display: grid;
    gap: 14px;
    width: 100%;
    min-width: 0;
    margin: 0;
  }

  .px2-hero__media {
    width: 100%;
    min-width: 0;
    margin: 0;
  }

  .px2-hero__content {
    display: grid;
    gap: 15px;
    min-width: 0;
    padding: 16px;
    border: 1px solid var(--px2-border);
    border-radius: 20px;
    background: var(--px2-surface);
    box-shadow: var(--px2-shadow);
  }

  .px2-hero__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
  }

  .px2-hero__meta a,
  .px2-hero__meta span {
    display: inline-flex;
    padding: 5px 9px;
    border-radius: 999px;
    background: var(--px2-surface-soft);
    color: var(--px2-muted);
    font-size: .76rem;
    font-weight: 800;
    text-decoration: none;
  }

  .px2-hero h1 {
    margin: 0;
    color: var(--px2-text);
    font-size: clamp(2rem, 10vw, 3.2rem);
    line-height: 1;
    letter-spacing: -.04em;
    overflow-wrap: anywhere;
  }

  .px2-hero__lead {
    margin: 0;
    color: var(--px2-muted);
    font-size: 1rem;
    line-height: 1.55;
  }

  .px2-hero__scoreline {
    min-width: 0;
  }

  .px2-hero__score-label {
    display: block;
    margin-bottom: 8px;
    color: var(--px2-muted);
    font-size: .75rem;
    font-weight: 800;
    letter-spacing: .06em;
    text-transform: uppercase;
  }

  .px2-hero__suitability > span {
    color: var(--px2-muted);
    font-size: .75rem;
    font-weight: 800;
    letter-spacing: .06em;
    text-transform: uppercase;
  }

  .px2-hero__suitability ul {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 8px 0 0;
    padding: 0;
    list-style: none;
  }

  .px2-hero__suitability li {
    padding: 7px 10px;
    border: 1px solid var(--px2-border);
    border-radius: var(--pt33-radius-pill, 999px);
    color: var(--px2-text);
    font-size: .82rem;
    font-weight: 700;
    line-height: 1.25;
  }

  .px2-hero--reference33 {
    gap: clamp(24px, 4vw, 56px);
    align-items: center;
  }

  .px2-hero--reference33 .px2-hero__content {
    display: contents;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
  }

  .px2-hero--reference33 .px2-hero__media { order: 1; }
  .px2-hero--reference33 .px2-hero__meta { order: 2; }
  .px2-hero--reference33 h1 { order: 3; }
  .px2-hero--reference33 .px2-hero__lead { order: 4; }
  .px2-hero--reference33 .px2-hero__scoreline { order: 5; }
  .px2-hero--reference33 .px2-hero__suitability { order: 6; }
  .px2-hero--reference33 :global(.px2-price) { order: 7; }
  .px2-hero--reference33 .px2-hero__compare { order: 8; }

  .px2-hero--reference33 .px2-hero__meta a,
  .px2-hero--reference33 .px2-hero__meta span {
    padding: 0;
    border-radius: 0;
    background: transparent;
    color: var(--px2-accent-text);
    font-size: .78rem;
    letter-spacing: .06em;
    text-transform: uppercase;
  }

  .px2-hero--reference33 .px2-hero__lead { max-width: 38rem; font-size: var(--pt33-font-body, 1.125rem); line-height: var(--pt33-leading-body, 1.6); }
  .px2-hero--reference33 .px2-hero__scoreline { display: grid; grid-template-columns: auto 1fr; gap: 12px; align-items: center; padding-block: 14px; border-block: 1px solid var(--px2-border); }
  .px2-hero--reference33 .px2-hero__score-label { margin: 0; }
  .px2-hero--reference33 .px2-hero__scoreline :global(.pt-score) { justify-self: start; }
  .px2-hero--reference33 :global(.px2-price) { padding: 0; border: 0; border-radius: 0; background: transparent; box-shadow: none; }
  .px2-hero--reference33 :global(.px2-price__header) { display: none; }
  .px2-hero--reference33 :global(.px2-price__amount) { display: flex; justify-content: flex-start; padding: 0 0 10px; border-top: 0; }
  .px2-hero--reference33 :global(.px2-price__amount strong) { font-size: clamp(1.35rem, 6vw, 1.8rem); }
  .px2-hero--reference33 :global(.px2-price__note) { font-size: .78rem; }

  .px2-hero__score-pending {
    display: grid;
    gap: 3px;
    padding: 12px 13px;
    border: 1px solid var(--px2-border);
    border-radius: 14px;
    background: var(--px2-surface-raised);
  }

  .px2-hero__score-pending strong {
    color: var(--px2-text);
    font-size: .92rem;
  }

  .px2-hero__score-pending span {
    color: var(--px2-muted);
    font-size: .76rem;
    line-height: 1.42;
  }

  .px2-hero__scoreline :global(.pt-score) {
    --score-surface: var(--px2-surface);
    --score-text: var(--px2-text);
    --score-muted: var(--px2-muted);
    --score-accent: var(--px2-green);
  }

  .px2-hero__decision {
    display: grid;
    gap: 8px;
    margin: 0;
  }

  .px2-hero__decision > div {
    min-width: 0;
    padding: 12px 13px;
    border: 1px solid var(--px2-border);
    border-radius: 14px;
    background: var(--px2-surface-raised);
  }

  .px2-hero__decision > div:first-child {
    background: var(--px2-green-soft);
  }

  .px2-hero__decision .is-limitation {
    background: var(--px2-red-soft);
  }

  .px2-hero__decision dt {
    margin-bottom: 4px;
    color: var(--px2-muted);
    font-size: .7rem;
    font-weight: 900;
    letter-spacing: .055em;
    text-transform: uppercase;
  }

  .px2-hero__decision dd {
    margin: 0;
    color: var(--px2-text);
    font-size: .92rem;
    font-weight: 750;
    line-height: 1.45;
    overflow-wrap: anywhere;
  }

  .px2-hero__compare {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 48px;
    padding: 11px 15px;
    border: 1px solid var(--px2-border);
    border-radius: 14px;
    color: var(--px2-text);
    font-weight: 850;
    text-decoration: none;
  }

  .px2-hero__compare:hover,
  .px2-hero__compare:focus-visible {
    border-color: var(--px2-accent-text);
    color: var(--px2-accent-text);
  }

  @media (max-width: 759px) {
    .px2-hero--reference33 { gap: var(--pt33-space-6, 24px); }
    .px2-hero__media {
      width: 100%;
      max-width: none;
      margin: 0;
    }

    .px2-hero--reference33 .px2-hero__scoreline {
      grid-template-columns: minmax(0, 1fr);
      gap: 8px;
    }

    .px2-hero--reference33 .px2-hero__scoreline :global(.pt-score) {
      width: 100%;
    }

    .px2-hero__content {
      width: calc(100% - 2 * var(--pt-page-gutter));
      margin-inline: auto;
    }
  }

  @media (min-width: 760px) {
    .px2-hero__content {
      padding: 22px;
    }

    .px2-hero__decision {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 980px) {
    .px2-hero {
      grid-template-columns: minmax(0, 1.12fr) minmax(360px, .88fr);
      gap: clamp(24px, 4vw, 48px);
      align-items: start;
    }

    .px2-hero__content {
      margin-inline: 0;
      padding: clamp(22px, 2.5vw, 30px);
    }

    .px2-hero h1 {
      font-size: clamp(2.3rem, 4vw, 4rem);
      overflow-wrap: normal;
    }

    .px2-hero__decision {
      grid-template-columns: 1fr;
    }

    .px2-hero--reference33 { grid-template-columns: minmax(0, 1.1fr) minmax(23rem, .9fr); }
    .px2-hero--reference33 .px2-hero__media { grid-column: 1; grid-row: 1 / span 8; }
    .px2-hero--reference33 :is(.px2-hero__meta, h1, .px2-hero__lead, .px2-hero__scoreline, .px2-hero__suitability, .px2-hero__compare) { grid-column: 2; }
    .px2-hero--reference33 :global(.px2-price) { grid-column: 2; }
  }
</style>
