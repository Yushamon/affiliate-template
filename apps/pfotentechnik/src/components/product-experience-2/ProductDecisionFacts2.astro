---
interface DecisionFact {
  label: string;
  value: string;
  consequence: string;
  source: "product-data" | "technical-specification" | "editorial";
}

interface Props {
  facts?: DecisionFact[];
}

const { facts = [] } = Astro.props;
---

{facts.length > 0 && (
  <section class="decision-facts" aria-labelledby="decision-facts-title">
    <header>
      <span>Eigenschaft und Konsequenz</span>
      <h2 id="decision-facts-title">Was die Daten wirklich bedeuten</h2>
    </header>

    <dl>
      {facts.map((fact) => (
        <div>
          <dt>
            <span>{fact.label}</span>
            <strong>{fact.value}</strong>
          </dt>
          <dd>
            <span aria-hidden="true">→</span>
            <p>{fact.consequence}</p>
          </dd>
        </div>
      ))}
    </dl>
  </section>
)}

<style>
  .decision-facts {
    display: grid;
    gap: 16px;
    padding: 16px;
    border: 1px solid var(--px2-border);
    border-radius: 20px;
    background: var(--px2-surface);
  }

  .decision-facts header > span {
    color: var(--px2-green-strong);
    font-size: .72rem;
    font-weight: 850;
    letter-spacing: .07em;
    text-transform: uppercase;
  }

  .decision-facts h2 {
    margin: 4px 0 0;
    font-size: clamp(1.35rem, 5.5vw, 1.9rem);
    letter-spacing: -.025em;
  }

  .decision-facts dl {
    display: grid;
    gap: 10px;
    margin: 0;
  }

  .decision-facts dl > div {
    display: grid;
    gap: 10px;
    min-width: 0;
    padding: 15px;
    border: 1px solid var(--px2-border);
    border-radius: 15px;
    background: var(--px2-surface-raised);
  }

  .decision-facts dt {
    display: grid;
    gap: 3px;
    min-width: 0;
  }

  .decision-facts dt span {
    color: var(--px2-muted);
    font-size: .7rem;
    font-weight: 850;
    letter-spacing: .055em;
    text-transform: uppercase;
  }

  .decision-facts dt strong {
    color: var(--px2-text);
    font-size: clamp(1.05rem, 4.5vw, 1.3rem);
    line-height: 1.25;
    overflow-wrap: anywhere;
  }

  .decision-facts dd {
    display: grid;
    grid-template-columns: 1.2rem minmax(0, 1fr);
    gap: 7px;
    margin: 0;
    color: var(--px2-muted);
    font-size: .89rem;
    line-height: 1.5;
  }

  .decision-facts dd > span {
    color: var(--px2-green-strong);
    font-weight: 900;
  }

  .decision-facts dd p {
    margin: 0;
  }

  @media (min-width: 720px) {
    .decision-facts {
      padding: 22px;
    }

    .decision-facts dl {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 1040px) {
    .decision-facts dl {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
