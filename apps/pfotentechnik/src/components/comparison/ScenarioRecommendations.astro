---
import type { ComparisonViewModel } from "@affiliate-core/comparison/model";
import EditorialScore from "@affiliate-core/components/EditorialScore.astro";
import ComparisonPriceSignal from "@affiliate-core/components/comparison/ComparisonPriceSignal.astro";

type Props = {
  scenarios: NonNullable<ComparisonViewModel["scenarioRecommendations"]>;
};

const { scenarios } = Astro.props;
---

{scenarios.length > 0 && (
  <section class="scenario-recommendations" aria-labelledby="scenario-title" data-comparison-scenarios>
    <div class="scenario-heading">
      <span>Automatisch eingeordnet</span>
      <h2 id="scenario-title">Empfehlungen nach Einsatzzweck</h2>
      <p>Die Auswahl berücksichtigt Eignung, redaktionellen Score und das aktuell hinterlegte Preisniveau.</p>
    </div>

    <div class="scenario-grid">
      {scenarios.map((scenario) => (
        <article class="pt-surface scenario-card">
          <div class="scenario-card__topline">
            <p class="scenario-label">{scenario.label}</p>
            <span class="scenario-match">{Math.max(0, Math.min(100, Math.round(scenario.score)))}/100 Fit</span>
          </div>
          <h3>
            <a href={scenario.winner.href}>{scenario.winner.title}</a>
          </h3>
          <p>{scenario.reason}</p>
          {typeof scenario.winner.rating === "number" && (
            <EditorialScore
              value={scenario.winner.rating}
              scale={100}
              variant="ring-compact"
              description="Redaktioneller Gesamtscore"
            />
          )}
          <ComparisonPriceSignal price={scenario.winner.price} />
          <div class="scenario-meta">
            {scenario.alternative && (
              <a href={scenario.alternative.href}>
                Alternative: {scenario.alternative.title}
              </a>
            )}
          </div>
        </article>
      ))}
    </div>
  </section>
)}

<style>
  .scenario-recommendations {
    width: 100%;
    min-width: 0;
    margin: 0;
  }
  .scenario-heading {
    max-width: 760px;
    margin-bottom: 1.5rem;
  }
  .scenario-heading > span,
  .scenario-label {
    color: var(--comparison-accent);
    font-size: .78rem;
    font-weight: 800;
    letter-spacing: .08em;
    text-transform: uppercase;
  }
  .scenario-heading h2 {
    margin: .35rem 0 .6rem;
    color: var(--comparison-text);
  }
  .scenario-heading p,
  .scenario-card > p {
    color: var(--comparison-muted);
  }
  .scenario-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: 1rem;
    min-width: 0;
  }
  .scenario-card {
    display: grid;
    min-width: 0;
    gap: .72rem;
    padding: 1.15rem;
    border: 1px solid var(--comparison-line);
    border-radius: 1rem;
    color: var(--comparison-text);
    background: var(--comparison-surface);
    box-shadow: 0 8px 24px color-mix(in srgb, var(--comparison-text) 7%, transparent);
  }
  .scenario-card__topline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: .75rem;
  }
  .scenario-label {
    margin: 0;
  }
  .scenario-match {
    flex: 0 0 auto;
    padding: .24rem .55rem;
    border-radius: 999px;
    color: var(--comparison-accent);
    background: color-mix(in srgb, var(--comparison-accent) 10%, var(--comparison-surface));
    font-size: .72rem;
    font-weight: 850;
  }
  .scenario-card h3 {
    margin: 0;
    font-size: 1.08rem;
    overflow-wrap: anywhere;
  }
  .scenario-card h3 a,
  .scenario-meta a {
    color: inherit;
  }
  .scenario-card a:hover {
    color: var(--comparison-accent);
  }
  .scenario-card a:focus-visible {
    outline: 3px solid var(--comparison-focus);
    outline-offset: 3px;
    border-radius: .25rem;
  }
  .scenario-card :global(.pt-score) {
    --score-surface: var(--comparison-surface);
    --score-text: var(--comparison-text);
    --score-muted: var(--comparison-muted);
  }
  .scenario-meta {
    display: flex;
    flex-wrap: wrap;
    gap: .55rem 1rem;
    min-width: 0;
    font-size: .86rem;
    font-weight: 700;
  }
  .scenario-meta > * {
    min-width: 0;
    overflow-wrap: anywhere;
  }
  @media (max-width: 760px) {
    .scenario-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .scenario-card {
      padding: 1.05rem;
    }
  }
</style>
