---
interface Props {
  summary: string;
  open?: boolean;
}

const { summary, open = false } = Astro.props;
---

<details class="pt-disclosure" open={open || undefined}>
  <summary>
    <span>{summary}</span>
    <svg class="pt-disclosure__icon" viewBox="0 0 20 20" aria-hidden="true">
      <path d="m5 7.5 5 5 5-5" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" />
    </svg>
  </summary>
  <div class="pt-disclosure__body">
    <slot />
  </div>
</details>
