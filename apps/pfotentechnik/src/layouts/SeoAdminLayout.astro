---
import "../styles/seo-admin.css";

type ActiveKey =
  | "overview"
  | "cockpit"
  | "advisor"
  | "tasks"
  | "history"
  | "prompts"
  | "prices"
  | "media"
  | "products"
  | "product-workspace"
  | "topical-authority";

interface Props {
  title: string;
  description: string;
  active?: ActiveKey;
}

const { title, description, active = "overview" } = Astro.props;
const area =
  ["overview", "advisor", "tasks", "prompts"].includes(active) ? "work" :
  ["cockpit", "topical-authority"].includes(active) ? "search" :
  ["prices", "media", "products", "product-workspace"].includes(active) ? "products" :
  "system";

const primaryNav = [
  ["work", "/admin/seo/", "Arbeit"],
  ["search", "/admin/seo/cockpit/", "Search"],
  ["products", "/admin/seo/products/", "Produkte"],
  ["system", "/admin/seo/history/", "System"],
] as const;

const contextNav = {
  work: [
    ["overview", "/admin/seo/", "Arbeitsübersicht"],
    ["advisor", "/admin/seo/advisor/", "Findings"],
    ["tasks", "/admin/seo/tasks/", "Aufgaben"],
    ["prompts", "/admin/seo/prompts/", "Prompt Registry"],
  ],
  search: [
    ["cockpit", "/admin/seo/cockpit/", "Cockpit"],
    ["topical-authority", "/admin/seo/topical-authority/", "Topical Authority"],
  ],
  products: [
    ["products", "/admin/seo/products/", "Seiten-Workspaces"],
    ["prices", "/admin/seo/prices/", "Produktpflege"],
    ["media", "/admin/seo/media/", "Media"],
  ],
  system: [
    ["history", "/admin/seo/history/", "Historie"],
  ],
} as const;
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="color-scheme" content="light dark" />
    <title>{title} | PfotenTechnik SEO</title>
    <script is:inline>
      (() => {
        const saved = localStorage.getItem("pfotentechnik-seo-theme");
        if (saved === "light" || saved === "dark") document.documentElement.dataset.theme = saved;
      })();
    </script>
  </head>
  <body>
    <div class="seo-shell">
      <div class="seo-topbar">
        <a class="seo-brand" href="/admin/seo/">
          <span class="seo-brand-mark" aria-hidden="true">PT</span>
          SEO Operations
        </a>
        <button class="seo-theme" type="button" data-theme-toggle aria-label="Farbschema wechseln">
          Theme wechseln
        </button>
      </div>

      <nav class="seo-nav" aria-label="SEO-Hauptbereiche">
        {primaryNav.map(([key, href, label]) => (
          <a href={href} aria-current={area === key ? "page" : undefined}>{label}</a>
        ))}
      </nav>

      <nav class="seo-context-nav" aria-label="Bereichsnavigation">
        {contextNav[area].map(([key, href, label]) => (
          <a href={href} aria-current={active === key ? "page" : undefined}>{label}</a>
        ))}
      </nav>

      <header class="seo-page-header">
        <div>
          <div class="seo-eyebrow">PfotenTechnik Quality Operations</div>
          <h1>{title}</h1>
          <p>{description}</p>
        </div>
      </header>

      <slot />
    </div>

    <script is:inline>
      document.querySelector("[data-theme-toggle]")?.addEventListener("click", () => {
        const current = document.documentElement.dataset.theme;
        const next = current === "dark" ? "light" : "dark";
        document.documentElement.dataset.theme = next;
        localStorage.setItem("pfotentechnik-seo-theme", next);
      });
    </script>
  </body>
</html>
