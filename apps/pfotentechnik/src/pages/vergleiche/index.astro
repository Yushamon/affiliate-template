---
import ProjectLayout from "../../layouts/ProjectLayout.astro";
import { getContentByHub } from "@app/domain/content";
import { buildComparisonOverviewModel } from "../../domain/comparison/buildComparisonOverviewModel";
import { siteMeta } from "../../project.config";

const comparisons = await getContentByHub("vergleiche");
const overview = buildComparisonOverviewModel(comparisons);
---

<ProjectLayout
  title="Vergleiche für smarte Haustiertechnik"
  seoTitle="Futterautomaten und Pet-Tech-Produkte im Vergleich"
  description="Vergleiche Futterautomaten, Hersteller und Funktionen. Finde schneller heraus, welches Produkt zu deinem Tier und deinem Alltag passt."
  canonical="/vergleiche/"
  author={siteMeta.defaultAuthor}
  mainClass="container--comparison-overview"
>
  <section class="comparison-hub-hero">
    <span>Vergleiche</span>
    <h1>Welcher Vergleich hilft dir bei deiner Entscheidung?</h1>
    <p>
      Starte mit dem Produktbereich, der zu deiner Aufgabe passt. Die Vergleiche
      ordnen Modelle nach Anwendungsfall ein und machen relevante Unterschiede sichtbar.
    </p>
  </section>

  <div class="comparison-hub" data-comparison-overview="demand-led">
    <section class="comparison-chapter comparison-chapter--priority" aria-labelledby="priority-heading">
      <header>
        <span>Häufige Entscheidungen</span>
        <h2 id="priority-heading">Die wichtigsten Produktbereiche</h2>
        <p>Diese Einstiege decken die breitesten Produktwelten und die häufigsten konkreten Auswahlfragen ab.</p>
      </header>

      <div class="comparison-priority-grid" data-comparison-overview-group="primary">
        {overview.primaryAreas.map((area, index) => (
          <article class="pt-surface comparison-priority-card" data-overview-rank={index + 1}>
            <div class="comparison-icon" aria-hidden="true">{area.icon}</div>
            <div>
              <a class="comparison-category-link" href={area.categoryHref}>{area.categoryLabel}</a>
              <h3>{area.question}</h3>
              <p>{area.reason}</p>
              <a class="comparison-action" href={area.href}>{area.title} <span aria-hidden="true">→</span></a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="comparison-chapter comparison-chapter--areas" aria-labelledby="areas-heading">
      <header>
        <span>Weitere Produktbereiche</span>
        <h2 id="areas-heading">Direkt zur passenden Auswahl</h2>
      </header>

      <div class="comparison-area-list" data-comparison-overview-group="additional">
        {overview.additionalAreas.map((area) => (
          <article class="comparison-area-row">
            <div class="comparison-icon" aria-hidden="true">{area.icon}</div>
            <div>
              <a class="comparison-category-link" href={area.categoryHref}>{area.categoryLabel}</a>
              <h3>{area.question}</h3>
              <p>{area.reason}</p>
            </div>
            <a class="comparison-action" href={area.href}>{area.title} <span aria-hidden="true">→</span></a>
          </article>
        ))}
      </div>
    </section>

    <section class="comparison-chapter comparison-chapter--specific" aria-labelledby="specific-heading">
      <header>
        <span>Konkrete Anforderungen</span>
        <h2 id="specific-heading">Alle weiteren Vergleiche</h2>
        <p>Wähle einen Vergleich, wenn Tier, Futterart, Ausstattung oder Alltag bereits feststehen.</p>
      </header>

      {overview.specialistComparisons.length > 0 ? (
        <nav class="comparison-specific-list" aria-label="Weitere konkrete Vergleiche" data-comparison-overview-group="specialist">
          {overview.specialistComparisons.map((comparison) => (
            <a href={comparison.href}>
              <small>{comparison.categoryLabel}</small>
              <strong>{comparison.title}</strong>
              <span aria-hidden="true">→</span>
            </a>
          ))}
        </nav>
      ) : (
        <p class="comparison-empty">Aktuell sind keine weiteren Vergleiche veröffentlicht.</p>
      )}
    </section>

    <section class="comparison-manufacturer-cta">
      <div>
        <span>Marken einordnen</span>
        <h2>Entdecke alle Hersteller im Überblick</h2>
        <p>Die Herstellerseiten zeigen Produktschwerpunkte, Bewertungen, Erfahrungen und passende Modelle.</p>
      </div>
      <a href="/hersteller/">Hersteller ansehen <span aria-hidden="true">→</span></a>
    </section>
  </div>
</ProjectLayout>

<style>
  :global(main.container.container--comparison-overview) {
    box-sizing: border-box;
  }

  .comparison-hub-hero,
  .comparison-hub {
    --comparison-accent: var(--pt-color-accent-text);
    --comparison-accent-strong: var(--pt-color-brand-600);
    --comparison-text: var(--pt-color-text);
    --comparison-muted: var(--pt-color-text-muted);
    --comparison-border: var(--pt-color-border);
    --comparison-surface: var(--pt-color-surface);
    --comparison-surface-soft: var(--pt-color-surface-soft);
    box-sizing: border-box;
    color: var(--comparison-text);
  }

  .comparison-hub-hero *,
  .comparison-hub * { box-sizing: border-box; }

  .comparison-hub-hero {
    max-width: 980px;
    margin: 1.5rem auto 3rem;
    padding: clamp(2rem, 5vw, 4.5rem);
    border: 1px solid var(--comparison-border);
    border-radius: 1.75rem;
    background:
      radial-gradient(circle at top right, color-mix(in srgb, var(--comparison-accent) 16%, transparent), transparent 38%),
      linear-gradient(145deg, var(--comparison-surface), var(--comparison-surface-soft));
    box-shadow: var(--pt-shadow-md);
    text-align: center;
  }

  .comparison-hub-hero > span,
  .comparison-chapter > header > span,
  .comparison-manufacturer-cta span {
    color: var(--comparison-accent);
    font-size: 0.76rem;
    font-weight: 900;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .comparison-hub-hero h1 {
    max-width: 18ch;
    margin: 0.75rem auto 1.25rem;
    font-size: clamp(2.75rem, 6vw, 5rem);
    line-height: 0.98;
    letter-spacing: -0.05em;
  }

  .comparison-hub-hero p,
  .comparison-chapter > header p,
  .comparison-priority-card p,
  .comparison-area-row p,
  .comparison-manufacturer-cta p {
    color: var(--comparison-muted);
    line-height: 1.7;
  }

  .comparison-hub-hero p { max-width: 66ch; margin: 0 auto; }
  .comparison-chapter { margin: 0 0 4.5rem; }
  .comparison-chapter > header { max-width: 800px; margin-bottom: 1.5rem; }

  .comparison-hub h2 {
    margin: 0.5rem 0 0.75rem;
    font-size: clamp(2rem, 4vw, 3.25rem);
    line-height: 1.08;
    letter-spacing: -0.04em;
  }

  .comparison-priority-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .comparison-priority-card {
    display: grid;
    min-width: 0;
    padding: clamp(1.25rem, 2.5vw, 2rem);
    grid-template-columns: auto minmax(0, 1fr);
    align-items: start;
    gap: 1rem;
    border: 1px solid var(--comparison-border);
    border-radius: 1.4rem;
    background: linear-gradient(145deg, var(--comparison-surface), var(--comparison-surface-soft));
    box-shadow: var(--pt-shadow-sm);
  }

  .comparison-icon {
    display: grid;
    width: 3rem;
    height: 3rem;
    flex: 0 0 auto;
    place-items: center;
    border-radius: 0.9rem;
    background: color-mix(in srgb, var(--comparison-accent) 14%, transparent);
    font-size: 1.35rem;
  }

  .comparison-category-link {
    color: var(--comparison-accent);
    font-size: 0.75rem;
    font-weight: 900;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .comparison-priority-card h3,
  .comparison-area-row h3 {
    margin: 0.45rem 0 0.6rem;
    font-size: 1.2rem;
    line-height: 1.25;
  }

  .comparison-priority-card p,
  .comparison-area-row p { margin: 0 0 1rem; font-size: 0.92rem; }

  .comparison-action {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    gap: 0.45rem;
    color: var(--comparison-accent);
    font-weight: 850;
    text-decoration: none;
  }

  .comparison-area-list { display: grid; gap: 0.85rem; }

  .comparison-area-row {
    display: grid;
    min-width: 0;
    padding: 1.1rem 1.25rem;
    grid-template-columns: auto minmax(0, 1fr) minmax(12rem, auto);
    align-items: center;
    gap: 1.1rem;
    border: 1px solid var(--comparison-border);
    border-radius: 1rem;
    background: var(--comparison-surface);
  }

  .comparison-area-row p { margin-bottom: 0; }
  .comparison-area-row > .comparison-action { justify-self: end; text-align: right; }

  .comparison-specific-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.65rem;
  }

  .comparison-specific-list > a {
    display: grid;
    min-width: 0;
    min-height: 4.25rem;
    padding: 0.85rem 1rem;
    grid-template-columns: minmax(0, 1fr) auto;
    align-content: center;
    gap: 0.2rem 0.8rem;
    border: 1px solid var(--comparison-border);
    border-radius: 0.85rem;
    color: var(--comparison-text);
    background: var(--comparison-surface-soft);
    text-decoration: none;
  }

  .comparison-specific-list small {
    grid-column: 1;
    color: var(--comparison-muted);
    font-size: 0.72rem;
  }

  .comparison-specific-list strong { grid-column: 1; line-height: 1.3; }
  .comparison-specific-list > a > span { grid-column: 2; grid-row: 1 / 3; align-self: center; color: var(--comparison-accent); }

  .comparison-empty {
    padding: 1.5rem;
    border: 1px dashed var(--comparison-border);
    border-radius: 1rem;
    background: var(--comparison-surface-soft);
  }

  .comparison-manufacturer-cta {
    display: flex;
    margin: 4rem 0;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    border: 1px solid var(--comparison-border);
    border-radius: 1.4rem;
    background: linear-gradient(135deg, color-mix(in srgb, var(--comparison-accent) 14%, var(--comparison-surface)), var(--comparison-surface) 54%);
  }

  .comparison-manufacturer-cta p { margin: 0; }

  .comparison-manufacturer-cta > a {
    display: inline-flex;
    min-height: 3.4rem;
    padding: 0.85rem 1.2rem;
    flex: 0 0 auto;
    align-items: center;
    gap: 0.7rem;
    border-radius: 0.8rem;
    color: var(--pt-color-on-brand);
    background: linear-gradient(135deg, var(--comparison-accent), var(--comparison-accent-strong));
    font-weight: 850;
    text-decoration: none;
  }

  @media (max-width: 980px) {
    .comparison-priority-grid { grid-template-columns: 1fr; }
  }

  @media (max-width: 760px) {
    .comparison-area-row { grid-template-columns: auto minmax(0, 1fr); }
    .comparison-area-row > .comparison-action { grid-column: 2; justify-self: start; text-align: left; }
    .comparison-specific-list { grid-template-columns: 1fr; }
    .comparison-manufacturer-cta { align-items: stretch; flex-direction: column; }
    .comparison-manufacturer-cta > a { justify-content: center; }
  }

  @media (max-width: 520px) {
    .comparison-priority-card { grid-template-columns: 1fr; }
    .comparison-area-row { grid-template-columns: 1fr; }
    .comparison-area-row > .comparison-action { grid-column: 1; }
  }

  @media (max-width: 360px) {
    .comparison-hub-hero { padding-inline: 1.25rem; }
    .comparison-hub-hero h1 { font-size: 2.25rem; }
  }
</style>
