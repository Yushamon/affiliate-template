---
import { getCollection } from "astro:content";
import SeoAdminLayout from "../../../layouts/SeoAdminLayout.astro";
import { buildPriceIndex } from "../../../domain/price/engine";

const products = await getCollection("products");
const index = buildPriceIndex(products);

const rows = products.map((entry) => {
  const insight = index.bySlug.get(entry.data.slug);
  const sourceLabel = insight?.source?.label ?? "Nicht angegeben";

  return {
    slug: entry.data.slug,
    title: entry.data.title,
    category: entry.data.category.label,
    current: insight?.formattedCurrent ?? "Noch nicht geprüft",
    currentValue: insight?.current ?? "",
    currency: insight?.currency ?? entry.data.price?.currency ?? "EUR",
    status: insight?.assessmentLabel ?? "offen",
    range: insight?.formattedRange ?? "Zu wenig Vergleichsdaten",
    checkedAt: insight?.checkedAt
      ? new Intl.DateTimeFormat("de-DE", {
          dateStyle: "medium",
          timeStyle: "short"
        }).format(new Date(insight.checkedAt))
      : "Nie",
    stale: insight?.isStale ?? true,
    hasUrl: Boolean(entry.data.affiliate?.url ?? insight?.affiliateUrl),
    targetUrl: entry.data.affiliate?.url ?? insight?.affiliateUrl ?? "",
    sourceLabel,
    comparisonText:
      entry.data.price?.comparisonText ??
      insight?.generatedComparisonText ??
      ""
  };
}).sort(
  (left, right) =>
    left.category.localeCompare(right.category, "de") ||
    left.title.localeCompare(right.title, "de")
);

const withPrice = index.products.filter((item) => item.current != null).length;
const serviceUrl =
  import.meta.env.PUBLIC_SEARCH_ADMIN_URL ||
  "http://127.0.0.1:4178";
const serializedConfig = JSON.stringify({ serviceUrl }).replaceAll("<", "\\u003c");
---

<SeoAdminLayout
  title="Preise"
  description="Aktuelle Händlerpreise prüfen oder redaktionell manuell hinterlegen und innerhalb der jeweiligen Produktkategorie einordnen."
  active="prices"
>
  <section class="price-actions seo-card">
    <div>
      <span class="seo-badge">Price Intelligence 1.1</span>
      <h2>{withPrice} von {rows.length} Preisen hinterlegt</h2>
      <p>
        Preisbereiche entstehen automatisch aus vergleichbaren Produkten derselben
        Kategorie. Einzelpreise können geprüft oder bei fehlender strukturierter
        Händlerangabe manuell gepflegt werden.
      </p>
    </div>
    <div class="price-actions__buttons">
      <a href="#manual-price-entry">Preis manuell hinterlegen</a>
      <button type="button" data-check-all>Alle Preise prüfen</button>
    </div>
  </section>

  <p class="price-status" aria-live="polite" data-price-status></p>
  <script
    type="application/json"
    data-price-config
    set:html={serializedConfig}
  ></script>

  <details class="manual-price seo-card" id="manual-price-entry">
    <summary>
      <span>
        <strong>Preis manuell hinterlegen</strong>
        <small>
          Für Händlerseiten ohne auslesbare strukturierte Preisdaten.
        </small>
      </span>
      <span aria-hidden="true">+</span>
    </summary>

    <form data-manual-price-form>
      <label>
        <span>Produkt</span>
        <select name="slug" required>
          <option value="">Produkt auswählen</option>
          {
            rows.map((row) => (
              <option value={row.slug}>
                {row.title} · {row.category}
              </option>
            ))
          }
        </select>
      </label>

      <label>
        <span>Aktueller Preis</span>
        <input
          name="current"
          type="number"
          inputmode="decimal"
          min="0.01"
          step="0.01"
          placeholder="119,00"
          required
        />
      </label>

      <label>
        <span>Währung</span>
        <select name="currency" required>
          <option value="EUR">EUR</option>
          <option value="CHF">CHF</option>
          <option value="USD">USD</option>
          <option value="GBP">GBP</option>
        </select>
      </label>

      <label>
        <span>Quelle oder Händler</span>
        <input
          name="sourceLabel"
          type="text"
          maxlength="120"
          placeholder="z. B. Amazon, Hersteller-Shop"
        />
      </label>

      <label class="manual-price__wide">
        <span>Händler- oder Affiliate-Ziel</span>
        <small>Eine URL für Preisprüfung sowie Produkt- und Vergleichs-CTA.</small>
        <input
          name="targetUrl"
          type="url"
          inputmode="url"
          placeholder="https://..."
        />
      </label>

      <label class="manual-price__wide">
        <span>Kurze Preiseinordnung</span>
        <textarea
          name="comparisonText"
          rows="3"
          maxlength="360"
          placeholder="Optional. Zum Beispiel: Etwas teurer als einfache Modelle, aber günstiger als Premium-Geräte mit Kamera."
        ></textarea>
      </label>

      <div class="manual-price__actions">
        <button type="submit">Manuellen Preis speichern</button>
        <button type="reset" class="secondary">Eingaben leeren</button>
      </div>
    </form>
  </details>

  <section class="price-table seo-card" aria-label="Produktpreise">
    <div class="price-head">
      <b>Produkt</b>
      <b>Preis</b>
      <b>Einordnung</b>
      <b>Prüfung</b>
      <b>Aktionen</b>
    </div>

    {
      rows.map((row) => (
        <article data-price-row={row.slug}>
          <div>
            <a href={`/produkt/${row.slug}/`} target="_blank">
              {row.title}
            </a>
            <small>{row.category}</small>
          </div>

          <div>
            <strong>{row.current}</strong>
            <small>{row.sourceLabel}</small>
          </div>

          <div>
            <span
              class="seo-badge"
              data-level={
                row.status === "eher teuer"
                  ? "high"
                  : row.status === "fair"
                    ? "medium"
                    : row.status === "günstig"
                      ? "low"
                      : undefined
              }
            >
              {row.status}
            </span>
            <small>{row.range}</small>
          </div>

          <div>
            <span>{row.checkedAt}</span>
            {row.stale && <small class="stale">Prüfung fällig</small>}
          </div>

          <div class="price-row-actions">
            <button
              type="button"
              class="secondary"
              data-edit-manual-price
              data-slug={row.slug}
              data-current={String(row.currentValue)}
              data-currency={row.currency}
              data-source-label={row.sourceLabel === "Nicht angegeben" ? "" : row.sourceLabel}
              data-target-url={row.targetUrl}
              data-comparison-text={row.comparisonText}
            >
              Manuell
            </button>
            <button
              type="button"
              data-check-price={row.slug}
              disabled={!row.hasUrl}
            >
              {row.hasUrl ? "Preis prüfen" : "URL fehlt"}
            </button>
          </div>
        </article>
      ))
    }
  </section>
</SeoAdminLayout>

<script>
  const status = document.querySelector<HTMLElement>("[data-price-status]");
  const configNode =
    document.querySelector<HTMLScriptElement>("[data-price-config]");
  const config = JSON.parse(configNode?.textContent || "{}");
  const serviceUrl = String(
    config.serviceUrl || "http://127.0.0.1:4178"
  ).replace(/\/$/, "");
  const manualDetails =
    document.querySelector<HTMLDetailsElement>("#manual-price-entry");
  const manualForm =
    document.querySelector<HTMLFormElement>("[data-manual-price-form]");

  const request = async (path: string, body: unknown) => {
    const response = await fetch(`${serviceUrl}${path}`, {
      method: "POST",
      headers: { "content-type": "application/json" },
      body: JSON.stringify(body)
    });
    const payload = await response.json();

    if (!response.ok) {
      throw new Error(
        payload?.error?.message ||
        payload?.error ||
        "Preisaktion fehlgeschlagen."
      );
    }

    return payload;
  };

  const setStatus = (message: string) => {
    if (status) status.textContent = message;
  };

  const field = <T extends HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>(
    name: string
  ) => manualForm?.elements.namedItem(name) as T | null;

  document
    .querySelectorAll<HTMLButtonElement>("[data-edit-manual-price]")
    .forEach((button) => {
      button.addEventListener("click", () => {
        if (!manualForm || !manualDetails) return;

        manualDetails.open = true;
        const slug = field<HTMLSelectElement>("slug");
        const current = field<HTMLInputElement>("current");
        const currency = field<HTMLSelectElement>("currency");
        const sourceLabel = field<HTMLInputElement>("sourceLabel");
        const targetUrl = field<HTMLInputElement>("targetUrl");
        const comparisonText =
          field<HTMLTextAreaElement>("comparisonText");

        if (slug) slug.value = button.dataset.slug || "";
        if (current) current.value = button.dataset.current || "";
        if (currency) currency.value = button.dataset.currency || "EUR";
        if (sourceLabel) {
          sourceLabel.value = button.dataset.sourceLabel || "";
        }
        if (targetUrl) {
          targetUrl.value = button.dataset.targetUrl || "";
        }
        if (comparisonText) {
          comparisonText.value = button.dataset.comparisonText || "";
        }

        manualDetails.scrollIntoView({
          behavior: "smooth",
          block: "start"
        });
        current?.focus({ preventScroll: true });
      });
    });

  manualForm?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const submitButton = manualForm.querySelector<HTMLButtonElement>(
      'button[type="submit"]'
    );
    const data = new FormData(manualForm);
    const slug = String(data.get("slug") || "");

    if (submitButton) submitButton.disabled = true;
    setStatus(`${slug} wird manuell gespeichert …`);

    try {
      const result = await request("/api/admin/prices/manual", {
        slug,
        current: data.get("current"),
        currency: data.get("currency"),
        sourceLabel: data.get("sourceLabel"),
        targetUrl: data.get("targetUrl"),
        comparisonText: data.get("comparisonText")
      });

      const formatted = new Intl.NumberFormat("de-DE", {
        style: "currency",
        currency: result.currency
      }).format(result.current);

      setStatus(
        `${result.title}: ${formatted} manuell hinterlegt.${result.ctaUpdated ? " CTA-Ziel aktualisiert." : ""} Seite wird neu geladen.`
      );
      setTimeout(() => location.reload(), 700);
    } catch (error) {
      setStatus(error instanceof Error ? error.message : String(error));
      if (submitButton) submitButton.disabled = false;
    }
  });

  document
    .querySelectorAll<HTMLButtonElement>("[data-check-price]")
    .forEach((button) =>
      button.addEventListener("click", async () => {
        button.disabled = true;
        setStatus(`${button.dataset.checkPrice} wird geprüft …`);

        try {
          const result = await request("/api/admin/prices/check", {
            slug: button.dataset.checkPrice
          });
          setStatus(
            `${result.title}: ${new Intl.NumberFormat("de-DE", {
              style: "currency",
              currency: result.currency
            }).format(result.current)} gefunden. Seite wird neu geladen.`
          );
          setTimeout(() => location.reload(), 600);
        } catch (error) {
          setStatus(error instanceof Error ? error.message : String(error));
          button.disabled = false;
        }
      })
    );

  document
    .querySelector<HTMLButtonElement>("[data-check-all]")
    ?.addEventListener("click", async (event) => {
      const button = event.currentTarget as HTMLButtonElement;
      button.disabled = true;
      setStatus(
        "Alle hinterlegten Händlerseiten werden nacheinander geprüft …"
      );

      try {
        const result = await request(
          "/api/admin/prices/check-all",
          {}
        );
        setStatus(
          `${result.succeeded} Preise aktualisiert, ${result.failed} Prüfungen ohne Ergebnis. Seite wird neu geladen.`
        );
        setTimeout(() => location.reload(), 900);
      } catch (error) {
        setStatus(error instanceof Error ? error.message : String(error));
        button.disabled = false;
      }
    });
</script>

<style>
  .price-actions {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 22px;
    padding: 24px;
  }

  .price-actions h2 {
    margin: 9px 0 7px;
  }

  .price-actions p {
    max-width: 760px;
    margin: 0;
    color: var(--seo-muted);
    line-height: 1.55;
  }

  .price-actions__buttons,
  .price-row-actions,
  .manual-price__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
  }

  .price-actions a,
  .price-actions button,
  .price-table button,
  .manual-price button {
    display: inline-flex;
    min-height: 42px;
    align-items: center;
    justify-content: center;
    border: 0;
    border-radius: 12px;
    padding: 10px 14px;
    background: var(--seo-accent);
    color: var(--seo-on-accent);
    font-weight: 850;
    text-decoration: none;
    cursor: pointer;
  }

  .price-actions a,
  .price-table button.secondary,
  .manual-price button.secondary {
    border: 1px solid var(--seo-border);
    background: var(--seo-surface);
    color: var(--seo-text);
  }

  .price-actions button:disabled,
  .price-table button:disabled,
  .manual-price button:disabled {
    opacity: .55;
    cursor: not-allowed;
  }

  .price-status {
    min-height: 24px;
    color: var(--seo-muted);
  }

  .manual-price {
    margin-bottom: 18px;
    overflow: hidden;
  }

  .manual-price summary {
    display: flex;
    min-height: 76px;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 18px 22px;
    cursor: pointer;
    list-style: none;
  }

  .manual-price summary::-webkit-details-marker {
    display: none;
  }

  .manual-price summary > span:first-child {
    display: grid;
    gap: 4px;
  }

  .manual-price summary small {
    color: var(--seo-muted);
    font-weight: 500;
  }

  .manual-price summary > span:last-child {
    font-size: 1.4rem;
    font-weight: 850;
    transition: transform .18s ease;
  }

  .manual-price[open] summary > span:last-child {
    transform: rotate(45deg);
  }

  .manual-price form {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 15px;
    padding: 0 22px 22px;
  }

  .manual-price label {
    display: grid;
    gap: 7px;
    color: var(--seo-text);
    font-weight: 750;
  }

  .manual-price input,
  .manual-price select,
  .manual-price textarea {
    width: 100%;
    min-height: 44px;
    border: 1px solid var(--seo-border);
    border-radius: 11px;
    padding: 10px 12px;
    background: var(--seo-surface-soft);
    color: var(--seo-text);
  }

  .manual-price textarea {
    resize: vertical;
    line-height: 1.5;
  }

  .manual-price__wide,
  .manual-price__actions {
    grid-column: 1 / -1;
  }

  .price-table {
    overflow: hidden;
  }

  .price-head,
  .price-table article {
    display: grid;
    grid-template-columns:
      minmax(220px, 1.4fr)
      minmax(120px, .7fr)
      minmax(190px, 1fr)
      minmax(140px, .8fr)
      minmax(180px, auto);
    align-items: center;
    gap: 14px;
    padding: 14px 18px;
  }

  .price-head {
    background: var(--seo-surface-soft);
    color: var(--seo-muted);
    font-size: .78rem;
  }

  .price-table article {
    border-top: 1px solid var(--seo-border);
  }

  .price-table article > div {
    display: grid;
    min-width: 0;
    gap: 5px;
  }

  .price-table a {
    color: var(--seo-text);
    font-weight: 800;
  }

  .price-table small {
    color: var(--seo-muted);
    line-height: 1.35;
  }

  .stale {
    color: var(--seo-warning) !important;
    font-weight: 800;
  }

  @media (max-width: 1050px) {
    .price-actions {
      grid-template-columns: 1fr;
    }

    .price-head {
      display: none;
    }

    .price-table article {
      grid-template-columns: 1fr 1fr;
    }

    .price-table article > div:first-child {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 620px) {
    .manual-price form,
    .price-table article {
      grid-template-columns: 1fr;
    }

    .manual-price__wide,
    .manual-price__actions,
    .price-table article > div:first-child {
      grid-column: auto;
    }

    .price-actions__buttons,
    .price-row-actions,
    .manual-price__actions {
      display: grid;
      grid-template-columns: 1fr;
    }

    .price-actions a,
    .price-actions button,
    .price-table button,
    .manual-price button {
      width: 100%;
    }
  }
</style>
