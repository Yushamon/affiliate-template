---
import { getCollection } from "astro:content";
import SeoAdminLayout from "../../../layouts/SeoAdminLayout.astro";
import { resolveCommerceOffers } from '../../../domain/commerceOffers.mjs';
import { commerceCockpitMarkup } from '../../../lib/price-intelligence/commerce-view.mjs';
import {
  AVAILABILITY_LABELS,
  buildOperationsDashboard,
  compareMaintenanceRows,
  toOperationsRecord
} from "../../../lib/product-operations/policy.mjs";

const products = await getCollection("products");
const rows = products
  .map((entry) => {
    const record = {...toOperationsRecord(entry.data),commerceOffers:resolveCommerceOffers(entry.data)};
    return { ...record, operations: record };
  })
  .sort(compareMaintenanceRows)
  .map(({ operations: _operations, ...record }) => record);
const dashboard = buildOperationsDashboard(rows.map((record) => ({ operations: record })));
const serviceUrl = import.meta.env.PUBLIC_SEARCH_ADMIN_URL || "http://127.0.0.1:4178";
const serializedConfig = JSON.stringify({ serviceUrl }).replaceAll("<", "\\u003c");
const serializedRows = JSON.stringify(rows).replaceAll("<", "\\u003c");
const formatDate = (value?: string | null) => value
  ? new Intl.DateTimeFormat("de-DE", { dateStyle: "medium" }).format(new Date(value))
  : "Nie";
const metrics = [
  ["missingPrice", "Aktive Pflegefälle ohne Preis"],
  ["missingAffiliate", "Aktive Pflegefälle ohne Händlerziel"],
  ["unknownAvailability", "Verfügbarkeit unbekannt"],
  ["discontinued", "Eingestellt"],
  ["unavailable", "Nicht verfügbar"],
  ["stale30", "Preis älter als 30 Tage"],
  ["stale90", "Preis älter als 90 Tage"],
  ["maintenanceRequired", "Pflege erforderlich"],
  ["maintenanceRecommended", "Pflege empfohlen"],
  ["archived", "Archiviert"],
  ["maintenanceRate", "Pflegefälle abgeschlossen (inkl. Archiv)"]
] as const;
---

<SeoAdminLayout
  title="Produktpflege"
  description="Preis, Affiliate-Ziel, Verfügbarkeit, Empfehlbarkeit und Pflegepriorität verwalten. Der redaktionelle Produktscore bleibt davon vollständig getrennt."
  active="prices"
>
  <section class="pt-surface ops-summary seo-card">
    <div>
      <span class="seo-badge">Product Operations 1.0</span>
      <h2>Handlungsbedarf statt Datenrauschen</h2>
      <p>
        Die Standardansicht enthält nur echte Pflegeaufgaben. Bewusst als eingestellt,
        vorübergehend nicht verfügbar oder nicht lieferbar gepflegte Produkte werden
        nicht als offene Aufgabe gewertet.
      </p>
      <p>Händlerangebote je Produkt aufklappen: PETLIBRO über Awin, Preise aus offiziellen Produktdaten. ADCELL/Tractive ist vorbereitet; die bestätigten Programmdaten fehlen noch.</p>
      <p>Unter „Händlerangebote“ kannst du jeden Händlerpreis getrennt bearbeiten. Beide Preise bleiben gespeichert; die Veröffentlichung berücksichtigt Aktualität und Verfügbarkeit. Die bisherigen Tabellenkennzahlen beziehen sich auf den Hauptdatensatz.</p>
    </div>
    <button type="button" data-check-all disabled>Commerce-Daten aktualisieren</button>
  </section>

  <datalist id="ops-providers"><option value="amazon"/><option value="petlibro"/><option value="tractive"/></datalist>
  <p class="ops-inventory">Datenbestand: {([['products','Produkte'],['withPrice','mit gespeichertem Preis'],['withAffiliate','mit Händlerziel'],['knownAvailability','mit Statusangabe']] as const).map(([key,label])=><button type="button" data-metric-filter={key}><strong data-metric={key}>{dashboard[key]}</strong> {label}</button>)}. Gespeichert bedeutet nicht aktuell bestätigt.</p>
  <section class="ops-metrics" aria-label="Produktpflege-Kennzahlen">
    {metrics.map(([key, label]) => (
      <article class="pt-surface seo-card"><button type="button" data-metric-filter={key}>
        <small>{["stale30","stale90"].includes(key)?"Aktualität":["unknownAvailability","discontinued","unavailable","archived"].includes(key)?"Bestandsstatus":"Pflegefälle"}</small><span>{label}</span>
        <strong data-metric={key}>
          {key === "maintenanceRate" ? `${dashboard[key]} %` : dashboard[key]}
        </strong></button>
      </article>
    ))}
  </section>

  <section class="pt-surface ops-toolbar seo-card" aria-label="Produktliste filtern">
    <div class="ops-tabs" role="group" aria-label="Ansicht">
      <button type="button" class="is-active" data-view="tasks">Arbeitsliste</button>
      <button type="button" data-view="all">Alle Produkte</button>
      <button type="button" data-view="archive">Archiv & Nichtverfügbarkeit</button>
    </div>
    <label>
      <span>Filter</span>
      <select data-filter>
        <option value="all">Alle</option>
        <option value="missing-price">Preis fehlt</option>
        <option value="missing-affiliate">Affiliate fehlt</option>
        <option value="stale-30">Preis älter als 30 Tage</option>
        <option value="stale-90">Preis älter als 90 Tage</option>
        <option value="unknown-availability">Verfügbarkeit unbekannt</option>
        <option value="temporarily-unavailable">Vorübergehend nicht verfügbar</option>
        <option value="out-of-stock">Nicht lieferbar</option>
        <option value="discontinued">Eingestellt</option>
        <option value="maintenance-required">Pflege erforderlich</option>
        <option value="maintenance-recommended">Pflege empfohlen</option>
        <option value="archived">Archiviert</option>
      </select>
    </label>
    <label class="ops-search">
      <span>Suche</span>
      <input type="search" data-search placeholder="Produkt oder Kategorie" />
    </label>
  </section>

  <p class="ops-status" aria-live="polite" data-ops-status>Schreibaktionen benötigen den lokalen Admin-Dienst: npm --workspace apps/pfotentechnik run seo:admin. Der öffentliche statische Build ist schreibgeschützt.</p><p>Pflegequote: Anteil vollständig bearbeiteter Fälle einschließlich bewusst archivierter Produkte an allen Produkten. Keine Liefer- oder Preisfrischequote. Kennzahlen überschneiden sich; anklicken zeigt die betroffenen Produkte.</p>
  <script type="application/json" data-ops-config set:html={serializedConfig}></script>
  <script type="application/json" data-ops-records set:html={serializedRows}></script>

  <section class="pt-surface ops-table seo-card" aria-label="Produktpflege">
    <div class="ops-head" aria-hidden="true">
      <b>Produkt</b>
      <b>Preis</b>
      <b>Preisdatum</b>
      <b>Preisstatus</b>
      <b>Affiliate</b>
      <b>Verfügbarkeit</b>
      <b>Empfehlung</b>
      <b>Redaktion</b>
      <b>Pflege</b>
      <b>Aktionen</b>
    </div>

    <div data-ops-list>
      {rows.map((row) => (
        <article data-product-row={row.slug}>
          <div class="ops-cell ops-product">
            <a href={`/produkt/${row.slug}/`} target="_blank">{row.title}</a>
            <small>{row.category}</small>
            <small class="ops-warning" data-field="warnings">
              {row.warnings.length ? row.warnings.join(" · ") : "Keine offene Warnung"}
            </small>
          </div>
          <div class="ops-cell">
            <strong data-field="formattedCurrent">{row.formattedCurrent ?? "Fehlt"}</strong>
            <small data-field="selectedPriceSource">{row.selectedPriceSource}</small><small data-field="publicPriceStateLabel">{row.publicPriceStateLabel}</small><small>Verwendetes Angebot: <span data-field="selectedOfferId">{row.selectedOfferId}</span></small><small>Letzter Commerce-Versuch: <span data-field="lastCommerceAttemptAt">Noch nicht protokolliert</span></small>
          </div>
          <div class="ops-cell">
            <small>Letzte Preisprüfung</small>
            <span data-field="lastPriceConfirmation">{formatDate(row.lastPriceConfirmation)}</span>
            <small data-field="priceAgeDays">
              {row.priceAgeDays == null ? "Kein Datenstand" : `${row.priceAgeDays} Tage alt`}
            </small>
          </div>
          <div class="ops-cell">
            <span class="pt-chip ops-chip" data-field="priceState" data-state={row.priceState}>{row.priceState}</span>
          </div>
          <div class="ops-cell">
            <span class="pt-chip ops-chip" data-field="affiliateAvailable" data-state={row.affiliateAvailable ? "yes" : "no"}>
              {row.affiliateAvailable ? "Vorhanden" : "Fehlt"}
            </span>
          </div>
          <div class="ops-cell">
            <span class="pt-chip ops-chip" data-field="availability" data-state={row.availability}>{row.availabilityLabel}</span>
            <small>Letzte bestätigte Verfügbarkeitsprüfung: <span data-field="availabilityUpdated">{formatDate(row.availabilityUpdated)}</span></small>
            <small>Letzte redaktionelle Produktprüfung: <span data-field="editorialReviewedAt">{formatDate(row.editorialReviewedAt)}</span></small>
            <small data-field="availabilityReason">{row.availabilityReason ?? "Keine Bemerkung"}</small>
          </div>
          <div class="ops-cell">
            <span class="pt-chip ops-chip" data-field="recommendationStatus" data-state={row.recommendationStatus}>{row.recommendationLabel}</span>
          </div>
          <div class="ops-cell">
            <span class="pt-chip ops-chip" data-field="editorialStatus" data-state={row.editorialStatus}>{row.editorialStatus}</span>
          </div>
          <div class="ops-cell">
            <span class="pt-chip ops-chip" data-field="maintenanceStatus" data-state={row.maintenanceStatus}>{row.maintenanceLabel}</span>
          </div>
          <div class="ops-cell ops-actions">
            <button type="button" data-check-price={row.slug} disabled>
              Commerce aktualisieren
            </button>
            <button type="button" class="pt-button pt-button-secondary secondary" data-toggle-editor={row.slug}>Pflegen</button>
          </div>

          <div class="ops-commerce" data-commerce-panel set:html={commerceCockpitMarkup(row.commerceOffers,row.slug)}></div>
          <form class="ops-editor" data-editor={row.slug} hidden>
            <label>Empfehlbarkeit<select data-policy="recommendationOverride"><option value="auto" selected={row.recommendationOverride==='auto'}>Aus Produktdaten ableiten</option><option value="limited" selected={row.recommendationOverride==='limited'}>Bewusst einschränken</option></select></label><label>Pflegepriorität<select data-policy="maintenancePriority">{[['high','Hoch'],['normal','Normal'],['low','Niedrig']].map(([value,label])=><option value={value} selected={row.maintenancePriority===value}>{label}</option>)}</select></label><button type="button" disabled data-save-policy={row.slug}>Empfehlbarkeit und Priorität speichern</button>
            <label>
              <span>Preis im bisherigen Hauptdatensatz (Händlerpreise separat unten)</span>
              <input
                type="text"
                inputmode="decimal"
                autocomplete="off"
                data-draft="current"
                value={row.storedCurrent ?? ""}
                placeholder="29,99"
              />
            </label>
            <label>
              <span>Währung</span>
              <select data-draft="currency">
                {["EUR", "CHF", "USD", "GBP"].map((currency) => (
                  <option value={currency} selected={currency === row.currency}>{currency}</option>
                ))}
              </select>
            </label>
            <label>
              <span>Preisstatus</span>
              <select data-draft="priceState">
                <option value="available" selected={row.priceState === "available"}>Preis vorhanden</option>
                <option value="unknown" selected={row.priceState === "unknown"}>Preis unbekannt</option>
                <option value="removed" selected={row.priceState === "removed"}>Bewusst entfernt</option>
                <option value="stale" selected={row.priceState === "stale"}>Veraltet</option>
              </select>
            </label>
            <label>
              <span>Quelle oder Händler</span>
              <input type="text" maxlength="120" data-draft="sourceLabel" value={row.sourceLabel === "Nicht angegeben" ? "" : row.sourceLabel} />
            </label>
            <label>
              <span>Herstellername</span>
              <input type="text" maxlength="120" data-draft="manufacturerName" value={row.manufacturerName ?? ""} placeholder="OnlyCat" />
            </label>
            <label>
              <span>Hersteller-Slug</span>
              <input type="text" maxlength="120" data-draft="manufacturerSlug" value={row.manufacturerSlug ?? ""} placeholder="onlycat" />
            </label>
            <label class="wide">
              <span>Affiliate- oder Händler-Ziel</span>
              <input type="url" inputmode="url" data-draft="targetUrl" value={row.targetUrl ?? ""} placeholder="https://…" />
            </label>
            <label>
              <span>Verfügbarkeit</span>
              <select data-draft="availability">
                {Object.entries(AVAILABILITY_LABELS).map(([value, label]) => (
                  <option value={value} selected={value === row.availability}>{label}</option>
                ))}
              </select>
            </label>
            <label class="wide">
              <span>Bemerkung zur Verfügbarkeit</span>
              <textarea rows="2" maxlength="500" data-draft="availabilityReason">{row.availabilityReason ?? ""}</textarea>
            </label>
            <label class="wide">
              <span>Kurze Preiseinordnung</span>
              <textarea rows="2" maxlength="360" data-draft="comparisonText">{row.comparisonText ?? ""}</textarea>
            </label>
            <label class="wide"><input type="checkbox" data-confirm-price/> Diesen Hauptpreis heute ausdrücklich geprüft und bestätigt</label>
            <div class="ops-editor__actions wide">
              <button disabled type="submit" data-save-product={row.slug}>Produktdaten speichern</button>
              <button type="button" class="pt-button pt-button-secondary secondary" disabled data-archive-product={row.slug}>
                {row.maintenanceStatus === "archived" ? "Aus Archiv lösen" : "Bewusst archivieren"}
              </button>
              <button type="button" class="pt-button pt-button-secondary secondary" data-close-editor={row.slug}>Schließen</button>
            </div>
          </form>
        </article>
      ))}
    </div>
    <p class="seo-empty" data-empty hidden>Für diese Ansicht gibt es keine Produkte.</p>
  </section>
</SeoAdminLayout>

<script>
  import {buildOperationsDashboard} from '../../../lib/product-operations/display.mjs';
  import { commerceCockpitMarkup } from '../../../lib/price-intelligence/commerce-view.mjs';
  // PT_SEO_PRICE_EDITOR_STABILITY_1_0_0: schützt aktive und ungespeicherte Preisentwürfe.
  type OperationsRecord = Record<string, any> & { slug: string; title: string };
  type Draft = {
    current: string;
    currency: string;
    priceState: string;
    sourceLabel: string;
    targetUrl: string;
    availability: string;
    availabilityReason: string;
    comparisonText: string;
    manufacturerName: string;
    manufacturerSlug: string;
  };

  const configNode = document.querySelector<HTMLScriptElement>("[data-ops-config]");
  const recordsNode = document.querySelector<HTMLScriptElement>("[data-ops-records]");
  const config = JSON.parse(configNode?.textContent || "{}");
  const serviceUrl = String(config.serviceUrl || "http://127.0.0.1:4178").replace(/\/$/, "");
  const initialRecords = JSON.parse(recordsNode?.textContent || "[]") as OperationsRecord[];
  const records = new Map(initialRecords.map((record) => [record.slug, record]));
  const drafts = new Map<string, Draft>();
  const PRICE_DRAFT_STORAGE_KEY = "pfotentechnik:seo-price-editor-drafts:v1";
  const dirtyEditors = new Set<string>();

  const loadPersistedDrafts = (): Record<string, Draft> => {
    try {
      const parsed = JSON.parse(sessionStorage.getItem(PRICE_DRAFT_STORAGE_KEY) || "{}");
      return parsed && typeof parsed === "object" ? parsed : {};
    } catch {
      return {};
    }
  };

  const persistedDrafts = loadPersistedDrafts();

  const persistDraft = (slug: string, draft: Draft) => {
    persistedDrafts[slug] = { ...draft };
    try {
      sessionStorage.setItem(PRICE_DRAFT_STORAGE_KEY, JSON.stringify(persistedDrafts));
    } catch {
      // Der Editor bleibt auch ohne Storage-Support innerhalb der aktuellen Seite geschützt.
    }
  };

  const clearPersistedDraft = (slug: string) => {
    delete persistedDrafts[slug];
    try {
      if (Object.keys(persistedDrafts).length) {
        sessionStorage.setItem(PRICE_DRAFT_STORAGE_KEY, JSON.stringify(persistedDrafts));
      } else {
        sessionStorage.removeItem(PRICE_DRAFT_STORAGE_KEY);
      }
    } catch {
      // Kein Abbruch, wenn Session Storage blockiert ist.
    }
  };
  const inFlight = new Map<string, Promise<any>>();
  const status = document.querySelector<HTMLElement>("[data-ops-status]");
  const list = document.querySelector<HTMLElement>("[data-ops-list]");
  const empty = document.querySelector<HTMLElement>("[data-empty]");
  const filter = document.querySelector<HTMLSelectElement>("[data-filter]");
  const search = document.querySelector<HTMLInputElement>("[data-search]");
  let currentView = 'tasks',metricFilter='';let serviceReady=false;
  let commerceRunActive = false;
  let commerceJobPolling = false;
  const localMode=['localhost','127.0.0.1','[::1]'].includes(location.hostname);
  const writable=()=>{document.querySelectorAll<HTMLButtonElement>('[data-check-all],[data-check-price],[data-archive-product],[data-remove-offer],[data-save-policy],form button[type=submit]').forEach(b=>b.disabled=!serviceReady||(b.hasAttribute('data-check-all')&&commerceRunActive))};

  const setStatus = (message: string, level: "normal" | "error" = "normal") => {
    if (!status) return;
    status.textContent = message;
    status.dataset.level = level;
  };

  const fetchJson = async (path: string, options: RequestInit = {}) => {
    const response = await fetch(`${serviceUrl}${path}`, {
      cache: "no-store",
      ...options,
      headers: {
        ...(options.body ? { "content-type": "application/json" } : {}),
        ...(options.headers || {})
      }
    });
    const payload = await response.json().catch(() => ({}));
    if (!response.ok) {
      throw new Error(payload?.error?.message || payload?.error || "Produktaktion fehlgeschlagen.");
    }
    return payload;
  };

  function runOnce<T>(key: string, task: () => Promise<T>): Promise<T> {
    const existing = inFlight.get(key);
    if (existing) return existing;
    const promise = task().finally(() => {
      if (inFlight.get(key) === promise) inFlight.delete(key);
    });
    inFlight.set(key, promise);
    return promise;
  }

  const formatDate = (value: string | null | undefined) => value
    ? new Intl.DateTimeFormat("de-DE", { dateStyle: "medium" }).format(new Date(value))
    : "Nie";

  const textFor = (record: OperationsRecord, field: string) => {
    if (field === "formattedCurrent") return record.formattedCurrent || "Fehlt";
    if (["priceUpdated", "availabilityUpdated", "editorialReviewedAt", "lastPriceConfirmation", "lastCommerceAttemptAt"].includes(field)) return formatDate(record[field]);
    if (field === "priceAgeDays") return record.priceAgeDays == null ? "Kein Datenstand" : `${record.priceAgeDays} Tage alt`;
    if (field === "affiliateAvailable") return record.affiliateAvailable ? "Vorhanden" : "Fehlt";
    if (field === "availability") return record.availabilityLabel;
    if (field === "availabilityReason") return record.availabilityReason || "Keine Bemerkung";
    if (field === "recommendationStatus") return record.recommendationLabel;
    if (field === "maintenanceStatus") return record.maintenanceLabel;
    if (field === "warnings") return record.warnings?.length ? record.warnings.join(" · ") : "Keine offene Warnung";
    return String(record[field] ?? "");
  };

  const draftFrom = (record: OperationsRecord): Draft => ({
    current: record.storedCurrent == null ? "" : String(record.storedCurrent).replace(".", ","),
    currency: record.currency || "EUR",
    priceState: record.priceState || "unknown",
    sourceLabel:record.storedSourceLabel||"",
    targetUrl: record.targetUrl || "",
    availability: record.availability || "unknown",
    availabilityReason: record.availabilityReason || "",
    comparisonText: record.comparisonText || "",
    manufacturerName: record.manufacturerName || "",
    manufacturerSlug: record.manufacturerSlug || ""
  });

  const writeDraftToEditor = (editor: HTMLFormElement, draft: Draft) => {
    editor.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>("[data-draft]").forEach((input) => {
      const key = input.dataset.draft as keyof Draft;
      input.value = draft[key] ?? "";
    });
  };

  const syncEditor = (record: OperationsRecord, options: { force?: boolean } = {}) => {
    const editor = document.querySelector<HTMLFormElement>(`[data-editor="${CSS.escape(record.slug)}"]`);
    if (!editor) return false;

    const archiveButton = editor.querySelector<HTMLButtonElement>("[data-archive-product]");
    if (archiveButton) {
      archiveButton.textContent = record.maintenanceStatus === "archived"
        ? "Aus Archiv lösen"
        : "Bewusst archivieren";
    }

    const protectedInteraction =
      dirtyEditors.has(record.slug) || editor.contains(document.activeElement);
    if (!options.force && protectedInteraction) return false;

    const draft = draftFrom(record);
    drafts.set(record.slug, draft);
    writeDraftToEditor(editor, draft);
    editor.querySelectorAll<HTMLSelectElement>('[data-policy]').forEach(n=>n.value=record[n.dataset.policy!]||'');
    const confirmed=editor.querySelector<HTMLInputElement>('[data-confirm-price]');if(confirmed)confirmed.checked=false;
    editor.dataset.dirty = "false";editor.dataset.sourceHash=record.sourceHash||"";
    return true;
  };
  const updateRow = (record: OperationsRecord) => {
    records.set(record.slug, record);
    const row = document.querySelector<HTMLElement>(`[data-product-row="${CSS.escape(record.slug)}"]`);
    if (!row) return;
    const panel = row.querySelector<HTMLElement>('[data-commerce-panel]');
    if (panel && !panel.contains(document.activeElement) && !panel.querySelector('[data-dirty="true"]')) {
      const open = panel.querySelector('details')?.open;
      panel.innerHTML = commerceCockpitMarkup(record.commerceOffers,record.slug,record.sourceHash);
      const details = panel.querySelector('details'); if (details && open) details.open = true;
    }
    row.querySelectorAll<HTMLElement>("[data-field]").forEach((node) => {
      const field = node.dataset.field || "";
      node.textContent = textFor(record, field);
      if (["priceState", "affiliateAvailable", "availability", "recommendationStatus", "editorialStatus", "maintenanceStatus"].includes(field)) {
        node.dataset.state = field === "affiliateAvailable" ? (record.affiliateAvailable ? "yes" : "no") : String(record[field] ?? "");
      }
    });
    const check = row.querySelector<HTMLButtonElement>("[data-check-price]");
    if (check) {
      check.disabled = !record.targetUrl && !record.commerceOffers?.length;
      check.textContent = "Commerce aktualisieren";
    }
    syncEditor(record);writable();
  };

  const refreshMetrics = () => {
    const values = [...records.values()];
    document.querySelectorAll<HTMLElement>("[data-metric]").forEach((node) => {
      node.textContent = node.dataset.metric==='maintenanceRate'?`${buildOperationsDashboard(values.map(operations=>({operations}))).maintenanceRate} %`:String(buildOperationsDashboard(values.map(operations=>({operations})))[node.dataset.metric||'']);
    });
  };

  const matchesFilter = (record: OperationsRecord, value: string) => {
    if (value === "all") return true;
    if (value === "missing-price") return !record.priceAvailable;
    if (value === "missing-affiliate") return !record.affiliateAvailable;
    if (value === "stale-30") return record.priceAgeDays != null && record.priceAgeDays > 30;
    if (value === "stale-90") return record.priceAgeDays != null && record.priceAgeDays > 90;
    if (value === "unknown-availability") return record.availability === "unknown";
    if (value === "temporarily-unavailable") return record.availability === "temporarily-unavailable";
    if (value === "out-of-stock") return record.availability === "out-of-stock";
    if (value === "discontinued") return record.availability === "discontinued";
    if (value === "maintenance-required") return record.maintenanceStatus === "required";
    if (value === "maintenance-recommended") return record.maintenanceStatus === "recommended";
    if (value === "archived") return record.maintenanceStatus === "archived";
    return true;
  };

  const applyView = () => {
    if (!list) return;
    const query = (search?.value || "").trim().toLocaleLowerCase("de-DE");
    const selectedFilter = filter?.value || "all";
    const ordered = [...records.values()].sort((left, right) =>
      Number(left.priorityRank ?? 1000) - Number(right.priorityRank ?? 1000) ||
      Number(right.priceAgeDays ?? -1) - Number(left.priceAgeDays ?? -1) ||
      String(left.title).localeCompare(String(right.title), "de")
    );
    let visible = 0;

    for (const record of ordered) {
      const row = document.querySelector<HTMLElement>(`[data-product-row="${CSS.escape(record.slug)}"]`);
      if (!row) continue;
      const viewMatch = currentView === "tasks" ? record.isTask : currentView === "archive" ? record.isArchive : true;
      const queryMatch = !query || `${record.title} ${record.category} ${record.slug}`.toLocaleLowerCase("de-DE").includes(query);
      const show = viewMatch && queryMatch && matchesFilter(record, selectedFilter) && (!metricFilter || matchesMetric(record,metricFilter));
      row.hidden = !show;
      if (show) {
        list.append(row);
        visible += 1;
      }
    }
    if (empty) empty.hidden = visible > 0;
  };

  const setRowBusy = (slug: string, busy: boolean) => {
    const row = document.querySelector<HTMLElement>(`[data-product-row="${CSS.escape(slug)}"]`);
    row?.querySelectorAll<HTMLButtonElement>("button").forEach((button) => {
      button.disabled = busy || (button.hasAttribute("data-check-price") && !records.get(slug)?.targetUrl && !records.get(slug)?.commerceOffers?.length);
    });
    if (row) row.dataset.busy = busy ? "true" : "false";
  };

  const hasProtectedEditorInteraction = () =>
    dirtyEditors.size > 0 || Boolean(document.querySelector('[data-commerce-panel] [data-dirty="true"]')) || Boolean(document.activeElement?.closest("[data-editor], [data-offer-editor], [data-commerce-price-editor]"));

  const applyServerResult = (result: any) => {
    const record = result?.record ?? result;
    if (!record?.slug) throw new Error("Die Serverantwort enthält keinen persistierten Produktzustand.");
    updateRow(record);
    refreshMetrics();
    if (!hasProtectedEditorInteraction()) applyView();
    return record;
  };

  document.querySelectorAll<HTMLButtonElement>("[data-view]").forEach((button) => {
    button.addEventListener("click", () => {
      metricFilter="";currentView = button.dataset.view || "tasks";
      document.querySelectorAll<HTMLButtonElement>("[data-view]").forEach((candidate) => candidate.classList.toggle("is-active", candidate === button));
      applyView();
    });
  });
  filter?.addEventListener("change", ()=>{metricFilter="";applyView()});
  search?.addEventListener("input", applyView);

  document.querySelectorAll<HTMLButtonElement>("[data-toggle-editor]").forEach((button) => {
    button.addEventListener("click", () => {
      const slug = button.dataset.toggleEditor || "";
      const editor = document.querySelector<HTMLFormElement>(`[data-editor="${CSS.escape(slug)}"]`);
      if (!editor) return;
      editor.hidden = !editor.hidden;
      if (!editor.hidden) editor.querySelector<HTMLInputElement>("[data-draft='current']")?.focus();
    });
  });
  document.querySelectorAll<HTMLButtonElement>("[data-close-editor]").forEach((button) => {
    button.addEventListener("click", () => {
      const editor = document.querySelector<HTMLFormElement>(`[data-editor="${CSS.escape(button.dataset.closeEditor || "")}"]`);
      if (editor) editor.hidden = true;
    });
  });

  document.querySelectorAll<HTMLFormElement>("[data-editor]").forEach((editor) => {
    const slug = editor.dataset.editor || "";
    const initial = records.get(slug);
    const restored = persistedDrafts[slug];
    const initialDraft = restored ?? draftFrom(initial || {});
    drafts.set(slug, initialDraft);
    writeDraftToEditor(editor, initialDraft);

    if (restored) {
      dirtyEditors.add(slug);
      editor.dataset.dirty = "true";
    } else {
      editor.dataset.dirty = "false";
    }

    const captureDraft = (input: HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement) => {
      const draft = drafts.get(slug) ?? draftFrom(records.get(slug) || {});
      draft[input.dataset.draft as keyof Draft] = input.value;
      drafts.set(slug, draft);
      const wasDirty = dirtyEditors.has(slug);
      dirtyEditors.add(slug);
      editor.dataset.dirty = "true";
      persistDraft(slug, draft);
      if (!wasDirty) {
        setStatus(`${records.get(slug)?.title || slug}: ungespeicherte Eingaben werden vor automatischer Synchronisierung geschützt.`);
      }
    };

    editor.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>("[data-draft]").forEach((input) => {
      input.addEventListener("input", () => captureDraft(input));
      input.addEventListener("change", () => captureDraft(input));
    });
    editor.addEventListener("submit", (event) => {
      event.preventDefault();
      const draft = drafts.get(slug) ?? draftFrom(records.get(slug) || {});
      runOnce(`save:${slug}`, async () => {
        setRowBusy(slug, true);
        setStatus(`${records.get(slug)?.title || slug} wird atomar gespeichert …`);
        try {
          const result = await fetchJson("/api/admin/prices/manual", {
            method: "POST",
            body: JSON.stringify({
              slug,expectedHash:editor.dataset.sourceHash,confirmPrice:editor.querySelector<HTMLInputElement>('[data-confirm-price]')?.checked===true,
              current: draft.current,
              currency: draft.currency,
              priceState: draft.priceState,
              sourceLabel: draft.sourceLabel,
              targetUrl: draft.targetUrl,
              comparisonText: draft.comparisonText,
              availability: draft.availability,
              availabilityReason: draft.availabilityReason,
              manufacturerName: draft.manufacturerName,
              manufacturerSlug: draft.manufacturerSlug,
              manufacturerKey: draft.manufacturerSlug
            })
          });
          dirtyEditors.delete(slug);
          clearPersistedDraft(slug);
          editor.dataset.dirty = "false";
          const record = applyServerResult(result);
          syncEditor(record, { force: true });
          setStatus(`${record.title}: persistierter Zustand wurde beim ersten Speichern übernommen.`);
        } catch (error) {
          setStatus(error instanceof Error ? error.message : String(error), "error");
        } finally {
          setRowBusy(slug, false);
        }
      });
    });
  });

  document.querySelectorAll<HTMLButtonElement>("[data-check-price]").forEach((button) => {
    button.addEventListener("click", () => {
      const slug = button.dataset.checkPrice || "";
      runOnce(`check:${slug}`, async () => {
        setRowBusy(slug, true);
        setStatus(`${records.get(slug)?.title || slug} wird geprüft …`);
        try {
          const result = await fetchJson("/api/admin/prices/check", {
            method: "POST",
            body: JSON.stringify({ slug })
          });
          const record = applyServerResult(result);
          setStatus(`${record.title}: Commerce-Prüfung abgeschlossen.${result.error ? ` Hinweise: ${result.error}` : ''}`, result.ok === false ? 'error' : undefined);
        } catch (error) {
          setStatus(error instanceof Error ? error.message : String(error), "error");
        } finally {
          setRowBusy(slug, false);
        }
      });
    });
  });

  document.querySelectorAll<HTMLButtonElement>("[data-archive-product]").forEach((button) => {
    button.addEventListener("click", () => {
      const slug = button.dataset.archiveProduct || "";
      const archive = records.get(slug)?.maintenanceStatus !== "archived";
      runOnce(`archive:${slug}`, async () => {
        setRowBusy(slug, true);
        try {
          const result = await fetchJson("/api/admin/products/operations", {
            method: "POST",
            body: JSON.stringify({ slug, archive })
          });
          const record = applyServerResult(result);
          setStatus(`${record.title}: ${archive ? "archiviert" : "aus dem Archiv gelöst"}.`);
        } catch (error) {
          setStatus(error instanceof Error ? error.message : String(error), "error");
        } finally {
          setRowBusy(slug, false);
        }
      });
    });
  });

  const trackCommerceJob = async (initial: any) => {
    if (commerceJobPolling || !initial) return;
    commerceJobPolling = true;
    commerceRunActive = true;
    writable();
    let applied = 0;
    try {
      let job = initial;
      while (job) {
        for (const result of job.results.slice(applied)) if (result.record) applyServerResult(result);
        applied = job.results.length;
        if (job.status === 'failed') throw new Error(job.error || 'Commerce-Lauf fehlgeschlagen.');
        if (job.status === 'completed') {
          const sourceFailures = job.results.reduce((count: number, result: any) => count + (result.providerResults || []).filter((p: any) => !p.ok).length, 0);
          setStatus(`${job.completed} von ${job.total} Produkten geprüft: ${job.succeeded} Produkte mit bestätigter Aktualisierung, ${job.failed} ohne bestätigtes Ergebnis; ${sourceFailures} Quellen ohne Bestätigung. Fehlgeschlagene Prüfungen erneuern keine Preisbestätigung.`);
          break;
        }
        setStatus(job.total == null ? 'Produktbestand wird geladen …' : `${job.completed} von ${job.total} Produkten geprüft · ${job.currentTitle || 'Händlerangebote werden geprüft'}. Der Lauf läuft auch beim Neuladen weiter.`);
        await new Promise(resolve => setTimeout(resolve, 1000));
        job = await fetchJson('/api/admin/prices/check-all');
      }
    } catch (error) {
      setStatus(`Fortschritt nicht verfügbar; beim Neuladen wird der Serverlauf erneut abgefragt. ${error instanceof Error ? error.message : String(error)}`, 'error');
    } finally {
      commerceJobPolling = false;
      commerceRunActive = false;
      writable();
    }
  };

  document.querySelector<HTMLButtonElement>("[data-check-all]")?.addEventListener("click", () => {
    runOnce("check-all", async () => {
      commerceRunActive = true;
      writable();
      setStatus("Händlerangebote aller Produkte werden nacheinander geprüft …");
      try {
        await trackCommerceJob(await fetchJson('/api/admin/prices/check-all', {method: 'POST', body: '{}'}));
      } catch (error) {
        setStatus(error instanceof Error ? error.message : String(error), "error");
      } finally {
        commerceRunActive = false;
        writable();
      }
    });
  });

  const refreshFromServer = async () => {
    try {
      if(!localMode){setStatus("Öffentliche Ansicht: Produktpflege nur im lokalen Administrationsmodus möglich.");writable();return}
      const payload = await fetchJson("/api/admin/prices");serviceReady=true;
      for (const record of payload.products || []) updateRow(record);
      refreshMetrics();writable();
      const protectedCount = dirtyEditors.size;
      if (!hasProtectedEditorInteraction()) applyView();
      setStatus(
        protectedCount
          ? `${protectedCount} ungespeicherte Preisentwürfe wurden beibehalten; die übrigen Produktdaten sind synchronisiert.`
          : "Persistierter Produktzustand ist synchronisiert."
      );
      const job = await fetchJson('/api/admin/prices/check-all');
      if (job?.status === 'running') void trackCommerceJob(job);
    } catch (error) {
      serviceReady=false;writable();setStatus(`Lokaler Admin-Dienst nicht erreichbar. Starte npm --workspace apps/pfotentechnik run seo:admin und lade die Seite neu: ${error instanceof Error ? error.message : String(error)}`, "error");
      applyView();
    }
  };

  document.querySelector('[data-ops-list]')?.addEventListener('input', event => {
    const form = (event.target as Element).closest<HTMLFormElement>('[data-offer-editor], [data-commerce-price-editor], [data-link-editor]');
    if (form) form.dataset.dirty = 'true';
  });
  document.querySelector('[data-ops-list]')?.addEventListener('submit', async event => {
    const priceForm = (event.target as Element).closest<HTMLFormElement>('[data-commerce-price-editor]');
    if (priceForm) {
      event.preventDefault();
      const button = priceForm.querySelector<HTMLButtonElement>('button');
      const feedback = priceForm.querySelector<HTMLElement>('[data-price-save-status]');
      if (button) button.disabled = true;
      try {
        const fields = new FormData(priceForm);
        const result = await fetchJson('/api/admin/prices/manual', {method:'POST',body:JSON.stringify({
          slug:priceForm.dataset.slug,expectedHash:records.get(priceForm.dataset.slug||'')?.sourceHash,offerId:priceForm.dataset.id,
          current:fields.get('current'),currency:fields.get('currency'),availability:fields.get('availability'),
          priceState:String(fields.get('current') || '').trim() ? 'available' : 'unknown'
        })});
        priceForm.dataset.dirty = 'false';
        if (document.activeElement instanceof HTMLElement) document.activeElement.blur();
        applyServerResult(result);
        if (feedback) feedback.textContent = 'Gespeichert.';
        setStatus('Händlerpreis gespeichert. Die übrigen Angebote bleiben unverändert.');
      } catch(error) { if (feedback) feedback.textContent = error instanceof Error ? error.message : String(error); }
      finally { if(button) button.disabled = false; }
      return;
    }
    const form = (event.target as Element).closest<HTMLFormElement>('[data-offer-editor]');
    if (!form) return;
    event.preventDefault();
    const button = form.querySelector<HTMLButtonElement>('button');
    const feedback = form.querySelector<HTMLElement>('[data-offer-save-status]');
    if (button) button.disabled = true;
    try {
      const fields = new FormData(form);
      const result = await fetchJson('/api/admin/prices/offer',{method:'POST',body:JSON.stringify({
        slug:form.dataset.slug,id:form.dataset.id,program:form.dataset.program,
        officialProductUrl:fields.get('officialProductUrl'),variantId:fields.get('variantId'),expectedSku:fields.get('expectedSku'),confirmIdentity:fields.get('confirmIdentity')==='on'
      })});
      form.dataset.dirty = 'false';
      if (document.activeElement instanceof HTMLElement) document.activeElement.blur();
      applyServerResult(result);
      setStatus('Händlerzuordnung gespeichert. Neue unbestätigte Ziele bleiben unresolved.');
    } catch(error) { if(feedback) feedback.textContent = error instanceof Error ? error.message : String(error); }
    finally { if(button) button.disabled = false; }
  });
  const matchesMetric=(r:any,key:string)=>({products:true,withPrice:r.priceAvailable,withAffiliate:r.affiliateAvailable,knownAvailability:r.availability!=='unknown',missingPrice:!r.priceAvailable&&!r.editorialPriceControl&&!r.consciouslyUnavailable&&!r.archived,missingAffiliate:!r.affiliateAvailable&&!r.consciouslyUnavailable&&!r.archived,unknownAvailability:r.availability==='unknown',discontinued:r.availability==='discontinued',unavailable:['temporarily-unavailable','out-of-stock'].includes(r.availability),stale30:r.priceAgeDays>30,stale90:r.priceAgeDays>90,maintenanceRequired:r.maintenanceStatus==='required',maintenanceRecommended:r.maintenanceStatus==='recommended',archived:r.archived,maintenanceRate:['complete','archived'].includes(r.maintenanceStatus)})[key]??false;
  document.querySelectorAll<HTMLButtonElement>('[data-metric-filter]').forEach(b=>b.addEventListener('click',()=>{metricFilter=b.dataset.metricFilter||'';currentView='all';document.querySelectorAll('[data-view]').forEach(n=>n.classList.toggle('is-active',(n as HTMLElement).dataset.view==='all'));if(filter)filter.value='all';applyView();setStatus('Gefiltert: '+b.textContent?.trim())}));
  document.querySelector('[data-ops-list]')?.addEventListener('click',async event=>{
    const policyButton=(event.target as Element).closest<HTMLButtonElement>('[data-save-policy]');if(policyButton&&serviceReady){const editor=policyButton.closest('form')!;policyButton.disabled=true;try{const patch=Object.fromEntries([...editor.querySelectorAll<HTMLSelectElement>('[data-policy]')].map(n=>[n.dataset.policy,n.value]));applyServerResult(await fetchJson('/api/admin/products/operations',{method:'POST',body:JSON.stringify({...patch,expectedHash:records.get(policyButton.dataset.savePolicy||'')?.sourceHash,slug:policyButton.dataset.savePolicy})}));setStatus('Empfehlbarkeit und Pflegepriorität gespeichert.')}catch(e){setStatus(String(e),'error')}finally{writable()}return}

    const b=(event.target as Element).closest<HTMLButtonElement>('[data-remove-offer]');if(!b||!serviceReady)return;
    b.disabled=true;try{(document.activeElement as HTMLElement)?.blur();applyServerResult(await fetchJson('/api/admin/prices/link',{method:'POST',body:JSON.stringify({slug:b.dataset.slug,id:b.dataset.removeOffer,action:'remove',expectedHash:b.dataset.sourceHash})}));setStatus('Händlerlink entfernt. Andere Angebote sind erhalten.')}catch(e){setStatus(String(e),'error')}finally{writable()}
  });
  document.querySelector('[data-ops-list]')?.addEventListener('submit',async event=>{
    const f=(event.target as Element).closest<HTMLFormElement>('[data-link-editor]');if(!f)return;event.preventDefault();if(!serviceReady)return;
    const b=f.querySelector<HTMLButtonElement>('button')!;b.disabled=true;
    try{const input=Object.fromEntries(new FormData(f));const result=await fetchJson('/api/admin/prices/link',{method:'POST',body:JSON.stringify({...input,slug:f.dataset.slug,action:f.dataset.action,expectedHash:f.dataset.sourceHash,confirmIdentity:input.confirmIdentity==='on'})});f.dataset.dirty='false';(document.activeElement as HTMLElement)?.blur();applyServerResult(result);setStatus('Händlerlink persistent gespeichert. Produktseiten übernehmen ihn beim nächsten Build.')}catch(e){f.querySelector('[data-link-status]')!.textContent=String(e);setStatus(String(e),'error')}finally{writable()}
  });
  refreshMetrics();applyView();writable();void refreshFromServer();
</script>



<script>
  // PT_SEO_PRICE_WORKFLOW_2_0_1: robuste Ergänzung ohne Abhängigkeit von Status-Texten.
  document.querySelectorAll("[data-editor]").forEach((editor) => {
    const priceInput = editor.querySelector("[data-draft='current']");
    const priceStateInput = editor.querySelector("[data-draft='priceState']");
    const targetUrlInput = editor.querySelector("[data-draft='targetUrl']");
    const sourceInput = editor.querySelector("[data-draft='sourceLabel']");

    const notifyDraftChange = (input, eventName = "input") => {
      input?.dispatchEvent(new Event(eventName, { bubbles: true }));
    };

    const normalizePriceState = () => {
      if (!priceInput?.value.trim() || !priceStateInput) return;
      if (["unknown", "removed"].includes(priceStateInput.value)) {
        priceStateInput.value = "available";
        notifyDraftChange(priceStateInput, "change");
      }
    };

    priceInput?.addEventListener("input", normalizePriceState);

    targetUrlInput?.addEventListener("blur", () => {
      const raw = targetUrlInput.value.trim();
      if (!raw) return;
      const candidate = /^[a-z][a-z0-9+.-]*:\/\//i.test(raw) ? raw : "https://" + raw;
      try {
        const parsed = new URL(candidate);
        if (parsed.protocol === "http:") parsed.protocol = "https:";
        if (parsed.protocol !== "https:") return;
        targetUrlInput.value = parsed.href;
        notifyDraftChange(targetUrlInput);
        if (sourceInput && !sourceInput.value.trim()) {
          sourceInput.value = parsed.hostname.replace(/^www\./, "");
          notifyDraftChange(sourceInput);
        }
      } catch {
        // Die vorhandene Servervalidierung zeigt beim Speichern die konkrete Fehlermeldung.
      }
    });

    editor.addEventListener("submit", normalizePriceState, true);
    editor.addEventListener("keydown", (event) => {
      if ((event.ctrlKey || event.metaKey) && event.key === "Enter") {
        event.preventDefault();
        editor.requestSubmit();
      }
    });
  });
</script>

