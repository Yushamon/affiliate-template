---
import { getCollection } from "astro:content";
import SeoAdminLayout from "../../../layouts/SeoAdminLayout.astro";
import {
  AVAILABILITY_LABELS,
  buildOperationsDashboard,
  compareMaintenanceRows,
  toOperationsRecord
} from "../../../lib/product-operations/policy.mjs";

const products = await getCollection("products");
const rows = products
  .map((entry) => {
    const record = toOperationsRecord(entry.data);
    return { ...record, operations: record };
  })
  .sort(compareMaintenanceRows)
  .map(({ operations: _operations, ...record }) => record);
const dashboard = buildOperationsDashboard(rows.map((record) => ({ operations: record })));
const serviceUrl = import.meta.env.PUBLIC_SEARCH_ADMIN_URL || "http://127.0.0.1:4178";
const serializedConfig = JSON.stringify({ serviceUrl }).replaceAll("<", "\\u003c");
const serializedRows = JSON.stringify(rows).replaceAll("<", "\\u003c");
const formatDate = (value?: string | null) => value
  ? new Intl.DateTimeFormat("de-DE", { dateStyle: "medium" }).format(new Date(value))
  : "Nie";
const metrics = [
  ["missingPrice", "Ohne Preis"],
  ["missingAffiliate", "Ohne Affiliate"],
  ["unknownAvailability", "Verfügbarkeit unbekannt"],
  ["discontinued", "Eingestellt"],
  ["unavailable", "Nicht verfügbar"],
  ["stale30", "Preis älter als 30 Tage"],
  ["stale90", "Preis älter als 90 Tage"],
  ["maintenanceRequired", "Pflege erforderlich"],
  ["maintenanceRecommended", "Pflege empfohlen"],
  ["archived", "Archiviert"],
  ["maintenanceRate", "Pflegequote"]
] as const;
---

<SeoAdminLayout
  title="Produktpflege"
  description="Preis, Affiliate-Ziel, Verfügbarkeit, Empfehlbarkeit und Pflegepriorität verwalten. Der redaktionelle Produktscore bleibt davon vollständig getrennt."
  active="prices"
>
  <section class="pt-surface ops-summary seo-card">
    <div>
      <span class="seo-badge">Product Operations 1.0</span>
      <h2>Handlungsbedarf statt Datenrauschen</h2>
      <p>
        Die Standardansicht enthält nur echte Pflegeaufgaben. Bewusst als eingestellt,
        vorübergehend nicht verfügbar oder nicht lieferbar gepflegte Produkte werden
        nicht als offene Aufgabe gewertet.
      </p>
    </div>
    <button type="button" data-check-all>Aktive Preise prüfen</button>
  </section>

  <section class="ops-metrics" aria-label="Produktpflege-Kennzahlen">
    {metrics.map(([key, label]) => (
      <article class="pt-surface seo-card">
        <span>{label}</span>
        <strong data-metric={key}>
          {key === "maintenanceRate" ? `${dashboard[key]} %` : dashboard[key]}
        </strong>
      </article>
    ))}
  </section>

  <section class="pt-surface ops-toolbar seo-card" aria-label="Produktliste filtern">
    <div class="ops-tabs" role="group" aria-label="Ansicht">
      <button type="button" class="is-active" data-view="tasks">Arbeitsliste</button>
      <button type="button" data-view="all">Alle Produkte</button>
      <button type="button" data-view="archive">Archiv & Nichtverfügbarkeit</button>
    </div>
    <label>
      <span>Filter</span>
      <select data-filter>
        <option value="all">Alle</option>
        <option value="missing-price">Preis fehlt</option>
        <option value="missing-affiliate">Affiliate fehlt</option>
        <option value="stale-30">Preis älter als 30 Tage</option>
        <option value="stale-90">Preis älter als 90 Tage</option>
        <option value="unknown-availability">Verfügbarkeit unbekannt</option>
        <option value="temporarily-unavailable">Vorübergehend nicht verfügbar</option>
        <option value="out-of-stock">Nicht lieferbar</option>
        <option value="discontinued">Eingestellt</option>
        <option value="maintenance-required">Pflege erforderlich</option>
        <option value="maintenance-recommended">Pflege empfohlen</option>
        <option value="archived">Archiviert</option>
      </select>
    </label>
    <label class="ops-search">
      <span>Suche</span>
      <input type="search" data-search placeholder="Produkt oder Kategorie" />
    </label>
  </section>

  <p class="ops-status" aria-live="polite" data-ops-status></p>
  <script type="application/json" data-ops-config set:html={serializedConfig}></script>
  <script type="application/json" data-ops-records set:html={serializedRows}></script>

  <section class="pt-surface ops-table seo-card" aria-label="Produktpflege">
    <div class="ops-head" aria-hidden="true">
      <b>Produkt</b>
      <b>Preis</b>
      <b>Preisdatum</b>
      <b>Preisstatus</b>
      <b>Affiliate</b>
      <b>Verfügbarkeit</b>
      <b>Empfehlung</b>
      <b>Redaktion</b>
      <b>Pflege</b>
      <b>Aktionen</b>
    </div>

    <div data-ops-list>
      {rows.map((row) => (
        <article data-product-row={row.slug}>
          <div class="ops-cell ops-product">
            <a href={`/produkt/${row.slug}/`} target="_blank">{row.title}</a>
            <small>{row.category}</small>
            <small class="ops-warning" data-field="warnings">
              {row.warnings.length ? row.warnings.join(" · ") : "Keine offene Warnung"}
            </small>
          </div>
          <div class="ops-cell">
            <strong data-field="formattedCurrent">{row.formattedCurrent ?? "Fehlt"}</strong>
            <small data-field="sourceLabel">{row.sourceLabel}</small>
          </div>
          <div class="ops-cell">
            <span data-field="priceUpdated">{formatDate(row.priceUpdated)}</span>
            <small data-field="priceAgeDays">
              {row.priceAgeDays == null ? "Kein Datenstand" : `${row.priceAgeDays} Tage alt`}
            </small>
          </div>
          <div class="ops-cell">
            <span class="pt-chip ops-chip" data-field="priceState" data-state={row.priceState}>{row.priceState}</span>
          </div>
          <div class="ops-cell">
            <span class="pt-chip ops-chip" data-field="affiliateAvailable" data-state={row.affiliateAvailable ? "yes" : "no"}>
              {row.affiliateAvailable ? "Vorhanden" : "Fehlt"}
            </span>
          </div>
          <div class="ops-cell">
            <span class="pt-chip ops-chip" data-field="availability" data-state={row.availability}>{row.availabilityLabel}</span>
            <small data-field="availabilityReason">{row.availabilityReason ?? "Keine Bemerkung"}</small>
          </div>
          <div class="ops-cell">
            <span class="pt-chip ops-chip" data-field="recommendationStatus" data-state={row.recommendationStatus}>{row.recommendationLabel}</span>
          </div>
          <div class="ops-cell">
            <span class="pt-chip ops-chip" data-field="editorialStatus" data-state={row.editorialStatus}>{row.editorialStatus}</span>
          </div>
          <div class="ops-cell">
            <span class="pt-chip ops-chip" data-field="maintenanceStatus" data-state={row.maintenanceStatus}>{row.maintenanceLabel}</span>
          </div>
          <div class="ops-cell ops-actions">
            <button type="button" data-check-price={row.slug} disabled={!row.targetUrl || row.consciouslyUnavailable}>
              {row.targetUrl ? "Preis prüfen" : "URL fehlt"}
            </button>
            <button type="button" class="pt-button pt-button-secondary secondary" data-toggle-editor={row.slug}>Pflegen</button>
          </div>

          <form class="ops-editor" data-editor={row.slug} hidden>
            <label>
              <span>Preis</span>
              <input
                type="text"
                inputmode="decimal"
                autocomplete="off"
                data-draft="current"
                value={row.current ?? ""}
                placeholder="29,99"
              />
            </label>
            <label>
              <span>Währung</span>
              <select data-draft="currency">
                {["EUR", "CHF", "USD", "GBP"].map((currency) => (
                  <option value={currency} selected={currency === row.currency}>{currency}</option>
                ))}
              </select>
            </label>
            <label>
              <span>Preisstatus</span>
              <select data-draft="priceState">
                <option value="available" selected={row.priceState === "available"}>Preis vorhanden</option>
                <option value="unknown" selected={row.priceState === "unknown"}>Preis unbekannt</option>
                <option value="removed" selected={row.priceState === "removed"}>Bewusst entfernt</option>
                <option value="stale" selected={row.priceState === "stale"}>Veraltet</option>
              </select>
            </label>
            <label>
              <span>Quelle oder Händler</span>
              <input type="text" maxlength="120" data-draft="sourceLabel" value={row.sourceLabel === "Nicht angegeben" ? "" : row.sourceLabel} />
            </label>
            <label class="wide">
              <span>Affiliate- oder Händler-Ziel</span>
              <input type="url" inputmode="url" data-draft="targetUrl" value={row.targetUrl ?? ""} placeholder="https://…" />
            </label>
            <label>
              <span>Verfügbarkeit</span>
              <select data-draft="availability">
                {Object.entries(AVAILABILITY_LABELS).map(([value, label]) => (
                  <option value={value} selected={value === row.availability}>{label}</option>
                ))}
              </select>
            </label>
            <label class="wide">
              <span>Bemerkung zur Verfügbarkeit</span>
              <textarea rows="2" maxlength="500" data-draft="availabilityReason">{row.availabilityReason ?? ""}</textarea>
            </label>
            <label class="wide">
              <span>Kurze Preiseinordnung</span>
              <textarea rows="2" maxlength="360" data-draft="comparisonText">{row.comparisonText ?? ""}</textarea>
            </label>
            <div class="ops-editor__actions wide">
              <button type="submit" data-save-product={row.slug}>Preis und Verfügbarkeit speichern</button>
              <button type="button" class="pt-button pt-button-secondary secondary" data-archive-product={row.slug}>
                {row.maintenanceStatus === "archived" ? "Aus Archiv lösen" : "Bewusst archivieren"}
              </button>
              <button type="button" class="pt-button pt-button-secondary secondary" data-close-editor={row.slug}>Schließen</button>
            </div>
          </form>
        </article>
      ))}
    </div>
    <p class="seo-empty" data-empty hidden>Für diese Ansicht gibt es keine Produkte.</p>
  </section>
</SeoAdminLayout>

<script>
  type OperationsRecord = Record<string, any> & { slug: string; title: string };
  type Draft = {
    current: string;
    currency: string;
    priceState: string;
    sourceLabel: string;
    targetUrl: string;
    availability: string;
    availabilityReason: string;
    comparisonText: string;
  };

  const configNode = document.querySelector<HTMLScriptElement>("[data-ops-config]");
  const recordsNode = document.querySelector<HTMLScriptElement>("[data-ops-records]");
  const config = JSON.parse(configNode?.textContent || "{}");
  const serviceUrl = String(config.serviceUrl || "http://127.0.0.1:4178").replace(/\/$/, "");
  const initialRecords = JSON.parse(recordsNode?.textContent || "[]") as OperationsRecord[];
  const records = new Map(initialRecords.map((record) => [record.slug, record]));
  const drafts = new Map<string, Draft>();
  const inFlight = new Map<string, Promise<any>>();
  const status = document.querySelector<HTMLElement>("[data-ops-status]");
  const list = document.querySelector<HTMLElement>("[data-ops-list]");
  const empty = document.querySelector<HTMLElement>("[data-empty]");
  const filter = document.querySelector<HTMLSelectElement>("[data-filter]");
  const search = document.querySelector<HTMLInputElement>("[data-search]");
  let currentView = "tasks";

  const setStatus = (message: string, level: "normal" | "error" = "normal") => {
    if (!status) return;
    status.textContent = message;
    status.dataset.level = level;
  };

  const fetchJson = async (path: string, options: RequestInit = {}) => {
    const response = await fetch(`${serviceUrl}${path}`, {
      cache: "no-store",
      ...options,
      headers: {
        ...(options.body ? { "content-type": "application/json" } : {}),
        ...(options.headers || {})
      }
    });
    const payload = await response.json().catch(() => ({}));
    if (!response.ok) {
      throw new Error(payload?.error?.message || payload?.error || "Produktaktion fehlgeschlagen.");
    }
    return payload;
  };

  function runOnce<T>(key: string, task: () => Promise<T>): Promise<T> {
    const existing = inFlight.get(key);
    if (existing) return existing;
    const promise = task().finally(() => {
      if (inFlight.get(key) === promise) inFlight.delete(key);
    });
    inFlight.set(key, promise);
    return promise;
  }

  const formatDate = (value: string | null | undefined) => value
    ? new Intl.DateTimeFormat("de-DE", { dateStyle: "medium" }).format(new Date(value))
    : "Nie";

  const textFor = (record: OperationsRecord, field: string) => {
    if (field === "formattedCurrent") return record.formattedCurrent || "Fehlt";
    if (field === "priceUpdated") return formatDate(record.priceUpdated);
    if (field === "priceAgeDays") return record.priceAgeDays == null ? "Kein Datenstand" : `${record.priceAgeDays} Tage alt`;
    if (field === "affiliateAvailable") return record.affiliateAvailable ? "Vorhanden" : "Fehlt";
    if (field === "availability") return record.availabilityLabel;
    if (field === "availabilityReason") return record.availabilityReason || "Keine Bemerkung";
    if (field === "recommendationStatus") return record.recommendationLabel;
    if (field === "maintenanceStatus") return record.maintenanceLabel;
    if (field === "warnings") return record.warnings?.length ? record.warnings.join(" · ") : "Keine offene Warnung";
    return String(record[field] ?? "");
  };

  const draftFrom = (record: OperationsRecord): Draft => ({
    current: record.current == null ? "" : String(record.current).replace(".", ","),
    currency: record.currency || "EUR",
    priceState: record.priceState || "unknown",
    sourceLabel: record.sourceLabel === "Nicht angegeben" ? "" : record.sourceLabel || "",
    targetUrl: record.targetUrl || "",
    availability: record.availability || "unknown",
    availabilityReason: record.availabilityReason || "",
    comparisonText: record.comparisonText || ""
  });

  const syncEditor = (record: OperationsRecord) => {
    const editor = document.querySelector<HTMLFormElement>(`[data-editor="${CSS.escape(record.slug)}"]`);
    if (!editor) return;
    const draft = draftFrom(record);
    drafts.set(record.slug, draft);
    editor.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>("[data-draft]").forEach((input) => {
      const key = input.dataset.draft as keyof Draft;
      input.value = draft[key] ?? "";
    });
    const archiveButton = editor.querySelector<HTMLButtonElement>("[data-archive-product]");
    if (archiveButton) archiveButton.textContent = record.maintenanceStatus === "archived" ? "Aus Archiv lösen" : "Bewusst archivieren";
  };

  const updateRow = (record: OperationsRecord) => {
    records.set(record.slug, record);
    const row = document.querySelector<HTMLElement>(`[data-product-row="${CSS.escape(record.slug)}"]`);
    if (!row) return;
    row.querySelectorAll<HTMLElement>("[data-field]").forEach((node) => {
      const field = node.dataset.field || "";
      node.textContent = textFor(record, field);
      if (["priceState", "affiliateAvailable", "availability", "recommendationStatus", "editorialStatus", "maintenanceStatus"].includes(field)) {
        node.dataset.state = field === "affiliateAvailable" ? (record.affiliateAvailable ? "yes" : "no") : String(record[field] ?? "");
      }
    });
    const check = row.querySelector<HTMLButtonElement>("[data-check-price]");
    if (check) {
      check.disabled = !record.targetUrl || record.consciouslyUnavailable;
      check.textContent = record.targetUrl ? "Preis prüfen" : "URL fehlt";
    }
    syncEditor(record);
  };

  const metricValue = (key: string, values: OperationsRecord[]) => {
    const count = (predicate: (record: OperationsRecord) => boolean) => values.filter(predicate).length;
    if (key === "missingPrice") return count((record) => !record.priceAvailable && !record.consciouslyUnavailable && !record.archived);
    if (key === "missingAffiliate") return count((record) => !record.affiliateAvailable && !record.consciouslyUnavailable && !record.archived);
    if (key === "unknownAvailability") return count((record) => record.availability === "unknown");
    if (key === "discontinued") return count((record) => record.availability === "discontinued");
    if (key === "unavailable") return count((record) => ["temporarily-unavailable", "out-of-stock"].includes(record.availability));
    if (key === "stale30") return count((record) => record.priceAgeDays != null && record.priceAgeDays > 30);
    if (key === "stale90") return count((record) => record.priceAgeDays != null && record.priceAgeDays > 90);
    if (key === "maintenanceRequired") return count((record) => record.maintenanceStatus === "required");
    if (key === "maintenanceRecommended") return count((record) => record.maintenanceStatus === "recommended");
    if (key === "archived") return count((record) => record.maintenanceStatus === "archived");
    if (key === "maintenanceRate") {
      const complete = count((record) => ["complete", "archived"].includes(record.maintenanceStatus));
      return values.length ? `${Math.round((complete / values.length) * 1000) / 10} %` : "100 %";
    }
    return 0;
  };

  const refreshMetrics = () => {
    const values = [...records.values()];
    document.querySelectorAll<HTMLElement>("[data-metric]").forEach((node) => {
      node.textContent = String(metricValue(node.dataset.metric || "", values));
    });
  };

  const matchesFilter = (record: OperationsRecord, value: string) => {
    if (value === "all") return true;
    if (value === "missing-price") return !record.priceAvailable;
    if (value === "missing-affiliate") return !record.affiliateAvailable;
    if (value === "stale-30") return record.priceAgeDays != null && record.priceAgeDays > 30;
    if (value === "stale-90") return record.priceAgeDays != null && record.priceAgeDays > 90;
    if (value === "unknown-availability") return record.availability === "unknown";
    if (value === "temporarily-unavailable") return record.availability === "temporarily-unavailable";
    if (value === "out-of-stock") return record.availability === "out-of-stock";
    if (value === "discontinued") return record.availability === "discontinued";
    if (value === "maintenance-required") return record.maintenanceStatus === "required";
    if (value === "maintenance-recommended") return record.maintenanceStatus === "recommended";
    if (value === "archived") return record.maintenanceStatus === "archived";
    return true;
  };

  const applyView = () => {
    if (!list) return;
    const query = (search?.value || "").trim().toLocaleLowerCase("de-DE");
    const selectedFilter = filter?.value || "all";
    const ordered = [...records.values()].sort((left, right) =>
      Number(left.priorityRank ?? 1000) - Number(right.priorityRank ?? 1000) ||
      Number(right.priceAgeDays ?? -1) - Number(left.priceAgeDays ?? -1) ||
      String(left.title).localeCompare(String(right.title), "de")
    );
    let visible = 0;

    for (const record of ordered) {
      const row = document.querySelector<HTMLElement>(`[data-product-row="${CSS.escape(record.slug)}"]`);
      if (!row) continue;
      const viewMatch = currentView === "tasks" ? record.isTask : currentView === "archive" ? record.isArchive : true;
      const queryMatch = !query || `${record.title} ${record.category} ${record.slug}`.toLocaleLowerCase("de-DE").includes(query);
      const show = viewMatch && queryMatch && matchesFilter(record, selectedFilter);
      row.hidden = !show;
      if (show) {
        list.append(row);
        visible += 1;
      }
    }
    if (empty) empty.hidden = visible > 0;
  };

  const setRowBusy = (slug: string, busy: boolean) => {
    const row = document.querySelector<HTMLElement>(`[data-product-row="${CSS.escape(slug)}"]`);
    row?.querySelectorAll<HTMLButtonElement>("button").forEach((button) => {
      button.disabled = busy || (button.hasAttribute("data-check-price") && (!records.get(slug)?.targetUrl || records.get(slug)?.consciouslyUnavailable));
    });
    if (row) row.dataset.busy = busy ? "true" : "false";
  };

  const applyServerResult = (result: any) => {
    const record = result?.record ?? result;
    if (!record?.slug) throw new Error("Die Serverantwort enthält keinen persistierten Produktzustand.");
    updateRow(record);
    refreshMetrics();
    applyView();
    return record;
  };

  document.querySelectorAll<HTMLButtonElement>("[data-view]").forEach((button) => {
    button.addEventListener("click", () => {
      currentView = button.dataset.view || "tasks";
      document.querySelectorAll<HTMLButtonElement>("[data-view]").forEach((candidate) => candidate.classList.toggle("is-active", candidate === button));
      applyView();
    });
  });
  filter?.addEventListener("change", applyView);
  search?.addEventListener("input", applyView);

  document.querySelectorAll<HTMLButtonElement>("[data-toggle-editor]").forEach((button) => {
    button.addEventListener("click", () => {
      const slug = button.dataset.toggleEditor || "";
      const editor = document.querySelector<HTMLFormElement>(`[data-editor="${CSS.escape(slug)}"]`);
      if (!editor) return;
      editor.hidden = !editor.hidden;
      if (!editor.hidden) editor.querySelector<HTMLInputElement>("[data-draft='current']")?.focus();
    });
  });
  document.querySelectorAll<HTMLButtonElement>("[data-close-editor]").forEach((button) => {
    button.addEventListener("click", () => {
      const editor = document.querySelector<HTMLFormElement>(`[data-editor="${CSS.escape(button.dataset.closeEditor || "")}"]`);
      if (editor) editor.hidden = true;
    });
  });

  document.querySelectorAll<HTMLFormElement>("[data-editor]").forEach((editor) => {
    const slug = editor.dataset.editor || "";
    const initial = records.get(slug);
    if (initial) drafts.set(slug, draftFrom(initial));
    editor.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>("[data-draft]").forEach((input) => {
      input.addEventListener("input", () => {
        const draft = drafts.get(slug) ?? draftFrom(records.get(slug) || {});
        draft[input.dataset.draft as keyof Draft] = input.value;
        drafts.set(slug, draft);
      });
      input.addEventListener("change", () => {
        const draft = drafts.get(slug) ?? draftFrom(records.get(slug) || {});
        draft[input.dataset.draft as keyof Draft] = input.value;
        drafts.set(slug, draft);
      });
    });

    editor.addEventListener("submit", (event) => {
      event.preventDefault();
      const draft = drafts.get(slug) ?? draftFrom(records.get(slug) || {});
      runOnce(`save:${slug}`, async () => {
        setRowBusy(slug, true);
        setStatus(`${records.get(slug)?.title || slug} wird atomar gespeichert …`);
        try {
          const result = await fetchJson("/api/admin/prices/manual", {
            method: "POST",
            body: JSON.stringify({
              slug,
              current: draft.current,
              currency: draft.currency,
              priceState: draft.priceState,
              sourceLabel: draft.sourceLabel,
              targetUrl: draft.targetUrl,
              comparisonText: draft.comparisonText,
              availability: draft.availability,
              availabilityReason: draft.availabilityReason
            })
          });
          const record = applyServerResult(result);
          setStatus(`${record.title}: persistierter Zustand wurde beim ersten Speichern übernommen.`);
        } catch (error) {
          setStatus(error instanceof Error ? error.message : String(error), "error");
        } finally {
          setRowBusy(slug, false);
        }
      });
    });
  });

  document.querySelectorAll<HTMLButtonElement>("[data-check-price]").forEach((button) => {
    button.addEventListener("click", () => {
      const slug = button.dataset.checkPrice || "";
      runOnce(`check:${slug}`, async () => {
        setRowBusy(slug, true);
        setStatus(`${records.get(slug)?.title || slug} wird geprüft …`);
        try {
          const result = await fetchJson("/api/admin/prices/check", {
            method: "POST",
            body: JSON.stringify({ slug })
          });
          const record = applyServerResult(result);
          setStatus(`${record.title}: Preis, Preisdatum, Affiliate, Verfügbarkeit und Priorisierung wurden aktualisiert.`);
        } catch (error) {
          setStatus(error instanceof Error ? error.message : String(error), "error");
        } finally {
          setRowBusy(slug, false);
        }
      });
    });
  });

  document.querySelectorAll<HTMLButtonElement>("[data-archive-product]").forEach((button) => {
    button.addEventListener("click", () => {
      const slug = button.dataset.archiveProduct || "";
      const archive = records.get(slug)?.maintenanceStatus !== "archived";
      runOnce(`archive:${slug}`, async () => {
        setRowBusy(slug, true);
        try {
          const result = await fetchJson("/api/admin/products/operations", {
            method: "POST",
            body: JSON.stringify({ slug, archive })
          });
          const record = applyServerResult(result);
          setStatus(`${record.title}: ${archive ? "archiviert" : "aus dem Archiv gelöst"}.`);
        } catch (error) {
          setStatus(error instanceof Error ? error.message : String(error), "error");
        } finally {
          setRowBusy(slug, false);
        }
      });
    });
  });

  document.querySelector<HTMLButtonElement>("[data-check-all]")?.addEventListener("click", (event) => {
    const button = event.currentTarget as HTMLButtonElement;
    runOnce("check-all", async () => {
      button.disabled = true;
      setStatus("Aktive Produkte werden nacheinander geprüft …");
      try {
        const result = await fetchJson("/api/admin/prices/check-all", {
          method: "POST",
          body: JSON.stringify({ includeInactive: false })
        });
        for (const item of result.results || []) {
          if (item.ok && item.record) applyServerResult(item);
        }
        setStatus(`${result.succeeded} Preise aktualisiert, ${result.failed} ohne Ergebnis, ${result.skipped} bewusst inaktive Produkte übersprungen.`);
      } catch (error) {
        setStatus(error instanceof Error ? error.message : String(error), "error");
      } finally {
        button.disabled = false;
      }
    });
  });

  const refreshFromServer = async () => {
    try {
      const payload = await fetchJson("/api/admin/prices");
      for (const record of payload.products || []) updateRow(record);
      refreshMetrics();
      applyView();
      setStatus("Persistierter Produktzustand ist synchronisiert.");
    } catch (error) {
      setStatus(`Lokaler Admin-Dienst nicht erreichbar: ${error instanceof Error ? error.message : String(error)}`, "error");
      applyView();
    }
  };

  refreshMetrics();
  applyView();
  void refreshFromServer();
</script>

