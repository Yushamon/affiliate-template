---
// Generated by pfotentechnik-topical-authority-center-1.0.0
import SeoAdminLayout from '../../../layouts/SeoAdminLayout.astro';
import { loadTopicalAuthority } from '../../../lib/seo/topical-authority/loadTopicalAuthority';
const data=loadTopicalAuthority();
const generatedAt=new Date(data.generatedAt).toLocaleString('de-DE');
const status={strong:'Stark',developing:'Im Aufbau',gap:'Lücke'};
const type={page:'Ratgeber/Hub',comparison:'Vergleich',product:'Produkt',manufacturer:'Hersteller'};
---
<SeoAdminLayout title="Topical Authority" description="Strategische Cluster-Abdeckung, Content-Journeys und priorisierte Ausbauchancen aus dem aktuellen Repository." active="topical-authority">
<section class="hero seo-card"><div><span class="seo-eyebrow">Repository-Analyse · {generatedAt}</span><h2>Authority Score</h2><p>Bewertet Hub, Ratgeber, Vergleiche, Produkte, Hersteller und interne Cluster-Verlinkung. Kein Google-Messwert.</p></div><div class="score" style={`--score:${data.authorityScore}`}><strong>{data.authorityScore}</strong><span>/ 100</span></div></section>
<section class="metrics"><article class="seo-card"><span>Dokumente</span><strong>{data.summary.documents}</strong></article><article class="seo-card"><span>Starke Cluster</span><strong>{data.summary.strong}</strong></article><article class="seo-card"><span>Im Aufbau</span><strong>{data.summary.developing}</strong></article><article class="seo-card"><span>Lücken</span><strong>{data.summary.gaps}</strong></article><article class="seo-card"><span>Opportunities</span><strong>{data.summary.opportunities}</strong></article></section>
<section class="section"><header><div><span class="seo-eyebrow">Cluster Heatmap</span><h2>Themenreife im Vergleich</h2></div><p>Starke Cluster konsolidieren; schwache Cluster nur als geschlossene Journey ausbauen.</p></header><div class="clusters">{data.clusters.map(c=><details class="seo-card cluster" data-status={c.status} open={c.priority==='high'}><summary><div><span class="seo-badge" data-level={c.priority}>{status[c.status]}</span><h3>{c.label}</h3><p>{c.description}</p></div><div class="cluster-score"><strong>{c.score}</strong><span>/100</span></div></summary><div class="bar"><span style={`width:${c.score}%`}></span></div><div class="chips"><span>{c.counts.pages} Ratgeber/Hubs</span><span>{c.counts.comparisons} Vergleiche</span><span>{c.counts.products} Produkte</span><span>{c.counts.manufacturers} Hersteller</span><span>{c.linkCoverage}% Links</span></div><div class="coverage">{Object.entries(c.coverage).map(([k,v])=><span data-ok={String(v)}>{v?'✓':'–'} {{hub:'Hub',guides:'Ratgeber',comparisons:'Vergleiche',products:'Produkte',manufacturers:'Hersteller',journey:'Journey'}[k]}</span>)}</div><div class="detail"><div><h4>Offene Lücken</h4>{c.gaps.length?<ul>{c.gaps.map(g=><li>{g}</li>)}</ul>:<p class="seo-muted">Keine strukturelle Kernlücke erkannt.</p>}</div><div><h4>Nächster Schritt</h4><p>{c.nextAction}</p></div></div>{c.documents.length>0&&<div class="documents"><h4>Erkannte Inhalte ({c.documents.length})</h4><div class="table"><table><thead><tr><th>Typ</th><th>Inhalt</th><th>Route</th></tr></thead><tbody>{c.documents.map(d=><tr><td>{type[d.type]}</td><td>{d.title}</td><td><code>{d.route}</code></td></tr>)}</tbody></table></div></div>}</details>)}</div></section>
<section class="section"><header><div><span class="seo-eyebrow">Roadmap</span><h2>Priorisierte Opportunities</h2></div><p>Strategische Planung bleibt getrennt von technischen Release-Blockern.</p></header><div class="ops">{data.opportunities.map((o,i)=><article class="seo-card op"><div class="rank">{i+1}</div><div><div class="meta"><span class="seo-badge" data-level={o.priority}>{o.priority}</span><span>{o.cluster}</span><span>Impact {o.impact}</span><span>Aufwand {o.effort}</span></div><h3>{o.title}</h3><p>{o.reason}</p><div class="action"><strong>Aktion:</strong> {o.action}</div></div></article>)}</div></section>
<section class="section"><header><div><span class="seo-eyebrow">Funnel</span><h2>Zielarchitektur der Journey</h2></div></header><div class="seo-card journey">{['Ratgeber','Vergleich','Produkt','Hersteller','passender Ratgeber'].map((x,i,a)=><><div class="step"><span>{i+1}</span><strong>{x}</strong></div>{i<a.length-1&&<b aria-hidden="true">→</b>}</>)}</div></section>
<section class="section"><header><div><span class="seo-eyebrow">Prüfliste</span><h2>Mögliche verwaiste Inhalte</h2></div><p>Kandidaten ohne erkannten eingehenden Markdown-/HTML-Link. Dynamische Komponenten können zusätzliche Links liefern.</p></header><div class="seo-card orphans"><div class="table"><table><thead><tr><th>Typ</th><th>Titel</th><th>Route</th><th>Datei</th></tr></thead><tbody>{data.orphans.map(d=><tr><td>{type[d.type]}</td><td>{d.title}</td><td><code>{d.route}</code></td><td><code>{d.filePath}</code></td></tr>)}</tbody></table></div></div></section>
</SeoAdminLayout>
<style>
.hero{display:grid;grid-template-columns:1fr auto;gap:24px;align-items:center;padding:clamp(22px,5vw,40px)}.hero h2{margin:7px 0 9px;font-size:clamp(1.7rem,4vw,2.8rem)}.hero p{max-width:72ch;margin:0;color:var(--seo-muted);line-height:1.65}.score{display:grid;place-content:center;width:146px;aspect-ratio:1;border-radius:50%;background:radial-gradient(circle,var(--seo-surface) 61%,transparent 62%),conic-gradient(var(--seo-accent) calc(var(--score)*1%),var(--seo-surface-soft) 0);border:1px solid var(--seo-border);text-align:center}.score strong{font-size:2.6rem;line-height:.95}.score span{color:var(--seo-muted);font-weight:750}.metrics{display:grid;grid-template-columns:repeat(5,1fr);gap:12px;margin-top:16px}.metrics article{padding:18px}.metrics span{display:block;color:var(--seo-muted);font-size:.82rem;font-weight:750}.metrics strong{display:block;margin-top:6px;font-size:1.8rem}.section{margin-top:34px}.section>header{display:flex;justify-content:space-between;align-items:end;gap:24px;margin-bottom:14px}.section h2{margin:5px 0 0;font-size:clamp(1.5rem,3vw,2.2rem)}.section header p{max-width:620px;margin:0;color:var(--seo-muted);line-height:1.55}.clusters,.ops{display:grid;gap:14px}.cluster{overflow:clip}.cluster summary{display:grid;grid-template-columns:1fr auto;gap:18px;align-items:center;padding:20px;cursor:pointer;list-style:none}.cluster summary::-webkit-details-marker{display:none}.cluster h3{margin:8px 0 5px;font-size:1.35rem}.cluster summary p{margin:0;color:var(--seo-muted);line-height:1.5}.cluster-score{text-align:right}.cluster-score strong{font-size:1.8rem}.cluster-score span{color:var(--seo-muted)}.bar{height:8px;background:var(--seo-surface-soft)}.bar span{display:block;height:100%;background:var(--seo-accent)}.cluster[data-status=gap] .bar span{background:var(--seo-danger)}.cluster[data-status=developing] .bar span{background:var(--seo-warning)}.chips,.coverage{display:flex;flex-wrap:wrap;gap:8px;padding:16px 20px 0}.chips span,.coverage span{padding:7px 10px;border-radius:999px;background:var(--seo-surface-soft);color:var(--seo-muted);font-size:.8rem}.coverage span[data-ok=true]{background:var(--seo-accent-soft);color:var(--seo-accent-strong)}.detail{display:grid;grid-template-columns:1fr 1fr;gap:18px;padding:20px}.detail>div{padding:16px;border:1px solid var(--seo-border);border-radius:14px}.detail h4,.documents h4{margin:0 0 10px}.detail p,.detail ul{margin:0;line-height:1.6}.documents{padding:0 20px 20px}.table{overflow:auto}table{width:100%;border-collapse:collapse;font-size:.86rem}th,td{padding:10px;border-bottom:1px solid var(--seo-border);text-align:left;vertical-align:top}th{color:var(--seo-muted);font-size:.75rem;text-transform:uppercase}code{overflow-wrap:anywhere;color:var(--seo-muted)}.op{display:grid;grid-template-columns:44px 1fr;gap:14px;padding:20px}.rank{display:grid;place-items:center;width:38px;height:38px;border-radius:12px;background:var(--seo-accent-soft);color:var(--seo-accent-strong);font-weight:900}.meta{display:flex;flex-wrap:wrap;gap:8px;align-items:center;color:var(--seo-muted);font-size:.8rem}.op h3{margin:9px 0 7px}.op p{margin:0;color:var(--seo-muted);line-height:1.6}.action{margin-top:13px;padding:12px 14px;border-left:4px solid var(--seo-accent);background:var(--seo-surface-soft);line-height:1.55}.journey{display:flex;align-items:stretch;gap:10px;padding:18px;overflow:auto}.step{flex:1 0 150px;display:flex;align-items:center;gap:10px;min-height:72px;padding:14px;border:1px solid var(--seo-border);border-radius:14px;background:var(--seo-surface-soft)}.step span{display:grid;place-items:center;width:28px;height:28px;border-radius:50%;background:var(--seo-accent);color:var(--seo-on-accent);font-weight:900}.journey b{display:grid;place-items:center;color:var(--seo-muted);font-size:1.4rem}.orphans{padding:18px}@media(max-width:900px){.metrics{grid-template-columns:repeat(2,1fr)}.detail{grid-template-columns:1fr}}@media(max-width:620px){.hero{grid-template-columns:1fr}.score{width:122px}.metrics{grid-template-columns:1fr 1fr}.section>header{display:block}.section header p{margin-top:8px}.cluster summary{padding:16px}.detail{padding:16px}.op{grid-template-columns:1fr;padding:16px}}
</style>