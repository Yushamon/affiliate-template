---
import SeoAdminLayout from "../../../layouts/SeoAdminLayout.astro";
import { loadSeoDashboard } from "../../../lib/seo/loadDashboard";
import { loadSeoRecovery } from "../../../lib/seo/loadRecovery";
import { isOpportunityObserving, readOpportunityState } from "../../../lib/seo/opportunity-state.mjs";

const payload = loadSeoDashboard();
const recovery = loadSeoRecovery();
const opportunityServiceUrl = import.meta.env.PUBLIC_SEARCH_ADMIN_URL || "http://127.0.0.1:4178";
const serializedOpportunityConfig = JSON.stringify({ serviceUrl: opportunityServiceUrl }).replaceAll("<", "\\u003c");
const opportunityState = readOpportunityState();
const opportunityNow = Date.now();
const observingEntries = Object.values(opportunityState.entries || {})
  .filter((entry: any) => isOpportunityObserving(entry, opportunityNow))
  .sort((a: any, b: any) => new Date(b.optimizedAt).getTime() - new Date(a.optimizedAt).getTime());
const observingPages = new Set(observingEntries.map((entry: any) => entry.page));
const serializedPayload = JSON.stringify(payload)
  .replace(/</g, "\\u003c")
  .replace(/\u2028/g, "\\u2028")
  .replace(/\u2029/g, "\\u2029");
const generatedAt = new Date(payload.generatedAt).toLocaleString("de-DE");
const recoveryGeneratedAt = recovery.generatedAt ? new Date(recovery.generatedAt).toLocaleString("de-DE") : "noch nicht erzeugt";
const recoveryMigrationRows = recovery.migrations
  .filter((row) => row.status !== "healthy" || row.signal.primaryOld.impressions > 0)
  .slice(0, 12);
const recoveryOpportunityRows = recovery.opportunities
  .filter((row) => !observingPages.has(row.page))
  .slice(0, 15);
const activeOpportunityCount = recovery.opportunities.filter((row) => !observingPages.has(row.page)).length;
const recoveryOpportunityMap = new Map(recovery.opportunities.map((row) => [row.page, row]));
const recoveryObservingRows = observingEntries.slice(0, 20).map((entry: any) => ({
  entry,
  current: recoveryOpportunityMap.get(entry.page),
}));
const recoveryStatusLabel = {
  risk: "Risiko",
  watch: "beobachten",
  transferring: "Transfer sichtbar",
  healthy: "sauber",
} as const;
---
<SeoAdminLayout
  title="Search Cockpit"
  description="Google- und Bing-Signale nach Zeitraum. Auffälligkeiten werden hier untersucht und anschließend als Finding oder Arbeitspaket bearbeitet."
  active="cockpit"
>
  <div class="seo-stack-lg" data-search-cockpit>
    <section class="seo-panel seo-stack">
      <div class="seo-section-header">
        <div>
          <span class="seo-eyebrow">Google Search Console · Bing Webmaster Tools</span>
          <h2 data-period>Zeitraum wird geladen</h2>
        </div>
        <span class="seo-muted">Synchronisiert: {generatedAt}</span>
      </div>

      <div class="seo-tabs" aria-label="Zeitraum auswählen">
        {[
          ["24h", "24 Stunden"],
          ["7d", "7 Tage"],
          ["28d", "28 Tage"],
          ["3m", "3 Monate"],
          ["6m", "6 Monate"],
          ["12m", "12 Monate"],
        ].map(([key, label]) => (
          <button class="pt-button seo-button" type="button" data-range={key}>{label}</button>
        ))}
      </div>

      {payload.fallbackMode && (
        <div class="seo-empty">
          Die Multi-Zeitraum-Datei fehlt. Das Cockpit zeigt die vorhandenen 7-Tage-Daten.
          <code>npm run gsc:sync</code> aktualisiert die Quelle.
        </div>
      )}

      {payload.emptyMode && (
        <div class="seo-empty">
          Noch keine GSC-Daten vorhanden. Zuerst <code>npm run gsc:sync</code> ausführen.
        </div>
      )}

      <div class="seo-empty" data-partial hidden>
        Der Zeitraum enthält aktuelle, noch nicht vollständig verarbeitete Daten.
      </div>

      <div class="seo-metrics" data-metrics></div>
    </section>

    <section class="seo-grid" data-columns="2">
      <article class="seo-panel">
        <div class="seo-section-header"><div><h2>Quick Wins</h2></div></div>
        <div class="seo-list" data-quick-wins></div>
      </article>

      <article class="seo-panel">
        <div class="seo-section-header"><div><h2>Schwache CTR</h2></div></div>
        <div class="seo-list" data-weak-ctr></div>
      </article>

      <article class="seo-panel">
        <div class="seo-section-header"><div><h2>Suchbegriffe</h2></div></div>
        <div class="seo-table-wrap">
          <table class="seo-table">
            <thead>
              <tr><th>Suchanfrage</th><th>Impr.</th><th>Klicks</th><th>Pos.</th></tr>
            </thead>
            <tbody data-queries></tbody>
          </table>
        </div>
      </article>

      <article class="seo-panel">
        <div class="seo-section-header"><div><h2>Search-Empfehlungen</h2></div></div>
        <div class="seo-list" data-recommendations></div>
      </article>
    </section>


    <section class="seo-panel seo-stack" data-seo-recovery>
      <div class="seo-section-header">
        <div>
          <span class="seo-eyebrow">Google Search Console · Recovery</span>
          <h2>Recovery & Chancen</h2>
        </div>
        <span class="seo-muted">Recovery: {recoveryGeneratedAt}</span>
      </div>

      {!recovery.available ? (
        <div class="seo-empty">
          Noch kein Recovery-Report vorhanden. <code>npm run seo:recovery</code> erzeugt Migration- und Opportunity-Daten.
        </div>
      ) : (
        <div class="seo-metrics">
          <article class="seo-metric">
            <span>Redirects</span>
            <strong>{recovery.summary.redirects}</strong>
            <span>{recovery.summary.transferring} mit sichtbarem Transfer</span>
          </article>
          <article class="seo-metric">
            <span>Signal-Watch</span>
            <strong>{recovery.summary.migrationWatch}</strong>
            <span>alte URL hat noch GSC-Signale</span>
          </article>
          <article class="seo-metric">
            <span>Technische Fehler</span>
            <strong>{recovery.summary.technicalErrors}</strong>
            <span>{recovery.summary.distAvailable ? "Build geprüft" : "Build noch nicht geprüft"}</span>
          </article>
          <article class="seo-metric">
            <span>Opportunities</span>
            <strong>{activeOpportunityCount}</strong>
            <span>{observingEntries.length} in Beobachtung · Google-only</span>
          </article>
        </div>
      )}
    </section>

    {recovery.available && (
      <section class="seo-grid" data-columns="2">
        <article class="seo-panel">
          <div class="seo-section-header">
            <div>
              <span class="seo-eyebrow">URL-Migration</span>
              <h2>Migration Recovery</h2>
            </div>
          </div>
          <div class="seo-table-wrap">
            <table class="seo-table">
              <thead>
                <tr><th>Alt → Neu</th><th>GSC {recovery.source.primaryRange}</th><th>Status</th></tr>
              </thead>
              <tbody>
                {recoveryMigrationRows.length ? recoveryMigrationRows.map((row) => (
                  <tr>
                    <td>
                      <code>{row.source}</code><br />
                      <span class="seo-muted">→ {row.target}</span>
                    </td>
                    <td>
                      alt {row.signal.primaryOld.impressions} · neu {row.signal.primaryNew.impressions}
                    </td>
                    <td>
                      <strong>{recoveryStatusLabel[row.status]}</strong>
                      {row.technicalIssues.length > 0 && (
                        <><br /><span class="seo-muted">{row.technicalIssues.join("; ")}</span></>
                      )}
                    </td>
                  </tr>
                )) : (
                  <tr><td colspan="3">Keine Migration mit aktuellem Beobachtungsbedarf.</td></tr>
                )}
              </tbody>
            </table>
          </div>
        </article>

        <article class="seo-panel">
          <div class="seo-section-header">
            <div>
              <span class="seo-eyebrow">Google-only Priorisierung</span>
              <h2>Google Opportunities</h2>
            </div>
          </div>
          <div class="seo-table-wrap">
            <table class="seo-table">
              <thead>
                <tr><th>Seite</th><th>Signal</th><th>Nächster Hebel</th><th>Aktion</th></tr>
              </thead>
              <tbody>
                {recoveryOpportunityRows.length ? recoveryOpportunityRows.map((row) => (
                  <tr>
                    <td>
                      <code>{row.page}</code><br />
                      <span class="seo-muted">Score {row.score}/100 · {row.confidence}</span>
                    </td>
                    <td>
                      {row.metrics.impressions} Impr. · Pos. {row.metrics.position.toFixed(1)}
                    </td>
                    <td>{row.action}</td>
                    <td>
                      <button
                        type="button"
                        class="pt-button seo-button"
                        data-opportunity-mark
                        data-page={row.page}
                        data-clicks={row.metrics.clicks}
                        data-impressions={row.metrics.impressions}
                        data-ctr={row.metrics.ctr}
                        data-position={row.metrics.position}
                      >
                        Bearbeitet
                      </button>
                    </td>
                  </tr>
                )) : (
                  <tr><td colspan="4">Keine aktive Opportunity. Bearbeitete Seiten können unten beobachtet werden.</td></tr>
                )}
              </tbody>
            </table>
          </div>
        </article>
      </section>
    )}

    {recovery.available && (
      <section class="seo-panel seo-stack" data-opportunity-watch>
        <div class="seo-section-header">
          <div>
            <span class="seo-eyebrow">Nach Optimierung</span>
            <h2>Optimierungen beobachten</h2>
          </div>
          <span class="seo-muted">Standard: 21 Tage Cooldown</span>
        </div>
        <div class="seo-table-wrap">
          <table class="seo-table">
            <thead>
              <tr><th>Seite</th><th>Bearbeitet</th><th>Baseline</th><th>Aktuelles Signal</th><th>Aktion</th></tr>
            </thead>
            <tbody>
              {recoveryObservingRows.length ? recoveryObservingRows.map(({ entry, current }: any) => (
                <tr>
                  <td><code>{entry.page}</code></td>
                  <td>
                    {new Date(entry.optimizedAt).toLocaleDateString("de-DE")}<br />
                    <span class="seo-muted">bis {new Date(entry.observeUntil).toLocaleDateString("de-DE")}</span>
                  </td>
                  <td>
                    {entry.baseline?.impressions ?? 0} Impr. · Pos. {Number(entry.baseline?.position || 0).toFixed(1)}
                  </td>
                  <td>
                    {current
                      ? `${current.metrics.impressions} Impr. · Pos. ${current.metrics.position.toFixed(1)}`
                      : "aktuell keine Opportunity"}
                  </td>
                  <td>
                    <button
                      type="button"
                      class="pt-button seo-button"
                      data-opportunity-reopen
                      data-page={entry.page}
                    >
                      Wieder öffnen
                    </button>
                  </td>
                </tr>
              )) : (
                <tr><td colspan="5">Noch keine Optimierung in Beobachtung.</td></tr>
              )}
            </tbody>
          </table>
        </div>
      </section>
    )}

    <script type="application/json" data-opportunity-config set:html={serializedOpportunityConfig}></script>
    <script type="application/json" data-search-json set:html={serializedPayload}></script>
  </div>
</SeoAdminLayout>

<script>
  const root = document.querySelector<HTMLElement>("[data-search-cockpit]");
  if (root) {
    const payload = JSON.parse(root.querySelector<HTMLScriptElement>("[data-search-json]")?.textContent || "{}");
    const number = new Intl.NumberFormat("de-DE");

    const cleanUrl = (url: string) =>
      (url || "/")
        .replace("https://www.pfotentechnik.de", "")
        .replace("https://pfotentechnik.de", "") || "/";

    const node = <K extends keyof HTMLElementTagNameMap>(
      tag: K,
      text?: string,
      className?: string,
    ): HTMLElementTagNameMap[K] => {
      const element = document.createElement(tag);
      if (text !== undefined) element.textContent = text;
      if (className) element.className = className;
      return element;
    };

    const listItem = (title: string, meta: string) => {
      const article = node("article", undefined, "seo-list-item");
      article.append(node("h3", title), node("p", meta));
      return article;
    };

    const signed = (value: number, suffix = "") => `${value > 0 ? "+" : ""}${value}${suffix}`;

    const render = (rangeKey: string) => {
      const data = payload.ranges?.[rangeKey];
      if (!data) return;

      root.querySelectorAll<HTMLButtonElement>("[data-range]").forEach((button) => {
        const exists = Boolean(payload.ranges?.[button.dataset.range || ""]);
        button.hidden = !exists;
        button.classList.toggle("is-primary", button.dataset.range === rangeKey);
      });

      const partial = root.querySelector<HTMLElement>("[data-partial]");
      if (partial) partial.hidden = !data.partial;

      const comparison = data.comparisonStartDate && data.comparisonEndDate
        ? ` · Vergleich ${String(data.comparisonStartDate).slice(0, 10)} bis ${String(data.comparisonEndDate).slice(0, 10)}`
        : "";
      const period = root.querySelector<HTMLElement>("[data-period]");
      if (period) period.textContent = `${data.label}${comparison}`;

      const current = data.metrics.current;
      const change = data.metrics.change;
      const comparisonAvailable = data.comparisonAvailable !== false;
      const metricValues = [
        ["Klicks", number.format(current.clicks), comparisonAvailable ? signed(change.clicks, " %") : "kein Vergleich"],
        ["Impressionen", number.format(current.impressions), comparisonAvailable ? signed(change.impressions, " %") : "kein Vergleich"],
        ["CTR", `${current.ctr.toFixed(2)} %`, comparisonAvailable ? signed(change.ctr, " Pp.") : "kein Vergleich"],
        ["Position", current.position.toFixed(1), comparisonAvailable ? signed(change.position) : "kein Vergleich"],
      ];

      const metrics = root.querySelector<HTMLElement>("[data-metrics]");
      metrics?.replaceChildren(...metricValues.map(([label, value, delta]) => {
        const article = node("article", undefined, "seo-metric");
        article.append(node("span", label), node("strong", value), node("span", delta));
        return article;
      }));

      const quickWins = (data.recommendations || [])
        .filter((item: any) => item.type === "quick-win")
        .slice(0, 20);
      const quickWinList = root.querySelector<HTMLElement>("[data-quick-wins]");
      quickWinList?.replaceChildren(...(
        quickWins.length
          ? quickWins.map((row: any) => listItem(
              `${cleanUrl(row.page)}${row.query ? ` · ${row.query}` : ""}`,
              `${row.reason} · ${row.action}`,
            ))
          : [listItem("Keine Quick Wins", "Für diesen Zeitraum wurde kein belastbarer Treffer gefunden.")]
      ));

      const weakCtr = (data.recommendations || [])
        .filter((item: any) => item.type === "ctr")
        .slice(0, 20);
      const weakCtrList = root.querySelector<HTMLElement>("[data-weak-ctr]");
      weakCtrList?.replaceChildren(...(
        weakCtr.length
          ? weakCtr.map((row: any) => listItem(
              `${cleanUrl(row.page)}${row.query ? ` · ${row.query}` : ""}`,
              `${row.reason} · ${row.action}`,
            ))
          : [listItem("Keine auffälligen Seiten", "Keine Seite liegt unter dem Schwellenwert.")]
      ));

      const queryBody = root.querySelector<HTMLTableSectionElement>("[data-queries]");
      queryBody?.replaceChildren(...(data.queries || []).slice(0, 30).map((row: any) => {
        const tr = document.createElement("tr");
        [
          row.query,
          number.format(row.impressions),
          number.format(row.clicks),
          row.position.toFixed(1),
        ].forEach((value) => tr.append(node("td", String(value))));
        return tr;
      }));

      const recommendations = (data.recommendations || [])
        .filter((item: any) => !["quick-win", "ctr"].includes(item.type))
        .slice(0, 20);
      const recommendationList = root.querySelector<HTMLElement>("[data-recommendations]");
      recommendationList?.replaceChildren(...(
        recommendations.length
          ? recommendations.map((item: any) => listItem(
              `${item.title}: ${cleanUrl(item.page)}`,
              `${item.reason} · ${item.action}`,
            ))
          : [listItem("Keine dringende Empfehlung", "Für diesen Zeitraum gibt es keinen Regel-Treffer.")]
      ));

      localStorage.setItem("seo-cockpit-range", rangeKey);
    };

    root.querySelectorAll<HTMLButtonElement>("[data-range]").forEach((button) => {
      button.addEventListener("click", () => render(button.dataset.range || ""));
    });

    const opportunityConfigNode = root.querySelector<HTMLScriptElement>("[data-opportunity-config]");
    const opportunityConfig = JSON.parse(opportunityConfigNode?.textContent || "{}");
    const opportunityServiceUrl = String(
      opportunityConfig.serviceUrl || "http://127.0.0.1:4178"
    ).replace(/\/$/, "");

    const postJson = async (url: string, body: Record<string, unknown>) => {
      const response = await fetch(`${opportunityServiceUrl}${url}`, {
        method: "POST",
        headers: {
          "content-type": "application/json",
          "accept": "application/json",
        },
        body: JSON.stringify(body),
      });
      const result = await response.json().catch(() => ({}));
      if (!response.ok) {
        throw new Error(result?.error?.message || `HTTP ${response.status}`);
      }
      return result;
    };

    root.querySelectorAll<HTMLButtonElement>("[data-opportunity-mark]").forEach((button) => {
      button.addEventListener("click", async () => {
        const page = button.dataset.page || "";
        const originalLabel = button.textContent || "Bearbeitet";
        button.disabled = true;
        button.textContent = "Speichere…";

        try {
          await postJson("/api/admin/seo/opportunities/mark", {
            page,
            observeDays: 21,
            baseline: {
              clicks: Number(button.dataset.clicks || 0),
              impressions: Number(button.dataset.impressions || 0),
              ctr: Number(button.dataset.ctr || 0),
              position: Number(button.dataset.position || 0),
            },
          });
          window.location.reload();
        } catch (error) {
          button.disabled = false;
          button.textContent = originalLabel;
          window.alert(error instanceof Error ? error.message : String(error));
        }
      });
    });

    root.querySelectorAll<HTMLButtonElement>("[data-opportunity-reopen]").forEach((button) => {
      button.addEventListener("click", async () => {
        const page = button.dataset.page || "";
        const originalLabel = button.textContent || "Wieder öffnen";
        button.disabled = true;
        button.textContent = "Öffne…";

        try {
          await postJson("/api/admin/seo/opportunities/reopen", { page });
          window.location.reload();
        } catch (error) {
          button.disabled = false;
          button.textContent = originalLabel;
          window.alert(error instanceof Error ? error.message : String(error));
        }
      });
    });

    const saved = localStorage.getItem("seo-cockpit-range");
    const initial =
      saved && payload.ranges?.[saved]
        ? saved
        : payload.defaultRange && payload.ranges?.[payload.defaultRange]
          ? payload.defaultRange
          : Object.keys(payload.ranges || {})[0];

    if (initial) render(initial);
  }
</script>
