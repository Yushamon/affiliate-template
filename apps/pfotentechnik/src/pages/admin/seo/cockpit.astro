---
import SeoAdminLayout from "../../../layouts/SeoAdminLayout.astro";
import { loadSeoDashboard } from "../../../lib/seo/loadDashboard";

const payload = loadSeoDashboard();
const serializedPayload = JSON.stringify(payload)
  .replace(/</g, "\\u003c")
  .replace(/\u2028/g, "\\u2028")
  .replace(/\u2029/g, "\\u2029");
const generatedAt = new Date(payload.generatedAt).toLocaleString("de-DE");
---
<SeoAdminLayout
  title="Search Cockpit"
  description="Google- und Bing-Signale nach Zeitraum. Auffälligkeiten werden hier untersucht und anschließend als Finding oder Arbeitspaket bearbeitet."
  active="cockpit"
>
  <div class="seo-stack-lg" data-search-cockpit>
    <section class="seo-panel seo-stack">
      <div class="seo-section-header">
        <div>
          <span class="seo-eyebrow">Google Search Console · Bing Webmaster Tools</span>
          <h2 data-period>Zeitraum wird geladen</h2>
        </div>
        <span class="seo-muted">Synchronisiert: {generatedAt}</span>
      </div>

      <div class="seo-tabs" aria-label="Zeitraum auswählen">
        {[
          ["24h", "24 Stunden"],
          ["7d", "7 Tage"],
          ["28d", "28 Tage"],
          ["3m", "3 Monate"],
          ["6m", "6 Monate"],
          ["12m", "12 Monate"],
        ].map(([key, label]) => (
          <button class="pt-button seo-button" type="button" data-range={key}>{label}</button>
        ))}
      </div>

      {payload.fallbackMode && (
        <div class="seo-empty">
          Die Multi-Zeitraum-Datei fehlt. Das Cockpit zeigt die vorhandenen 7-Tage-Daten.
          <code>npm run gsc:sync</code> aktualisiert die Quelle.
        </div>
      )}

      {payload.emptyMode && (
        <div class="seo-empty">
          Noch keine GSC-Daten vorhanden. Zuerst <code>npm run gsc:sync</code> ausführen.
        </div>
      )}

      <div class="seo-empty" data-partial hidden>
        Der Zeitraum enthält aktuelle, noch nicht vollständig verarbeitete Daten.
      </div>

      <div class="seo-metrics" data-metrics></div>
    </section>

    <section class="seo-grid" data-columns="2">
      <article class="seo-panel">
        <div class="seo-section-header"><div><h2>Quick Wins</h2></div></div>
        <div class="seo-list" data-quick-wins></div>
      </article>

      <article class="seo-panel">
        <div class="seo-section-header"><div><h2>Schwache CTR</h2></div></div>
        <div class="seo-list" data-weak-ctr></div>
      </article>

      <article class="seo-panel">
        <div class="seo-section-header"><div><h2>Suchbegriffe</h2></div></div>
        <div class="seo-table-wrap">
          <table class="seo-table">
            <thead>
              <tr><th>Suchanfrage</th><th>Impr.</th><th>Klicks</th><th>Pos.</th></tr>
            </thead>
            <tbody data-queries></tbody>
          </table>
        </div>
      </article>

      <article class="seo-panel">
        <div class="seo-section-header"><div><h2>Search-Empfehlungen</h2></div></div>
        <div class="seo-list" data-recommendations></div>
      </article>
    </section>

    <script type="application/json" data-search-json set:html={serializedPayload}></script>
  </div>
</SeoAdminLayout>

<script>
  const root = document.querySelector<HTMLElement>("[data-search-cockpit]");
  if (root) {
    const payload = JSON.parse(root.querySelector<HTMLScriptElement>("[data-search-json]")?.textContent || "{}");
    const number = new Intl.NumberFormat("de-DE");

    const cleanUrl = (url: string) =>
      (url || "/")
        .replace("https://www.pfotentechnik.de", "")
        .replace("https://pfotentechnik.de", "") || "/";

    const node = <K extends keyof HTMLElementTagNameMap>(
      tag: K,
      text?: string,
      className?: string,
    ): HTMLElementTagNameMap[K] => {
      const element = document.createElement(tag);
      if (text !== undefined) element.textContent = text;
      if (className) element.className = className;
      return element;
    };

    const listItem = (title: string, meta: string) => {
      const article = node("article", undefined, "seo-list-item");
      article.append(node("h3", title), node("p", meta));
      return article;
    };

    const signed = (value: number, suffix = "") => `${value > 0 ? "+" : ""}${value}${suffix}`;

    const render = (rangeKey: string) => {
      const data = payload.ranges?.[rangeKey];
      if (!data) return;

      root.querySelectorAll<HTMLButtonElement>("[data-range]").forEach((button) => {
        const exists = Boolean(payload.ranges?.[button.dataset.range || ""]);
        button.hidden = !exists;
        button.classList.toggle("is-primary", button.dataset.range === rangeKey);
      });

      const partial = root.querySelector<HTMLElement>("[data-partial]");
      if (partial) partial.hidden = !data.partial;

      const comparison = data.comparisonStartDate && data.comparisonEndDate
        ? ` · Vergleich ${String(data.comparisonStartDate).slice(0, 10)} bis ${String(data.comparisonEndDate).slice(0, 10)}`
        : "";
      const period = root.querySelector<HTMLElement>("[data-period]");
      if (period) period.textContent = `${data.label}${comparison}`;

      const current = data.metrics.current;
      const change = data.metrics.change;
      const comparisonAvailable = data.comparisonAvailable !== false;
      const metricValues = [
        ["Klicks", number.format(current.clicks), comparisonAvailable ? signed(change.clicks, " %") : "kein Vergleich"],
        ["Impressionen", number.format(current.impressions), comparisonAvailable ? signed(change.impressions, " %") : "kein Vergleich"],
        ["CTR", `${current.ctr.toFixed(2)} %`, comparisonAvailable ? signed(change.ctr, " Pp.") : "kein Vergleich"],
        ["Position", current.position.toFixed(1), comparisonAvailable ? signed(change.position) : "kein Vergleich"],
      ];

      const metrics = root.querySelector<HTMLElement>("[data-metrics]");
      metrics?.replaceChildren(...metricValues.map(([label, value, delta]) => {
        const article = node("article", undefined, "seo-metric");
        article.append(node("span", label), node("strong", value), node("span", delta));
        return article;
      }));

      const quickWins = (data.recommendations || [])
        .filter((item: any) => item.type === "quick-win")
        .slice(0, 20);
      const quickWinList = root.querySelector<HTMLElement>("[data-quick-wins]");
      quickWinList?.replaceChildren(...(
        quickWins.length
          ? quickWins.map((row: any) => listItem(
              `${cleanUrl(row.page)}${row.query ? ` · ${row.query}` : ""}`,
              `${row.reason} · ${row.action}`,
            ))
          : [listItem("Keine Quick Wins", "Für diesen Zeitraum wurde kein belastbarer Treffer gefunden.")]
      ));

      const weakCtr = (data.recommendations || [])
        .filter((item: any) => item.type === "ctr")
        .slice(0, 20);
      const weakCtrList = root.querySelector<HTMLElement>("[data-weak-ctr]");
      weakCtrList?.replaceChildren(...(
        weakCtr.length
          ? weakCtr.map((row: any) => listItem(
              `${cleanUrl(row.page)}${row.query ? ` · ${row.query}` : ""}`,
              `${row.reason} · ${row.action}`,
            ))
          : [listItem("Keine auffälligen Seiten", "Keine Seite liegt unter dem Schwellenwert.")]
      ));

      const queryBody = root.querySelector<HTMLTableSectionElement>("[data-queries]");
      queryBody?.replaceChildren(...(data.queries || []).slice(0, 30).map((row: any) => {
        const tr = document.createElement("tr");
        [
          row.query,
          number.format(row.impressions),
          number.format(row.clicks),
          row.position.toFixed(1),
        ].forEach((value) => tr.append(node("td", String(value))));
        return tr;
      }));

      const recommendations = (data.recommendations || [])
        .filter((item: any) => !["quick-win", "ctr"].includes(item.type))
        .slice(0, 20);
      const recommendationList = root.querySelector<HTMLElement>("[data-recommendations]");
      recommendationList?.replaceChildren(...(
        recommendations.length
          ? recommendations.map((item: any) => listItem(
              `${item.title}: ${cleanUrl(item.page)}`,
              `${item.reason} · ${item.action}`,
            ))
          : [listItem("Keine dringende Empfehlung", "Für diesen Zeitraum gibt es keinen Regel-Treffer.")]
      ));

      localStorage.setItem("seo-cockpit-range", rangeKey);
    };

    root.querySelectorAll<HTMLButtonElement>("[data-range]").forEach((button) => {
      button.addEventListener("click", () => render(button.dataset.range || ""));
    });

    const saved = localStorage.getItem("seo-cockpit-range");
    const initial =
      saved && payload.ranges?.[saved]
        ? saved
        : payload.defaultRange && payload.ranges?.[payload.defaultRange]
          ? payload.defaultRange
          : Object.keys(payload.ranges || {})[0];

    if (initial) render(initial);
  }
</script>
