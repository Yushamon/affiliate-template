---

import ProjectLayout from "../../layouts/ProjectLayout.astro";
import "../../styles/pfotentechnik-product-mobile-premium.css";

import ProductRenderer from "../../components/product-standard-2/ProductRenderer.astro";
import AutoLinkContent from "@affiliate-core/components/AutoLinkContent.astro";
import RelatedArticles from "@affiliate-core/components/RelatedArticles.astro";
import DecisionNextSteps from "../../components/DecisionNextSteps.astro";
import EditorialTransparency from "../../components/EditorialTransparency.astro";
import { addAmazonTrackingId } from "@affiliate-core/affiliate";
import { projectConfig, site } from "../../project.config";

import {
  getAlternativeRecommendations
} from "@app/domain/productAlternatives";
import {
  getProductBreadcrumbs,
  getRelatedContent
} from "@app/domain/content";
import {
  getInternalLinkDefinitions,
  getSourceContexts
} from "../../domain/content/internalLinks";
import { buildProductNextSteps } from "../../domain/recommendationLinks";
import { deriveProductOperations } from "../../lib/product-operations/policy.mjs";
import { calculateProductScore } from "../../domain/productScore";
import { getCachedImage } from "../../lib/imageOptimization";
import {
  getComparisons,
  getManufacturers,
  getPages,
  getProducts,
  type ProductEntry
} from "../../domain/content/registry";

type PageProps = {
  contentEntry: ProductEntry;
};

export async function getStaticPaths() {
  const contentProducts =
    await getProducts();

  return contentProducts.map(
    (entry) => ({
      params: {
        product: entry.data.slug
      },
      props: {
        contentEntry: entry
      } satisfies PageProps
    })
  );
}

const { contentEntry } =
  Astro.props as PageProps;

if (!contentEntry) {
  throw new Error("Das Content-Produkt wurde nicht an die Route übergeben.");
}

const contentProduct =
  contentEntry.data;
const productOperations = deriveProductOperations(contentProduct);

const breadcrumbs =
  getProductBreadcrumbs(contentEntry);

const [allProducts, pages, comparisons, manufacturers] =
  await Promise.all([
    getProducts(),
    getPages(),
    getComparisons(),
    getManufacturers()
  ]);
const internalLinkDefinitions = getInternalLinkDefinitions({
  pages,
  products: allProducts,
  comparisons,
  manufacturers
});
const sourceContexts = getSourceContexts(contentProduct);

const alternativeRecommendations =
  getAlternativeRecommendations(
    contentEntry,
    allProducts,
    3
  );

const relatedEntries = await getRelatedContent({
  currentSlug: contentProduct.slug,
  tags: contentProduct.related?.tags.length
    ? contentProduct.related.tags
    : contentProduct.tags,
  sections: contentProduct.hub?.sections ?? [],
  type: "product",
  exclude: contentProduct.related?.exclude ?? [],
  limit: contentProduct.related?.limit ?? 4
});

const relatedItems = relatedEntries
  .filter((entry) => entry.type !== "product" && entry.type !== "comparison")
  .map((entry) => ({
    href: entry.href,
    label: entry.type === "manufacturer" ? "Hersteller" : "Ratgeber",
    title: entry.hubTitle,
    text: entry.hubDescription
  }))
  .slice(0, 3);

const productNextSteps = buildProductNextSteps({
  product: contentProduct,
  pages,
  comparisons
});

const pageTitle =
  contentProduct.title;

const pageDescription =
  contentProduct.description;

const seoTitle =
  contentProduct.seo?.title ??
  `${contentProduct.title} im Test und Vergleich`;

const seoDescription =
  contentProduct.seo?.description ??
  contentProduct.description;

const canonical =
  contentProduct.seo?.canonical ??
  contentProduct.productUrl ??
  `/produkt/${contentProduct.slug}/`;

const heroImage =
  contentProduct.images.hero.src;

const heroImageAlt =
  contentProduct.images.hero.alt ??
  pageTitle;

const calculatedProductScore = calculateProductScore(contentProduct);
const productScore100 = calculatedProductScore.score;

const productSuitabilityLabels = Array.from(new Set([
  ...(Array.isArray(contentProduct.decision?.bestFor)
    ? contentProduct.decision.bestFor
    : []),
  ...(Array.isArray(contentProduct.petSize)
    ? contentProduct.petSize
    : contentProduct.petSize
      ? [contentProduct.petSize]
      : []),
  ...(contentProduct.animal
    ? [contentProduct.animal]
    : [])
]))
  .map((value) => String(value).trim())
  .filter(Boolean)
  .slice(0, 4);

const compactProductSpecs = (() => {
  const source = contentProduct.specs ?? {};
  const entries = Array.isArray(source)
    ? source
    : Object.entries(source).map(([label, value]) => ({
        label,
        value:
          value && typeof value === "object"
            ? value.value ?? value.label ?? value.text ?? ""
            : value
      }));

  const blocked = new Set([
    "status",
    "prüfstatus",
    "teststatus",
    "bewertungsstatus"
  ]);

  const normalized = entries
    .map((item) => ({
      ...item,
      label: String(item?.label ?? item?.title ?? item?.name ?? "").trim(),
      value: String(item?.value ?? item?.text ?? item?.description ?? "").trim()
    }))
    .filter((item) =>
      item.label &&
      item.value &&
      !blocked.has(item.label.toLowerCase()) &&
      item.value.toLowerCase() !== "editorial-review"
    )
    .slice(0, 8);

  if (productSuitabilityLabels.length) {
    normalized.unshift({
      label: "Geeignet für",
      value: productSuitabilityLabels.join(", ")
    });
  }

  return normalized.slice(0, 8);
})();

// Product Renderer 4.1 Premium: bestehende Datenlogik bleibt unverändert.
const reviewProduct = {
        name: contentProduct.title,
        manufacturerLabel:
          contentProduct.manufacturer.name,
        category:
          contentProduct.category.label,
        recommendation:
          contentProduct.recommendation,
        rating: undefined,
        score: productScore100 ?? undefined,
        capacity:
          contentProduct.capacity,
        expandable:
          contentProduct.expandable,
        useCase:
          contentProduct.useCase,
        pros:
          contentProduct.strengths,
        cons:
          contentProduct.weaknesses,
        bestFor:
          contentProduct.decision.bestFor,
        notFor:
          contentProduct.decision.attention,
        ratings:
          contentProduct.ratings,
        specs: compactProductSpecs,
        review:
          contentProduct.review,
        images: {
          hero: {
            src: heroImage,
            alt: heroImageAlt
          },
          gallery:
            contentProduct.images.gallery
        },
        conversion:
          contentProduct.conversion,
        affiliate:
          contentProduct.affiliate
            ? {
                ...contentProduct.affiliate,
                url: addAmazonTrackingId(
                  contentProduct.affiliate.url,
                  projectConfig.affiliate.amazon.trackingId
                )
              }
            : undefined
      };

const optimizedOgImage = await getCachedImage({
  src: heroImage,
  width: 1200,
  quality: "high"
});

const categoryLabel =
  contentProduct.category.label;

const categoryHref =
  contentProduct.category.path ??
  "/smarte-futterautomaten/";

const author =
  contentProduct.author ?? {
    name:
      "PfotenTechnik Redaktion",

    role:
      "Redaktion"
  };

const publishedAt = contentProduct.publishedAt;
const updatedAt =
  contentProduct.updatedAt ??
  publishedAt;


const toReviewItemList = (items = []) => ({
  "@type": "ItemList",
  itemListElement: items
    .filter(Boolean)
    .slice(0, 5)
    .map((name, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name
    }))
});

const structuredReviewBody =
  contentProduct.review?.verdict ??
  contentProduct.review?.summary ??
  contentProduct.recommendation;

const schemaPriceCurrent = contentProduct.price?.current;
const schemaPriceCheckedAt = contentProduct.price?.checkedAt
  ? new Date(contentProduct.price.checkedAt).getTime()
  : Number.NaN;
const schemaPriceIsFresh =
  typeof schemaPriceCurrent === "number" &&
  Number.isFinite(schemaPriceCurrent) &&
  schemaPriceCurrent > 0 &&
  Number.isFinite(schemaPriceCheckedAt) &&
  Date.now() - schemaPriceCheckedAt <= 14 * 86_400_000 &&
  productOperations.purchasable;

const productSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: contentProduct.title,
  description: seoDescription,
  url: new URL(canonical, site.domain).toString(),
  image: [
    new URL(optimizedOgImage.src, site.domain).toString()
  ],
  sku: contentProduct.slug,
  category: contentProduct.category.label,
  brand: {
    "@type": "Brand",
    name: contentProduct.manufacturer.name
  },
  ...(schemaPriceIsFresh
    ? {
        offers: {
          "@type": "Offer",
          price: schemaPriceCurrent,
          priceCurrency: contentProduct.price.currency,
          availability: "https://schema.org/InStock",
          url: contentProduct.affiliate?.url ?? new URL(canonical, site.domain).toString()
        }
      }
    : {}),
  ...(productScore100 !== null && productScore100 > 0 ? { review: {
    "@type": "Review",
    name: `${contentProduct.title} – redaktionelle Einordnung`,
    reviewBody: structuredReviewBody,
    datePublished: publishedAt,
    author: {
      "@type": "Organization",
      name: author.name
    },
    publisher: {
      "@type": "Organization",
      name: "PfotenTechnik"
    },
    reviewRating: {
      "@type": "Rating",
      ratingValue: productScore100,
      bestRating: 100,
      worstRating: 0
    },
    ...(contentProduct.strengths?.length
      ? { positiveNotes: toReviewItemList(contentProduct.strengths) }
      : {}),
    ...(contentProduct.weaknesses?.length
      ? { negativeNotes: toReviewItemList(contentProduct.weaknesses) }
      : {})
  }} : {})
};


---

<ProjectLayout
  title={`${pageTitle} Testbericht`}
  seoTitle={seoTitle}
  description={pageDescription}
  seoDescription={seoDescription}
  canonical={canonical}
  noindex={contentProduct.seo?.noindex ?? false}
  ogImage={optimizedOgImage.src}
  author={author}
  publishedAt={publishedAt}
  updatedAt={updatedAt}
  categoryLabel={categoryLabel}
  breadcrumbs={breadcrumbs}
  schemaType="webpage"
>
  <script
    type="application/ld+json"
    set:html={JSON.stringify(productSchema)}
  />

  <!-- Breadcrumbs werden ausschließlich als BreadcrumbList-JSON-LD im Layout ausgegeben. -->

  <div class="product-detail pt-product-detail" data-product-page>
    <AutoLinkContent
      definitions={internalLinkDefinitions}
      sourcePath={canonical}
      sourceGroup="product"
      sourceContexts={sourceContexts}
      maxLinksPerPage={5}
    >
      <ProductRenderer
        product={{
          slug: contentEntry.slug,
          data: contentProduct
        }}
        currentEntry={contentEntry}
        allProducts={allProducts}
        reviewProduct={reviewProduct}
        alternativeRecommendations={alternativeRecommendations}
      />
    </AutoLinkContent>

    <EditorialTransparency
      kind="produkt"
      author={author}
      publishedAt={publishedAt}
      updatedAt={updatedAt}
      testStatus={contentProduct.testStatus}
      evidence={contentProduct.editorial?.evidence ?? []}
      recommendationReason={contentProduct.recommendation}
    />

    <DecisionNextSteps
      title="Passend weiterentscheiden"
      intro="Öffne den passenden Vergleich oder die Kaufberatung für diesen Anwendungsfall."
      items={productNextSteps}
    />

<RelatedArticles
  items={relatedItems}
  eyebrow="Ratgeber und Hintergründe"
  title="Passend zum Produkt weiterlesen"
/>
  </div>





</ProjectLayout>
