---
import { render } from "astro:content";
import ProjectLayout from "../layouts/ProjectLayout.astro";
import Breadcrumbs from "@affiliate-core/components/Breadcrumbs.astro";
import FAQ from "@affiliate-core/components/FAQ.astro";
import RelatedArticles from "@affiliate-core/components/RelatedArticles.astro";
import AutoLinkContent from "@affiliate-core/components/AutoLinkContent.astro";
import HealthBridge from "../components/HealthBridge.astro";
import EditorialEvidence from "../components/EditorialEvidence.astro";
import CategoryExperience from "../components/category/CategoryExperience.astro";
import GuideExperience from "../components/guide/GuideExperience.astro";
import { siteMeta } from "../project.config";
import { assembleContentPage } from "../domain/contentPlatform";
import { buildCategoryViewModel } from "../domain/category/buildCategoryViewModel";
import { buildGuideExperienceModel } from "../domain/guideExperience/model";
import { getPageBreadcrumbs, getRelatedContent } from "@app/domain/content";
import { getInternalLinkDefinitions, getSourceContexts } from "../domain/content/internalLinks";
import defaultHero from "../assets/images/project/pfotentechnik/hero.webp";
import { getCachedImage } from "../lib/imageOptimization";
import {
  getComparisons,
  getManufacturers,
  getPages,
  getProducts,
  type PageEntry
} from "../domain/content/registry";

type Props = { page: PageEntry; };

export async function getStaticPaths() {
  const pages = await getPages();
  return pages.map((page) => ({ params: { slug: page.data.slug }, props: { page } satisfies Props }));
}

const { page } = Astro.props as Props;
const { Content, headings } = await render(page);
const [pages, products, comparisons, manufacturers] = await Promise.all([
  getPages(),
  getProducts(),
  getComparisons(),
  getManufacturers()
]);
const breadcrumbs = getPageBreadcrumbs(page);
const assembledPage = assembleContentPage(page.data);
const categoryModel = buildCategoryViewModel({ page, pages, products, comparisons });
const guideModel = categoryModel ? undefined : buildGuideExperienceModel({ page, pages, products, comparisons, assembled: assembledPage });
const author = page.data.author ?? siteMeta.defaultAuthor;
const publishedAt = page.data.publishedAt ?? siteMeta.articleDefaults.publishedAt;
const updatedAt = page.data.updatedAt ?? page.data.publishedAt ?? siteMeta.articleDefaults.updatedAt;
const ogImage = page.data.ogImage ?? page.data.heroImage ?? { src: defaultHero, alt: page.data.title };
const optimizedOgImage = await getCachedImage({ src: ogImage.src, width: 1200, quality: "high" });
const internalLinkDefinitions = getInternalLinkDefinitions({ pages, products, comparisons, manufacturers });
const sourceContexts = getSourceContexts(page.data);
const relatedEntries = await getRelatedContent({
  currentSlug: page.data.slug,
  title: page.data.title,
  description: page.data.description,
  tags: page.data.related?.tags.length ? page.data.related.tags : page.data.tags,
  sections: page.data.hub?.sections ?? [],
  type: page.data.type,
  exclude: page.data.related?.exclude ?? [],
  limit: page.data.related?.limit ?? 3
});
const relatedItems = relatedEntries.map((entry) => ({
  href: entry.href,
  label: entry.type === "product" ? "Produkt" : entry.type === "manufacturer" ? "Hersteller" : entry.type === "comparison" ? "Vergleich" : "Ratgeber",
  title: entry.hubTitle,
  text: entry.hubDescription
}));
const plainBody = (page.body ?? "")
  .replace(/```[\s\S]*?```/g, " ")
  .replace(/`[^`]*`/g, " ")
  .replace(/<[^>]+>/g, " ")
  .replace(/[{}[\]()*_#>\-|]/g, " ")
  .replace(/\s+/g, " ")
  .trim();
const readingTimeMinutes = Math.max(1, Math.ceil(plainBody.split(" ").filter(Boolean).length / 200));
---

<ProjectLayout
  title={page.data.title}
  description={page.data.description}
  seoTitle={page.data.seo?.title ?? page.data.seoTitle}
  seoDescription={page.data.seo?.description ?? page.data.seoDescription}
  canonical={page.data.seo?.canonical ?? `/${page.data.slug}/`}
  noindex={page.data.seo?.noindex ?? false}
  ogImage={optimizedOgImage.src}
  faq={assembledPage.faq}
  author={author}
  publishedAt={publishedAt}
  updatedAt={updatedAt}
  categoryLabel={assembledPage.categoryLabel}
  breadcrumbs={breadcrumbs}
  schemaType="article"
  mainClass={categoryModel ? "container--category-34-2" : undefined}
>
  <Breadcrumbs items={breadcrumbs} />

  {categoryModel ? (
    <CategoryExperience model={categoryModel} authorName={author.name} updatedAt={updatedAt} />
  ) : guideModel ? (
    <>
      <GuideExperience
        model={guideModel}
        headings={headings}
        author={author}
        publishedAt={publishedAt}
        updatedAt={updatedAt}
        readingTimeMinutes={readingTimeMinutes}
      >
        <AutoLinkContent
          definitions={internalLinkDefinitions}
          sourcePath={`/${page.data.slug}/`}
          sourceGroup="knowledge"
          sourceContexts={sourceContexts}
          maxLinksPerPage={7}
        >
          <Content />
        </AutoLinkContent>
        <Fragment slot="after-content">
          <EditorialEvidence profile={assembledPage.informationGain} />
          {page.data.healthBridge && <HealthBridge {...page.data.healthBridge} />}
        </Fragment>
        <Fragment slot="faq">
          <FAQ items={assembledPage.faq} />
        </Fragment>
      </GuideExperience>
      <RelatedArticles items={relatedItems} />
    </>
  ) : null}
</ProjectLayout>
