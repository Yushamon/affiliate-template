---
import ProjectLayout from "../../layouts/ProjectLayout.astro";
import Breadcrumbs from "@affiliate-core/components/Breadcrumbs.astro";
import FAQ from "@affiliate-core/components/FAQ.astro";
import RelatedArticles from "@affiliate-core/components/RelatedArticles.astro";
import ManufacturerExperience from "../../components/manufacturer/ManufacturerExperience.astro";
import { getManufacturerBreadcrumbs, getRelatedContent } from "@app/domain/content";
import { getCachedImage } from "../../lib/imageOptimization";
import { buildManufacturerExperienceModel } from "../../domain/manufacturerExperience/model";
import {
  getComparisons,
  getManufacturers,
  getProducts,
  type ManufacturerEntry
} from "../../domain/content/registry";

type Props = { entry: ManufacturerEntry; };

export async function getStaticPaths() {
  const manufacturers = await getManufacturers();
  return manufacturers.map((entry) => ({
    params: { manufacturer: entry.data.slug },
    props: { entry } satisfies Props
  }));
}

const { entry } = Astro.props as Props;
if (!entry) throw new Error("Der Hersteller wurde nicht an die Route übergeben.");

const manufacturer = entry.data;
const [products, manufacturers, comparisons] = await Promise.all([
  getProducts(),
  getManufacturers(),
  getComparisons()
]);
const model = buildManufacturerExperienceModel({ entry, products, comparisons, manufacturers });
const breadcrumbs = getManufacturerBreadcrumbs(entry);
const optimizedOgImage = await getCachedImage({ src: manufacturer.images.hero.src, width: 1200, quality: "high" });
const relatedEntries = await getRelatedContent({
  currentSlug: manufacturer.slug,
  tags: manufacturer.related?.tags.length ? manufacturer.related.tags : manufacturer.tags,
  sections: manufacturer.hub?.sections ?? [],
  type: "manufacturer",
  exclude: manufacturer.related?.exclude ?? [],
  limit: manufacturer.related?.limit ?? 4
});
const relatedItems = relatedEntries.map((related) => ({
  href: related.href,
  label: related.type === "product" ? "Produkt" : related.type === "manufacturer" ? "Hersteller" : related.type === "comparison" ? "Vergleich" : "Ratgeber",
  title: related.hubTitle,
  text: related.hubDescription
}));
---

<ProjectLayout
  title={`${manufacturer.name}: Produkte, Erfahrungen und Empfehlungen`}
  seoTitle={manufacturer.seo?.title ?? `${manufacturer.name}: Erfahrungen und Produkte`}
  description={manufacturer.description}
  seoDescription={manufacturer.seo?.description ?? manufacturer.description}
  canonical={manufacturer.seo?.canonical ?? `/hersteller/${manufacturer.slug}/`}
  noindex={manufacturer.seo?.noindex ?? false}
  ogImage={optimizedOgImage.src}
  faq={manufacturer.faq}
  author={manufacturer.author}
  publishedAt={manufacturer.publishedAt}
  updatedAt={manufacturer.updatedAt}
  categoryLabel="Hersteller"
  breadcrumbs={breadcrumbs}
  schemaType="article"
>
  <Breadcrumbs items={breadcrumbs} />
  <ManufacturerExperience model={model} />
  <RelatedArticles items={relatedItems} />
  <FAQ items={manufacturer.faq} />
</ProjectLayout>
